), Col("M4.03-R03", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.01-R01", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.01-R02", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Approved deviation"]), Col("M5.01-R03", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.01-R04", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.01-R05", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.01-R06", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.01-R07", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.01-R08", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.02-R01", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Approved deviation"]), Col("M5.02-R02", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.02-R03", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.02-R04", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.02-R05", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("M5.02-R06", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-ACC-01", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-ACC-02", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-ACC-03", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-ACC-04", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-ACC-05", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-ACC-06", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-CON-01", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-CON-02", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-CON-03", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-CON-04", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-CON-05", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-M365-01", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-M365-02", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-M365-03", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-M365-04", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-SEC-01", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-SEC-02", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-SEC-03", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-SEC-04", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-FIN-01", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-FIN-02", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-FIN-03", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"]), Col("EXT-FIN-04", ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "Verified in design"])])
reviewContent = [rvSeverity, rvChecksHead, rvChecks, rv00, rv01, rv02, rv03, rv04, rv05, rv06, rv07, rv08, rv09, rv10, rv11]
rvSeverity = SingleStackedBarChart(["High severity", "Medium severity"], [8, 4])
rvChecksHead = CardHeader("Executed document checks", "What the prior review verified and its boundary")
rvChecks = Table([Col("Check", ["Historical statement preservation", "Traceability matrix agreement", "Historical control descriptions", "Lifecycle state names", "Duplicate HTML/SVG IDs", "Requirements-to-workflow references", "Workflow-to-Requirements references", "Executable inline JavaScript", "New extension ID hyperlinks in workflow matrix", "Generic acceptance criteria", "Authored status labels"]), Col("Observed result", ["115/115 IDs and normalized visible statements unchanged", "138/138 rows match across all nine normalized columns", "13/13 match", "11/11 match", "0 in either updated file", "138/138 match valid JavaScript tab route keys", "175/175 target existing anchors", "4/4 pass node --check", "0/23", "104/138", "129 “Verified in design”; 9 “Approved deviation”"]), Col("Boundary", ["Compared with earlier baseline requirements register, not the original Word file", "Agreement can duplicate the same incorrect mapping", "Descriptive match, not runtime enforcement", "One proposal row adds a compatible explanatory email-only note", "Static HTML, before Mermaid generates SVG at runtime", "Canonical filenames assumed; not 138 missing DOM anchors", "Canonical filenames assumed", "External scripts and text/plain Mermaid definitions excluded", "These cells are spans, not navigable requirement links", "Text starts with “Satisfies business rule ...”", "Labels in the files, not this review's verification results"])])
rv00 = MarkDownRenderer("F01 — High: Concrete enforcement references do not match source\n\n**Document evidence:** both matrices, including M1.02-R01, M1.03-R01 and EXT-ACC-01. In the uploaded workflow these rows start around lines 2150, 2227 and 3349 respectively; in Requirements around 3953, 4030 and 5152.\n\nThe following types had zero matches in repository searches scoped to src:\n\n- `ProposalCompilationService`, named as `ProposalCompilationService.GenerateProposalAsync`.\n- `DualKeyAcceptanceService`, named as `DualKeyAcceptanceService.SignKeyAsync`.\n- `ClientAccountingProfileService`, named as `ClientAccountingProfileService.ActivateContextAsync`.\n\nActual quotation and letter behavior is in [src/AuditSphereOps.Application/Practice/CommercialDocumentService.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Application/Practice/CommercialDocumentService.cs). `GenerateBriefQuotationAsync` and `GenerateEngagementLetterAsync` delegate to `GenerateDocumentAsync`. Letter generation checks the approved quotation, current commercial acceptance, exact dispatch/response evidence, current unconditional Partner risk acceptance and source generation. Its risk evidence is resolved through `EngagementRiskEvidence.ForPeriodAsync`.\n\n**Correction:** replace these references with the actual path and method chain, or explicitly label a reference as a proposed design element. Audit every remaining enforcement reference rather than assuming that plausible class names exist. An absent named type does not establish absence of the business capability.\n\n", "card")
rv01 = MarkDownRenderer("F02 — High: The 138-row denominator omits material current requirements\n\nThe files preserve 115 historical statements and add 23 broad extension summaries. That is a document inventory, not a demonstrated inventory of all applicable current requirements.\n\n[docs/requirements/auditsphere-accounting-module-requirements-current.md](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/docs/requirements/auditsphere-accounting-module-requirements-current.md) is CURRENT v2.2 and explicitly adds the seven-phase workflow experience, phase-to-canonical-state mapping, engagement dashboards, reusable templates, recurring engagements, safe automation and security/non-regression rules. The revised HTML does not model that required seven-phase orchestration layer with its own traceable requirements and controls.\n\nThis is not merely speculative future functionality. [src/AuditSphereOps.Application/Practice/EngagementWorkflowPlanService.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Application/Practice/EngagementWorkflowPlanService.cs) contains published-template selection, preview and execution contracts, expected preview digests, idempotency keys, owner selections and typed PBC steps. Its explicit boundary is that templates create supporting tasks and fresh unsent PBC drafts; they do not advance the lifecycle or professional decisions.\n\nThe current requirement set also distinguishes authorized native bookkeeping from import-first accounting and requires reviewed cutover. The 23 extension summaries do not provide a complete mapping of those source-mode, invoice, credit, opening-balance and settlement workflows. This observation does not assert that every proposed bookkeeping feature is already mandatory or complete.\n\n**Correction:** derive the applicable inventory from current normative sources and approved decisions, not a chosen number of extension summaries. Keep the historical 115 count separately. Do not announce a new “100%” denominator before the inventory and exclusions are complete.\n\n", "card")
rv02 = MarkDownRenderer("F03 — High: Approved reporting-context design is presented as implemented\n\nThe accounting diagram immediately binds an ADR-0015 reporting-context revision. EXT-ACC-01 says context activation is verified and names the nonexistent service in F01. Requirements' extension narrative also says the accounting capabilities are fully implemented.\n\nAt the inspected snapshot, [docs/architecture/adr/auditsphere-architecture-adr-0015-reporting-context-identity-pins-approved.md](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/docs/architecture/adr/auditsphere-architecture-adr-0015-reporting-context-identity-pins-approved.md) explicitly records T014 as unstarted and dependent on T013 and T007. Existing records already enforce scoped identities and selected revision pins; that is not proof that the complete new context-activation capability exists.\n\n[docs/execution/status.json](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/docs/execution/status.json) separately records partial implementation/acceptance, false production enablement, and open financial-statement, parity and external gates. Historical slice evidence is not current whole-product acceptance.\n\n**Correction:** distinguish approved target behavior, existing narrower safeguards, incomplete implementation and acceptance evidence. Remove unqualified “fully implemented” statements. Do not imply that an approved ADR itself proves implementation.\n\n", "card")
rv03 = MarkDownRenderer("F04 — High: Archive acceptance invents a state and a universal HTTP contract\n\nEXT-SEC-04 states that the engagement becomes `ARCHIVED_LOCKED` and that all POST/PUT/DELETE commands return HTTP 423. This conflicts with both files' own eleven-state register.\n\nActual source: [src/AuditSphereOps.Application/Acceptance/EngagementLifecycleQuery.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Application/Acceptance/EngagementLifecycleQuery.cs) defines `CanonicalEngagementStages.ArchivedReadOnly = \"ARCHIVED_READ_ONLY\"`. It derives this state from a committed local freeze; elapsed time alone is not an archived state. Local freeze and provider protection are exposed separately.\n\nThe shared command mapping in [src/AuditSphereOps.Api/Ui/UiEndpoints.Infrastructure.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Api/Ui/UiEndpoints.Infrastructure.cs) uses typed errors mapped through `StatusFor`, including 401, 403, 409 and a 400 fallback. It does not implement the documented blanket 423 mapping.\n\n**Correction:** use the canonical derived state and distinguish scheduled, overdue-but-not-committed, locally frozen and externally verified protection. Map each relevant denial to the existing route's actual error/status contract; do not mandate an undocumented global status-code rewrite.\n\n", "card")
rv04 = MarkDownRenderer("F05 — High: Signature guarantees exceed the implementation\n\nEXT-SEC-03 names `PdfDigitalSigningService`, claims certificate revocation checking, and states that a missing certificate always blocks signing. Requirements' ADR summary similarly states an unconditional missing-certificate failure.\n\nActual [src/AuditSphereOps.Application/Completion/ReportCertificateSigning.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Application/Completion/ReportCertificateSigning.cs) implements:\n\n- `Resolve`: no configured certificate and signing not required permits visual signature/seal only.\n- Required-but-missing or configured-but-unusable certificate material blocks signing.\n- `Validate`: private key, validity interval, RSA key size and key-usage checks.\n- `ReportSignatureVerifier.Verify`: `SignedCms.CheckSignature(verifySignatureOnly: true)` verifies the signed bytes; it does not establish certificate trust or revocation status.\n\n[src/AuditSphereOps.Application/Completion/AuditDeliverableService.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Application/Completion/AuditDeliverableService.cs) owns `SignIndependentReportAsync`; the corresponding API delegates to it with `IReportSigningCredentialSource`.\n\n**Correction:** document VISUAL versus CERTIFICATE mode, the Required switch, configured-but-invalid refusal, and the exact verification guarantees. Remove revocation/trust claims unless a separately approved and verified implementation exists. Keep production certificate custody and legal acceptance separate.\n\n", "card")
rv05 = MarkDownRenderer("F06 — High: Microsoft provisioning omits the approved privileged-worker exception\n\nThe M365 diagram lists six single-purpose identities, then shows dedicated-site creation and site permission assignment without modeling the provisioner's distinct permissions and isolation. Its general “one permission” description is incomplete for the separately approved site-provisioning resource boundary.\n\n[src/AuditSphereOps.Infrastructure/Providers/SharePointClientSiteProvider.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Infrastructure/Providers/SharePointClientSiteProvider.cs) contains separate SharePoint and Graph resource token sources. SharePoint token validation requires exactly `Sites.FullControl.All`; the Graph provisioner is also configured for that role. It uses SPSiteManager, verifies the exact ownership marker and site identity, and grants a different document-worker identity write access to the exact site.\n\n[docs/architecture/auditsphere-client-sharepoint-sites-current.md](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/docs/architecture/auditsphere-client-sharepoint-sites-current.md) confines the privileged credential to the isolated Acceptance `client-sites` worker, not the API or PBC worker; one role per resource is the relevant exception. Rollout cutoff, consent, configuration and remote verification remain distinct gates.\n\n**Correction:** model the privileged provisioner explicitly without broadening the ordinary document-worker identity. Preserve `Sites.Selected` for document operations, the resource distinction, exact-site validation and unknown-create reconciliation. Do not confuse application permissions with Entra directory administrator roles.\n\n", "card")
rv06 = MarkDownRenderer("F07 — High: Scope authorization is drawn in the wrong layer\n\nThe overview and M365 diagrams place scoped RoleGrant enforcement in API authentication middleware.\n\n[src/AuditSphereOps.Api/HttpBoundary/HttpPolicies.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Api/HttpBoundary/HttpPolicies.cs) explicitly states that HTTP authorization only establishes an authenticated cookie session. `TrustedActorResolver`, `AuthorizationDecision`, RoleGrant scope and business gates remain in Application. The shared endpoint helper re-resolves the session and delegates to named commands/queries; the browser cannot authorize the operation.\n\n**Correction:** draw OIDC/cookie/CSRF checks at the HTTP boundary and firm/client/engagement/group business authorization inside Application on every read and mutation. Preserve both layers rather than replacing either.\n\n", "card")
rv07 = MarkDownRenderer("F08 — High: Invoice and release diagrams omit operative finance gates\n\nThe onboarding flow says “Issue 50 percent advance invoice”; the release flow assembles the final bundle, then generates its balance invoice. Other document text mentions draft-only automation, but the workflows do not express the full approved dependency and approval boundaries.\n\n[src/AuditSphereOps.Application/Practice/AutomaticFeeInvoices.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Application/Practice/AutomaticFeeInvoices.cs) implements optional automation which returns without work when disabled. It runs under captured, revalidated finance/administrator authority. It creates drafts through `FeeAgreementService.IssueAdvanceInvoiceAsync` or `IssueBalanceInvoiceAsync`. Independent approval, posting and mail dispatch are separate.\n\nThe balance discovery condition includes a currently paid advance and a release whose target is a **FinancialPackage**. A financial-package release and the final five-part commercial bundle must not be collapsed into one event.\n\n**Correction:** distinguish draft creation, finance approval, posting, dispatch, payment allocation, financial-package release and final bundle assembly. Preserve existing-client exceptions and executed commercial terms. Do not infer automatic posting or a circular final-invoice/bundle dependency.\n\n", "card")
rv08 = MarkDownRenderer("F09 — Medium: The risk view does not fully incorporate approved current definitions\n\nHistorical threshold wording remains useful provenance, but the current view still presents Amber sampling as mandatory and mainly describes banding through balance thresholds.\n\n[docs/architecture/adr/auditsphere-architecture-adr-0017-ste-v22-delegated-requirement-decisions-approved.md](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/docs/architecture/adr/auditsphere-architecture-adr-0017-ste-v22-delegated-requirement-decisions-approved.md) defines Amber work as Senior-or-above execution and Audit Manager review, with documented senior judgment between sampling and full-population testing; it explicitly rejects a universal sample requirement. It also defines recorded critical-estimate and high-inherent-risk inputs.\n\n[src/AuditSphereOps.Application/Audit/RiskBandService.cs](https://github.com/nirzaf/AuditSphere/blob/a96c83d804cecd39ca96a0bbbb7fb8ae4557be30/src/AuditSphereOps.Application/Audit/RiskBandService.cs) records likelihood, magnitude, significance, fraud and critical-estimate inputs, delegates band computation to `RiskBandRules.Band`, and enforces staffing/independent clearance. It does not take an FSLI balance as the assessment request shown in that path.\n\n**Correction:** separate historical balance-based requirements from the exact implemented risk-routing inputs and approved product definitions. Any remaining source-versus-code gap requires explicit disposition; do not silently claim equivalence. Show the staffed Engagement Partner requirement for final professional actions, as specified by ADR-0017.\n\n", "card")
rv09 = MarkDownRenderer("F10 — Medium: Source authority and ADR references remain internally inconsistent\n\nThe workflow simultaneously says full accounting/consolidation is implemented and later calls the same capabilities unapproved extensions (around lines 883–898 versus 2051–2056). It also retains “signature technology is open” wording after adding the approved certificate-signing decision. The historical/current boundary is not consistently applied.\n\nRequirements' ADR register contains incorrect baseline references:\n\n| Register entry | Current reference | Problem |\n|---|---|---|\n| ADR-0011 | M2.04-R03 | This is Revenue; historical normalized PBT is M2.04-R02 |\n| ADR-0016 | M4.02-R05 | This is management correspondence; report/statements are M4.02-R02 and final signature is M4.01-R07 |\n| ADR-0005 | M4.02-R05 | The same correspondence row is not the visual-credentials requirement |\n\n**Correction:** retain historical text but label its applicability at the point of use, and provide the operative overlay immediately beside the affected requirement/diagram. Fix every source reference and link the actual decision document. Do not declare all open professional or external matters resolved by an ADR about a narrower technical choice.\n\n", "card")
rv10 = MarkDownRenderer("F11 — Medium: Acceptance and design-verification labels are not supported by the matrix\n\n104 cells say only “Satisfies business rule [ID] as defined in source specification §4.” They do not define observable inputs, authorized actor, success result, denial, relevant revision condition or evidence. Copying these cells to a second matrix does not strengthen traceability.\n\n**Correction:** replace generic cells with focused, testable behavior, appropriate to the requirement's actual granularity. Separately record source authority, design coverage, code implementation and executed acceptance evidence. Some of the historical 115 statements are headings or child bullets; preserve those identities without falsely treating each as a complete independent feature.\n\nSuggested minimum fields: source ID/path/section; current operative rule; actual code path/method or explicit proposed element; API/Angular enforcement path where applicable; one positive criterion; relevant denial/staleness criterion; evidence status and unresolved dependencies.\n\n", "card")
rv11 = MarkDownRenderer("F12 — Medium: Navigation has improved but extension traceability and runtime validation remain incomplete\n\nThe filename-case mismatch is corrected and the canonical cross-document links pass structural checks. Requirements-to-workflow fragments use JavaScript tab routing and are valid; they should not be incorrectly reported as missing DOM IDs.\n\nHowever, all 23 EXT identifier cells in the workflow are plain spans, despite the instruction that every requirement ID opens its full narrative. Add exact anchors and links for those rows. Deliver the pair using canonical filenames, or consolidate into a single self-contained reference without cross-document file dependencies. If older canonical files sit beside them, navigation can open stale content.\n\nExternal Tailwind, font and Mermaid dependencies remain in the workflow file. JavaScript syntax checks do not prove Mermaid rendering, CDN availability, mobile interaction or print completeness.\n\n**Correction:** link extension records, retain explicit network requirements or package local/pre-rendered assets, and execute a focused browser check before claiming interactive or offline acceptance.\n\n## Prioritized correction sequence\n\n1. **Remove misleading evidence:** quarantine unverified code pointers, eliminate the unsupported implemented/verified claims, and correct the archive and signature contracts.\n2. **Establish complete applicable scope:** inventory CURRENT v2.2 plus approved extensions/deviations; preserve the original 115 separately. Explicitly identify excluded, proposed and externally blocked items.\n3. **Repair source-to-design mappings:** use existing application services and exact HTTP/Angular paths; repair security, provider permissions, finance dependencies and risk-policy overlays.\n4. **Make acceptance criteria executable:** replace generic repetitions; distinguish design coverage from code presence and behavioral verification. Do not retrofit source behavior to incorrect documentation.\n5. **Recheck the artifacts:** regenerate both views from a common inventory if the existing tooling supports it, preserve source wording and IDs, and run targeted static/browser checks. No full application suite is justified for documentation-only changes.\n\n## Acceptance conditions for a subsequent review\n\nThe documentation pair can be accepted as a code-aligned reference only when every applicable current requirement has a supported disposition, all concrete code pointers resolve to the reviewed implementation or are explicitly proposed, every diagram preserves actual mandatory gates, and incorrect status/permission/signature claims are removed. A reviewed source commit and observed evidence must remain attributable without duplicating volatile repository state across uncontrolled narratives.\n\nDo not claim 100% production implementation, financial-methodology approval, tenant acceptance or regulatory compliance from these checks. Current deployment, professional and external gates remain governed by their existing records.\n\n## Executed versus not executed\n\n**Executed:** complete local HTML parsing; historical ID/text comparison; matrix equality and status counts; control/state checks; unique-ID checks; route-aware cross-link checks; four node syntax checks; current GitHub snapshot and authority retrieval; targeted source inspection and three source-scoped symbol searches.\n\n**Not executed:** .NET/Angular builds or application tests; authenticated application journeys; live Entra/Graph/SharePoint operations; database/permission changes; deployed archive/recovery validation; certificate trust/revocation tests; browser execution of the supplied HTML or Mermaid; mobile/print/offline acceptance. These checks are not marked passed.\n\n**No source changes:** uploaded originals remain unchanged. This report and its validation evidence are separate generated artifacts.\n", "card")
