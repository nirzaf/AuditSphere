ovPara0 = TextContent("The architecture atlas, supplied requirements, current-source additions, and review findings are available here without external scripts or separate document files.")
ovPara1 = TextContent(".NET 10 / C# 14, Angular 22 / Material-CDK, one modular monolith and isolated worker groups, as described in the source atlas.")
ovPara2 = TextContent("The atlas pins PostgreSQL 18.6 / EF Core 10. Firm books, client accounting and group consolidation remain separate financial domains.")
ovBoundary = Callout("warning", "Design is not production acceptance", "Historical statements are kept for provenance. Supplied extensions are unverified, and the prior review findings below still apply.")
ovMix = PieChart(["Historical requirement", "Architecture diagram", "Current v2.2 source excerpt", "Historical control", "Historical lifecycle", "Supplied extension — unverified", "Prior review finding"], [115, 16, 3, 13, 11, 23, 12], "donut")
ovModules = HorizontalBarChart(["M1 · Commercial & CRM Pipeline", "M2 · Administration, Governance & Planning", "M3 · Technical Execution & Audit Fieldwork", "M4 · Reporting & Final Deliverables", "M5 · Practice Analytics & Internal Bookkeeping"], [Series("Historical requirements", [31, 28, 26, 16, 14])], "grouped", "Requirements", "Module")
ovCatalog = Table([Col("#", ["00", "01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12", "13", "14", "15"]), Col("View", ["Master architecture", "Module & feature catalog", ".NET layers & authority", "Sign-in & command sequence", "11-stage lifecycle", "7-phase workflow & tasks", "CRM, acceptance & activation", "Audit planning & fieldwork", "Client accounting & statements", "Group consolidation", "Practice & firm finance", "Microsoft 365 & SharePoint", "PBC, signing & archive", "Durable operations & recovery", "Financial & data integrity", "Deployment & verification"]), Col("Scope", ["Canonical Angular plus ASP.NET Core modular monolith, all major business capabilities, one PostgreSQL database, isolated worker roles, and external Microsoft services.", "All five STE functional modules plus the current client accounting, consolidation, PBC, technical library, workflow experience and platform administration capabilities.", "Runtime layering, static commands/queries, domain calculations, persistent database model, and separate execution host.", "Actual same-origin browser authentication model and responsibility split between transport and business authority.", "Canonical derived lifecycle projection, no persisted manually mutable stage column.", "Simplified user workflow is a projection of the eleven canonical stages, not a second state machine.", "Exact accepted offer and risk evidence must both exist for a letter; paid advance precedes engagement activation.", "Planning controls, risk routing, programme publication, sampling, PBC, execution/review receipts, SRM and human opinion.", "Two supported accounting-source modes, with separate native journal and invoice workflows and partial ancillary capabilities.", "Approved perimeters, versioned components, external packs, exchange-rate policy, matching/eliminations and group reports.", "Commercial fees, time, billing, practice financial statements, staff economics and separately controlled client accounting.", "The correctly split application identities, privileged client-sites exception, local RoleGrants, and provider readback.", "Immutable document identities, professional review, signature policy, five-part bundle, client portal freeze, separate secondary SharePoint copy.", "Operation intent / leased worker execution / verified remote effects / idempotent original-actor recovery.", "One PostgreSQL database with business ownership boundaries, transaction guards and immutable evidence.", "Existing implementation/runtime topology and separate verification controls, without inventing a production-ready deployment."])])
diagramsContent = [dgNote, dgHead00, dgCode00, dgHead01, dgCode01, dgHead02, dgCode02, dgHead03, dgCode03, dgHead04, dgCode04, dgHead05, dgCode05, dgHead06, dgCode06, dgHead07, dgCode07, dgHead08, dgCode08, dgHead09, dgCode09, dgHead10, dgCode10, dgHead11, dgCode11, dgHead12, dgCode12, dgHead13, dgCode13, dgHead14, dgCode14, dgHead15, dgCode15]
dgNote = TextContent("Each view is Mermaid source; renderers with a Mermaid-aware CodeBlock draw it, others show the source.", "small")
dgHead00 = CardHeader("00 · Master architecture", "Canonical Angular plus ASP.NET Core modular monolith, all major business capabilities, one PostgreSQL database, isolated worker roles, and external Microsoft services.")
dgCode00 = CodeBlock("mermaid", "flowchart TB\n    subgraph ACTORS[\"Users and external actors\"]\n        STAFF[\"Firm staff: Administrator, Partner, Manager, Preparer\"]\n        CLIENT[\"Client liaison, CFO, management\"]\n        OPERATOR[\"Tenant / deployment operator\"]\n    end\n\n    subgraph UI[\"AuditSphereOps.Ui — Angular 22 + Material/CDK\"]\n        STAFF_UI[\"Staff portal: practice, audit, accounting, consolidation\"]\n        CLIENT_UI[\"Client portal: PBC, finance documents, responses\"]\n        ADMIN_UI[\"Admin: users, tenant, permissions, operations\"]\n        UX[\"Seven-phase engagement tracker and task queues — v2.2\"]\n    end\n\n    subgraph API[\"AuditSphereOps.Api — ASP.NET Core 10\"]\n        HTTP[\"Same-origin /api/ui + /api/setup; SPA /ui\"]\n        SESSION[\"OIDC sign-in, secure cookie, anti-CSRF, session freshness\"]\n        CONTRACTS[\"OpenAPI 3.1, exact decimal-string contracts, bounded uploads\"]\n    end\n\n    subgraph APP[\"AuditSphereOps.Application — static capability commands/queries\"]\n        ACCESS[\"Trusted actor + scoped RoleGrant and business authorization\"]\n        CRM[\"Commercial CRM, proposals, quotations, dual-key acceptance\"]\n        ACTIVATE[\"Fee agreement, advance gate, engagement activation\"]\n        PLAN[\"Staffing, budgets, materiality, risk, workflow templates\"]\n        FIELD[\"Audit programme, workpapers, sampling, confirmation, review\"]\n        PBC[\"PBC requests, client reviews, evidence and secure documents\"]\n        COMPLETE[\"SRM, Partner opinion, signing, bundles, release, archive\"]\n        FIRM[\"Practice time, billing, collections, firm ledger and reporting\"]\n        ACCOUNT[\"Client source intake, native books, journals, statements\"]\n        GROUP[\"Group consolidation, intercompany, FX, eliminations\"]\n        ADMIN[\"Microsoft tenant administration, directory, selected sites\"]\n        DURABLE[\"Durable intent, idempotency, receipts and recovery\"]\n    end\n\n    subgraph LOWER[\"Domain + Infrastructure (separate projects)\"]\n        DOMAIN[\"Domain rules and pure deterministic calculators\"]\n        EF[\"EF Core 10 / Npgsql — one capability-split AuditSphereDbContext\"]\n        ADAPTERS[\"Providers, rendering, signing credential source\"]\n    end\n\n    subgraph WORK[\"AuditSphereOps.Worker — isolated executable groups\"]\n        LOCAL[\"general / processing / records: local durable work\"]\n        MAIL[\"mail: separately enabled outbound delivery\"]\n        DOC[\"pbc: Sites.Selected, exact-site evidence transport\"]\n        SITES[\"client-sites: privileged site provisioner, isolated\"]\n    end\n\n    subgraph DATA[\"Authoritative application data / document evidence\"]\n        PG[(\"PostgreSQL 18.6: firm, client, group, audit, receipts, history\")]\n        RELEASE[\"Authoritative issued bytes and manifest, SHA-256 lineage\"]\n        FREEZE[\"Local file freeze and immutable archive evidence\"]\n    end\n\n    subgraph EXTERNAL[\"Externally controlled services (consent and evidence required)\"]\n        ENTRA[\"Microsoft Entra ID / OIDC\"]\n        GRAPH[\"Microsoft Graph: capability-specific app identities\"]\n        SP[\"SharePoint: client sites, workpapers, secondary archive copy\"]\n        MAIL_PROVIDER[\"Configured provider: Graph Mail / SMTP / Resend\"]\n    end\n\n    STAFF --> STAFF_UI\n    CLIENT --> CLIENT_UI\n    OPERATOR --> ADMIN_UI\n    STAFF_UI --> HTTP\n    CLIENT_UI --> HTTP\n    ADMIN_UI --> HTTP\n    UX --> STAFF_UI\n    HTTP --> SESSION --> ACCESS\n    HTTP --> CONTRACTS\n    SESSION <-->|\"server-side sign-in\"| ENTRA\n    ACCESS --> CRM --> ACTIVATE --> PLAN --> FIELD --> COMPLETE\n    PLAN --> PBC\n    FIELD --> PBC\n    FIELD -.->|\"approved source / FSLI\"| ACCOUNT\n    ACCOUNT -.->|\"read-only component inputs\"| GROUP\n    FIELD -.->|\"approved time\"| FIRM\n    COMPLETE -.->|\"fee/release evidence\"| FIRM\n    ACCESS --> ACCOUNT\n    ACCESS --> GROUP\n    ACCESS --> ADMIN\n    ACCESS --> FIRM\n    ACCESS --> DURABLE\n    CRM --> DOMAIN\n    ACCOUNT --> DOMAIN\n    GROUP --> DOMAIN\n    COMPLETE --> DOMAIN\n    ACCESS --> EF\n    DURABLE --> EF\n    EF --> PG\n    COMPLETE --> RELEASE\n    RELEASE --> FREEZE\n    LOCAL --> DURABLE\n    MAIL --> DURABLE\n    DOC --> DURABLE\n    SITES --> DURABLE\n    LOCAL --> EF\n    MAIL --> MAIL_PROVIDER\n    DOC --> GRAPH\n    DOC --> SP\n    SITES --> SP\n    SITES --> GRAPH\n    ADMIN --> GRAPH\n    PBC -.->|\"verified provider receipts\"| DOC\n    RELEASE -.->|\"secondary copy; verify bytes and grants\"| DOC\n    ADAPTERS --> GRAPH\n    ADAPTERS --> SP\n    ADAPTERS --> RELEASE")
dgHead01 = CardHeader("01 · Module & feature catalog", "All five STE functional modules plus the current client accounting, consolidation, PBC, technical library, workflow experience and platform administration capabilities.")
dgCode01 = CodeBlock("mermaid", "flowchart LR\n    subgraph M1[\"STE Module 1 — Commercial and CRM\"]\n        M1A[\"Leads, client organizations, contacts, opportunities\"]\n        M1B[\"Firm profile, quotations, tender proposals, approvals\"]\n        M1C[\"Exact offer dispatch and response; dual-key acceptance\"]\n        M1D[\"Engagement letter, agreed fee and 50/50 milestones\"]\n    end\n    subgraph M2[\"STE Module 2 — Governance and planning\"]\n        M2A[\"New-client and recurring-client risk, AML/KYC, Partner decision\"]\n        M2B[\"Staffing, capacity, leave, Sunday-week calendar, budgets\"]\n        M2C[\"Materiality PM / TE / SAD and documented ±5% rounding\"]\n        M2D[\"Risk routing, staffing minimums, Partner clearance\"]\n    end\n    subgraph M3[\"STE Module 3 — Fieldwork\"]\n        M3A[\"TB / GL comparatives, FSLI dashboards, analytical review\"]\n        M3B[\"Published programmes, procedures, sampling, workpapers\"]\n        M3C[\"PBC evidence, confirmations, exceptions, differences\"]\n        M3D[\"Independent reviewer notes, rework, current evidence\"]\n    end\n    subgraph M4[\"STE Module 4 — Completion and records\"]\n        M4A[\"SRM, critical confirmations, Partner opinion and basis\"]\n        M4B[\"Signed report and statements, representations, five-part bundle\"]\n        M4C[\"Release, client upload freeze, 60-day file freeze\"]\n        M4D[\"Authoritative archive, manifests and regulator export\"]\n    end\n    subgraph M5[\"STE Module 5 — Practice management\"]\n        M5A[\"Time recording, rate cards, approvals, resource utilization\"]\n        M5B[\"Fee invoices, allocations, receipts, reversals, AR ageing\"]\n        M5C[\"Own-firm ledger, expenses, EOS provision, firm TB / P&L\"]\n        M5D[\"Practice analytics, portfolio, client work, technical library\"]\n    end\n    subgraph R2R[\"Client-owned accounting (independent financial book)\"]\n        R1[\"External source TB / GL, approval, mapping and history\"]\n        R2[\"Native bookkeeping (accepted mandate), opening balances, journals\"]\n        R3[\"Client sales / purchase documents, credits, allocations — partial\"]\n        R4[\"Adjustments, reconciliations, valuation and FX workpapers\"]\n        R5[\"Financial statements, disclosure, review, package and exports\"]\n    end\n    subgraph CONS[\"Group consolidation (separate group run)\"]\n        C1[\"Scope/perimeter, ownership, components, external packs\"]\n        C2[\"Currency translation, approved rates, CTA and NCI\"]\n        C3[\"Intercompany matching, eliminations, independent reviews\"]\n        C4[\"Group run and reports — no component-book write-back\"]\n    end\n    subgraph PLATFORM[\"Cross-cutting platform modules\"]\n        P1[\"Identity, trusted actors, RoleGrants, session revocation\"]\n        P2[\"M365 consent, directory discovery, selected-site resources\"]\n        P3[\"PBC requests, review, source-bound secure documents\"]\n        P4[\"v2.2 seven-phase UI, templates, task queue and reminders\"]\n        P5[\"Durable operations, recovery, metrics, global search\"]\n    end\n    M1D --> M2A\n    M2C --> M3A\n    M3D --> M4A\n    M3B -.-> M5A\n    M1D -.-> M5B\n    R1 --> R4 --> R5\n    R2 --> R3\n    R2 --> R5\n    R5 -.-> M3A\n    R5 -.-> C1\n    C1 --> C2 --> C3 --> C4\n    P3 --> M3C\n    P4 -.-> M1C\n    P4 -.-> M3D\n    P1 -.-> M1C\n    P1 -.-> R2\n    P1 -.-> C1\n    P2 -.-> P3\n    P5 -.-> P3")
dgHead02 = CardHeader("02 · .NET layers & authority", "Runtime layering, static commands/queries, domain calculations, persistent database model, and separate execution host.")
dgCode02 = CodeBlock("mermaid", "flowchart TB\n    B[\"Angular SPA in browser: /ui/app and /ui/portal\"]\n    subgraph API[\"AuditSphereOps.Api — HTTP transport only\"]\n      ROUTES[\"/api/ui/*, /api/setup/*, file transports; OpenAPI\"]\n      HTTPAUTH[\"Authenticated session, anti-CSRF, limits and headers\"]\n      RESOLVE[\"TrustedActorResolver: user, firm, session epoch\"]\n    end\n    subgraph APPLICATION[\"AuditSphereOps.Application — business authority\"]\n      AUTHORIZE[\"AuthorizationDecision: RoleGrant + CLIENT / ENGAGEMENT / GROUP scope\"]\n      HANDLERS[\"Static capability commands and queries returning CommandResult<T>\"]\n      FENCE[\"Business guards: current approvals, revision/generation, independence\"]\n      OP[\"DurableOperation contracts, idempotent request receipts\"]\n    end\n    subgraph DOMAIN[\"AuditSphereOps.Domain — pure state and rules\"]\n      TYPES[\"Firm, engagement, workpaper, books, journal, package, group types\"]\n      RULES[\"Balanced money, materiality, FX, risk, consolidation calculators\"]\n    end\n    subgraph INFRA[\"AuditSphereOps.Infrastructure — implementations\"]\n      EF[\"One AuditSphereDbContext, capability partials, EF migrations\"]\n      PROV[\"Provider adapters, PDF/Office renderers, certificate sources\"]\n    end\n    subgraph RUNNERS[\"Separate executable processes\"]\n      HOST[\"AuditSphereOps.Api: HTTP + Angular asset serving\"]\n      WORK[\"AuditSphereOps.Worker: local and isolated live groups\"]\n    end\n    PG[(\"PostgreSQL 18.6: business state, triggers, immutable receipts\")]\n    EXT[\"Microsoft Entra / Graph / SharePoint / mail providers\"]\n    B --> ROUTES --> HTTPAUTH --> RESOLVE --> AUTHORIZE --> HANDLERS --> FENCE\n    HANDLERS --> TYPES\n    HANDLERS --> RULES\n    HANDLERS --> OP\n    HANDLERS --> EF\n    EF --> PG\n    HANDLERS --> PROV\n    PROV -.-> EXT\n    HOST --> ROUTES\n    WORK --> HANDLERS\n    WORK --> EF\n    WORK --> PROV")
dgHead03 = CardHeader("03 · Sign-in & command sequence", "Actual same-origin browser authentication model and responsibility split between transport and business authority.")
dgCode03 = CodeBlock("mermaid", "sequenceDiagram\n    autonumber\n    actor User as Staff / client user\n    participant UI as Angular browser\n    participant API as ASP.NET Core API\n    participant Entra as Microsoft Entra ID\n    participant Actor as TrustedActorResolver\n    participant App as Application command/query\n    participant PG as PostgreSQL\n\n    User->>UI: Open staff workbench or client portal\n    UI->>API: Navigate /ui route / sign-in request\n    API->>Entra: Server-side OIDC challenge\n    Entra-->>API: Validated authentication callback\n    API->>PG: Resolve/bind current identity and session\n    API-->>UI: Secure HttpOnly cookie + XSRF cookie\n\n    User->>UI: View client / engagement records\n    UI->>API: GET same-origin /api/ui/* with cookie\n    API->>Actor: Authenticate and resolve current actor\n    Actor->>PG: Current user / firm / session epoch\n    Actor-->>API: Scoped ActorContext or deny\n    API->>App: Run named Application query\n    App->>PG: Current RoleGrant + client/engagement scope checks\n    alt Scope, current session and business read allowed\n        PG-->>App: Current authorized records\n        App-->>API: CommandResult<T> (exact decimals as strings)\n        API->>Actor: Recheck session before emitting protected read\n        API-->>UI: JSON response\n    else Denied or stale\n        App-->>API: Typed denial / stale result\n        API-->>UI: Failure without unauthorized records\n    end\n\n    User->>UI: Submit draft or professional command\n    UI->>API: POST /api/ui/* + cookie + XSRF header\n    API->>API: Validate anti-CSRF and request limits\n    API->>Actor: Resolve trusted actor again\n    API->>App: Review exact command intent\n    App->>PG: Lock in approved order; recheck role, scope, revision, independence\n    alt Fully authorized current command\n        App->>PG: Atomic business changes + immutable evidence/receipt\n        App-->>API: Actor-owned outcome\n        API-->>UI: Confirmed result\n    else Denied or stale\n        App-->>API: No publication; typed error\n        API-->>UI: Denial / refresh-review prompt\n    end")
dgHead04 = CardHeader("04 · 11-stage lifecycle", "Canonical derived lifecycle projection, no persisted manually mutable stage column.")
dgCode04 = CodeBlock("mermaid", "stateDiagram-v2\n    [*] --> LEAD_INGESTION\n    LEAD_INGESTION --> PROPOSAL_GENERATION: Legal entity / contacts validated\n    PROPOSAL_GENERATION --> DUAL_KEY_PENDING: Approved quotation dispatched by email\n    DUAL_KEY_PENDING --> ADVANCE_BILLING: Client response + current Partner risk approval\n    ADVANCE_BILLING --> PORTAL_ACTIVE_PLANNING: Current agreement and 50 percent advance PAID\n    PORTAL_ACTIVE_PLANNING --> FIELDWORK_EXECUTION: Current mapped TB / Partner-approved planning\n    FIELDWORK_EXECUTION --> MANAGERIAL_REVIEW: Current assigned procedures submitted\n    MANAGERIAL_REVIEW --> FIELDWORK_EXECUTION: Reviewer returns affected work with mandatory notes\n    MANAGERIAL_REVIEW --> PARTNER_APPROVAL: Current reviews, no open notes, SRM, release blockers cleared\n    PARTNER_APPROVAL --> DELIVERABLE_RELEASE: Staffed Partner opinion + authorized report signing\n    DELIVERABLE_RELEASE --> COMPLIANCE_COUNTDOWN: Released final bundle available and local freeze scheduled\n    COMPLIANCE_COUNTDOWN --> ARCHIVED_READ_ONLY: 60-day due / early Partner lock AND committed local freeze\n    ARCHIVED_READ_ONLY --> [*]")
dgHead05 = CardHeader("05 · 7-phase workflow & tasks", "Simplified user workflow is a projection of the eleven canonical stages, not a second state machine.")
dgCode05 = CodeBlock("mermaid", "flowchart TB\n    subgraph PHASES[\"Seven visible Angular phases — presentation only\"]\n        P1[\"1 Client Onboarding<br/>Lead, proposal, both keys, advance payment\"]\n        P2[\"2 Audit Planning<br/>Staff, TB, mapping, materiality, risk\"]\n        P3[\"3 Audit Fieldwork<br/>FSLI, tests, evidence, PBC, sampling\"]\n        P4[\"4 Manager Review<br/>Reviewer notes, rework and SRM\"]\n        P5[\"5 Partner Sign-off<br/>Risk clearance, opinion and signature\"]\n        P6[\"6 Report and Delivery<br/>Verified package and final deliverables\"]\n        P7[\"7 Archive and Close<br/>60-day countdown and committed freeze\"]\n    end\n    subgraph TASKS[\"Supporting work orchestration — some features flag-gated / partial\"]\n        T1[\"Published versioned templates, exact pinned revision\"]\n        T2[\"My Tasks / Team Work / Waiting for Client / review queues\"]\n        T3[\"Dependencies, no cycles; source-evidence prerequisites\"]\n        T4[\"Optional reminders, task creation and escalation\"]\n    end\n    subgraph AUTHORITY[\"Authoritative server state\"]\n        CAN[\"EngagementLifecycleQuery: 11-stage derived projection\"]\n        CMD[\"Application commands: role, scope, currentness, human approval\"]\n        DATA[(\"Durable decisions, receipts, PBC, risk and review evidence\")]\n    end\n    P1 --> P2 --> P3 --> P4 --> P5 --> P6 --> P7\n    P4 -.->|\"reviewer returns work\"| P3\n    CAN -->|\"project phase, blocker, next action\"| P1\n    CAN --> P7\n    T1 --> T2 --> T3 --> T4\n    T2 -.->|\"request, not automatic authority\"| CMD\n    T3 -.->|\"verify current evidence\"| CMD\n    CMD --> DATA --> CAN\n    T4 -.->|\"never approve, post, sign or release\"| CMD")
dgHead06 = CardHeader("06 · CRM, acceptance & activation", "Exact accepted offer and risk evidence must both exist for a letter; paid advance precedes engagement activation.")
dgCode06 = CodeBlock("mermaid", "flowchart TB\n    LEAD[\"Firm CRM: lead + organization / contacts / opportunities\"] --> QUOTE[\"Versioned quotation and approved proposal\"]\n    QUOTE --> SEND[\"Evidence-bound email dispatch of exact approved offer\"]\n    SEND --> CLIENT[\"Key 1: exact client commercial acceptance<br/>Response channel + immutable evidence\"]\n    QUOTE --> ACCEPT[\"New acceptance or recurring continuance<br/>AML/KYC, UBO, independence, adverse answers\"]\n    ACCEPT --> PARTNER[\"Key 2: current Partner risk decision for service / period\"]\n    CLIENT --> GATE{\"Both current independent keys?<br/>Quotation / response / risk generations match?\"}\n    PARTNER --> GATE\n    GATE -->|No| STOP[\"Block letter; review stale / absent proof\"]\n    GATE -->|Yes| LETTER[\"CommercialDocumentService.GenerateEngagementLetterAsync<br/>approved template + version / SHA lineage\"]\n    LETTER --> AGREEMENT[\"Fee agreement: 50 percent advance + 50 percent balance\"]\n    AGREEMENT --> DRAFT[\"Optional standing-policy automation: draft advance invoice only\"]\n    AGREEMENT --> MANUALDRAFT[\"Reviewed manual advance-invoice draft\"]\n    MANUALDRAFT --> REVIEW[\"Finance maker/checker; post actual invoice; dispatch separately\"]\n    DRAFT --> REVIEW\n    REVIEW --> PAYMENT[\"Record and allocate real external payment with reference\"]\n    PAYMENT --> PAID{\"Current advance milestone fully PAID?\"}\n    PAID -->|No| BLOCK[\"Activation and converted-client portal access blocked\"]\n    PAID -->|Yes| ACT[\"Engagement activation under current Partner authority\"]\n    ACT --> PORTAL[\"Client portal intent, Microsoft sign-in / first sign-in gate\"]\n    PORTAL -.->|\"external consent and identity evidence\"| PENDING[\"BLOCKED_EXTERNAL until live acceptance\"]\n    ACT --> PLANNING[\"Planning, staffing, PBC workspace intents\"]")
dgHead07 = CardHeader("07 · Audit planning & fieldwork", "Planning controls, risk routing, programme publication, sampling, PBC, execution/review receipts, SRM and human opinion.")
dgCode07 = CodeBlock("mermaid", "flowchart TB\n    SOURCE[\"Approved client TB / mapped balances + comparative evidence\"] --> MATERIAL[\"MaterialityEngineService: PM, TE, SAD<br/>unnormalized PBT per ADR-0011\"]\n    MATERIAL --> ROUND[\"Manager rounding within +/- 5 percent; immutable decision\"]\n    ROUND --> P_APPROVAL[\"Partner current materiality and risk-routing approval\"]\n    RISK[\"Recorded risk likelihood, magnitude, fraud, significance, critical estimate\"] --> BANDS[\"RiskBandService: GREEN / AMBER / RED + staff rules\"]\n    BANDS --> RED{Red risk?}\n    RED -->|Yes| PR[\"Independent Partner clearance of exact Red assessment\"]\n    RED -->|No| OWNER[\"Current qualified risk owner\"]\n    PR --> OWNER\n    OWNER --> P_APPROVAL\n\n    LIBRARY[\"AuditProgramCatalog: versioned source and immutable definition\"] --> PUB[\"Independent review and publication of exact programme digest\"]\n    PUB --> PROC[\"Adopt procedures / FSLI / risk links; assignment\"]\n    P_APPROVAL --> PROC\n    PROC --> EVIDENCE[\"Current evidence: manual, linked PDF, PBC and physical index\"]\n    PROC --> SAMPLE[\"MUS / systematic / stratified sampling as applicable\"]\n    EVIDENCE --> PREVIEW[\"AuditProcedureCommandWorkspace: current preview / receipt\"]\n    SAMPLE --> PREVIEW\n    PREVIEW --> SUBMIT[\"Preparer submits evidence snapshot + content digest\"]\n    SUBMIT --> MANAGER[\"Independent reviewer checks current exact revision\"]\n    MANAGER --> CHECK{Approved; no open review notes?}\n    CHECK -->|No| REWORK[\"Mandatory return reason / preserved history\"]\n    REWORK --> PREVIEW\n    CHECK -->|Yes| CONF[\"Critical third-party confirmations: bank / AR / AP / inventory / legal\"]\n    CONF --> GATE{All required critical confirmations returned?}\n    GATE -->|No| HOLD[\"Block final report release; holding letter\"]\n    GATE -->|Yes| SRM[\"Current Summary Review Memorandum: AJE / SAD / estimates\"]\n    SRM --> FINAL[\"Staffed Engagement Partner clears SRM and decides opinion\"]")
dgHead08 = CardHeader("08 · Client accounting & statements", "Two supported accounting-source modes, with separate native journal and invoice workflows and partial ancillary capabilities.")
dgCode08 = CodeBlock("mermaid", "flowchart TB\n    S[\"Client accounting profile, period, book, chart, currency\"] --> MODE{\"Authorized source mode\"}\n    MODE -->|\"EXTERNAL_SOURCE default\"| EXTERNAL[\"CSV/XLSX trial balance / source GL intake\"]\n    EXTERNAL --> CTRL[\"Header, dates, currency, balance and GL-completeness checks\"]\n    CTRL --> SEALED[\"Accepted source dataset + digest / immutable lineage\"]\n    MODE -->|\"NATIVE_BOOKKEEPING with accepted service mandate\"| NATIVE[\"Native opening balances + chart/account roles\"]\n    NATIVE --> JOURNAL[\"Balanced client operational journal<br/>draft -> independent review -> posting\"]\n    JOURNAL --> NATIVEGL[\"Client-owned posted GL, TB movements and posting sequence\"]\n    NATIVE --> SALES[\"Sales invoice and receivable open item workflows\"]\n    NATIVE --> PURCHASE[\"Purchase invoices / credits / allocations: bounded partial slices\"]\n    SALES --> NATIVEGL\n    PURCHASE --> NATIVEGL\n    NATIVEGL --> SOURCES[\"Client reporting source / approved current period\"]\n    SEALED --> SOURCES\n    SOURCES --> MAPPING[\"Approved, versioned FSLI and statement mappings\"]\n    MAPPING --> ADJUST[\"AJE, reclassification, adjustment plans and review\"]\n    MAPPING --> ANALYSIS[\"Reconciliations, valuation, analytical and FX workpapers\"]\n    ADJUST --> PACK[\"Financial package build with revision / mapping pins\"]\n    ANALYSIS --> PACK\n    PACK --> REVS[\"Independent source, content, composition and stage reviews\"]\n    REVS --> STATEMENTS[\"P&L, financial position, cash flow, equity and notes\"]\n    STATEMENTS --> OUT[\"Reviewed PDF / DOCX / XLSX presentation and release candidate\"]\n    CTX[\"ADR-0015 reporting-context manifest: approved design,<br/>full T014 activation NOT established\"] -.-> MAPPING\n    BOUNDARY[\"Never write to firm's Practice ledger;<br/>AJE is not native client cash/payment execution\"] -.-> SOURCES")
dgHead09 = CardHeader("09 · Group consolidation", "Approved perimeters, versioned components, external packs, exchange-rate policy, matching/eliminations and group reports.")
dgCode09 = CodeBlock("mermaid", "flowchart TB\n    GROUP[\"ClientGroup: member entities and ownership\"] --> SCOPE[\"Reviewed versioned consolidation scope / effective dates\"]\n    SCOPE --> COMPONENTS[\"Component inclusion and authorized report basis\"]\n    CLIENTS[\"Accepted component client books / packages\"] --> SNAPSHOTS[\"Immutable read-only component inputs\"]\n    OUTSIDE[\"External component reporting packs\"] --> SNAPSHOTS\n    COMPONENTS --> SNAPSHOTS\n    SNAPSHOTS --> CURRENCY{Component currency differs from group currency?}\n    CURRENCY -->|Yes| FX[\"Approved exchange-rate set and translation policy\"]\n    FX --> FXCALC[\"Pure CurrencyTranslationCalculator<br/>purpose-specific rates and CTA\"]\n    CURRENCY -->|No| NORMAL[\"Identity translation rate 1\"]\n    FXCALC --> NORMAL\n    NORMAL --> MATCH[\"Intercompany AR/AP, revenue/expense, loans and difference review\"]\n    MATCH --> ELIM[\"Proposed eliminations / manual review / advanced calculations\"]\n    ELIM --> REVIEWS[\"Authorized independent review with exact source/rate pins\"]\n    REVIEWS --> RUN[\"Group-only consolidation run and immutable evidence\"]\n    RUN --> REPORTS[\"Consolidated financial reports / group output\"]\n    RUN -.->|\"NO WRITE-BACK\"| CLIENTS\n    FIRM[\"Practice firm's ledger — distinct financial book\"] -.->|\"NEVER mixed with component/group entries\"| RUN\n    UNKNOWN[\"Missing rates, stale scope, unclassified lines => fail closed\"] -.-> FX")
dgHead10 = CardHeader("10 · Practice & firm finance", "Commercial fees, time, billing, practice financial statements, staff economics and separately controlled client accounting.")
dgCode10 = CodeBlock("mermaid", "flowchart TB\n    CLIENT[\"Client engagement and accepted fee agreement\"] --> FEE[\"50/50 advance and balance fee milestones\"]\n    FEE --> AUTO[\"Optional default-off standing fee policy\"]\n    AUTO --> DRAFT[\"Create advance/balance invoice DRAFT only\"]\n    FEE --> MANUAL[\"Manual reviewed invoice draft\"]\n    MANUAL --> CHECK[\"Independent finance review and posting\"]\n    DRAFT --> CHECK\n    CHECK --> DISPATCH[\"Separately controlled mail / client invoice access\"]\n    CHECK --> FIRMGL[\"Firm Practice ledger: posted invoices and journal entries\"]\n    PAYMENT[\"Externally completed cheque / transfer payment evidence\"] --> RECEIPT[\"Payment receipt, allocation, reversal review\"]\n    RECEIPT --> FIRMGL\n    FIRMGL --> AGING[\"Firm AR ageing / invoices including non-50/50 invoices\"]\n    FIRMGL --> BOOKS[\"Internal firm TB / monthly P&L and comparator\"]\n\n    STAFF[\"Staff profiles, role, approved rate card and working calendar\"] --> TIME[\"Task/FSLI-bound time, budget, review/return\"]\n    TIME --> STANDARD[\"Billable standard value / contracted contribution\"]\n    TIME --> ACTUAL[\"Actual staff cost and approved non-billable time\"]\n    STANDARD --> ANALYTICS[\"Realization, utilization, engagement and portfolio analytics\"]\n    ACTUAL --> ANALYTICS\n    EXPENSE[\"Rent, staff benefits, facilities, petty cash and EOS provision\"] --> FIRMGL\n    TASKS[\"Workflow template revisions, tasks, dependencies, PBC waiting\"] --> TIME\n    TECH[\"Versioned technical library and searchable firm resources\"] -.-> TASKS\n    OTHER[\"Client invoices and GL are client-owned — never firm revenue\"] -.-> FIRMGL")
dgHead11 = CardHeader("11 · Microsoft 365 & SharePoint", "The correctly split application identities, privileged client-sites exception, local RoleGrants, and provider readback.")
dgCode11 = CodeBlock("mermaid", "flowchart TB\n    subgraph LOGIN[\"Application login — browser never owns Graph app credentials\"]\n        ANG[\"Angular /ui\"] --> API[\"ASP.NET Core OIDC, secure cookie, CSRF\"]\n        API <-->|\"sign-in\"| IDP[\"Microsoft Entra ID\"]\n        API --> GRANT[\"Application RoleGrant scope; independent of Entra admin roles\"]\n    end\n    subgraph ADMIN[\"Consent / tenant administration — independently enabled\"]\n        CONSENT[\"Nonce-bound admin consent + SHA-256 state verification\"]\n        VERIFIED[\"Tenant/capability verification; default-disabled optional actions\"]\n        READER[\"Directory reader: User.Read.All\"]\n        USERCREATE[\"Optional user creation: User.Create\"]\n        INVITE[\"Optional guest invitation: User.Invite.All\"]\n        GROUPS[\"Optional managed groups: GroupMember.ReadWrite.All\"]\n        OUTMAIL[\"Outbound mail app: Mail.Send\"]\n    end\n    subgraph SITES[\"Approved client-site creation exception — isolated client-sites worker\"]\n        SITEPOL[\"Explicit UTC rollout boundary + standing operator policy\"]\n        PROVISIONER[\"Privileged provisioner app: Sites.FullControl.All<br/>SharePoint and Graph resource tokens\"]\n        CREATE[\"SPSiteManager creates STS#3 site; verify exact ownership marker\"]\n        STAFFGRANTS[\"AuditSphere-managed SharePoint group: assigned staff Full Control\"]\n        GRANTAPP[\"Grant exact-site document worker application access; read back\"]\n    end\n    subgraph DOCUMENTS[\"Selected-site evidence path — separate isolated pbc worker\"]\n        SELECTED[\"Document app: Sites.Selected and exact-site write grant\"]\n        PBC[\"PBC workspace / versioned upload / SHA-256 verification\"]\n        RECORD[\"Provider status, accepted bytes, request identity, receipts\"]\n    end\n    GAPI[\"Microsoft Graph\"]\n    SP[\"SharePoint client sites\"]\n    CONSENT --> VERIFIED\n    VERIFIED --> READER --> GAPI\n    VERIFIED -.-> USERCREATE --> GAPI\n    VERIFIED -.-> INVITE --> GAPI\n    VERIFIED -.-> GROUPS --> GAPI\n    VERIFIED -.-> OUTMAIL --> GAPI\n    SITEPOL --> PROVISIONER --> CREATE --> STAFFGRANTS --> GRANTAPP\n    CREATE --> SP\n    STAFFGRANTS --> SP\n    GRANTAPP --> GAPI\n    GRANTAPP --> SELECTED\n    SELECTED --> PBC --> RECORD\n    PBC --> SP\n    GRANT -.->|\"application access only\"| PBC\n    STAFFGRANTS -.->|\"external site-wide rights; not AuditSphere grants\"| GRANT")
dgHead12 = CardHeader("12 · PBC, signing & archive", "Immutable document identities, professional review, signature policy, five-part bundle, client portal freeze, separate secondary SharePoint copy.")
dgCode12 = CodeBlock("mermaid", "flowchart TB\n    CLIENT[\"Client coordinator: authenticated first sign-in\"] --> PBC[\"PBC request, upload chunk stream, versioned evidence\"]\n    PBC --> TRANSFER[\"Durable selected-site write + exact-version SHA readback\"]\n    TRANSFER --> REVIEW[\"Assigned reviewer accepts exact verified upload or rejects with reason\"]\n    REVIEW --> EVIDENCE[\"Immutable accepted source and provider receipt\"]\n    EVIDENCE --> WORKPAPER[\"Audit workpaper and current procedure evidence\"]\n    WORKPAPER --> GATE[\"Manager-reviewed work, SRM, critical confirmations\"]\n    GATE --> PARTNER[\"Staffed Partner selects opinion; modified basis if needed\"]\n    PARTNER --> SIGN{\"Certificate required or configured?\"}\n    SIGN -->|\"Optional unconfigured\"| VISUAL[\"Visual Partner PNG + firm seal only; not cryptographic signature\"]\n    SIGN -->|\"Required/configured\"| CERT[\"Firm-held X.509 signing; validate key, dates, usage\"]\n    CERT --> CERTOK{\"Credential usable?\"}\n    CERTOK -->|No| BLOCKSIGN[\"Fail closed: do not sign with image-only fallback\"]\n    CERTOK -->|Yes| PDFVERIFY[\"Sign exact PDF and verify embedded byte integrity;<br/>trust / revocation not asserted\"]\n    VISUAL --> BUNDLE\n    PDFVERIFY --> BUNDLE[\"Five-part bundle: signed report/statements, management letter,<br/>signed LOR, correspondence, posted balance invoice\"]\n    FINPKG[\"Separately released reviewed financial package\"] --> BALDRAFT[\"Balance-fee draft eligible after paid advance\"]\n    BALDRAFT --> BALPOST[\"Independent finance review and posted balance invoice\"]\n    BALPOST --> BUNDLE\n    LOR[\"Client-signed LOR, human Partner-verified exact PDF\"] --> BUNDLE\n    FINPKG --> BUNDLE\n    BUNDLE --> RELEASE[\"Authorized release, issued byte / manifest SHA identities\"]\n    RELEASE --> PORTAL[\"Client bundle availability, final-release PBC upload fence\"]\n    RELEASE --> STORE[\"Authoritative append-only platform release/archive store\"]\n    STORE --> COPY[\"Separate secondary SharePoint read-only library copy\"]\n    COPY --> PROTECT[\"Read back exact file hashes and expected access grants\"]\n    PROTECT --> EXT{\"Remote state independently OBSERVED?\"}\n    EXT -->|No| BLOCKED[\"Provider BLOCKED_EXTERNAL; no immutability claim\"]\n    EXT -->|Yes| REPORTED[\"Report verified secondary-copy access only\"]\n    STORE --> CLOCK[\"Signature-anchored 60-day due date or earlier Partner lock\"]\n    CLOCK --> FREEZE[\"Commit local read-only freeze; append-only audit evidence\"]\n    FREEZE --> ARCHIVED[\"Derived ARCHIVED_READ_ONLY state\"]")
dgHead13 = CardHeader("13 · Durable operations & recovery", "Operation intent / leased worker execution / verified remote effects / idempotent original-actor recovery.")
dgCode13 = CodeBlock("mermaid", "sequenceDiagram\n    autonumber\n    participant UI as Angular user action\n    participant API as ASP.NET Core API\n    participant DB as PostgreSQL operations and receipts\n    participant W as Group-isolated .NET Worker\n    participant P as Configured provider or local effect\n\n    UI->>API: Submit stable request identity + expected revision\n    API->>DB: Validate scope and transactionally store intent + outbox row\n    API-->>UI: Accepted request identity (not proof of provider success)\n    W->>DB: Claim eligible row via SKIP LOCKED / lease + attempt token\n    DB-->>W: Work item + current fence / capability metadata\n    W->>DB: Revalidate current authority, generation and target identity\n    alt Local operation\n        W->>DB: Publish transaction-owned result + immutable receipt\n    else External operation allowed + live prerequisite verified\n        W->>P: Execute exact scoped operation\n        alt Verified success\n            P-->>W: Identity, version and provider receipt\n            W->>P: Read back exact target / hash / grants\n            P-->>W: Verification response\n            W->>DB: Persist result and provider evidence; bind locally\n        else Network timeout or result unknown\n            W->>DB: Mark UNKNOWN / reconciliation-needed state\n            W->>P: Read-only reconciliation of exact original request\n            alt Observed original effect\n                P-->>W: Exact original target and receipt\n                W->>DB: Verify and publish original result\n            else Absent or unprovable\n                W->>DB: Keep blocked/unknown outcome; no blind duplicate create\n            end\n        end\n    end\n    UI->>API: Lookup original actor-owned receipt / request\n    API->>DB: Recheck current scope and retained outcome\n    DB-->>API: Original outcome or explicit pending/blocked state\n    API-->>UI: Truthful recovery; never synthesize an approval")
dgHead14 = CardHeader("14 · Financial & data integrity", "One PostgreSQL database with business ownership boundaries, transaction guards and immutable evidence.")
dgCode14 = CodeBlock("mermaid", "flowchart TB\n    ACTOR[\"ActorContext: FirmId, UserId, SessionEpoch\"] --> GRANTS[\"RoleGrant scope: FIRM_WIDE / CLIENT / ENGAGEMENT / GROUP\"]\n    GRANTS --> ACTION[\"Authorized Application command / query\"]\n    ACTION --> LOCK[\"Lock firm/client/aggregate/actor in established order\"]\n    LOCK --> REVISION{\"Exact revision/generation/digest current?\"}\n    REVISION -->|No| STALE[\"Reject stale request; keep original records intact\"]\n    REVISION -->|Yes| TRANSACTION[\"Single EF Core / PostgreSQL transaction\"]\n    TRANSACTION --> FIRM[(\"Firm ledger and invoices\")]\n    TRANSACTION --> CLIENT[(\"Client-owned GL/TB/journals and packages\")]\n    TRANSACTION --> GROUP[(\"Group-only eliminations and consolidation runs\")]\n    TRANSACTION --> EVIDENCE[(\"Append-only events / decision receipts / hashes\")]\n    CLIENT -.->|\"component snapshots only\"| GROUP\n    GUARD1[\"No client journal / TB posted to firm ledger\"] -.-> FIRM\n    GUARD2[\"Consolidation never changes client source books\"] -.-> CLIENT\n    GUARD3[\"decimal + numeric(19,6) + ToEven; exact JSON strings\"] -.-> TRANSACTION\n    GUARD4[\"Database check constraints + UPDATE/DELETE denial triggers\"] -.-> EVIDENCE\n    GUARD5[\"Unknown browser outcome: lookup original idempotent receipt\"] -.-> EVIDENCE")
dgHead15 = CardHeader("15 · Deployment & verification", "Existing implementation/runtime topology and separate verification controls, without inventing a production-ready deployment.")
dgCode15 = CodeBlock("mermaid", "flowchart TB\n    subgraph DEV[\"AI agent / developer loop\"]\n        SRC[\"Relevant Domain / Application / Api / Angular feature\"]\n        BUILD[\"Targeted dotnet build + Angular check\"]\n        FOCUS[\"Small focused xUnit / Angular spec / API test\"]\n        OAPI[\"OpenAPI 3.1 emitter and contract drift verification\"]\n    end\n    subgraph CI[\"GitHub Actions — separate assurance levels\"]\n        FAST[\"ci.yml: fast PR/push checks and build\"]\n        FULL[\"release-verification.yml: full suite on immutable SHA\"]\n        REVIEW[\"Human review and authorized release approval\"]\n    end\n    subgraph RUNTIME[\"Environment — one application deployment unit plus worker groups\"]\n        WEB[\"ASP.NET Core 10 serves Angular static /ui and API\"]\n        GENERAL[\"Worker general / processing / records: local operations\"]\n        LIVE[\"Isolated Acceptance mail / pbc / client-sites groups\"]\n        DB[(\"PostgreSQL 18.6; migrations and backups\")]\n        OBS[\"OpenTelemetry tracing/metrics, correlation IDs\"]\n        SECRETS[\"Role-specific configuration and certificate mounts\"]\n    end\n    subgraph GATES[\"Unclosed acceptance / operations decisions\"]\n        OUT[\"Real-tenant Entra / Graph / SharePoint evidence\"]\n        RECOVERY[\"Independent restore RPO/RTO and disaster-recovery acceptance\"]\n        COMPLIANCE[\"Professional signoffs, certificate/legal and archive protection\"]\n        PARITY[\"Complete API/Angular parity, browser a11y, canary and rollback\"]\n    end\n    SRC --> BUILD --> FOCUS --> OAPI --> FAST\n    FAST -.->|\"nightly or manually dispatched\"| FULL\n    FAST --> REVIEW\n    FULL --> REVIEW\n    REVIEW -.->|\"authorization required\"| WEB\n    WEB --> DB\n    GENERAL --> DB\n    LIVE --> DB\n    WEB --> OBS\n    GENERAL --> OBS\n    LIVE --> OBS\n    SECRETS --> WEB\n    SECRETS --> LIVE\n    PARITY -.->|\"not closed by green CI\"| REVIEW\n    OUT -.-> REVIEW")
$reqModule = ""
$reqSearch = ""
requirementsContent = [rqNote, rqFilters, rqCount, rqTable]
rqNote = Callout("info", "Historical baseline", "These statements are preserved for provenance. Where an approved v2.2 decision overlay differs, the overlay governs.")
rqFilters = Form("reqFilters", rqButtons, [rqModuleField, rqSearchField])
rqButtons = Buttons([Button("Clear filters", @Reset($reqModule, $reqSearch), "secondary")])
rqModuleField = FormControl("Module", Select("module", [SelectItem("", "All modules"), SelectItem("M1", "M1 · Commercial & CRM Pipeline (31)"), SelectItem("M2", "M2 · Administration, Governance & Planning (28)"), SelectItem("M3", "M3 · Technical Execution & Audit Fieldwork (26)"), SelectItem("M4", "M4 · Reporting & Final Deliverables (16)"), SelectItem("M5", "M5 · Practice Analytics & Internal Bookkeeping (14)")], "All modules", null, $reqModule))
rqSearchField = FormControl("Search", Input("search", "ID, feature or statement text", "text", null, $reqSearch))
rqCount = TextContent("" + @Count(rqRows) + " of 115 statements", "small-heavy")
rqRows = @Filter(rqByModule, "haystack", "contains", $reqSearch)
rqByModule = @Filter(reqData, "module", "contains", $reqModule)
rqTable = Table([Col("ID", rqRows.id), Col("Module", rqRows.moduleName), Col("Feature", rqRows.feature), Col("Statement", rqRows.text)])
reqData = [{id: "M1.01-R01", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Lead Capture & Client Profiles", text: "Ingest leads across Phone, WhatsApp, Email, Web Forms, and Referrals.", haystack: "M1.01-R01 Lead Capture & Client Profiles Ingest leads across Phone, WhatsApp, Email, Web Forms, and Referrals."}, {id: "M1.01-R02", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Lead Capture & Client Profiles", text: "Maintain complete organizational trees (Holdings, Subsidiaries, Affiliates).", haystack: "M1.01-R02 Lead Capture & Client Profiles Maintain complete organizational trees (Holdings, Subsidiaries, Affiliates)."}, {id: "M1.01-R03", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Lead Capture & Client Profiles", text: "Multi-Contact Directory with role-based communication routing:", haystack: "M1.01-R03 Lead Capture & Client Profiles Multi-Contact Directory with role-based communication routing:"}, {id: "M1.01-R04", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Lead Capture & Client Profiles", text: "Managing Director / General Manager: Recipient of Proposals, Engagement Letters, and final reports.", haystack: "M1.01-R04 Lead Capture & Client Profiles Managing Director / General Manager: Recipient of Proposals, Engagement Letters, and final reports."}, {id: "M1.01-R05", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Lead Capture & Client Profiles", text: "Chief Financial Officer / Finance Director: Recipient of Commercial Invoices and Receipts.", haystack: "M1.01-R05 Lead Capture & Client Profiles Chief Financial Officer / Finance Director: Recipient of Commercial Invoices and Receipts."}, {id: "M1.01-R06", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Lead Capture & Client Profiles", text: "Chief Accountant / Audit Liaison: Recipient of PBC operational document requests.", haystack: "M1.01-R06 Lead Capture & Client Profiles Chief Accountant / Audit Liaison: Recipient of PBC operational document requests."}, {id: "M1.02-R01", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Commercial Proposal Engine", text: "Brief Quotation (RFQ/RFP): Output a 1–2 page standardized summary showing engagement scope, statutory year, professional fees, payment terms (50/50), and execution timeline.", haystack: "M1.02-R01 Commercial Proposal Engine Brief Quotation (RFQ/RFP): Output a 1–2 page standardized summary showing engagement scope, statutory year, professional fees, payment terms (50/50), and execution timeline."}, {id: "M1.02-R02", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Commercial Proposal Engine", text: "Comprehensive Proposal: Auto-compile a multi-page presentation document incorporating:", haystack: "M1.02-R02 Commercial Proposal Engine Comprehensive Proposal: Auto-compile a multi-page presentation document incorporating:"}, {id: "M1.02-R03", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Commercial Proposal Engine", text: "1. Firm Profile, History, and Commercial Registrations.", haystack: "M1.02-R03 Commercial Proposal Engine 1. Firm Profile, History, and Commercial Registrations."}, {id: "M1.02-R04", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Commercial Proposal Engine", text: "2. Assigned Engagement Partner & Audit Team CVs.", haystack: "M1.02-R04 Commercial Proposal Engine 2. Assigned Engagement Partner & Audit Team CVs."}, {id: "M1.02-R05", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Commercial Proposal Engine", text: "3. Industry-specific Credentials and Portfolio Evidence.", haystack: "M1.02-R05 Commercial Proposal Engine 3. Industry-specific Credentials and Portfolio Evidence."}, {id: "M1.02-R06", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Commercial Proposal Engine", text: "4. Audit Methodology Overview (ISA compliance).", haystack: "M1.02-R06 Commercial Proposal Engine 4. Audit Methodology Overview (ISA compliance)."}, {id: "M1.02-R07", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Commercial Proposal Engine", text: "5. Fee Schedule & Deliverables Timeline.", haystack: "M1.02-R07 Commercial Proposal Engine 5. Fee Schedule & Deliverables Timeline."}, {id: "M1.03-R01", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Dual-Key Onboarding Gatekeeper", text: "The system shall strictly disallow the generation of an Engagement Letter until two independent authorization keys are marked active in the database:", haystack: "M1.03-R01 Dual-Key Onboarding Gatekeeper The system shall strictly disallow the generation of an Engagement Letter until two independent authorization keys are marked active in the database:"}, {id: "M1.03-R02", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Dual-Key Onboarding Gatekeeper", text: "Key 1 (Commercial Approval): Recorded confirmation of client quote acceptance.", haystack: "M1.03-R02 Dual-Key Onboarding Gatekeeper Key 1 (Commercial Approval): Recorded confirmation of client quote acceptance."}, {id: "M1.03-R03", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Dual-Key Onboarding Gatekeeper", text: "Key 2 (Risk Clearance): Partner completion and digital sign-off of the Client Acceptance/Continuance Checklist.", haystack: "M1.03-R03 Dual-Key Onboarding Gatekeeper Key 2 (Risk Clearance): Partner completion and digital sign-off of the Client Acceptance/Continuance Checklist."}, {id: "M1.04-R01", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Engagement Letter Generation (ISA\n                            210)", text: "Automatically pull standardized templates based on engagement type:", haystack: "M1.04-R01 Engagement Letter Generation (ISA\n                            210) Automatically pull standardized templates based on engagement type:"}, {id: "M1.04-R02", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Engagement Letter Generation (ISA\n                            210)", text: "External Statutory Audit Template", haystack: "M1.04-R02 Engagement Letter Generation (ISA\n                            210) External Statutory Audit Template"}, {id: "M1.04-R03", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Engagement Letter Generation (ISA\n                            210)", text: "Internal Audit / Agreed-Upon Procedures (ISRS 4400) Template", haystack: "M1.04-R03 Engagement Letter Generation (ISA\n                            210) Internal Audit / Agreed-Upon Procedures (ISRS 4400) Template"}, {id: "M1.04-R04", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Engagement Letter Generation (ISA\n                            210)", text: "Require minimal manual field input (Client Legal Name, Period Covered, Agreed Fee, Submission Deadlines).", haystack: "M1.04-R04 Engagement Letter Generation (ISA\n                            210) Require minimal manual field input (Client Legal Name, Period Covered, Agreed Fee, Submission Deadlines)."}, {id: "M1.04-R05", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Engagement Letter Generation (ISA\n                            210)", text: "Apply Partner digital stamp and signature upon generation.", haystack: "M1.04-R05 Engagement Letter Generation (ISA\n                            210) Apply Partner digital stamp and signature upon generation."}, {id: "M1.05-R01", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Advance Invoicing, Receipting & Portal\n                            Onboarding", text: "Generate the 50% Advance Invoice alongside the Engagement Letter.", haystack: "M1.05-R01 Advance Invoicing, Receipting & Portal\n                            Onboarding Generate the 50% Advance Invoice alongside the Engagement Letter."}, {id: "M1.05-R02", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Advance Invoicing, Receipting & Portal\n                            Onboarding", text: "Record payment receipt with payment reference data (cheque, transfer code).", haystack: "M1.05-R02 Advance Invoicing, Receipting & Portal\n                            Onboarding Record payment receipt with payment reference data (cheque, transfer code)."}, {id: "M1.05-R03", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Advance Invoicing, Receipting & Portal\n                            Onboarding", text: "Automated Receipt Generation: Instantly compile and dispatch an official payment receipt voucher to the client upon recording payment.", haystack: "M1.05-R03 Advance Invoicing, Receipting & Portal\n                            Onboarding Automated Receipt Generation: Instantly compile and dispatch an official payment receipt voucher to the client upon recording payment."}, {id: "M1.05-R04", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Advance Invoicing, Receipting & Portal\n                            Onboarding", text: "Automated Client Portal Provisioning:", haystack: "M1.05-R04 Advance Invoicing, Receipting & Portal\n                            Onboarding Automated Client Portal Provisioning:"}, {id: "M1.05-R05", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Advance Invoicing, Receipting & Portal\n                            Onboarding", text: "Auto-generate an isolated workspace for the client.", haystack: "M1.05-R05 Advance Invoicing, Receipting & Portal\n                            Onboarding Auto-generate an isolated workspace for the client."}, {id: "M1.05-R06", module: "M1", moduleName: "Commercial & CRM Pipeline", feature: "Advance Invoicing, Receipting & Portal\n                            Onboarding", text: "Email temporary access credentials to the designated Client Audit Liaison.", haystack: "M1.05-R06 Advance Invoicing, Receipting & Portal\n                            Onboarding Email temporary access credentials to the designated Client Audit Liaison."}, {id: "M1.05-R07", module: "