<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AuditSphereOps.Domain\AuditSphereOps.Domain.csproj" />
    <ProjectReference Include="..\..\src\AuditSphereOps.Worker\AuditSphereOps.Worker.csproj" />
    <ProjectReference Include="..\..\src\AuditSphereOps.Application\AuditSphereOps.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each database test owns a freshly migrated schema, so the runner is throttled to keep the
         PostgreSQL shared lock table within its default budget instead of failing unrelated tests
         with 53200. Coverage is unchanged; nothing is skipped. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>