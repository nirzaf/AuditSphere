@* Client workspaces and engagement PBC repositories in the approved selected site (P2). *@
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject ISelectedSiteWorkspaceProvisioner Provisioner

<MudPaper Class="audit-workspace-panel audit-admin-panel pa-4 mt-3" Elevation="0" role="region" aria-labelledby="workspace-provisioning-heading">
  <h3 id="workspace-provisioning-heading">Client workspaces and PBC repositories</h3>
  <MudText Typo="Typo.body2" Class="field-help">Folders are created inside the client’s verified dedicated site when one is requested, otherwise inside the previously approved selected site. An engagement repository accepts PBC uploads only after a disposable upload and exact read-back succeed.</MudText>
  @if (!Provisioner.IsConfigured)
  {
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">The selected-site runtime credential is not configured on this server.</MudAlert>
  }
  @if (_rows is null) { <LoadingState IsLoading="true" LoadingMessage="Loading workspaces…" /> }
  else if (_rows.Count == 0) { <MudText Class="mt-2">No accepted clients have a workspace intent yet. Accepting a client creates one.</MudText> }
  else
  {
    <div class="audit-admin-table-scroll">
    <MudSimpleTable Dense="true" Class="mt-2">
      <thead><tr><th>Client</th><th>Workspace</th><th>Engagement PBC repositories</th></tr></thead>
      <tbody>
        @foreach (var row in _rows)
        {
          <tr>
            <td>@row.ClientName</td>
            <td>
              <StatusChip Status="@row.WorkspaceState" />
              @if (row.LastErrorCode is not null) { <div class="field-help">@row.LastErrorCode</div> }
              @if (row.WorkspaceState != "READY")
              {
                <div><MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(_busy || !Provisioner.IsConfigured)" OnClick="() => ProvisionClientAsync(row.ClientId)">Provision workspace</MudButton></div>
              }
            </td>
            <td>
              @if (row.Engagements.Count == 0) { <span class="muted">No engagements</span> }
              @foreach (var engagement in row.Engagements)
              {
                <div class="my-1">
                  @engagement.Label <StatusChip Status="@engagement.BindingState" />
                  @if (engagement.BindingState != "VERIFIED" && row.WorkspaceState == "READY")
                  {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(_busy || !Provisioner.IsConfigured)" OnClick="() => ProvisionEngagementAsync(engagement.EngagementId)">Provision PBC repository</MudButton>
                  }
                </div>
              }
            </td>
          </tr>
        }
      </tbody>
    </MudSimpleTable>
    </div>
  }
  <div class="mt-2">
    <MudButton Disabled="@(_busy || _page == 0)" OnClick="() => ChangePageAsync(-1)">Previous workspace page</MudButton>
    <span>Page @(_page + 1)</span>
    <MudButton Disabled="@(_busy || !_hasMore)" OnClick="() => ChangePageAsync(1)">Next workspace page</MudButton>
    <MudText Typo="Typo.caption">Up to 25 clients and 25 engagement repositories per client are shown on a page. Open the client workbench for further engagements.</MudText>
  </div>
  @if (!string.IsNullOrWhiteSpace(_message)) { <MudAlert Severity="@(_ok ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-2" role="status">@_message</MudAlert> }
</MudPaper>

@code {
  private IReadOnlyList<ClientWorkspaceRow>? _rows;
  private bool _busy, _ok, _hasMore;
  private int _page;
  private string? _message;

  protected override Task OnInitializedAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) { _rows = []; _hasMore = false; _page = 0; return; }
    await using var db = await DbFactory.CreateDbContextAsync();
    var result = await WorkspaceProvisioningAdministration.GetAsync(db, actor, _page);
    _rows = result.Succeeded ? result.Value!.Clients : [];
    _hasMore = result.Succeeded && result.Value!.HasMore;
  }

  private async Task ChangePageAsync(int direction)
  {
    if (_busy || direction < 0 && _page == 0 || direction > 0 && !_hasMore) return;
    _page += direction;
    await LoadAsync();
  }

  private Task ProvisionClientAsync(Guid clientId) => RunAsync((db, actor) =>
    PbcRepositoryProvisioningService.ProvisionClientWorkspaceAsync(db, actor, Provisioner, clientId, DateTimeOffset.UtcNow));

  private Task ProvisionEngagementAsync(Guid engagementId) => RunAsync((db, actor) =>
    PbcRepositoryProvisioningService.ProvisionEngagementRepositoryAsync(db, actor, Provisioner, engagementId, DateTimeOffset.UtcNow));

  private async Task RunAsync(Func<AuditSphereDbContext, ActorContext, Task<CommandResult<WorkspaceProvisioningResult>>> action)
  {
    _busy = true; _message = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _ok = false; _message = "Your session is no longer authorized."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await action(db, actor);
      _ok = result.Succeeded && result.Value!.State is "READY" or "VERIFIED";
      _message = result.Succeeded ? result.Value!.Message : result.Message;
      await LoadAsync();
    }
    finally { _busy = false; }
  }
}
