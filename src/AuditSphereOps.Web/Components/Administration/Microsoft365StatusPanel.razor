@* Security & Consent, SharePoint and Mail status (§§12, 13, 21). Each capability is shown separately;
   one green badge never implies the rest. *@
@using AuditSphereOps.Application.Microsoft365
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IMicrosoftTenantConsentVerifier Verifier
@inject TenantAdministrationSettings Settings

<MudTabs Elevation="0" Rounded="true">
  <MudTabPanel Text="Security & Consent">
    <MudPaper Class="audit-workspace-panel audit-admin-panel pa-4" Elevation="0" role="region" aria-labelledby="consent-heading">
      <h3 id="consent-heading">Security &amp; consent</h3>
      <MudText Typo="Typo.body2" Class="field-help">Tenant: <code>@(Overview.TenantId ?? "not configured")</code>. Microsoft Entra authenticates identities and controls tenant authority; AuditSphere owns its application roles and scope.</MudText>
      <div class="d-flex flex-wrap gap-2 my-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/app/administration/microsoft365/tenant-connection">Tenant connection</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="VerifyAsync" Disabled="@_busy">@(_busy ? "Checking Microsoft…" : "Verify capabilities")</MudButton>
      </div>
      @if (!string.IsNullOrWhiteSpace(_message)) { <MudAlert Severity="Severity.Info" Dense="true" role="status">@_message</MudAlert> }
      <MudTable Items="Overview.Capabilities" Dense="true" Elevation="0" HorizontalScrollbar="true" Class="audit-admin-wide-table mt-2">
        <HeaderContent><MudTh>Capability</MudTh><MudTh>Permission</MudTh><MudTh>Enabled</MudTh><MudTh>State</MudTh><MudTh>Last verification</MudTh><MudTh>Diagnostic</MudTh></HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Capability">@context.DisplayName</MudTd>
          <MudTd DataLabel="Permission"><code>@context.Permission</code></MudTd>
          <MudTd DataLabel="Enabled">@(context.Enabled ? "Yes" : "No")</MudTd>
          <MudTd DataLabel="State"><StatusChip Status="@context.State" /></MudTd>
          <MudTd DataLabel="Last verification">@(context.LastVerifiedAt?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Never")</MudTd>
          <MudTd DataLabel="Diagnostic"><code>@context.DiagnosticCode</code></MudTd>
        </RowTemplate>
      </MudTable>
      <h4 class="mt-4">Permission matrix</h4>
      <MudTable Items="Overview.PermissionMatrix" Dense="true" Elevation="0" HorizontalScrollbar="true" Class="audit-admin-wide-table audit-admin-permission-table">
        <HeaderContent><MudTh>Capability</MudTh><MudTh>Graph endpoint</MudTh><MudTh>Permission</MudTh><MudTh>Type</MudTh><MudTh>Why required</MudTh><MudTh>Admin consent</MudTh><MudTh>Required Entra role</MudTh><MudTh>Configured?</MudTh><MudTh>Verified?</MudTh></HeaderContent>
        <RowTemplate>
          @{ var status = Overview.Capabilities.Single(x => x.Capability == context.Capability); }
          <MudTd DataLabel="Capability">@context.DisplayName</MudTd>
          <MudTd DataLabel="Graph endpoint"><code>@context.GraphEndpoint</code></MudTd>
          <MudTd DataLabel="Permission"><code>@context.Permission</code></MudTd>
          <MudTd DataLabel="Type">@context.PermissionType</MudTd>
          <MudTd DataLabel="Why required">@context.WhyRequired</MudTd>
          <MudTd DataLabel="Admin consent">@context.AdminConsent</MudTd>
          <MudTd DataLabel="Required Entra role">@context.RequiredEntraRole</MudTd>
          <MudTd DataLabel="Configured?">@(status.Enabled ? "Yes" : "No")</MudTd>
          <MudTd DataLabel="Verified?"><StatusChip Status="@status.State" /></MudTd>
        </RowTemplate>
      </MudTable>
      <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
        Never requested by the document or tenant-administration apps: @string.Join(", ", Microsoft365PermissionMatrix.Prohibited). The isolated client-sites worker has a separately consented Sites.FullControl.All exception. Microsoft Entra administrator-role assignment is not available in AuditSphere.
      </MudAlert>
    </MudPaper>
  </MudTabPanel>
  <MudTabPanel Text="SharePoint">
    <MudPaper Class="audit-workspace-panel audit-admin-panel pa-4" Elevation="0" role="region" aria-labelledby="sharepoint-heading">
      <h3 id="sharepoint-heading">SharePoint documents and client sites</h3>
      <dl class="details audit-admin-details">
        <dt>Selected site</dt><dd>@(Overview.SharePoint.SiteUrl ?? "Not configured")</dd>
        <dt>Library</dt><dd><code>@(Overview.SharePoint.DriveId ?? "—")</code></dd>
        <dt>Root folder</dt><dd><code>@(Overview.SharePoint.RootFolderId ?? "—")</code></dd>
        <dt>Access profile</dt><dd>@Overview.SharePoint.AccessProfile</dd>
        <dt>Workspace template</dt><dd><StatusChip Status="@Overview.SharePoint.ClientTemplate" /></dd>
        <dt>Client workspace provisioning</dt><dd>@Overview.SharePoint.ReadyClientWorkspaces ready, @Overview.SharePoint.BlockedClientWorkspaces not ready</dd>
        <dt>Engagement workspace provisioning</dt><dd>Uses the approved engagement folder template under the client workspace.</dd>
        <dt>Last verification</dt><dd>@(Overview.SharePoint.LastVerification?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Never")</dd>
      </dl>
      <MudSimpleTable Dense="true" Class="mt-2">
        <tbody>
          <tr><td>Tenant authentication</td><td><StatusChip Status="@Overview.SharePoint.TenantAuthentication" /></td></tr>
          <tr><td>Application consent</td><td><StatusChip Status="@Overview.SharePoint.ApplicationConsent" /></td></tr>
          <tr><td>Selected site permission</td><td><StatusChip Status="@Overview.SharePoint.SelectedSitePermission" /></td></tr>
          <tr><td>Library access</td><td><StatusChip Status="@Overview.SharePoint.LibraryAccess" /></td></tr>
          <tr><td>Workspace configuration</td><td><StatusChip Status="@Overview.SharePoint.WorkspaceConfiguration" /></td></tr>
        </tbody>
      </MudSimpleTable>
      <MudButton Variant="Variant.Outlined" Href="/app/administration/microsoft365" Class="mt-3">Configure selected site, library and templates</MudButton>
      <ClientSharePointSitesPanel />
      <WorkspaceProvisioningPanel />
    </MudPaper>
  </MudTabPanel>
  <MudTabPanel Text="Mail">
    <MudPaper Class="audit-workspace-panel audit-admin-panel pa-4" Elevation="0" role="region" aria-labelledby="mail-heading">
      <h3 id="mail-heading">Outbound mail</h3>
      <MudText Typo="Typo.body2" Class="field-help">AuditSphere sends notifications only. Mailbox reading, inbox synchronization and tenant mail administration are not available.</MudText>
      <dl class="details audit-admin-details">
        <dt>Sender identity</dt><dd>@Overview.Mail.SenderIdentity</dd>
        <dt>Transport state</dt><dd><StatusChip Status="@Overview.Mail.TransportState" /></dd>
        <dt>Permission state</dt><dd><StatusChip Status="@Overview.Mail.PermissionState" /></dd>
        <dt>Last verification</dt><dd>@(Overview.Mail.LastVerification?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Never")</dd>
        <dt>Last failure</dt><dd>@(Overview.Mail.LastFailure ?? "None recorded")</dd>
      </dl>
    </MudPaper>
  </MudTabPanel>
</MudTabs>

@code {
  [Parameter, EditorRequired] public AdministrationOverview Overview { get; set; } = default!;
  [Parameter] public EventCallback Changed { get; set; }
  private bool _busy;
  private string? _message;

  private async Task VerifyAsync()
  {
    _busy = true; _message = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _message = "Your session is no longer authorized."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await TenantCapabilityService.VerifyAsync(db, actor, Verifier, Settings.Options, DateTimeOffset.UtcNow);
      _message = result.Succeeded
        ? "Capability verification recorded. Each capability is shown with its own result."
        : result.Message;
      await Changed.InvokeAsync();
    }
    finally { _busy = false; }
  }
}
