@* Create Microsoft 365 User (§7). Visible only when provisioning is enabled and verified. The temporary
   password exists only in this circuit's memory, is shown once, and is cleared on acknowledgement. *@
@using AuditSphereOps.Application.Microsoft365
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IMicrosoftDirectoryUserProvisioner Provisioner
@inject TenantAdministrationSettings Settings

<MudPaper Class="audit-workspace-panel audit-admin-panel pa-4 my-3" Elevation="0" role="region" aria-labelledby="create-user-heading">
  <h3 id="create-user-heading">Create Microsoft 365 user</h3>
  @if (!Available)
  {
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
      Tenant user provisioning is @(Settings.Options.ProvisioningEnabled ? "enabled but not verified (User.Create consent must be verified first)" : "not enabled for this deployment")
      . Use Microsoft Directory to select an existing user instead.
    </MudAlert>
  }
  else
  {
    <MudBreadcrumbs Items="@_crumbs" />
    <MudProgressLinear Value="@((_step + 1) * 100.0 / Steps.Length)" Class="mb-3" aria-label="Create user progress" />
    @switch (_step)
    {
      case 0:
        <MudText Typo="Typo.subtitle1">Identity</MudText>
        <MudTextField T="string" Label="Display name" @bind-Value="_displayName" MaxLength="256" id="create-display-name" Required="true" />
        break;
      case 1:
        <MudText Typo="Typo.subtitle1">Microsoft account details</MudText>
        <MudTextField T="string" Label="User principal name" @bind-Value="_upn" MaxLength="113" id="create-upn" HelperText="Must use a verified domain of the configured tenant." />
        <MudTextField T="string" Label="Mail nickname" @bind-Value="_nickname" MaxLength="64" id="create-nickname" />
        <MudSwitch T="bool" @bind-Value="_enabled" Label="Account enabled" Color="Color.Primary" />
        @if (!_enabled) { <MudAlert Severity="Severity.Warning" Dense="true">A disabled account cannot receive AuditSphere access; creation will be refused.</MudAlert> }
        <MudAlert Severity="Severity.Info" Dense="true">Initial password: generated by AuditSphere, sent only to Microsoft, shown to you once and never stored. The user must change it at first sign-in.</MudAlert>
        break;
      case 2:
        <MudText Typo="Typo.subtitle1">AuditSphere role</MudText>
        <MudSelect T="string" Label="Role" @bind-Value="_role" id="create-role">
          @foreach (var role in RoleAdministrationService.RoleCodes.Where(x => x != "ClientUser")) { <MudSelectItem Value="@role">@role</MudSelectItem> }
        </MudSelect>
        break;
      case 3:
        <MudText Typo="Typo.subtitle1">Scope</MudText>
        <MudSelect T="string" Label="Scope type" @bind-Value="_scopeKind" id="create-scope">
          <MudSelectItem Value="@("FIRM_WIDE")">Firm-wide</MudSelectItem>
          <MudSelectItem Value="@("CLIENT")">Client</MudSelectItem>
          <MudSelectItem Value="@("ENGAGEMENT")">Engagement</MudSelectItem>
        </MudSelect>
        @if (_scopeKind is "CLIENT" or "ENGAGEMENT")
        {
          <MudSelect T="Guid?" Label="Client" @bind-Value="_clientId" id="create-client">
            @foreach (var client in Clients) { <MudSelectItem T="Guid?" Value="@client.Id">@client.Name</MudSelectItem> }
          </MudSelect>
        }
        @if (_scopeKind == "ENGAGEMENT")
        {
          <MudSelect T="Guid?" Label="Engagement" @bind-Value="_engagementId" id="create-engagement">
            @foreach (var engagement in Engagements.Where(x => x.ParentId == _clientId)) { <MudSelectItem T="Guid?" Value="@engagement.Id">@engagement.Name</MudSelectItem> }
          </MudSelect>
        }
        <MudTextField T="string" Label="Reason" @bind-Value="_reason" Lines="2" MaxLength="1000" id="create-reason" />
        break;
      case 4:
        <MudText Typo="Typo.subtitle1">Review</MudText>
        <dl class="details audit-admin-details">
          <dt>Display name</dt><dd>@_displayName</dd>
          <dt>User principal name</dt><dd>@_upn</dd>
          <dt>Mail nickname</dt><dd>@_nickname</dd>
          <dt>Account enabled</dt><dd>@(_enabled ? "Yes" : "No")</dd>
          <dt>AuditSphere role</dt><dd>@_role</dd>
          <dt>Scope</dt><dd>@_scopeKind @(ScopeName())</dd>
          <dt>Reason</dt><dd>@_reason</dd>
          <dt>Request key</dt><dd><code>@_idempotencyKey</code> (a retry reuses this key and cannot create a duplicate)</dd>
        </dl>
        <MudAlert Severity="Severity.Warning" Dense="true">Creating a Microsoft user is an external action. It is recorded before dispatch and reconciled if Microsoft does not confirm the result.</MudAlert>
        break;
      case 5:
      case 6:
        <MudText Typo="Typo.subtitle1">@(_step == 5 ? "Create" : "Verify")</MudText>
        @if (_result is not null)
        {
          <MudAlert Severity="@(_result.State == "BOUND" ? Severity.Success : _result.State is "UNKNOWN" or "ACCEPTED" ? Severity.Warning : Severity.Error)" role="status">
            <div><StatusChip Status="@_result.State" /> @_result.Message</div>
            @if (_result.CorrelationId is not null) { <div class="field-help">Microsoft request ID: <code>@_result.CorrelationId</code></div> }
          </MudAlert>
          @if (_password is not null)
          {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert" Class="mt-2">
              <strong>One-time initial password</strong> — share it with the user through an approved secure channel. It is not stored and will not be shown again.
              <div class="mt-2"><code id="one-time-password">@_password</code></div>
              <MudButton Variant="Variant.Filled" Color="Color.Warning" Class="mt-2" OnClick="ClearPassword">I have securely recorded it</MudButton>
            </MudAlert>
          }
        }
        break;
    }
    @if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" role="alert">@_error</MudAlert> }
    <div class="mt-3 d-flex gap-2">
      @if (_step is > 0 and < 5) { <MudButton Variant="Variant.Outlined" OnClick="Back" Disabled="@_busy">Back</MudButton> }
      @if (_step < 4) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Next">Next</MudButton> }
      @if (_step == 4) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="@_busy">@(_busy ? "Creating…" : "Create user")</MudButton> }
      @if (_step >= 5 && _result?.State is "UNKNOWN" or "ACCEPTED") { <MudButton Variant="Variant.Outlined" OnClick="ReconcileAsync" Disabled="@_busy">Reconcile</MudButton> }
      @if (_step >= 5) { <MudButton Variant="Variant.Text" OnClick="Reset" Disabled="@(_password is not null)">Start another</MudButton> }
    </div>
  }
</MudPaper>

@code {
  private static readonly string[] Steps = ["Identity", "Microsoft Account Details", "AuditSphere Role", "Scope", "Review", "Create", "Verify"];
  [Parameter] public bool Available { get; set; }
  [Parameter] public IReadOnlyList<ScopeOption> Clients { get; set; } = [];
  [Parameter] public IReadOnlyList<ScopeOption> Engagements { get; set; } = [];
  [Parameter] public EventCallback Changed { get; set; }

  private int _step;
  private string _displayName = string.Empty, _upn = string.Empty, _nickname = string.Empty, _role = "Staff",
    _scopeKind = string.Empty, _reason = string.Empty, _idempotencyKey = NewKey();
  private bool _enabled = true, _busy;
  private Guid? _clientId, _engagementId;
  private ExternalOperationResult? _result;
  private string? _password, _error;
  private List<BreadcrumbItem> _crumbs = [];

  protected override void OnParametersSet() => UpdateCrumbs();

  private void UpdateCrumbs() => _crumbs = Steps.Select((x, i) => new BreadcrumbItem(x, href: null, disabled: i != _step)).ToList();

  private void Next()
  {
    _error = _step switch
    {
      0 when string.IsNullOrWhiteSpace(_displayName) => "Enter a display name.",
      1 when string.IsNullOrWhiteSpace(_upn) || !_upn.Contains('@') || string.IsNullOrWhiteSpace(_nickname) => "Enter a user principal name and mail nickname.",
      2 when string.IsNullOrWhiteSpace(_role) => "Choose a role.",
      3 when string.IsNullOrWhiteSpace(_scopeKind) || _scopeKind != "FIRM_WIDE" && !_clientId.HasValue ||
             _scopeKind == "ENGAGEMENT" && !_engagementId.HasValue => "Choose an explicit scope.",
      3 when string.IsNullOrWhiteSpace(_reason) || _reason.Trim().Length < 5 => "Enter a reason of at least five characters.",
      _ => null
    };
    if (_error is null) { _step++; UpdateCrumbs(); }
  }

  private void Back() { _step--; _error = null; UpdateCrumbs(); }

  private string ScopeName() => _scopeKind switch
  {
    "CLIENT" => Clients.FirstOrDefault(x => x.Id == _clientId)?.Name ?? string.Empty,
    "ENGAGEMENT" => Engagements.FirstOrDefault(x => x.Id == _engagementId)?.Name ?? string.Empty,
    _ => string.Empty
  };

  private async Task CreateAsync()
  {
    _busy = true; _error = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _error = "Your session is no longer authorized. Sign in again."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await DirectoryProvisioningService.CreateTenantUserAsync(db, actor, Provisioner, Settings.Options,
        new(_idempotencyKey, _displayName, _upn, _nickname, _enabled, _role, _scopeKind,
          _scopeKind == "FIRM_WIDE" ? null : _clientId, _scopeKind == "ENGAGEMENT" ? _engagementId : null, _reason),
        DateTimeOffset.UtcNow);
      if (!result.Succeeded) { _error = result.Message; return; }
      _result = result.Value!;
      _password = _result.TemporaryPassword;
      _step = _result.State == "BOUND" ? 6 : 5;
      UpdateCrumbs();
      await Changed.InvokeAsync();
    }
    finally { _busy = false; }
  }

  private async Task ReconcileAsync()
  {
    if (_result is null) return;
    _busy = true; _error = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _error = "Your session is no longer authorized. Sign in again."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await DirectoryProvisioningService.ResumeAsync(db, actor, _result.OperationId,
        new(Provisioner, null, null), Settings.Options, DateTimeOffset.UtcNow);
      if (!result.Succeeded) { _error = result.Message; return; }
      _result = result.Value;
      if (_result!.State == "BOUND") { _step = 6; UpdateCrumbs(); }
      await Changed.InvokeAsync();
    }
    finally { _busy = false; }
  }

  private void ClearPassword() => _password = null;

  private void Reset()
  {
    _step = 0; _displayName = _upn = _nickname = _reason = _scopeKind = string.Empty; _role = "Staff";
    _clientId = _engagementId = null; _enabled = true; _result = null; _password = null; _error = null;
    _idempotencyKey = NewKey(); UpdateCrumbs();
  }

  private static string NewKey() => "create-" + Guid.NewGuid().ToString("N");
}
