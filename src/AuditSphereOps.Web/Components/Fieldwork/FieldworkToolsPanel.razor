@* Fieldwork tools: the integrated sampling tool with its calculation log, the client evidence picker, the physical
   file index and ad hoc steps. Every action goes through the guarded Application commands. *@
@using AuditSphereOps.Application.Audit
@using AuditSphereOps.Domain.Audit
@using AuditSphereOps.Domain.Completion
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" role="region" aria-labelledby="fieldwork-tools-heading">
  <h2 id="fieldwork-tools-heading">Fieldwork tools</h2>
  <MudTabs Elevation="0" Rounded="true">
    <MudTabPanel Text="Sampling">
      <p class="scope-note">Runs the sampling engine over an approved schedule. Parameters, seed and the exact source digest are logged, so the selection can be re-performed.</p>
      <div class="audit-inline-form">
        <label for="smp-procedure">Procedure <select id="smp-procedure" @bind="_procedureId">@ProcedureOptions()</select></label>
        <label for="smp-schedule">Approved schedule <select id="smp-schedule" @bind="_scheduleId"><option value="">Select</option>@foreach (var s in _schedules) { <option value="@s.Id">@s.ScheduleType · @s.RowCount rows (@s.Currency)</option> }</select></label>
        <label for="smp-method">Method <select id="smp-method" @bind="_method">@foreach (var m in AuditSamplingMethods.All) { <option value="@m">@m</option> }</select></label>
        @if (_method == AuditSamplingMethods.MonetaryUnit) { <label for="smp-interval">Interval <input id="smp-interval" type="number" step="0.01" @bind="_interval" /></label> }
        @if (_method is AuditSamplingMethods.KeyItem or AuditSamplingMethods.Stratified) { <label for="smp-key">Key-item threshold <input id="smp-key" type="number" step="0.01" @bind="_keyThreshold" /></label> }
        @if (_method is AuditSamplingMethods.Random or AuditSamplingMethods.Stratified)
        {
          <label for="smp-size">Sample size <input id="smp-size" type="number" min="1" @bind="_sampleSize" /></label>
          <label for="smp-seed">Seed <input id="smp-seed" type="number" @bind="_seed" /></label>
        }
        <label for="smp-rationale">Rationale <input id="smp-rationale" @bind="_samplingRationale" maxlength="500" /></label>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunSamplingAsync" Disabled="@_busy">Run sampling</MudButton>
      </div>
      @if (_runs.Count > 0)
      {
        <MudTable Items="_runs" Dense="true" Elevation="0" aria-label="Sampling calculation log">
          <HeaderContent><MudTh>When</MudTh><MudTh>Method</MudTh><MudTh>Parameters</MudTh><MudTh>Selected</MudTh><MudTh>Coverage</MudTh><MudTh>Re-performed</MudTh></HeaderContent>
          <RowTemplate>
            <MudTd DataLabel="When">@context.Run.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Method">@context.Run.Method</MudTd>
            <MudTd DataLabel="Parameters">@Parameters(context.Run)</MudTd>
            <MudTd DataLabel="Selected">@context.Run.SelectedCount of @context.Run.PopulationCount</MudTd>
            <MudTd DataLabel="Coverage">@context.Run.CoveragePercent.ToString("0.##")%</MudTd>
            <MudTd DataLabel="Re-performed"><span class="@(context.Reproduces ? "success-text" : "error-text")">@(context.Reproduces ? "Matches" : "Source changed")</span></MudTd>
          </RowTemplate>
        </MudTable>
      }
    </MudTabPanel>
    <MudTabPanel Text="Client evidence">
      <p class="scope-note">Link a received client upload to a procedure. The link pins the provider receipt digest; a superseded version cannot be linked.</p>
      <div class="audit-inline-form">
        <label for="ev-procedure">Procedure <select id="ev-procedure" @bind="_evidenceProcedureId">@ProcedureOptions()</select></label>
        <label for="ev-upload">Received upload <select id="ev-upload" @bind="_uploadId"><option value="">Select</option>@foreach (var c in _candidates) { <option value="@c.UploadIntentId">@c.RequestArea · @c.FileName · @c.ReceivedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(c.Superseded ? " (superseded)" : "")</option> }</select></label>
        <label for="ev-note">Note <input id="ev-note" @bind="_evidenceNote" maxlength="500" /></label>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LinkEvidenceAsync" Disabled="@_busy">Link evidence</MudButton>
      </div>
      @if (_linked.Count > 0)
      {
        <ul aria-label="Linked client evidence">@foreach (var l in _linked) { <li>@l.FileName <code>@l.ContentSha256[..12]</code> @(l.Note is null ? "" : $"— {l.Note}")</li> }</ul>
      }
    </MudTabPanel>
    <MudTabPanel Text="Physical files">
      <div class="audit-inline-form">
        <label for="ph-index">File index <input id="ph-index" @bind="_fileIndex" maxlength="40" placeholder="X-1" /></label>
        <label for="ph-box">Box <input id="ph-box" @bind="_box" maxlength="40" placeholder="Box 3" /></label>
        <label for="ph-desc">Description <input id="ph-desc" @bind="_description" maxlength="300" /></label>
        <label for="ph-location">Location <input id="ph-location" @bind="_location" maxlength="200" /></label>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RegisterPhysicalAsync" Disabled="@_busy">Register file</MudButton>
      </div>
      @foreach (var item in _physical)
      {
        <div class="physical-item" data-file-index="@item.FileIndex">
          <p><strong>@item.FileIndex</strong> · @item.BoxReference · @item.Description — at <em>@item.CurrentLocation</em></p>
          <p class="muted">History: @string.Join(" → ", item.Movements.Select(m => $"{m.ToLocation} ({m.MovedAt.ToLocalTime():yyyy-MM-dd})"))</p>
          <p class="muted">Procedures: @(item.Procedures.Count == 0 ? "none" : string.Join(", ", item.Procedures.Select(p => p.Title)))</p>
          <div class="audit-inline-form">
            <label>Link to procedure <select @bind="_physicalLinkTarget" aria-label="@($"Procedure for {item.FileIndex}")">@ProcedureOptions()</select></label>
            <MudButton Variant="Variant.Text" OnClick="@(() => LinkPhysicalAsync(item.Id))" Disabled="@_busy" aria-label="@($"Link {item.FileIndex}")">Link</MudButton>
            <label>Move to <input @bind="_moveTo" aria-label="@($"New location for {item.FileIndex}")" /></label>
            <MudButton Variant="Variant.Text" OnClick="@(() => MoveAsync(item.Id))" Disabled="@_busy" aria-label="@($"Move {item.FileIndex}")">Record move</MudButton>
          </div>
        </div>
      }
    </MudTabPanel>
    <MudTabPanel Text="Ad hoc steps">
      <p class="scope-note">Add a step for an unusual risk or transaction. The adopted programme's baseline is untouched; the step must be performed and reviewed before completion.</p>
      <label for="ah-title" class="d-block">Title <input id="ah-title" @bind="_adhocTitle" maxlength="300" /></label>
      <label for="ah-wording" class="d-block">Step <textarea id="ah-wording" @bind="_adhocWording" maxlength="4000" rows="2"></textarea></label>
      <label for="ah-reason" class="d-block">Why it is needed <input id="ah-reason" @bind="_adhocReason" maxlength="500" /></label>
      <label for="ah-section" class="d-block">Audit area <input id="ah-section" @bind="_adhocSection" maxlength="100" /></label>
      <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InsertAdHocAsync" Disabled="@_busy">Insert step</MudButton>
    </MudTabPanel>
    <MudTabPanel Text="Review notes">
      <p class="scope-note">Anchor a note to text in the current submitted result. A result cannot be approved while a note is open; the preparer responds and a reviewer resolves.</p>
      <label for="rn-procedure">Procedure <select id="rn-procedure" @bind="_notesProcedureId" @bind:after="LoadNotesAsync">@ProcedureOptions()</select></label>
      @if (_currentResult is not null)
      {
        <div class="review-result" aria-label="Current submitted result">
          <p><strong>Revision @_currentResult.Revision — work performed:</strong> @_currentResult.WorkPerformed</p>
          <p><strong>Conclusion:</strong> @_currentResult.Conclusion</p>
        </div>
        <div class="audit-inline-form">
          <label for="rn-field">Field <select id="rn-field" @bind="_noteField"><option value="WORK_PERFORMED">Work performed</option><option value="CONCLUSION">Conclusion</option></select></label>
          <label for="rn-excerpt">Quoted text <input id="rn-excerpt" @bind="_noteExcerpt" maxlength="500" /></label>
          <label for="rn-body">Note <input id="rn-body" @bind="_noteBody" maxlength="4000" /></label>
          <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddNoteAsync" Disabled="@_busy">Add note</MudButton>
        </div>
      }
      @foreach (var note in _notes)
      {
        <div class="review-note @(note.Open ? "review-note-open" : "")" data-note="@note.Excerpt">
          <p><mark>“@note.Excerpt”</mark> (r@(note.ResultRevision), @note.Field.ToLowerInvariant().Replace('_', ' ')) — @note.Body <span class="muted">@note.AuthorName</span> <strong>@(note.Open ? "Open" : "Resolved")</strong></p>
          @foreach (var e in note.Events) { <p class="muted">@e.Kind.ToLowerInvariant(): @e.Body</p> }
          <div class="audit-inline-form">
            <label>Reply <input @bind="_noteReply" aria-label="@($"Reply to note on {note.Excerpt}")" /></label>
            <MudButton Variant="Variant.Text" OnClick="@(() => NoteEventAsync(note.NoteId, "RESPONSE"))" Disabled="@_busy">Respond</MudButton>
            @if (note.Open) { <MudButton Variant="Variant.Text" OnClick="@(() => NoteEventAsync(note.NoteId, "RESOLVED"))" Disabled="@_busy" aria-label="@($"Resolve note on {note.Excerpt}")">Resolve</MudButton> }
          </div>
        </div>
      }
    </MudTabPanel>
  </MudTabs>
  @if (_message is not null) { <p class="command-result @(_error ? "error-text" : "success-text")" role="status">@_message</p> }
</MudPaper>

@code {
  [Parameter, EditorRequired] public Guid EngagementId { get; set; }
  private List<(Guid Id, string Label)> _procedures = [];
  private List<AuditSchedule> _schedules = [];
  private List<SamplingRunView> _runs = [];
  private IReadOnlyList<EvidenceCandidate> _candidates = [];
  private IReadOnlyList<ProcedureEvidenceView> _linked = [];
  private IReadOnlyList<PhysicalItemView> _physical = [];
  private string _procedureId = "", _scheduleId = "", _method = AuditSamplingMethods.MonetaryUnit, _samplingRationale = "";
  private decimal? _interval, _keyThreshold;
  private int? _sampleSize, _seed;
  private string _evidenceProcedureId = "", _uploadId = "", _evidenceNote = "";
  private string _fileIndex = "", _box = "", _description = "", _location = "", _physicalLinkTarget = "", _moveTo = "";
  private string _adhocTitle = "", _adhocWording = "", _adhocReason = "", _adhocSection = "";
  private bool _busy, _error;
  private string? _message;

  private string _notesProcedureId = "", _noteField = "WORK_PERFORMED", _noteExcerpt = "", _noteBody = "", _noteReply = "";
  private AuditProcedureResult? _currentResult;
  private IReadOnlyList<ReviewNoteView> _notes = [];

  private async Task LoadNotesAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null || !Guid.TryParse(_notesProcedureId, out var procedureId)) { _currentResult = null; _notes = []; return; }
    await using var db = await DbFactory.CreateDbContextAsync();
    _currentResult = await db.AuditProcedureResults.AsNoTracking().Where(x => x.FirmId == actor.FirmId && x.AuditProcedureId == procedureId)
      .OrderByDescending(x => x.Revision).FirstOrDefaultAsync();
    _notes = await ReviewNotesService.ListAsync(db, actor, procedureId);
  }

  private Task AddNoteAsync() => _currentResult is null ? Task.CompletedTask : RunAsync(async (db, a) =>
  {
    var r = await ReviewNotesService.AddNoteAsync(db, a, new(_currentResult.Id, _noteField, _noteExcerpt, _noteBody));
    await LoadNotesAsync();
    return (r.Succeeded, r.Succeeded ? "Note added." : r.Message!);
  });

  private Task NoteEventAsync(Guid noteId, string kind) => RunAsync(async (db, a) =>
  {
    var r = kind == "RESOLVED" ? await ReviewNotesService.ResolveAsync(db, a, noteId, string.IsNullOrWhiteSpace(_noteReply) ? "Resolved." : _noteReply)
      : await ReviewNotesService.RespondAsync(db, a, noteId, _noteReply);
    _noteReply = "";
    await LoadNotesAsync();
    return (r.Succeeded, r.Succeeded ? (kind == "RESOLVED" ? "Note resolved." : "Response added.") : r.Message!);
  });

  private static string Parameters(AuditSamplingRun r) => string.Join(", ", new[]
  {
    r.Interval is null ? null : $"interval {r.Interval:N2}", r.KeyItemThreshold is null ? null : $"key items ≥ {r.KeyItemThreshold:N2}",
    r.SampleSize is null ? null : $"size {r.SampleSize}", r.Seed is null ? null : $"seed {r.Seed}", $"source {r.SourceDigest[..10]}"
  }.Where(x => x is not null));

  private RenderFragment ProcedureOptions() => builder =>
  {
    var seq = 0;
    builder.OpenElement(seq++, "option"); builder.AddAttribute(seq++, "value", ""); builder.AddContent(seq++, "Select"); builder.CloseElement();
    foreach (var p in _procedures) { builder.OpenElement(seq++, "option"); builder.AddAttribute(seq++, "value", p.Id.ToString()); builder.AddContent(seq++, p.Label); builder.CloseElement(); }
  };

  protected override Task OnParametersSetAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    _procedures = (await db.AuditProcedures.AsNoTracking().Where(x => x.FirmId == actor.FirmId && x.EngagementId == EngagementId && x.ApplicabilityStatus == AuditApplicabilityStatuses.Applicable)
      .OrderBy(x => x.SourceProcedureId).Select(x => new { x.Id, Label = x.SourceProcedureId + " · " + x.Title }).ToListAsync()).Select(x => (x.Id, x.Label)).ToList();
    _schedules = await db.AuditSchedules.AsNoTracking().Where(x => x.FirmId == actor.FirmId && x.EngagementId == EngagementId && x.Status == AuditScheduleStatuses.Approved).ToListAsync();
    var runs = await AuditFieldworkService.ListSamplingRunsAsync(db, actor, EngagementId);
    _runs = [];
    foreach (var run in runs.Take(10))
      if ((await AuditFieldworkService.GetSamplingRunAsync(db, actor, run.Id)).Value is { } view) _runs.Add(view);
    _candidates = await AuditFieldworkService.EvidenceCandidatesAsync(db, actor, EngagementId);
    _linked = Guid.TryParse(_evidenceProcedureId, out var p) ? await AuditFieldworkService.ProcedureEvidenceAsync(db, actor, p) : [];
    _physical = await AuditFieldworkService.PhysicalItemsAsync(db, actor, EngagementId);
  }

  private async Task RunAsync(Func<AuditSphereDbContext, ActorContext, Task<(bool Ok, string Message)>> command)
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var (ok, message) = await command(db, actor);
      (_error, _message) = (!ok, message);
      await LoadAsync();
    }
    finally { _busy = false; }
  }

  private Task RunSamplingAsync() => Guid.TryParse(_procedureId, out var procedure) && Guid.TryParse(_scheduleId, out var schedule)
    ? RunAsync(async (db, a) =>
      {
        var r = await AuditFieldworkService.RunSamplingAsync(db, a, new(EngagementId, procedure, schedule, _method, _interval, _keyThreshold, _sampleSize, _seed, _samplingRationale));
        return (r.Succeeded, r.Succeeded ? $"Selected {r.Value!.Run.SelectedCount} of {r.Value.Run.PopulationCount} items ({r.Value.Run.CoveragePercent:0.##}% coverage); the selection awaits review." : r.Message!);
      })
    : Task.CompletedTask;

  private Task LinkEvidenceAsync() => Guid.TryParse(_evidenceProcedureId, out var procedure) && Guid.TryParse(_uploadId, out var upload)
    ? RunAsync(async (db, a) => { var r = await AuditFieldworkService.LinkClientEvidenceAsync(db, a, procedure, upload, _evidenceNote); return (r.Succeeded, r.Succeeded ? "Evidence linked." : r.Message!); })
    : Task.CompletedTask;

  private Task RegisterPhysicalAsync() => RunAsync(async (db, a) =>
  {
    var r = await AuditFieldworkService.RegisterPhysicalItemAsync(db, a, EngagementId, _fileIndex, _box, _description, _location);
    return (r.Succeeded, r.Succeeded ? $"Registered {_fileIndex.Trim().ToUpperInvariant()}." : r.Message!);
  });

  private Task LinkPhysicalAsync(Guid itemId) => Guid.TryParse(_physicalLinkTarget, out var procedure)
    ? RunAsync(async (db, a) => { var r = await AuditFieldworkService.LinkPhysicalItemAsync(db, a, procedure, itemId); return (r.Succeeded, r.Succeeded ? "Physical file linked." : r.Message!); })
    : Task.CompletedTask;

  private Task MoveAsync(Guid itemId) => RunAsync(async (db, a) =>
  {
    var r = await AuditFieldworkService.MovePhysicalItemAsync(db, a, itemId, _moveTo, "Moved from the fieldwork page");
    return (r.Succeeded, r.Succeeded ? "Movement recorded." : r.Message!);
  });

  private Task InsertAdHocAsync() => RunAsync(async (db, a) =>
  {
    var r = await AuditFieldworkService.InsertAdHocProcedureAsync(db, a, new(EngagementId, _adhocTitle, _adhocWording, _adhocReason, _adhocSection, null));
    return (r.Succeeded, r.Succeeded ? "Ad hoc step inserted; it must be performed and reviewed before completion." : r.Message!);
  });
}
