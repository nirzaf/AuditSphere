@inherits LayoutComponentBase

<div class="shell">
  <header class="topbar">
    <a class="brand" href="/">AuditSphereOps</a>
    <span class="environment">@EnvironmentLabel</span>
  </header>
  <div class="shell-body">
    <nav aria-label="Primary navigation" class="sidebar">
      <a href="/app">Portfolio</a>
      <a href="/app/practice/leads">Leads</a>
      <a href="/app/practice/time">Time</a>
      <a href="/app/finance">Finance</a>
      <a href="/app/accounting">Accounting workspace</a>
      <a href="/app/accounting/evidence">Accounting evidence</a>
      <a href="/app/accounting/rollforward">Period roll-forward</a>
      <a href="/app/accounting/reviews">Package reviews</a>
      <a href="/app/accounting/restatements">Period restatements</a>
      <a href="/app/consolidation">Consolidation</a>
      <a href="/app/journals">Journals</a>
      <a href="/app/operations">Operations</a>
      <a href="/app/administration">Administration</a>
      <a href="/portal">Client portal</a>
      <a href="/health/ready">Readiness</a>
    </nav>
    <main class="content" id="main-content">
      @Body
    </main>
  </div>
</div>

@code {
  [Inject] private IConfiguration Configuration { get; set; } = default!;
  private string EnvironmentLabel => Configuration["ASPNETCORE_ENVIRONMENT"] ?? "Development";
}
