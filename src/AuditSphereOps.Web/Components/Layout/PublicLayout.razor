@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="#main-content">Skip to main content</a>
<MudLayout Class="audit-shell audit-public-shell">
  <MudAppBar Elevation="0" Class="audit-topbar">
    <MudLink Href="/" Color="Color.Inherit" Typo="Typo.subtitle1" Underline="Underline.None">AuditSphereOps</MudLink>
  </MudAppBar>
  <MudMainContent Class="audit-main-content">
    <MudContainer MaxWidth="MaxWidth.Large" Class="audit-workspace">
      <main id="main-content">@Body</main>
    </MudContainer>
  </MudMainContent>
</MudLayout>

@code {
  private readonly MudTheme _theme = Theme.AuditSphereTheme.Create();
}
