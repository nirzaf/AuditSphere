@* UX-029 bounded staff search. Results come from GlobalSearchQuery, which re-authorizes every hit with the rule its
   destination route applies; this component only debounces input, drops stale responses and renders links. *@
@using AuditSphereOps.Application.Search
@implements IDisposable
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="audit-search @(_open ? "is-open" : null)" role="search" aria-label="Staff search">
  <button type="button" class="audit-search-toggle" aria-label="Open search" aria-expanded="@(_open ? "true" : "false")"
          aria-controls="global-search-input" @onclick="ToggleOpen">
    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
  </button>
  <div class="audit-search-field">
    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="audit-search-icon" aria-hidden="true" />
    <label for="global-search-input" class="sr-only">Search clients, engagements, requests, leads, invoices and pages</label>
    <input id="global-search-input" type="search" autocomplete="off" spellcheck="false"
           maxlength="@GlobalSearchQuery.MaximumTermLength" placeholder="Search records you can open…"
           aria-describedby="global-search-coverage" aria-controls="global-search-results"
           @oninput="OnInput" @onkeydown="OnKeyDown" />
    <kbd class="audit-search-hint" aria-hidden="true">/</kbd>
  </div>
  @if (ShowPanel)
  {
    <div id="global-search-results" class="audit-search-panel" role="region" aria-label="Search results">
      <p class="sr-only" role="status" aria-live="polite">@StatusText</p>
      @if (_searching && _result is null)
      {
        <p class="audit-search-note">Searching…</p>
      }
      else if (_failed)
      {
        <p class="audit-search-note error-text">Search is unavailable right now. Try again.</p>
      }
      else if (_result is { Hits.Count: 0 })
      {
        <p class="audit-search-note">No records you can open match “@_result.Term”.</p>
      }
      else if (_result is not null)
      {
        @foreach (var group in _result.Hits.GroupBy(x => x.Kind))
        {
          <h2 class="audit-search-group">@group.Key</h2>
          <ul class="audit-search-list">
            @foreach (var hit in group)
            {
              <li><a href="@hit.Href" @onclick="Close"><span class="audit-search-title">@hit.Title</span><span class="audit-search-detail">@hit.Detail</span></a></li>
            }
          </ul>
        }
        @if (_result.Truncated)
        {
          <p class="audit-search-note">More matches exist; refine the search to narrow them.</p>
        }
      }
      <p id="global-search-coverage" class="audit-search-coverage">@GlobalSearchQuery.Coverage</p>
    </div>
  }
  else
  {
    <p id="global-search-coverage" class="sr-only">@GlobalSearchQuery.Coverage</p>
  }
</div>

@code {
  private string _term = string.Empty;
  private GlobalSearchResult? _result;
  private bool _searching;
  private bool _failed;
  private bool _open;
  private long _generation;
  private CancellationTokenSource? _pending;

  private bool ShowPanel => _term.Trim().Length >= GlobalSearchQuery.MinimumTermLength;
  private string StatusText => _failed ? "Search failed." : _result is null ? "Searching." : $"{_result.Hits.Count} result(s).";

  protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

  private void ToggleOpen() => _open = !_open;

  private async Task OnInput(ChangeEventArgs args)
  {
    _term = args.Value?.ToString() ?? string.Empty;
    var generation = Interlocked.Increment(ref _generation);
    CancelPending();
    _result = null;
    _failed = false;
    if (!ShowPanel) { _searching = false; return; }
    var cts = _pending = new CancellationTokenSource();
    _searching = true;
    try
    {
      await Task.Delay(300, cts.Token);
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) throw new InvalidOperationException("No signed-in staff actor.");
      await using var db = await DbFactory.CreateDbContextAsync(cts.Token);
      var result = await GlobalSearchQuery.SearchAsync(db, actor, _term, cts.Token);
      if (generation != Interlocked.Read(ref _generation)) return; // a newer query or navigation superseded this one
      _result = result.Succeeded ? result.Value : null;
      _failed = !result.Succeeded;
    }
    catch (OperationCanceledException) { return; }
    catch (Exception)
    {
      if (generation != Interlocked.Read(ref _generation)) return;
      _failed = true;
    }
    finally
    {
      if (generation == Interlocked.Read(ref _generation)) _searching = false;
    }
  }

  // Detach before cancelling so a later keystroke never touches an already-disposed source.
  private void CancelPending()
  {
    var previous = _pending;
    _pending = null;
    if (previous is null) return;
    previous.Cancel();
    previous.Dispose();
  }

  private void OnKeyDown(KeyboardEventArgs args)
  {
    if (args.Key == "Escape") Close();
  }

  private void Close()
  {
    Interlocked.Increment(ref _generation);
    CancelPending();
    _term = string.Empty;
    _result = null;
    _failed = false;
    _searching = false;
    _open = false;
    // The input is uncontrolled so fast typing is never overwritten by a stale render; clear it in the browser.
    _ = ClearInputAsync();
  }

  private async Task ClearInputAsync()
  {
    try { await JS.InvokeVoidAsync("auditSearch.clear"); }
    catch (JSDisconnectedException) { }
    catch (InvalidOperationException) { } // prerender: no browser yet
  }

  // Changing route changes context: drop results so nothing from the previous context lingers.
  private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() => { Close(); StateHasChanged(); });

  public void Dispose()
  {
    Navigation.LocationChanged -= OnLocationChanged;
    CancelPending();
  }
}
