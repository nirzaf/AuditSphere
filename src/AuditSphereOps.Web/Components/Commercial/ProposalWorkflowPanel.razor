@* Proposal lifecycle actions. Each button calls the existing CRM command, which enforces roles, independence of the
   reviewer from the preparer, and the approved-quotation gate. Marking a proposal sent records status only. *@
@using AuditSphereOps.Application.Practice
@using AuditSphereOps.Domain.Practice
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" role="region" aria-labelledby="workflow-heading">
  <h2 id="workflow-heading">Commercial workflow</h2>
  <p class="scope-note">Marking a proposal as sent records its status only; no email is sent by this page. A client response is recorded here by staff. Professional acceptance remains a separate Partner decision.</p>
  @switch (Proposal.Status)
  {
    case CrmStates.ProposalDraft:
      <p>Draft. Price the proposal above, obtain any required approvals, then submit it for independent internal review.</p>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ReviewAsync" Disabled="@_busy">Submit for internal review</MudButton>
      break;
    case CrmStates.ProposalInternalReview:
      <p>Internally reviewed. Mark it as sent once it has been delivered to the client.</p>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SendAsync" Disabled="@_busy">Mark as sent</MudButton>
      break;
    case CrmStates.ProposalSent:
      <p>Sent. Record the client's response.</p>
      <div class="audit-action-row">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => RespondAsync(true)" Disabled="@_busy">Record client acceptance</MudButton>
      </div>
      <MudTextField T="string" Label="Reason if declined" @bind-Value="_reason" Lines="2" MaxLength="1000" Margin="Margin.Dense" />
      <MudButton Variant="Variant.Outlined" OnClick="() => RespondAsync(false)" Disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))">Record client decline</MudButton>
      break;
    case CrmStates.ProposalAccepted when Proposal.PracticeClientId is null:
      <p>Accepted. Convert to a prospect client to open professional acceptance. This does not activate any audit work.</p>
      <MudTextField T="string" Label="Client legal name" @bind-Value="_legalName" MaxLength="200" Margin="Margin.Dense" Required="true" />
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConvertAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_legalName))">Convert to client</MudButton>
      break;
    case CrmStates.ProposalAccepted:
      <p>Accepted and converted. <a href="@($"/app/clients/{Proposal.PracticeClientId}")">Open the client</a> to continue with professional acceptance.</p>
      break;
    case CrmStates.ProposalDeclined:
      <p>Declined@(string.IsNullOrWhiteSpace(Proposal.ResponseReason) ? "." : $": {Proposal.ResponseReason}")</p>
      break;
    default:
      <p>This revision was superseded by a later proposal revision.</p>
      break;
  }
  @if (_message is not null)
  {
    <p class="command-result @(_isError ? "error-text" : "success-text")" role="status">@_message</p>
  }
</MudPaper>

@code {
  [Parameter, EditorRequired] public Proposal Proposal { get; set; } = default!;
  [Parameter] public string LeadName { get; set; } = string.Empty;
  [Parameter] public EventCallback<string> OnChanged { get; set; }

  private string _reason = string.Empty;
  private string _legalName = string.Empty;
  private bool _busy;
  private bool _isError;
  private string? _message;

  protected override void OnParametersSet()
  {
    if (string.IsNullOrEmpty(_legalName)) _legalName = LeadName;
  }

  private Task ReviewAsync() => RunAsync((db, actor) => PracticeCrmService.ApproveProposalAsync(db, actor, Proposal.Id), "Proposal moved to internal review.");
  private Task SendAsync() => RunAsync((db, actor) => PracticeCrmService.SendProposalAsync(db, actor, Proposal.Id), "Proposal marked as sent (status only; nothing was emailed).");
  private Task RespondAsync(bool accepted) => RunAsync((db, actor) => PracticeCrmService.RecordProposalResponseAsync(db, actor, Proposal.Id,
    new(accepted ? CrmStates.ProposalAccepted : CrmStates.ProposalDeclined, accepted ? null : _reason)),
    accepted ? "Client acceptance recorded." : "Client decline recorded.");
  private Task ConvertAsync() => RunAsync(async (db, actor) =>
  {
    var result = await PracticeCrmService.ConvertToClientDraftAsync(db, actor, new(Proposal.Id, _legalName));
    return result.Succeeded ? CommandResult.Ok() : CommandResult.Fail(result.ErrorCode!, result.Message!);
  }, "Converted to a prospect client. Professional acceptance is now pending.");

  private Task RunAsync(Func<AuditSphereDbContext, ActorContext, Task<CommandResult>> action, string success) => RunCoreAsync(action, success);

  private async Task RunCoreAsync(Func<AuditSphereDbContext, ActorContext, Task<CommandResult>> action, string success)
  {
    if (_busy) return;
    _busy = true;
    _message = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _isError = true; _message = "Sign in again."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await action(db, actor);
      _isError = !result.Succeeded;
      _message = result.Succeeded ? success : result.Message;
      if (result.Succeeded) await OnChanged.InvokeAsync(success);
    }
    finally { _busy = false; }
  }
}
