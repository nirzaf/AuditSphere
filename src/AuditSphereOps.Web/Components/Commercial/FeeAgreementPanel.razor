@* Agreed fee cycle: 50% advance and 50% balance. Payments are recorded manually (no payment gateway). *@
@using AuditSphereOps.Application.Practice
@using AuditSphereOps.Domain.Practice
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" role="region" aria-labelledby="fee-heading">
  <h2 id="fee-heading">Agreed fee and billing milestones</h2>
  @if (_loading)
  {
    <LoadingState IsLoading="true" LoadingMessage="Loading fee agreement…" />
  }
  else if (Proposal.Status != CrmStates.ProposalAccepted || Proposal.PracticeClientId is null)
  {
    <p class="muted">A fee agreement is created once the proposal is accepted and converted to a client. Nothing is invoiced before then.</p>
  }
  else if (_view is null)
  {
    <p class="scope-note">The accepted fee of <strong>@Proposal.Fee.ToString("N2") @Proposal.Currency</strong> will be split into a 50% advance and a 50% balance.</p>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAgreementAsync" Disabled="@_busy">Create fee agreement</MudButton>
  }
  else
  {
    var advance = _view.Milestones.Single(x => x.Milestone.Kind == FeeMilestoneKinds.Advance);
    var balance = _view.Milestones.Single(x => x.Milestone.Kind == FeeMilestoneKinds.Balance);
    <p>Agreed fee <strong>@_view.Agreement.AgreedFee.ToString("N2") @_view.Agreement.Currency</strong> — @_view.Agreement.AdvancePercent.ToString("0.##")% advance, remainder on delivery of the final report.</p>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Fee milestones</caption>
        <thead><tr><th scope="col">Milestone</th><th scope="col" class="num">Amount</th><th scope="col">State</th><th scope="col">Invoice</th><th scope="col" class="num">Paid</th><th scope="col" class="num">Outstanding</th></tr></thead>
        <tbody>
          @foreach (var m in _view.Milestones)
          {
            <tr>
              <td>@(m.Milestone.Kind == FeeMilestoneKinds.Advance ? "Advance" : "Balance")</td>
              <td class="num">@m.Milestone.Amount.ToString("N2")</td>
              <td><StatusChip Status="@m.Milestone.State" /></td>
              <td>
                @if (m.Milestone.InvoiceId is { } invoiceId)
                {
                  <a href="/app/practice/invoices/@invoiceId">@m.InvoiceNumber</a> <span class="muted">(@m.InvoiceStatus)</span>
                }
                else { <span class="muted">Not invoiced</span> }
              </td>
              <td class="num">@m.Allocated.ToString("N2")</td>
              <td class="num">@m.Outstanding.ToString("N2")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    @if (advance.Milestone.InvoiceId is null)
    {
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="IssueAdvanceAsync" Disabled="@_busy">Issue advance invoice</MudButton>
      <span class="muted">Requires a finance identity; the draft then follows invoice review and posting.</span>
    }
    else if (advance.Milestone.State != FeeMilestoneStates.Paid)
    {
      @if (advance.InvoiceStatus is BillingStates.InvoicePosted or BillingStates.InvoiceSent)
      {
        <fieldset class="audit-quote-form">
          <legend>Record advance payment (manual)</legend>
          <MudNumericField T="decimal" Label="Amount received" @bind-Value="_amount" Min="0" Format="N2" Margin="Margin.Dense" />
          <MudTextField T="string" Label="Bank or transfer reference" @bind-Value="_reference" MaxLength="120" Margin="Margin.Dense" />
          <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="RecordPaymentAsync" Disabled="@_busy">Record advance payment</MudButton>
          <p class="muted">A fully paid advance produces one official receipt and queues one email. A repeated reference records nothing twice.</p>
        </fieldset>
      }
      else
      {
        <p class="muted" role="status">The advance invoice is <strong>@advance.InvoiceStatus</strong>. It must be approved and posted before a payment is recorded.</p>
      }
    }
    else
    {
      <p class="success-text" role="status">Advance paid @(advance.Milestone.PaidAt?.ToString("yyyy-MM-dd") ?? string.Empty). Official receipt generated.</p>
    }

    <h3 class="mt-4">Final balance</h3>
    @if (_view.Agreement.EngagementId is null)
    {
      <p class="muted">Link the accepted engagement so the final release can trigger the balance invoice.</p>
      @if (_engagements.Count > 0)
      {
        <MudSelect T="Guid?" Label="Engagement" @bind-Value="_engagementId" Margin="Margin.Dense">
          @foreach (var e in _engagements)
          {
            <MudSelectItem T="Guid?" Value="@((Guid?)e.Id)">@e.ServiceRoute · @e.PeriodStart to @e.PeriodEnd</MudSelectItem>
          }
        </MudSelect>
        <MudButton Variant="Variant.Outlined" OnClick="LinkEngagementAsync" Disabled="@(_busy || _engagementId is null)">Link engagement</MudButton>
      }
      else { <p class="muted">No engagement exists for this client yet; activate the engagement through acceptance first.</p> }
    }
    else if (balance.Milestone.InvoiceId is not null)
    {
      <p class="success-text" role="status">Balance invoice issued.</p>
    }
    else if (_view.ReleaseRecorded && advance.Milestone.State == FeeMilestoneStates.Paid)
    {
      <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="notice my-2" role="status">
        <strong>The final report has been delivered and signed off.</strong> Issue the remaining balance of @balance.Milestone.Amount.ToString("N2") @_view.Agreement.Currency.
      </MudAlert>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="IssueBalanceAsync" Disabled="@_busy">Issue balance invoice</MudButton>
    }
    else
    {
      <p class="muted">The balance is invoiced after the advance is paid and the final report is released.</p>
    }
  }

  @if (_message is not null)
  {
    <p class="command-result @(_isError ? "error-text" : "success-text")" role="status">@_message</p>
  }
</MudPaper>

@code {
  [Parameter, EditorRequired] public Proposal Proposal { get; set; } = default!;
  [Parameter] public EventCallback<string> OnChanged { get; set; }

  private FeeAgreementView? _view;
  private List<AuditSphereOps.Domain.Engagements.Engagement> _engagements = [];
  private Guid? _engagementId;
  private decimal _amount;
  private string _reference = string.Empty;
  private bool _loading = true;
  private bool _busy;
  private bool _isError;
  private string? _message;
  private long _generation;

  protected override async Task OnParametersSetAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    var generation = ++_generation;
    _loading = true;
    _view = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null || Proposal.PracticeClientId is null) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var view = await FeeAgreementService.GetForProposalAsync(db, actor, Proposal.Id);
      if (generation != _generation) return;
      _view = view.Succeeded ? view.Value : null;
      if (_view is not null)
      {
        var outstanding = _view.Milestones.Single(x => x.Milestone.Kind == FeeMilestoneKinds.Advance).Outstanding;
        if (_amount <= 0 || _amount > outstanding) _amount = outstanding;
        if (_view.Agreement.EngagementId is null)
          _engagements = await db.Engagements.AsNoTracking()
            .Where(x => x.FirmId == actor.FirmId && x.PracticeClientId == _view.Agreement.PracticeClientId)
            .OrderByDescending(x => x.CreatedAt).ToListAsync();
      }
    }
    catch (Exception)
    {
      if (generation == _generation) { _isError = true; _message = "The fee agreement could not be loaded. Retry by refreshing the page."; }
    }
    finally
    {
      if (generation == _generation) _loading = false;
    }
  }

  private Task CreateAgreementAsync() => RunAsync(async (db, actor) =>
  {
    var result = await FeeAgreementService.CreateAgreementAsync(db, actor, Proposal.Id);
    return (result.Succeeded, result.Succeeded ? "Fee agreement created." : result.Message);
  });

  private Task IssueAdvanceAsync() => RunAsync(async (db, actor) =>
  {
    var result = await FeeAgreementService.IssueAdvanceInvoiceAsync(db, actor, _view!.Agreement.Id);
    return (result.Succeeded, result.Succeeded ? "Advance invoice drafted. Review, approve and post it in firm finance." : result.Message);
  });

  private Task RecordPaymentAsync() => RunAsync(async (db, actor) =>
  {
    var result = await FeeAgreementService.RecordAdvancePaymentAsync(db, actor, _view!.Agreement.Id, _amount, _reference);
    if (result.Succeeded) _reference = string.Empty;
    return (result.Succeeded, result.Succeeded ? result.Value!.Message : result.Message);
  });

  private Task LinkEngagementAsync() => RunAsync(async (db, actor) =>
  {
    var result = await FeeAgreementService.LinkEngagementAsync(db, actor, _view!.Agreement.Id, _engagementId!.Value);
    return (result.Succeeded, result.Succeeded ? "Engagement linked." : result.Message);
  });

  private Task IssueBalanceAsync() => RunAsync(async (db, actor) =>
  {
    var result = await FeeAgreementService.IssueBalanceInvoiceAsync(db, actor, _view!.Agreement.Id);
    return (result.Succeeded, result.Succeeded ? "Balance invoice drafted. Review, approve and post it in firm finance." : result.Message);
  });

  private async Task RunAsync(Func<AuditSphereDbContext, ActorContext, Task<(bool Ok, string? Message)>> action)
  {
    if (_busy) return;
    _busy = true;
    _message = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _isError = true; _message = "Sign in again."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var (ok, message) = await action(db, actor);
      _isError = !ok;
      _message = message;
      await LoadAsync();
      if (ok) await OnChanged.InvokeAsync(message ?? "Saved.");
    }
    finally { _busy = false; }
  }
}
