@* Calculated quotation for a proposal: approved rate cards × hours → complexity → risk premium → discount, versioned,
   approved per the configurable matrix, then branded Quotation and Engagement Letter documents. Every command is an
   Application service that authorizes and enforces the rules; this component only edits inputs and shows outcomes. *@
@using AuditSphereOps.Application.Practice
@using AuditSphereOps.Domain.Practice
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" role="region" aria-labelledby="quotation-heading">
  <h2 id="quotation-heading">Calculated quotation</h2>
  @if (_loading)
  {
    <LoadingState IsLoading="true" LoadingMessage="Loading quotation…" />
  }
  else if (_error is not null && _views is null)
  {
    <p class="error-text" role="alert">@_error</p>
  }
  else
  {
    @if (Editable)
    {
      <p class="scope-note">Hours are priced at the latest <strong>approved</strong> rate for each role and activity. A role without an approved rate cannot be quoted.</p>
      @if (_options.Count == 0)
      {
        <p class="muted" role="status">No approved rate cards exist in @Proposal.Currency. Approve rate cards in practice time before quoting.</p>
      }
      else
      {
        <fieldset class="audit-quote-form">
          <legend>Hours</legend>
          @for (var index = 0; index < _lines.Count; index++)
          {
            var line = _lines[index];
            var position = index;
            <div class="audit-quote-line">
              <MudSelect T="string" Label="Role and activity" @bind-Value="line.Key" Dense="true" Class="audit-quote-role">
                @foreach (var option in _options)
                {
                  <MudSelectItem T="string" Value="@Key(option)">@option.Role · @option.Activity (@option.RatePerHour.ToString("N2")/h)</MudSelectItem>
                }
              </MudSelect>
              <MudNumericField T="decimal" Label="Hours" @bind-Value="line.Hours" Min="0" Step="0.5m" Format="0.##" Margin="Margin.Dense" Class="audit-quote-hours" />
              <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@($"Remove line {position + 1}")" Size="Size.Small"
                             OnClick="() => RemoveLine(position)" Disabled="@(_lines.Count == 1 || _busy)" />
            </div>
          }
          <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="AddLine" Disabled="@_busy">Add line</MudButton>
          <div class="audit-quote-factors">
            <MudNumericField T="decimal" Label="Complexity factor (0.5–3)" @bind-Value="_complexity" Min="0.5m" Max="3m" Step="0.05m" Format="0.####" Margin="Margin.Dense" />
            <MudNumericField T="decimal" Label="Risk premium %" @bind-Value="_risk" Min="0" Max="100" Step="0.5m" Format="0.##" Margin="Margin.Dense" />
            <MudNumericField T="decimal" Label="Discount %" @bind-Value="_discount" Min="0" Max="100" Step="0.5m" Format="0.##" Margin="Margin.Dense" />
          </div>
          <label class="audit-inline-check">
            <MudCheckBox T="bool" @bind-Value="_nonStandard" Disabled="@_busy" data-optional="true" />
            Non-standard contractual terms
          </label>
          @if (_nonStandard)
          {
            <MudTextField T="string" Label="Describe the non-standard terms" @bind-Value="_note" Lines="2" MaxLength="2000" Required="true" />
          }
          @* Recomputed on every render so the preview always reflects the current inputs (same calculator as the server). *@
          @{ Recalculate(); }
          @if (_preview is not null)
          {
            <div class="audit-quote-preview" role="status" aria-label="Fee preview">
              <strong>Preview: @_preview.Fee.ToString("N2") @Proposal.Currency</strong>
              <span>Hours × rate @_preview.BaseAmount.ToString("N2") · complexity @Signed(_preview.ComplexityAmount) · risk premium @Signed(_preview.RiskPremiumAmount) · discount @Signed(-_preview.DiscountAmount)</span>
            </div>
          }
          else if (_previewError is not null)
          {
            <p class="muted" role="status">@_previewError</p>
          }
          <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(_busy || _preview is null)">Calculate and save as new version</MudButton>
        </fieldset>
      }
    }
    else
    {
      <p class="muted">This proposal is no longer a draft, so its quotation is read-only. Revise the proposal to reprice.</p>
    }

    @if (_message is not null)
    {
      <p class="command-result @(_error is null ? "success-text" : "error-text")" role="status">@(_error ?? _message)</p>
    }

    @if (_views is { Count: 0 })
    {
      <p class="muted">No quotation has been calculated for this proposal yet.</p>
    }
    else if (_views is not null)
    {
      <h3>Quotation versions</h3>
      @foreach (var view in _views)
      {
        <section class="audit-quote-version" aria-label="@($"Quotation revision {view.Version.Revision}")">
          <header>
            <strong>Revision @view.Version.Revision</strong>
            <StatusChip Status="@view.Version.Status" />
            <span class="audit-quote-fee">@view.Version.Fee.ToString("N2") @view.Version.Currency</span>
          </header>
          <div class="table-wrap">
            <table>
              <caption class="sr-only">Fee breakdown for revision @view.Version.Revision</caption>
              <thead><tr><th scope="col">Role</th><th scope="col">Activity</th><th scope="col" class="num">Hours</th><th scope="col" class="num">Rate / hour</th><th scope="col" class="num">Amount</th></tr></thead>
              <tbody>
                @foreach (var l in view.Lines)
                {
                  <tr><td>@l.Role</td><td>@l.Activity</td><td class="num">@l.Hours.ToString("0.##")</td><td class="num">@l.RatePerHour.ToString("N2")</td><td class="num">@l.Amount.ToString("N2")</td></tr>
                }
              </tbody>
              <tfoot>
                <tr><td colspan="4">Hours × rate</td><td class="num">@view.Version.BaseAmount.ToString("N2")</td></tr>
                <tr><td colspan="4">Complexity factor × @view.Version.ComplexityFactor.ToString("0.####")</td><td class="num">@Signed(view.Version.ComplexityAmount)</td></tr>
                <tr><td colspan="4">Risk premium @view.Version.RiskPremiumPercent.ToString("0.##")%</td><td class="num">@Signed(view.Version.RiskPremiumAmount)</td></tr>
                <tr><td colspan="4">Discount @view.Version.DiscountPercent.ToString("0.##")%</td><td class="num">@Signed(-view.Version.DiscountAmount)</td></tr>
                <tr class="total-row"><td colspan="4">Total fee</td><td class="num">@view.Version.Fee.ToString("N2") @view.Version.Currency</td></tr>
              </tfoot>
            </table>
          </div>
          @if (view.Version.NonStandardTerms)
          {
            <p><strong>Non-standard terms:</strong> @view.Version.NonStandardTermsNote</p>
          }
          @if (view.RequiredApprovals.Count > 0)
          {
            <h4>Required approvals</h4>
            <ul class="audit-quote-approvals">
              @foreach (var required in view.RequiredApprovals)
              {
                var done = view.Approvals.FirstOrDefault(a => a.RuleKey == required.RuleKey);
                <li>
                  <span><strong>@required.Role</strong> — @required.Reason</span>
                  @if (done is not null)
                  {
                    <span class="success-text">Approved by @Name(done.ApprovedByUserId) on @done.ApprovedAt.ToString("yyyy-MM-dd HH:mm") UTC: @done.Reason</span>
                  }
                  else if (view.Version.Status == QuotationStates.PendingApproval)
                  {
                    <MudTextField T="string" Label="@($"Reason for {required.Role} approval")" Margin="Margin.Dense" Class="audit-quote-reason"
                                  Value="@ReasonFor(required.RuleKey)" ValueChanged="(string v) => SetReason(required.RuleKey, v)" MaxLength="1000" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@_busy"
                               OnClick="() => ApproveAsync(view.Version.Id, required)">Approve as @required.Role</MudButton>
                  }
                  else { <span class="muted">Awaiting submission.</span> }
                </li>
              }
            </ul>
          }
          @if (view.Version.Status == QuotationStates.Draft)
          {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => SubmitAsync(view.Version.Id)" Disabled="@_busy">
              @(view.RequiredApprovals.Count == 0 ? "Approve quotation (no approval required)" : "Submit for approval")
            </MudButton>
          }
        </section>
      }
    }

    <h3 class="mt-4">Documents</h3>
    @if (_current is { Status: QuotationStates.Approved } && _current.Fee == Proposal.Fee)
    {
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GenerateAsync" Disabled="@_busy">Generate brief quotation</MudButton>
      <MudButton Variant="Variant.Outlined" OnClick="GenerateLetterAsync" Disabled="@_busy">Generate engagement letter (Partner)</MudButton>
      <MudText Typo="Typo.caption">Engagement letters require recorded client approval and current Partner risk clearance.</MudText>
    }
    else
    {
      <p class="muted">Documents are generated from an approved quotation whose fee matches the proposal.</p>
    }
    <MudText Typo="Typo.h6">Comprehensive five-chapter proposal</MudText>
    <MudText Typo="Typo.body2">Uses the reviewed chapters in Commercial settings. Enter CVs for the actual assigned team and the delivery timeline. One immutable proposal is retained per approved quotation revision; revising it requires a new quotation revision.</MudText>
    <MudTextField T="string" Label="Assigned Partner and team CVs" @bind-Value="_teamCvs" Lines="5" MaxLength="16000" />
    <MudTextField T="string" Label="Deliverables timeline" @bind-Value="_tenderTimeline" Lines="3" MaxLength="8000" />
    <MudCheckBox T="bool" @bind-Value="_tenderReviewed" Label="I reviewed the firm chapters, assigned team and timeline for this client" />
    <MudButton Variant="Variant.Outlined" OnClick="GenerateTenderAsync" Disabled="@(_busy || !_tenderReviewed)">Generate comprehensive proposal</MudButton>
    @if (_documents.Count > 0)
    {
      <ul class="audit-document-list">
        @foreach (var document in _documents)
        {
          <li>
            <a href="@($"/api/commercial/documents/{document.Id:D}/download")" download>@document.FileName</a>
            <span class="muted">@Label(document.Kind) · template @document.TemplateVersion · SHA-256 <code>@document.Sha256Hex[..12]…</code> · @document.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
          </li>
        }
      </ul>
    }
  }
</MudPaper>

@code {
  [Parameter, EditorRequired] public Proposal Proposal { get; set; } = default!;
  [Parameter] public EventCallback<string> OnChanged { get; set; }

  private sealed class LineModel { public string Key { get; set; } = string.Empty; public decimal Hours { get; set; } = 1m; }

  private readonly List<LineModel> _lines = [new()];
  private readonly Dictionary<string, string> _reasons = [];
  private readonly Dictionary<Guid, string> _names = [];
  private IReadOnlyList<QuotationRateOption> _options = [];
  private IReadOnlyList<QuotationView>? _views;
  private IReadOnlyList<CommercialDocument> _documents = [];
  private string _teamCvs = "", _tenderTimeline = "";
  private bool _tenderReviewed;
  private QuotationVersion? _current;
  private QuotationPricingResult? _preview;
  private string? _previewError;
  private decimal _complexity = 1m;
  private decimal _risk;
  private decimal _discount;
  private bool _nonStandard;
  private string? _note;
  private bool _loading = true;
  private bool _busy;
  private string? _message;
  private string? _error;
  private long _generation;

  private bool Editable => Proposal.Status == CrmStates.ProposalDraft;

  protected override async Task OnParametersSetAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    var generation = ++_generation;
    _loading = true;
    _views = null;
    _current = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _error = "Sign in with a commercial identity."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var options = await QuotationService.ListRateOptionsAsync(db, actor, Proposal.Currency);
      var views = await QuotationService.ListAsync(db, actor, Proposal.Id);
      var documents = await CommercialDocumentService.ListAsync(db, actor, Proposal.Id);
      if (generation != _generation) return;
      if (!views.Succeeded || !options.Succeeded || !documents.Succeeded)
      {
        _error = "Commercial quotation details are not available to this identity.";
        return;
      }
      _options = options.Value!;
      _views = views.Value!;
      _documents = documents.Value!;
      _current = _views.FirstOrDefault(x => x.Version.Status != QuotationStates.Superseded)?.Version;
      var ids = _views.SelectMany(v => v.Approvals.Select(a => a.ApprovedByUserId)).Distinct().ToList();
      var names = await db.Users.AsNoTracking().Where(x => x.FirmId == actor.FirmId && ids.Contains(x.Id)).Select(x => new { x.Id, x.DisplayName }).ToListAsync();
      foreach (var n in names) _names[n.Id] = n.DisplayName;
      if (_lines.All(x => string.IsNullOrEmpty(x.Key)) && _options.Count > 0) _lines[0].Key = Key(_options[0]);
      if (_current is not null && Editable && _lines.Count == 1 && _lines[0].Hours == 1m)
      {
        var last = _views.First().Lines;
        _lines.Clear();
        foreach (var l in last) _lines.Add(new LineModel { Key = $"{l.Role}|{l.Activity}", Hours = l.Hours });
        var v = _views.First().Version;
        _complexity = v.ComplexityFactor; _risk = v.RiskPremiumPercent; _discount = v.DiscountPercent; _nonStandard = v.NonStandardTerms; _note = v.NonStandardTermsNote;
      }
      Recalculate();
    }
    catch (Exception)
    {
      if (generation == _generation) _error = "The quotation could not be loaded. Retry by refreshing the page.";
    }
    finally
    {
      if (generation == _generation) _loading = false;
    }
  }

  private static string Key(QuotationRateOption option) => $"{option.Role}|{option.Activity}";

  private void AddLine() { _lines.Add(new LineModel { Key = _options.Count > 0 ? Key(_options[0]) : string.Empty }); Recalculate(); }

  private void RemoveLine(int index)
  {
    if (_lines.Count > 1) _lines.RemoveAt(index);
    Recalculate();
  }

  // The preview uses the same pure calculator as the server so what is shown is what will be saved.
  private void Recalculate()
  {
    _preview = null;
    _previewError = null;
    var priced = new List<QuotationLineInput>();
    foreach (var line in _lines)
    {
      var option = _options.FirstOrDefault(x => Key(x) == line.Key);
      if (option is null) { _previewError = "Choose a role and activity for every line."; return; }
      priced.Add(new(option.Role, option.Activity, line.Hours, option.RatePerHour, option.RateCardVersionId));
    }
    var input = new QuotationPricingInput(Proposal.Currency, priced, _complexity, _risk, _discount);
    var invalid = QuotationCalculator.Validate(input);
    if (invalid is not null) { _previewError = invalid; return; }
    _preview = QuotationCalculator.Calculate(input);
  }

  private async Task SaveAsync()
  {
    Recalculate();
    await RunAsync(async (db, actor) =>
    {
      var lines = _lines.Select(l => new QuotationHoursLine(l.Key.Split('|')[0], l.Key.Split('|')[1], l.Hours)).ToList();
      var result = await QuotationService.SaveAsync(db, actor, new(Proposal.Id, lines, _complexity, _risk, _discount, _nonStandard, _note));
      return (result.Succeeded, result.Succeeded ? "Quotation calculated and saved as a new version. Submit it for approval." : result.Message);
    });
  }

  private Task SubmitAsync(Guid versionId) => RunAsync(async (db, actor) =>
  {
    var result = await QuotationService.SubmitAsync(db, actor, versionId);
    return (result.Succeeded, result.Succeeded ? "Quotation submitted." : result.Message);
  });

  private Task ApproveAsync(Guid versionId, RequiredApproval required) => RunAsync(async (db, actor) =>
  {
    var result = await QuotationService.ApproveAsync(db, actor, versionId, required.RuleKey, ReasonFor(required.RuleKey));
    return (result.Succeeded, result.Succeeded ? $"Approval recorded for the {required.Role} rule." : result.Message);
  });

  private Task GenerateTenderAsync() => RunAsync(async (db, actor) =>
  {
    var result = await CommercialDocumentService.GenerateTenderAsync(db, actor, Proposal.Id, _teamCvs, _tenderTimeline, _tenderReviewed);
    return (result.Succeeded, result.Succeeded ? "Comprehensive proposal generated from reviewed content." : result.Message);
  });

  private Task GenerateLetterAsync() => RunAsync(async (db, actor) =>
  {
    var result = await CommercialDocumentService.GenerateEngagementLetterAsync(db, actor, Proposal.Id);
    return (result.Succeeded, result.Succeeded ? "Engagement letter generated with both approval keys recorded." : result.Message!);
  });

  private Task GenerateAsync() => RunAsync(async (db, actor) =>
  {
    var result = await CommercialDocumentService.GenerateBriefQuotationAsync(db, actor, Proposal.Id);
    return (result.Succeeded, result.Succeeded ? "Brief quotation generated." : result.Message);
  });

  private async Task RunAsync(Func<AuditSphereDbContext, ActorContext, Task<(bool Ok, string? Message)>> action)
  {
    if (_busy) return;
    _busy = true;
    _message = null;
    _error = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _error = "Sign in again."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var (ok, message) = await action(db, actor);
      _message = message;
      if (!ok) _error = message; // an outcome is never shown as success unless the command confirmed it
      await LoadAsync();
      if (ok) await OnChanged.InvokeAsync(message ?? "Saved.");
    }
    finally { _busy = false; }
  }

  private string ReasonFor(string key) => _reasons.GetValueOrDefault(key, string.Empty);
  private void SetReason(string key, string value) => _reasons[key] = value;
  private string Name(Guid id) => _names.GetValueOrDefault(id, "Approver");
  private static string Signed(decimal amount) => (amount < 0 ? "−" : amount > 0 ? "+" : "") + Math.Abs(amount).ToString("N2");
  private static string Label(string kind) => kind switch
  {
    CommercialDocumentKinds.Quotation => "Quotation",
    CommercialDocumentKinds.ComprehensiveProposal => "Comprehensive proposal",
    CommercialDocumentKinds.EngagementLetter => "Engagement letter",
    CommercialDocumentKinds.PaymentReceipt => "Payment receipt",
    _ => kind
  };
}
