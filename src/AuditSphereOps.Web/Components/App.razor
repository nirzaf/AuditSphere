<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="/" />
  <link rel="stylesheet" href="app.css" />
  <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
  <link href="enterprise-ui.css" rel="stylesheet" />
  <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
  <Routes @rendermode="InteractiveServer" />
  @* Custom Blazor reconnection UI: blazor.web.js toggles the components-reconnect-* classes on this element. *@
  <div id="components-reconnect-modal" class="audit-reconnect" role="alert" aria-live="assertive" data-nosnippet>
    <div class="audit-reconnect-panel">
      <p class="audit-reconnect-state audit-reconnect-retrying"><strong>Connection lost — reconnecting…</strong></p>
      <p class="audit-reconnect-state audit-reconnect-failed"><strong>Could not reconnect to AuditSphere.</strong></p>
      <p class="audit-reconnect-state audit-reconnect-rejected"><strong>This session has ended.</strong> Reload to sign in again.</p>
      <p class="audit-reconnect-note">An action you started before the connection dropped is not confirmed until its result is shown after reconnecting. Check the record before repeating it.</p>
      <button type="button" class="audit-reconnect-action" data-reconnect-action>Retry</button>
    </div>
  </div>
  <script src="pbc-upload.js"></script>
  <script src="_framework/blazor.web.js"></script>
  <script src="_content/MudBlazor/MudBlazor.min.js"></script>
  <script src="draft-state.js"></script>
  <script src="reconnect-state.js"></script>
  <script src="search-shortcut.js"></script>
</body>
</html>
