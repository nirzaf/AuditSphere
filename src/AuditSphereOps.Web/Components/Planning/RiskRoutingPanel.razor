@* Green/amber/red routing. The colour is computed from the recorded likelihood, magnitude, fraud flag and the risk's own
   significance decision; the professional judgment stays with the people it routes to. *@
@using AuditSphereOps.Application.Audit
@using AuditSphereOps.Application.Practice
@using AuditSphereOps.Domain.Audit
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" role="region" aria-labelledby="risk-routing-heading">
  <h2 id="risk-routing-heading">Risk routing</h2>
  <p class="scope-note">Green: a Staff Associate may perform. Amber: Senior Auditor or above performs, Manager reviews. Red (any significant or fraud risk, or likelihood × magnitude ≥ 6): Audit Manager or above performs and the Engagement Partner must review before completion. (@RiskBandRules.RuleVersion)</p>
  @if (_rows.Count == 0)
  {
    <p class="muted">No risks are recorded yet.</p>
  }
  @foreach (var row in _rows)
  {
    <div class="risk-route-card risk-band-@(row.Band?.ToLowerInvariant() ?? "none")" data-risk="@row.Area">
      <p><strong>@row.Area</strong> — @row.Assertion <span class="risk-band-chip" aria-label="@($"Band {row.Band ?? "not assessed"}")">@(row.Band ?? "NOT ASSESSED")</span>
        @if (row.PartnerReviewRequired) { <span class="@(row.PartnerCleared ? "success-text" : "error-text")">@(row.PartnerCleared ? $"Partner reviewed ({row.PartnerName})" : "Partner review required")</span> }</p>
      <p class="muted">@row.Route @(row.OwnerName is null ? "" : $"Owner: {row.OwnerName} ({row.OwnerLevel}).")</p>
      <div class="audit-inline-form">
        <label>Likelihood <select @bind="Input(row.RiskId).Likelihood"><option value="1">1 Low</option><option value="2">2 Moderate</option><option value="3">3 High</option></select></label>
        <label>Magnitude <select @bind="Input(row.RiskId).Magnitude"><option value="1">1 Low</option><option value="2">2 Moderate</option><option value="3">3 High</option></select></label>
        <label><input type="checkbox" @bind="Input(row.RiskId).Fraud" /> Fraud risk</label>
        <label>Rationale <input @bind="Input(row.RiskId).Rationale" maxlength="500" aria-label="@($"Band rationale for {row.Area}")" /></label>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => AssessAsync(row.RiskId))" Disabled="@_busy" aria-label="@($"Assess band for {row.Area}")">Assess band</MudButton>
      </div>
      @if (row.Band is not null && _canAssign && _team.Count > 0)
      {
        <div class="audit-inline-form">
          <label>Owner <select @bind="Input(row.RiskId).Owner" aria-label="@($"Owner for {row.Area}")"><option value="">Select</option>@foreach (var t in _team) { <option value="@t.UserId">@t.Name (@t.LevelLabel)</option> }</select></label>
          <MudButton Variant="Variant.Text" OnClick="@(() => AssignAsync(row.RiskId))" Disabled="@_busy" aria-label="@($"Assign owner for {row.Area}")">Assign owner</MudButton>
        </div>
      }
      @if (row.PartnerReviewRequired && !row.PartnerCleared && _isPartner)
      {
        <div class="audit-inline-form">
          <label>Partner review note <input @bind="Input(row.RiskId).Note" maxlength="1000" aria-label="@($"Partner review note for {row.Area}")" /></label>
          <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ClearAsync(row.RiskId))" Disabled="@_busy" aria-label="@($"Record Partner review for {row.Area}")">Record Partner review</MudButton>
        </div>
      }
    </div>
  }
  @if (_message is not null) { <p class="command-result @(_error ? "error-text" : "success-text")" role="status">@_message</p> }
</MudPaper>

@code {
  [Parameter, EditorRequired] public Guid EngagementId { get; set; }
  [Parameter] public int Version { get; set; }
  private List<RiskRoutingRow> _rows = [];
  private List<StaffAssignmentRow> _team = [];
  private readonly Dictionary<Guid, RowInput> _inputs = [];
  private bool _busy, _error, _canAssign, _isPartner;
  private string? _message;

  private sealed class RowInput
  {
    public int Likelihood { get; set; } = 1;
    public int Magnitude { get; set; } = 1;
    public bool Fraud { get; set; }
    public string Rationale { get; set; } = string.Empty;
    public string Owner { get; set; } = string.Empty;
    public string Note { get; set; } = string.Empty;
  }

  private RowInput Input(Guid riskId) => _inputs.TryGetValue(riskId, out var input) ? input : _inputs[riskId] = new RowInput();

  protected override Task OnParametersSetAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) return;
    _canAssign = actor.Roles.Any(x => x is "Partner" or "Manager" or "Administrator");
    _isPartner = actor.Roles.Contains("Partner");
    await using var db = await DbFactory.CreateDbContextAsync();
    var rows = await RiskBandService.GetRoutingAsync(db, actor, EngagementId);
    _rows = rows.Succeeded ? rows.Value!.ToList() : [];
    var team = await StaffingService.ListAsync(db, actor, EngagementId);
    _team = team.Succeeded ? team.Value!.ToList() : [];
    foreach (var row in _rows.Where(r => r.Likelihood is not null))
    {
      var input = Input(row.RiskId);
      input.Likelihood = row.Likelihood!.Value; input.Magnitude = row.Magnitude!.Value; input.Fraud = row.FraudRisk;
    }
  }

  private async Task RunAsync(Func<AuditSphereDbContext, ActorContext, Task<CommandResult<Guid>>> command, string success)
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await command(db, actor);
      (_error, _message) = result.Succeeded ? (false, success) : (true, result.Message);
      await LoadAsync();
    }
    finally { _busy = false; }
  }

  private Task AssessAsync(Guid riskId)
  {
    var i = Input(riskId);
    return RunAsync((db, actor) => RiskBandService.AssessAsync(db, actor, new(riskId, i.Likelihood, i.Magnitude, i.Fraud, i.Rationale)), "Band assessed.");
  }

  private Task AssignAsync(Guid riskId) =>
    Guid.TryParse(Input(riskId).Owner, out var owner)
      ? RunAsync((db, actor) => RiskBandService.AssignOwnerAsync(db, actor, riskId, owner), "Owner assigned.")
      : Task.CompletedTask;

  private Task ClearAsync(Guid riskId) =>
    RunAsync((db, actor) => RiskBandService.PartnerClearAsync(db, actor, riskId, Input(riskId).Note), "Partner review recorded.");
}
