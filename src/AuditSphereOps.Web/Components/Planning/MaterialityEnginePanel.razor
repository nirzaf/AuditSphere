@* Automatic three-tier materiality. The benchmark amount comes from the current approved mapping over the sealed trial
   balance; nobody types it. Approval stays with the existing independent approval command. *@
@using AuditSphereOps.Application.Audit
@using AuditSphereOps.Domain.Audit
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" role="region" aria-labelledby="materiality-engine-heading">
  <h2 id="materiality-engine-heading">Materiality calculator</h2>
  @if (_latest is not null)
  {
    var c = _latest.Calculation;
    <p><StatusChip Status="@_latest.State" /> @_latest.Route</p>
    <MudGrid Spacing="2" Class="my-2" aria-label="Materiality thresholds">
      <MudItem xs="12" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Planning materiality (PM)</MudText><MudText Typo="Typo.h5">@c.PlanningMateriality.ToString("N2") @c.Currency</MudText></MudPaper></MudItem>
      <MudItem xs="12" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Tolerable error (TE)</MudText><MudText Typo="Typo.h5">@c.TolerableError.ToString("N2") @c.Currency</MudText></MudPaper></MudItem>
      <MudItem xs="12" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">SAD threshold</MudText><MudText Typo="Typo.h5">@c.SadThreshold.ToString("N2") @c.Currency</MudText></MudPaper></MudItem>
    </MudGrid>
    <p class="muted">@c.BenchmarkKind@(c.DestinationCode is null ? "" : $" ({c.DestinationCode})") of @c.BenchmarkAmount.ToString("N2") @c.Currency from @c.SourceLineCount mapped line(s), mapping version @c.MappingVersionNumber; rate @c.RatePercent%, TE @c.PerformancePercent% of PM, SAD @c.TrivialPercent% of PM (@c.PolicyVersion).</p>
    @if (_latest.State == MaterialityCalculationStates.Draft)
    {
      <MudButton Variant="Variant.Outlined" OnClick="ApproveAsync" Disabled="@_busy">Approve calculated materiality</MudButton>
    }
  }
  @if (_source is null)
  {
    <p class="muted">@(_sourceMessage ?? "Loading the mapped trial balance…")</p>
  }
  else
  {
    <p class="scope-note">Source: mapping version @_source.MappingVersion over trial balance <code>@_source.DatasetDigest[..12]</code> (@_source.Currency).</p>
    <div class="audit-inline-form">
      <label for="matcalc-benchmark">Benchmark
        <select id="matcalc-benchmark" @bind="_optionKey">
          @foreach (var o in _source.Options.Where(o => o.Amount is not null))
          {
            <option value="@Key(o)">@o.Label — @o.Amount!.Value.ToString("N2")</option>
          }
        </select></label>
      <label for="matcalc-rate">Rate % <input id="matcalc-rate" type="number" step="0.1" @bind="_rate" /></label>
      <label for="matcalc-te">TE % of PM <input id="matcalc-te" type="number" step="1" @bind="_performance" /></label>
      <label for="matcalc-sad">SAD % of PM <input id="matcalc-sad" type="number" step="0.5" @bind="_trivial" /></label>
    </div>
    @if (SelectedRange is { } range)
    {
      <p class="muted">Policy range for this benchmark: @range.MinRatePercent%–@range.MaxRatePercent%; TE @MaterialityCalculator.PerformanceRange.Min–@MaterialityCalculator.PerformanceRange.Max%; SAD @MaterialityCalculator.TrivialRange.Min–@MaterialityCalculator.TrivialRange.Max%.</p>
    }
    <label for="matcalc-rationale" class="d-block">Rationale for the benchmark <textarea id="matcalc-rationale" @bind="_rationale" maxlength="2000" rows="2"></textarea></label>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CalculateAsync" Disabled="@(_busy || string.IsNullOrEmpty(_optionKey))">Calculate materiality</MudButton>
  }
  @if (_message is not null) { <p class="command-result @(_error ? "error-text" : "success-text")" role="status">@_message</p> }
</MudPaper>

@code {
  [Parameter, EditorRequired] public Guid EngagementId { get; set; }
  [Parameter] public EventCallback<string> OnChanged { get; set; }
  private MaterialitySourceView? _source;
  private MaterialityCalculationView? _latest;
  private string? _sourceMessage, _message;
  private string _optionKey = string.Empty, _rationale = string.Empty;
  private decimal _rate = 1m, _performance = 75m, _trivial = 5m;
  private bool _busy, _error;

  private static string Key(MaterialityBenchmarkOption o) => o.Kind + "|" + (o.DestinationCode ?? string.Empty);
  private MaterialityPolicyRange? SelectedRange => string.IsNullOrEmpty(_optionKey) ? null : MaterialityCalculator.RateRanges.GetValueOrDefault(_optionKey.Split('|')[0]);

  protected override Task OnParametersSetAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    var source = await MaterialityEngineService.GetSourceAsync(db, actor, EngagementId);
    _source = source.Succeeded ? source.Value : null;
    _sourceMessage = source.Succeeded ? null : source.Message;
    if (_source is not null && string.IsNullOrEmpty(_optionKey))
      _optionKey = _source.Options.Where(o => o.Amount is > 0).Select(Key).FirstOrDefault() ?? string.Empty;
    _latest = await MaterialityEngineService.GetLatestAsync(db, actor.FirmId, EngagementId);
  }

  private async Task CalculateAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) return;
    var parts = _optionKey.Split('|');
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await MaterialityEngineService.CalculateAsync(db, actor, new(EngagementId, parts[0], parts[1].Length == 0 ? null : parts[1],
        _rate, _performance, _trivial, _rationale));
      (_error, _message) = result.Succeeded ? (false, "Materiality calculated; an independent Manager or Partner must approve it.") : (true, result.Message);
      await LoadAsync();
      if (result.Succeeded) await OnChanged.InvokeAsync(_message);
    }
    finally { _busy = false; }
  }

  private async Task ApproveAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null || _latest is null) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await AuditPlanningService.ApproveMaterialityAssessmentAsync(db, actor, _latest.AssessmentId);
      (_error, _message) = result.Succeeded ? (false, "Materiality approved.") : (true, result.Message);
      await LoadAsync();
      if (result.Succeeded) await OnChanged.InvokeAsync(_message);
    }
    finally { _busy = false; }
  }
}
