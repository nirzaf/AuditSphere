@* Four-level engagement staffing. Each level grants exactly one engagement-scoped role; the Application service
   enforces certification, rank and the single-partner rule and explains any refusal. *@
@using AuditSphereOps.Application.Practice
@using AuditSphereOps.Domain.Practice
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" role="region" aria-labelledby="staffing-heading">
  <h2 id="staffing-heading">Engagement team</h2>
  <p class="scope-note">Engagement Partner → Audit Manager → Senior Auditor → Staff Associate. Each level grants the matching role on this engagement only (Partner, Manager, Senior, Staff); revoking it removes that access immediately.</p>
  <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">When dedicated client-site provisioning is enabled, this assignment also authorizes Full Control over the entire client SharePoint site, including other engagements, sharing and deletion. AuditSphere access remains engagement scoped. Removing this assignment schedules SharePoint removal only when no other active assignment remains for that client.</MudAlert>
  @if (_rows.Count == 0)
  {
    <p class="muted">Nobody is staffed on this engagement yet.</p>
  }
  else
  {
    <MudTable Items="_rows" Dense="true" Elevation="0" aria-label="Engagement team">
      <HeaderContent><MudTh>Name</MudTh><MudTh>Level</MudTh><MudTh>Engagement role</MudTh><MudTh>Certification</MudTh><MudTh><span class="sr-only">Action</span></MudTh></HeaderContent>
      <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Level">@context.LevelLabel</MudTd>
        <MudTd DataLabel="Engagement role"><code>@context.AuthorizationRole</code></MudTd>
        <MudTd DataLabel="Certification">@(context.Certified ? "Current" : "None on file")</MudTd>
        <MudTd DataLabel="Action"><MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RevokeAsync(context.AssignmentId))" Disabled="@_busy" aria-label="@($"Revoke {context.Name}")">Revoke</MudButton></MudTd>
      </RowTemplate>
    </MudTable>
  }
  @if (_canStaff)
  {
    <div class="audit-inline-form">
      <label for="staff-user">Person
        <select id="staff-user" @bind="_userId">
          <option value="">Select a staff member</option>
          @foreach (var c in _candidates) { <option value="@c.UserId">@c.Name@(c.Department is null ? "" : $" — {c.Department}")@(c.Certified ? " (certified)" : "")</option> }
        </select></label>
      <label for="staff-level">Level
        <select id="staff-level" @bind="_level">
          @foreach (var level in StaffingLevels.All) { <option value="@level">@StaffingLevels.Label(level)</option> }
        </select></label>
      <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AssignAsync" Disabled="@(_busy || string.IsNullOrEmpty(_userId))">Add to team</MudButton>
    </div>
  }
  @if (_message is not null) { <p class="command-result @(_error ? "error-text" : "success-text")" role="status">@_message</p> }
</MudPaper>

@code {
  [Parameter, EditorRequired] public Guid EngagementId { get; set; }
  private List<StaffAssignmentRow> _rows = [];
  private IReadOnlyList<StaffCandidate> _candidates = [];
  private string _userId = string.Empty, _level = StaffingLevels.StaffAssociate;
  private bool _busy, _error, _canStaff;
  private string? _message;

  protected override Task OnParametersSetAsync() => LoadAsync();

  private async Task LoadAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    var rows = await StaffingService.ListAsync(db, actor, EngagementId);
    _rows = rows.Succeeded ? rows.Value!.ToList() : [];
    _canStaff = actor.Roles.Any(x => x is "Partner" or "Manager" or "Administrator");
    _candidates = _canStaff ? (await StaffingService.CandidatesAsync(db, actor)).Where(c => _rows.All(r => r.UserId != c.UserId)).ToList() : [];
  }

  private async Task AssignAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null || !Guid.TryParse(_userId, out var userId)) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await StaffingService.AssignAsync(db, actor, new(EngagementId, userId, _level));
      (_error, _message) = result.Succeeded ? (false, $"Added as {StaffingLevels.Label(_level)}.") : (true, result.Message);
      _userId = string.Empty;
      await LoadAsync();
    }
    finally { _busy = false; }
  }

  private async Task RevokeAsync(Guid assignmentId)
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is null) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await StaffingService.RevokeAsync(db, actor, assignmentId);
      (_error, _message) = result.Succeeded ? (false, "Removed from the team; the engagement role was revoked.") : (true, result.Message);
      await LoadAsync();
    }
    finally { _busy = false; }
  }
}
