@page "/portal"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Accounting
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Client portal</PageTitle>
<PageHeader Title="Client portal" Description="Restricted client workspace. This view contains assigned PBC requests and transfer receipts only. Internal risk, review and workpaper content is not exposed." />
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button-secondary" OnClick="LoadPortalAsync" Disabled="@_loading">Refresh portal</MudButton>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading assigned requests…" />
}
else if (_actor is null || !_clientIds.Any())
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Portal unavailable</h2>
    <MudText Typo="Typo.body2">An authenticated client identity with an active assigned engagement is required.</MudText>
  </MudAlert>
}
else
{
  <p class="scope-note">This restricted view contains assigned PBC requests and transfer receipts only. Internal risk, review and workpaper content is not exposed.</p>
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="client-pbc-heading" role="region">
    <h2 id="client-pbc-heading">Requests</h2>
    @if (_requests.Count == 0)
    {
      <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">No requests are assigned to this client identity.</MudText>
    }
    else
    {
      <MudTable Items="_requests" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
          <MudTh>Area</MudTh>
          <MudTh>Period</MudTh>
          <MudTh>Due</MudTh>
          <MudTh>State</MudTh>
          <MudTh><span class="sr-only">Action</span></MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Area">@context.Area</MudTd>
          <MudTd DataLabel="Period">@context.PeriodStart to @context.PeriodEnd</MudTd>
          <MudTd DataLabel="Due">@context.DueDate</MudTd>
          <MudTd DataLabel="State"><StatusChip Status="@context.State" /></MudTd>
          <MudTd DataLabel="Action"><MudLink Href="@($"/portal/requests/{context.Id}")">Open</MudLink></MudTd>
        </RowTemplate>
        <PagerContent>
          <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
      </MudTable>
    }
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="client-packages-heading" role="region">
    <h2 id="client-packages-heading">Financial packages for management review</h2>
    <p class="scope-note">These are validated packages explicitly shared with this client identity. This view does not expose internal audit workpapers or review decisions.</p>
    @if (_packages.Count == 0)
    {
      <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">No validated financial packages are available for this identity.</MudText>
    }
    else
    {
      <MudTable Items="_packages" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
          <MudTh>Framework</MudTh>
          <MudTh>Period</MudTh>
          <MudTh>Currency</MudTh>
          <MudTh><span class="sr-only">Action</span></MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Framework">@context.Framework</MudTd>
          <MudTd DataLabel="Period">@context.PeriodStart to @context.PeriodEnd</MudTd>
          <MudTd DataLabel="Currency"><code>@context.Currency</code></MudTd>
          <MudTd DataLabel="Action"><MudLink Href="@($"/portal/accounting/packages/{context.Id}")">Open package</MudLink></MudTd>
        </RowTemplate>
        <PagerContent>
          <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
      </MudTable>
    }
  </MudPaper>
}

@code {
  private ActorContext? _actor;
  private List<Guid> _clientIds = [];
  private List<PbcRequest> _requests = [];
  private List<ClientPackageRow> _packages = [];
  private bool _loading = true;
  private long _loadGeneration;

  protected override Task OnInitializedAsync() => LoadPortalAsync();

  private async Task LoadPortalAsync()
  {
    var generation = ++_loadGeneration;
    _loading = true;
    _actor = null;
    _clientIds = [];
    _requests = [];
    _packages = [];
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null || generation != _loadGeneration)
        return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var grants = db.RoleGrants.AsNoTracking().Where(x =>
        x.FirmId == actor.FirmId && x.UserId == actor.UserId && x.Role == "ClientUser" &&
        x.ClientId.HasValue && x.RevokedAt == null);
      var grantScopes = await grants.Select(x => new { x.ClientId, x.EngagementId }).ToListAsync();
      var clientIds = grantScopes.Select(x => x.ClientId!.Value).Distinct().ToList();
      var requests = new List<PbcRequest>();
      var packageRows = new List<ClientPackageRow>();
      if (clientIds.Count > 0)
      {
        requests = await db.PbcRequests.AsNoTracking().Where(x =>
          x.FirmId == actor.FirmId && x.ClientOwnerUserId == actor.UserId &&
          grants.Any(g => g.ClientId == x.ClientId &&
            (!g.EngagementId.HasValue || g.EngagementId == x.EngagementId)))
          .OrderBy(x => x.DueDate).ThenBy(x => x.Area).ToListAsync();
        var packages = await db.FinancialPackages.AsNoTracking().Where(x =>
          x.FirmId == actor.FirmId && x.Status == AccountingPackageStates.PackageValidated &&
          grants.Any(g => g.ClientId == x.ClientId &&
            (!g.EngagementId.HasValue || g.EngagementId == x.EngagementId)))
          .OrderByDescending(x => x.CreatedAt).Take(100).ToListAsync();
        packageRows = packages.Select(package => new ClientPackageRow(package.Id, package.Framework, package.PeriodStart,
            package.PeriodEnd, package.Currency))
          .ToList();
      }
      if (generation != _loadGeneration)
        return;
      var currentActor = await ActorResolver.ResolveAsync();
      if (currentActor is null || currentActor.UserId != actor.UserId ||
          currentActor.FirmId != actor.FirmId || currentActor.SessionEpoch != actor.SessionEpoch ||
          generation != _loadGeneration)
        return;
      _actor = actor;
      _clientIds = clientIds;
      _requests = requests;
      _packages = packageRows;
    }
    finally
    {
      if (generation == _loadGeneration)
        _loading = false;
    }
  }

  private sealed record ClientPackageRow(Guid Id, string Framework, string PeriodStart, string PeriodEnd, string Currency);
}
