@page "/app/assessments/{Id:guid}/decision"
@using Microsoft.AspNetCore.Components.Authorization
@using AuditSphereOps.Application.Acceptance
@using AuditSphereOps.Application.Security
@using AuditSphereOps.Domain.Shared
@using AuditSphereOps.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider Auth
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Partner Decision — AuditSphereOps</PageTitle>

<div class="page-header">
    <nav class="breadcrumb-nav">
        <a href="/app">Portfolio</a> /
        <a href="/app/assessments/@Id">Assessment</a> /
        <span>Decision</span>
    </nav>
    <h1>Partner Acceptance / Continuance Decision</h1>
</div>

@if (_loading)
{
    <p role="status">Checking decision access…</p>
}
else if (_scopeDenied)
{
    <section class="notice" role="alert">
        <h2>Decision unavailable</h2>
        <p>The current identity is not authorized to record a partner decision for this client.</p>
    </section>
}
else if (_expectedGeneration is null)
{
    <section class="notice" role="alert">
        <h2>Decision unavailable</h2>
        <p>The current client evaluation is unavailable. No decision was recorded.</p>
    </section>
}
else
{
<div class="card decision-card">
    <p class="notice-text">
        This decision is <strong>immutable</strong>. The partner records scope, rationale and conditions. 
        A qualified response does not satisfy an unconditional requirement.
    </p>

    <div class="form-group">
        <label for="decision-outcome">Decision outcome <span class="required-marker">*</span></label>
        <select id="decision-outcome" @bind="_outcome" required title="Record the professional decision for this exact client/service scope. A decision does not create a remote folder in this request.">
            <option value="">— select —</option>
            <option value="ACCEPTED">Accepted</option>
            <option value="ACCEPTED_WITH_CONDITIONS">Accepted with Conditions</option>
            <option value="DECLINED">Declined</option>
            <option value="DEFERRED">Deferred (additional information required)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="decision-service">Service route <span class="required-marker">*</span></label>
        <input id="decision-service" @bind="_serviceRoute" maxlength="50" required title="Stable service scope used to bind the decision and any later workspace intent." />
    </div>

    <div class="form-group">
        <label for="decision-rationale">Rationale / scope <span class="required-marker">*</span></label>
        <textarea id="decision-rationale" rows="5" @bind="_rationale" placeholder="Describe scope, factors considered and professional basis." required title="Required professional basis retained with the immutable decision." />
    </div>

    <div class="form-group">
        <label for="decision-conditions">Conditions <span class="optional-label">optional unless conditional acceptance</span></label>
        <textarea id="decision-conditions" rows="3" @bind="_conditions" placeholder="Leave blank if unconditional." data-optional="true" title="Required only for Accepted with Conditions; open conditions prevent workspace readiness." />
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-banner" role="alert">@_errorMessage</div>
    }

    <div class="action-bar">
        <button class="btn-primary" @onclick="RecordDecision" disabled="@(_submitting || _expectedGeneration is null)" title="Persist the guarded decision and, for effective acceptance, one waiting client-workspace intent">
            @(_submitting ? "Recording…" : "Record Partner Decision")
        </button>
        <a class="btn-secondary" href="/app/assessments/@Id">Cancel</a>
    </div>
</div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    string _outcome = "";
    string _serviceRoute = "FinancialStatementAudit";
    string _rationale = "";
    string _conditions = "";
    string _errorMessage = "";
    bool _submitting;
    bool _loading = true;
    bool _scopeDenied;
    long? _expectedGeneration;
    AuditSphereOps.Application.Abstractions.ActorContext? _actor;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _scopeDenied = false;
        _expectedGeneration = null;
        _actor = null;
        _errorMessage = "";
        _outcome = "";
        _serviceRoute = "FinancialStatementAudit";
        _rationale = "";
        _conditions = "";

        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/login");
                return;
            }
            _actor = await ActorResolver.ResolveAsync();
            if (_actor is null)
            {
                _scopeDenied = true;
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
                new AuthorizationRequest(_actor.FirmId, ClientId: Id, RequiredRoles: ["Partner"], InternalOnly: true));
            if (!authorization.Succeeded)
            {
                _scopeDenied = true;
                return;
            }

            _expectedGeneration = await db.ClientSafetyStates.AsNoTracking()
                .Where(x => x.FirmId == _actor.FirmId && x.Id == Id)
                .Select(x => (long?)x.InputGeneration).SingleOrDefaultAsync();
        }
        finally { _loading = false; }
    }

    async Task RecordDecision()
    {
        _errorMessage = "";
        if (string.IsNullOrWhiteSpace(_outcome))
        { _errorMessage = "Select a decision outcome."; return; }
        if (string.IsNullOrWhiteSpace(_rationale))
        { _errorMessage = "Rationale is required."; return; }
        if (string.IsNullOrWhiteSpace(_serviceRoute))
        { _errorMessage = "Service route is required."; return; }
        if (_actor is null || _expectedGeneration is null)
        { _errorMessage = "The current authorized client generation could not be loaded."; return; }

        _submitting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await AcceptanceDecisionService.RecordAsync(db, _actor,
                new(Id, null, _serviceRoute, _outcome, _rationale, _conditions, _expectedGeneration.Value));
            if (!result.Succeeded)
            {
                if (result.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale)
                {
                    _scopeDenied = true;
                    _expectedGeneration = null;
                    _actor = null;
                    _outcome = "";
                    _rationale = "";
                    _conditions = "";
                    return;
                }
                _errorMessage = result.Message ?? "The decision could not be recorded.";
                return;
            }
            Nav.NavigateTo($"/app/assessments/{Id}");
        }
        finally { _submitting = false; }
    }
}
