@page "/app/operations"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Operations
@using AuditSphereOps.Domain.Completion
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Operations</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Operations" Description="Redacted operational evidence for the current firm only: classification codes and durable state, never payloads, request bytes or lease owner identities. A re-armed operation re-runs through the same guarded validation as a first attempt. Only queued work without a worker lease can be cancelled safely." />
<MudButton Color="Color.Primary" Variant="Variant.Outlined" Class="button-secondary" OnClick="LoadOperationsAsync" Disabled="@(_loading || _busy)">Refresh operations</MudButton>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading the durable operation ledger…" />
}
else if (_actor is null || !_isAdmin)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">Sign in with an authorized administrator identity to view operations.</MudText>
  </MudAlert>
}
else
{
    <p class="scope-note">Redacted operational evidence for the current firm only: classification codes and durable state, never payloads, request bytes or lease owner identities. A re-armed operation re-runs through the same guarded validation as a first attempt. Only queued work without a worker lease can be cancelled safely.</p>
    @if (_operatingMode == "RECOVERY_QUARANTINE")
    {
      <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="notice warning my-4" role="alert">
        <h2>Recovery Quarantine Active</h2>
        <MudText Typo="Typo.body2">Firm operating mode is quarantined. Side effects and operations are fenced until authorized recovery is lifted.</MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button mt-2" OnClick="LiftQuarantineAsync" Disabled="@_busy">Lift recovery quarantine</MudButton>
      </MudAlert>
    }
    @if (_result is not null)
    {
      <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">
        @(_result.Succeeded ? (_successMessage ?? "The action succeeded.") : "Blocked: " + _result.ErrorCode)
      </p>
    }
  @if (_operations.Count == 0)
  {
    <MudPaper Class="pa-4 my-4" Elevation="1"><MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">No durable operations are recorded for this firm.</MudText></MudPaper>
  }
  else
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="operations-heading" role="region">
      <h2 id="operations-heading">Latest 50 durable operations</h2>
      <label for="cancel-disposition">Cancellation disposition</label>
      <MudTextField T="string" @bind-Value="_cancelDisposition" MaxLength="2000" id="cancel-disposition" Placeholder="Why is the queued operation being cancelled?" required title="Explain why this queued operation is being cancelled; the disposition is stored with the operation event." />
      <MudTable Items="_operations" Dense="true" Hover="true" Elevation="0" Class="mt-3">
        <HeaderContent>
          <MudTh>Kind</MudTh>
          <MudTh>Status</MudTh>
          <MudTh>Attempts</MudTh>
          <MudTh>Next attempt</MudTh>
          <MudTh>Code</MudTh>
          <MudTh>Disposition</MudTh>
          <MudTh>Action</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Kind">@context.Kind</MudTd>
          <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
          <MudTd DataLabel="Attempts">@context.AttemptCount</MudTd>
          <MudTd DataLabel="Next attempt">@(context.NextAttemptAt == null ? "—" : context.NextAttemptAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</MudTd>
          <MudTd DataLabel="Code">@(context.ErrorCode ?? "—")</MudTd>
          <MudTd DataLabel="Disposition">@(context.CancellationDisposition ?? "—")</MudTd>
          <MudTd DataLabel="Action">
            @if (context.Status is "PENDING" or "RETRY_WAIT")
            {
              <MudButton Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" Class="button me-1" OnClick="() => CancelAsync(context)" Disabled="@_busy">Cancel queued work</MudButton>
            }
            @if (OperationRecoveryService.RetryableStates.Contains(Enum.Parse<OperationState>(context.Status)))
            {
              <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="button" OnClick="() => RetryAsync(context)" Disabled="@_busy">Re-arm for retry</MudButton>
            }
          </MudTd>
        </RowTemplate>
        <PagerContent>
          <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
      </MudTable>
    </MudPaper>
  }
}

@code {
  private ActorContext? _actor;
  private bool _isAdmin;
  private string? _operatingMode;
  private List<OperationProjection> _operations = [];
  private CommandResult? _result;
  private string? _successMessage;
  private string _cancelDisposition = string.Empty;
  private bool _loading = true;
  private bool _busy;
  private long _loadGeneration;

  protected override Task OnInitializedAsync() => LoadOperationsAsync();

  private void ClearProtectedState()
  {
    _actor = null;
    _isAdmin = false;
    _operatingMode = null;
    _operations = [];
    _result = null;
    _successMessage = null;
    _cancelDisposition = string.Empty;
  }

  private async Task LoadOperationsAsync()
  {
    var generation = ++_loadGeneration;
    _loading = true;
    ClearProtectedState();
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null || generation != _loadGeneration) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var mode = await OperationRecoveryService.GetFirmOperatingModeAsync(db, actor);
      if (!mode.Succeeded || generation != _loadGeneration) return;
      var listed = await OperationRecoveryService.ListAsync(db, actor);
      if (!listed.Succeeded || generation != _loadGeneration) return;
      var currentMode = await OperationRecoveryService.GetFirmOperatingModeAsync(db, actor);
      var currentActor = await ActorResolver.ResolveAsync();
      if (!currentMode.Succeeded || currentActor is null ||
          currentActor.UserId != actor.UserId || currentActor.FirmId != actor.FirmId ||
          currentActor.SessionEpoch != actor.SessionEpoch || generation != _loadGeneration) return;
      _actor = currentActor;
      _isAdmin = true;
      _operatingMode = currentMode.Value;
      _operations = listed.Value!.ToList();
    }
    finally { if (generation == _loadGeneration) _loading = false; }
  }

  private async Task<ActorContext?> CurrentAdminAsync()
  {
    if (_actor is null) return null;
    var current = await ActorResolver.ResolveAsync();
    if (current is null || current.UserId != _actor.UserId ||
        current.FirmId != _actor.FirmId || current.SessionEpoch != _actor.SessionEpoch)
    {
      ClearProtectedState();
      return null;
    }
    return current;
  }

  private async Task LiftQuarantineAsync()
  {
    if (_busy) return;
    _busy = true;
    try
    {
      var actor = await CurrentAdminAsync();
      if (actor is null) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await OperationRecoveryService.LiftQuarantineAsync(db, actor);
      await LoadOperationsAsync();
      if (_isAdmin)
      {
        _result = result;
        if (result.Succeeded)
          _successMessage = "Recovery quarantine was lifted; operating mode is now LOCAL_ONLY.";
      }
    }
    finally { _busy = false; }
  }

  private async Task RetryAsync(OperationProjection op)
  {
    if (_busy) return;
    _busy = true;
    try
    {
      var actor = await CurrentAdminAsync();
      if (actor is null) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await OperationRecoveryService.RetryAsync(db, actor, new OperationRecoveryRequest(op.Id));
      await LoadOperationsAsync();
      if (_isAdmin)
      {
        _result = result;
        if (result.Succeeded)
          _successMessage = "The operation was re-armed for retry; the worker picks it up on its next attempt window.";
      }
    }
    finally { _busy = false; }
  }

  private async Task CancelAsync(OperationProjection op)
  {
    if (_busy) return;
    _busy = true;
    try
    {
      var actor = await CurrentAdminAsync();
      if (actor is null) return;
      var disposition = _cancelDisposition;
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await OperationRecoveryService.CancelAsync(db, actor,
        new OperationCancellationRequest(op.Id, disposition));
      await LoadOperationsAsync();
      if (_isAdmin)
      {
        _result = result;
        if (result.Succeeded)
          _successMessage = "The queued operation was cancelled and cannot be claimed by a worker.";
      }
    }
    finally { _busy = false; }
  }
}
