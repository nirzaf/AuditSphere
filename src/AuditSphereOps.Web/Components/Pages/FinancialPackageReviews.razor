@page "/app/accounting/reviews"
@rendermode InteractiveServer
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject ILogger<FinancialPackageReviews> Logger

<PageTitle>Financial package reviews</PageTitle>
<MudLink Href="/app/accounting" Class="back-link mb-2 d-inline-block">← Back to accounting workspace</MudLink>
<PageHeader Title="Financial package reviews" Eyebrow="Accounting review" Description="Only validated packages in the current client and engagement grants are listed. Every stage is bound to the package's exact revision, generation and hash." />
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button-secondary" OnClick="LoadQueueAsync" Disabled="@(_loading || _refreshing)">Refresh queue</MudButton>
@if (_refreshing)
{
  <p role="status">Refreshing the queue for your current access…</p>
}

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading the review queue…" />
}
else if (_actor is null || !IsStaff)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">This queue requires an authorized internal accounting role.</MudText>
  </MudAlert>
}
else if (_error is not null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Review queue unavailable</h2>
    <MudText Typo="Typo.body2">@_error</MudText>
  </MudAlert>
}
else
{
  <MudGrid Spacing="2" Class="audit-accounting-metrics my-3" aria-label="Scoped package review counts">
    <MudItem xs="6" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Stages shown</MudText><MudText Typo="Typo.h4">@_queue.Count</MudText></MudPaper></MudItem>
    <MudItem xs="6" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Partner action required</MudText><MudText Typo="Typo.h4">@_queue.Count(x => x.NextAction == "PARTNER_APPROVAL_REQUIRED")</MudText></MudPaper></MudItem>
    <MudItem xs="12" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Selected for preview</MudText><MudText Typo="Typo.h4">@_selectedPackageIds.Count</MudText></MudPaper></MudItem>
  </MudGrid>
  <section class="card audit-accounting-review" aria-labelledby="queue-heading" data-draft-scope="package-review-selection">
    <h2 id="queue-heading">Action required</h2>
    <p class="muted">Selection is optional and is retained as a browser draft. Preview only; no package decision is recorded from this screen.</p>
    <div class="action-bar audit-accounting-review-actions">
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="PreviewSelection" Disabled="@(_selectedPackageIds.Count == 0)">Preview selected</MudButton>
      @if (!string.IsNullOrWhiteSpace(_selectionPreview))
      {
        <p class="notice-text" role="status" aria-live="polite">@_selectionPreview</p>
      }
    </div>
    @if (_queue.Count == 0)
    {
      <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-3" role="status">@(_refreshing ? "Refreshing…" : "No current package review stage is waiting in your authorized scope.")</MudAlert>
    }
    else
    {
      <div class="table-wrap audit-accounting-table-wrap"><MudTable Items="_queue" Dense="true" Hover="true" Elevation="0">
<!-- Native checkboxes retained: data-draft-field selection state inside a draft boundary, bound with explicit checked/onchange inside the MudTable header/rows. -->
  <HeaderContent><MudTh scope="col"><label title="Select all visible package stages for a preview."><input id="select-all-packages" type="checkbox" data-draft-field="select-all-packages" checked="@AllSelected" @onchange="ToggleAll" /> <span class="sr-only">Select all visible packages</span></label></MudTh><MudTh scope="col">Package</MudTh><MudTh scope="col">Period</MudTh><MudTh scope="col">Management</MudTh><MudTh scope="col">Accounting</MudTh><MudTh scope="col">Partner</MudTh><MudTh scope="col">Next action</MudTh><MudTh scope="col"><span class="sr-only">Action</span></MudTh></HeaderContent>
  <RowTemplate>            <MudTd><input id="select-package-@context.PackageId" type="checkbox" data-draft-field="package-@context.PackageId" checked="@IsSelected(context.PackageId)" @onchange="eventArgs => TogglePackage(context.PackageId, eventArgs)" title="Select this exact package review stage for a preview." /></MudTd>
            <MudTd><code>@context.PackageId</code><br /><span class="muted">@context.Framework · @context.Currency</span></MudTd>
            <MudTd>@context.PeriodStart to @context.PeriodEnd</MudTd>
            <MudTd><StatusChip Status="@context.ManagementDecision" /></MudTd>
            <MudTd><StatusChip Status="@context.AccountingDecision" /></MudTd>
            <MudTd><StatusChip Status="@context.PartnerDecision" /></MudTd>
            <MudTd><strong>@context.NextAction</strong></MudTd>
            <MudTd><MudLink Href="@($"/app/accounting/packages/{context.PackageId}")">Open package</MudLink></MudTd></RowTemplate>
</MudTable></div>
    }
  </section>
}

@code {
  private ActorContext? _actor;
  private List<FinancialPackageReviewQueueItem> _queue = [];
  private string? _error;
  private string? _selectionPreview;
  private bool _loading = true;
  private bool _refreshing;
  private HashSet<Guid> _selectedPackageIds = [];
  private bool IsStaff => _actor is not null && _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "AccountingReviewer" or "AccountingPreparer");
  private bool AllSelected => _queue.Count > 0 && _queue.All(x => _selectedPackageIds.Contains(x.PackageId));

  protected override Task OnInitializedAsync() => LoadQueueAsync();

  private async Task LoadQueueAsync()
  {
    _refreshing = true;
    _queue = [];
    _selectedPackageIds.Clear();
    _selectionPreview = null;
    _error = null;
    try
    {
      _actor = await ActorResolver.ResolveAsync();
      if (_actor is not null && IsStaff)
      {
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await FinancialPackageReviewService.GetStaffQueueAsync(db, _actor);
        if (result.Succeeded)
          _queue = result.Value?.ToList() ?? [];
        else
          _error = result.Message;
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to refresh the financial package review queue.");
      _error = "The review queue could not be refreshed. Retry when the connection is available.";
    }
    finally
    {
      _loading = false;
      _refreshing = false;
    }
  }

  private bool IsSelected(Guid packageId) => _selectedPackageIds.Contains(packageId);

  private void ToggleAll(ChangeEventArgs args)
  {
    if (args.Value is true or "true")
      _selectedPackageIds = _queue.Select(x => x.PackageId).ToHashSet();
    else
      _selectedPackageIds.Clear();
    _selectionPreview = null;
  }

  private void TogglePackage(Guid packageId, ChangeEventArgs args)
  {
    if (args.Value is true or "true")
      _selectedPackageIds.Add(packageId);
    else
      _selectedPackageIds.Remove(packageId);
    _selectionPreview = null;
  }

  private void PreviewSelection()
  {
    var selected = _queue.Where(x => _selectedPackageIds.Contains(x.PackageId)).ToList();
    var blocked = selected.Where(x => x.NextAction == "PARTNER_APPROVAL_REQUIRED").ToList();
    var eligible = selected.Count - blocked.Count;
    _selectionPreview = blocked.Count == 0
      ? $"Preview: {eligible} selected stage{(eligible == 1 ? "" : "s")} are eligible for this role. No decision was recorded."
      : $"Preview: {eligible} eligible, {blocked.Count} blocked because partner approval requires a Partner or Administrator. No decision was recorded.";
  }
}
