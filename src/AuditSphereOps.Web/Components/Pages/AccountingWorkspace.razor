@page "/app/accounting"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Accounting
@using AuditSphereOps.Domain.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Client accounting workspace</PageTitle>
<a class="back-link" href="/app">← Back to portfolio</a>
<h1>Client accounting workspace</h1>

@if (_loading)
{
  <p role="status">Loading accounting context…</p>
}
else if (!_authorized)
{
  <section class="notice" role="alert"><h2>Access unavailable</h2><p>This workspace requires an authorized accounting role.</p></section>
}
else
{
  <section class="card" aria-labelledby="workspace-context-heading">
    <h2 id="workspace-context-heading">Active accounting context</h2>
    <p class="scope-note">Firm <code>@_actor!.FirmId</code> · Group <strong>none</strong> · @_scopeDescription · @_clients.Count legal entities in the current grant scope. Group navigation does not grant sibling-company access.</p>
    <p class="muted">Each row below pins the legal entity, engagement, period, book, currency and latest package version. Select a handoff only after confirming this context.</p>
  </section>
  <section class="metric-grid" aria-label="Accounting workspace counts">
    <article class="metric card"><span class="metric-label">Client profiles</span><strong class="metric-value">@_profileCount</strong></article>
    <article class="metric card"><span class="metric-label">Open periods</span><strong class="metric-value">@_openPeriodCount</strong></article>
    <article class="metric card"><span class="metric-label">Sealed imports</span><strong class="metric-value">@_sealedImportCount</strong></article>
    <article class="metric card"><span class="metric-label">Blocked/stale work</span><strong class="metric-value">@_blockedCount</strong></article>
  </section>
  @if (!_hasClientScope)
  {
    <section class="notice" role="status"><h2>No client scope assigned</h2><p>Ask a firm administrator for an active client or engagement grant before using this workspace. No firm data is shown without an explicit scope.</p></section>
  }
  <section class="card" aria-labelledby="context-heading">
    <h2 id="context-heading">Current accounting context</h2>
    <div class="table-wrap">
      <table>
        <caption class="sr-only">Accounting client context</caption>
        <thead><tr><th scope="col">Legal entity</th><th scope="col">Currency</th><th scope="col">Periods</th><th scope="col">Latest chart</th><th scope="col">Latest import</th></tr></thead>
        <tbody>
        @foreach (var row in _clients)
        {
          <tr><td><strong>@row.Name</strong></td><td><code>@row.Currency</code></td><td>@row.Periods</td><td>@row.ChartStatus</td><td>@row.ImportStatus</td></tr>
        }
        </tbody>
      </table>
    </div>
  </section>
  <section class="card" aria-labelledby="period-control-heading">
    <h2 id="period-control-heading">Period control and handoffs</h2>
    @if (_periods.Count == 0)
    {
      <p class="muted">No reporting periods are available in the current scope.</p>
    }
    else
    {
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Scoped client reporting periods</caption>
        <thead><tr><th scope="col">Legal entity</th><th scope="col">Engagement</th><th scope="col">Period</th><th scope="col">Book</th><th scope="col">Currency</th><th scope="col">Package</th><th scope="col">Status</th><th scope="col">Handoffs</th></tr></thead>
          <tbody>
          @foreach (var period in _periods)
          {
            <tr>
              <td><strong>@period.ClientName</strong></td>
              <td>@period.Engagement</td>
              <td>@period.PeriodCode · @period.Basis<br /><span class="muted">@period.StartDate.ToString("yyyy-MM-dd") — @period.EndDate.ToString("yyyy-MM-dd")</span></td>
              <td>@period.Book</td>
              <td><code>@period.Currency</code></td>
              <td>@period.Package</td>
              <td><span class="status">@period.Status</span></td>
              <td><a href="/app/accounting/rollforward" title="Create a new draft period from this scoped period">Roll forward</a> · <a href="/app/accounting/restatements" title="Review an authorized amendment without rewriting the issued package">Restatements</a></td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </section>
  <section class="card" aria-labelledby="routes-heading">
    <h2 id="routes-heading">Accounting workbenches</h2>
    <div style="display:flex;gap:.75rem;flex-wrap:wrap">
      <a class="button" href="/app/consolidation" title="Review explicitly granted group perimeters and approved consolidation scopes">Group consolidation</a>
      <a class="button" href="/app/accounting/evidence" title="Review scoped ECL, inventory, specialist, analytical and journal-risk evidence">Account-area evidence</a>
      <a class="button" href="/app/accounting/rollforward" title="Create a draft reporting period with explicit opening-balance evidence">Period roll-forward</a>
      <a class="button" href="/app/journals" title="Review proposed accounting and reporting adjustments">Adjustments and journals</a>
      <a class="button" href="/app/accounting/reviews" title="Review package stages and current applicability">Package review queue</a>
      <a class="button" href="/app/accounting/restatements" title="Record an authorized post-close amendment with immutable lineage">Period restatements</a>
    </div>
  </section>
}

@code {
  private sealed record ClientRow(string Name, string Currency, int Periods, string ChartStatus, string ImportStatus);
  private sealed record PeriodRow(string ClientName, string Engagement, string PeriodCode, string Basis, DateOnly StartDate, DateOnly EndDate,
    string Book, string Currency, string Package, string Status, long Revision);
  private ActorContext? _actor;
  private bool _loading = true;
  private bool _authorized;
  private int _profileCount;
  private int _openPeriodCount;
  private int _sealedImportCount;
  private int _blockedCount;
  private bool _hasClientScope;
  private string _scopeDescription = "No active client or engagement grant";
  private List<ClientRow> _clients = [];
  private List<PeriodRow> _periods = [];

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    _authorized = _actor is not null && _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "AccountingPreparer" or "AccountingReviewer");
    if (_authorized && _actor is not null)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var grants = await db.RoleGrants.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.UserId == _actor.UserId && x.RevokedAt == null)
        .Select(x => new { x.ClientId, x.EngagementId }).ToListAsync();
      var firmWide = grants.Any(x => x.ClientId is null && x.EngagementId is null);
      var grantedClientIds = grants.Where(x => x.ClientId.HasValue).Select(x => x.ClientId!.Value).ToArray();
      var engagementIds = grants.Where(x => x.EngagementId.HasValue).Select(x => x.EngagementId!.Value).ToArray();
      var engagementClientIds = engagementIds.Length == 0
        ? []
        : await db.Engagements.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && engagementIds.Contains(x.Id))
          .Select(x => x.PracticeClientId).ToArrayAsync();
      var clientIds = grantedClientIds.Concat(engagementClientIds).Distinct().ToArray();
      _hasClientScope = firmWide || clientIds.Length > 0;
      _scopeDescription = firmWide ? "Firm-wide grant" : $"{clientIds.Length} explicitly granted legal entit{(clientIds.Length == 1 ? "y" : "ies")}";
      var profiles = await db.ClientAccountingProfiles.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).ToListAsync();
      var clients = await db.PracticeClients.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.Id))).ToDictionaryAsync(x => x.Id);
      var periods = await db.ClientReportingPeriods.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).ToListAsync();
      var books = await db.ClientReportingBooks.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).ToListAsync();
      var engagements = await db.Engagements.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.PracticeClientId))).ToListAsync();
      var packages = await db.FinancialPackages.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).ToListAsync();
      var charts = await db.ClientChartVersions.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).GroupBy(x => x.ClientId)
        .Select(x => new { ClientId = x.Key, Status = x.OrderByDescending(y => y.Version).Select(y => y.Status).First() }).ToListAsync();
      var imports = await db.SourceImportBatches.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).GroupBy(x => x.ClientId)
        .Select(x => new { ClientId = x.Key, Status = x.OrderByDescending(y => y.CreatedAt).Select(y => y.Status).First() }).ToListAsync();
      _profileCount = profiles.Count;
      _openPeriodCount = periods.Count(x => x.Status != AccountingWorkflowStates.Closed);
      _sealedImportCount = await db.SourceImportBatches.AsNoTracking().CountAsync(x => x.FirmId == _actor.FirmId && x.Status == "SEALED" &&
        (firmWide || clientIds.Contains(x.ClientId)));
      _blockedCount = periods.Count(x => x.Status is AccountingWorkflowStates.Stale or AccountingWorkflowStates.Rejected);
      _periods = periods.OrderByDescending(x => x.EndDate).ThenBy(x => x.PeriodCode).Select(x => new PeriodRow(
        clients.GetValueOrDefault(x.ClientId)?.LegalName ?? "Scoped client",
        engagements.Where(e => e.PracticeClientId == x.ClientId).OrderByDescending(e => e.CreatedAt).Select(e => e.ServiceRoute).FirstOrDefault() ?? "No engagement",
        x.PeriodCode, x.Basis, x.StartDate, x.EndDate,
        books.FirstOrDefault(b => b.ClientId == x.ClientId && b.PeriodId == x.Id)?.Code ?? "No book",
        x.Currency,
        packages.Where(p => p.ClientId == x.ClientId && p.PeriodId == x.Id).OrderByDescending(p => p.CreatedAt)
          .Select(p => $"{p.Status} · v{p.Revision}").FirstOrDefault() ?? "NO_PACKAGE",
        x.Status, x.Revision)).ToList();
      _clients = profiles.Where(x => clients.ContainsKey(x.ClientId)).Select(x => new ClientRow(
        clients[x.ClientId].LegalName, x.FunctionalCurrency, periods.Count(p => p.ClientId == x.ClientId),
        charts.SingleOrDefault(c => c.ClientId == x.ClientId)?.Status ?? "NO_CHART",
        imports.SingleOrDefault(i => i.ClientId == x.ClientId)?.Status ?? "NO_IMPORT")).OrderBy(x => x.Name).ToList();
    }
    _loading = false;
  }
}
