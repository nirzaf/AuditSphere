@page "/app/accounting"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Accounting
@using AuditSphereOps.Domain.Documents
@using AuditSphereOps.Domain.Practice
@using AuditSphereOps.Domain.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject ILogger<AccountingWorkspace> Logger

<PageTitle>Client accounting workspace</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Client accounting workspace" Description="Explicitly granted legal entity accounting contexts, periods, and workflow dashboard." />
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button-secondary" OnClick="LoadAccountingContextAsync" Disabled="@_loading">Refresh workspace</MudButton>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading accounting context…" />
}
else if (_error is not null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Accounting workspace unavailable</h2>
    <MudText Typo="Typo.body2">@_error</MudText>
  </MudAlert>
}
else if (!_authorized)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">This workspace requires an authorized accounting role.</MudText>
  </MudAlert>
}
else
{
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="workspace-context-heading" role="region">
    <h2 id="workspace-context-heading">Active accounting context</h2>
    <p class="scope-note">Firm <code>@_actor!.FirmId</code> · Group <strong>none</strong> · @_scopeDescription · @_clients.Count legal entities in the current grant scope. Group navigation does not grant sibling-company access.</p>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">Each row below pins the legal entity, engagement, period, book, currency and latest package version. Select a handoff only after confirming this context.</MudText>
  </MudPaper>
  <MudPaper  Class="pa-4 my-4" Elevation="1" id="dashboard" aria-labelledby="dashboard-heading" role="region">
    <h2 id="dashboard-heading">Workflow dashboard</h2>
    <p class="muted">Counts are derived from the visible period and package records. No due date is invented: until a task or PBC due date is linked, the dashboard shows <strong>Not recorded</strong>.</p>
    <MudGrid Spacing="3" Class="metric-grid my-3" aria-label="Accounting workflow counts">
      <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 h-100" Elevation="1">
          <span class="metric-label">Required</span>
          <strong class="metric-value">@_requiredCount</strong>
        </MudPaper>
      </MudItem>
      <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 h-100" Elevation="1">
          <span class="metric-label">Complete</span>
          <strong class="metric-value">@_completeCount</strong>
        </MudPaper>
      </MudItem>
      <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 h-100" Elevation="1">
          <span class="metric-label">Stale</span>
          <strong class="metric-value">@_staleCount</strong>
        </MudPaper>
      </MudItem>
      <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 h-100" Elevation="1">
          <span class="metric-label">Blocked</span>
          <strong class="metric-value">@_blockedCount</strong>
        </MudPaper>
      </MudItem>
    </MudGrid>
    @if (_dashboardRows.Count == 0)
    {
      <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">No period workflow items are available in the current scope.</MudText>
    }
    else
    {
      <MudTable Items="_dashboardRows" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
          <MudTh>Client / period</MudTh>
          <MudTh>State</MudTh>
          <MudTh>Next owner</MudTh>
          <MudTh>Due date</MudTh>
          <MudTh><span class="sr-only">Action</span></MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Client / period"><strong>@context.ClientName</strong><br /><span class="muted">@context.PeriodCode</span></MudTd>
          <MudTd DataLabel="State"><StatusChip Status="@context.State" /></MudTd>
          <MudTd DataLabel="Next owner">@context.NextOwner</MudTd>
          <MudTd DataLabel="Due date"><span title="A due date is shown only when a persisted accounting task or PBC request supplies one.">@context.DueDate</span></MudTd>
          <MudTd DataLabel="Action"><MudLink Href="@context.Href">@context.Action</MudLink></MudTd>
        </RowTemplate>
        <PagerContent>
          <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
      </MudTable>
    }
  </MudPaper>
  <MudGrid Spacing="3" Class="metric-grid my-3" aria-label="Accounting workspace source counts">
    <MudItem xs="12" sm="6" md="3">
      <MudPaper Class="pa-4 h-100" Elevation="1">
        <span class="metric-label">Client profiles</span>
        <strong class="metric-value">@_profileCount</strong>
      </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
      <MudPaper Class="pa-4 h-100" Elevation="1">
        <span class="metric-label">Open periods</span>
        <strong class="metric-value">@_openPeriodCount</strong>
      </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
      <MudPaper Class="pa-4 h-100" Elevation="1">
        <span class="metric-label">Sealed imports</span>
        <strong class="metric-value">@_sealedImportCount</strong>
      </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
      <MudPaper Class="pa-4 h-100" Elevation="1">
        <span class="metric-label">Blocked/stale work</span>
        <strong class="metric-value">@_blockedCount</strong>
      </MudPaper>
    </MudItem>
  </MudGrid>
  @if (!_hasClientScope)
  {
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="status"><h2>No client scope assigned</h2><p>Ask a firm administrator for an active client or engagement grant before using this workspace. No firm data is shown without an explicit scope.</p></MudAlert>
  }
  <section class="card" aria-labelledby="selected-context-heading" data-draft-scope="accounting-context">
    <h2 id="selected-context-heading">Selected accounting context</h2>
    <label class="field">
      Context (optional)
      <select id="accounting-context-selector" @bind="_selectedContextKey" data-optional="true" title="Choose a visible client period to keep its legal entity, engagement, book, currency and package context together.">
        <option value="">No period selected</option>
        @foreach (var periodContext in _periods)
        {
          <option value="@periodContext.Id">@periodContext.ClientName · @periodContext.PeriodCode · @periodContext.Book · @periodContext.Currency</option>
        }
      </select>
    </label>
    @if (SelectedContext is { } selected)
    {
      <dl class="details">
        <dt>Firm</dt><dd><code>@_actor!.FirmId</code></dd>
        <dt>Group</dt><dd>None — client accounting scope</dd>
        <dt>Legal entity</dt><dd>@selected.ClientName</dd>
        <dt>Engagement</dt><dd>@selected.Engagement</dd>
        <dt>Period</dt><dd>@selected.PeriodCode · @selected.Basis · @selected.StartDate.ToString("yyyy-MM-dd") — @selected.EndDate.ToString("yyyy-MM-dd")</dd>
        <dt>Book</dt><dd>@selected.Book</dd>
        <dt>Currency</dt><dd><code>@selected.Currency</code></dd>
        <dt>Package version</dt><dd>@selected.Package</dd>
      </dl>
      <p class="context-actions" aria-label="Selected accounting record links">
        @if (selected.PackageId is { } packageId)
        {
          <a href="@($"/app/accounting/packages/{packageId}")" title="Open the exact validated package for the selected client period">Open package</a>
        }
        @if (selected.MappingId is { } mappingId)
        {
          <a href="@($"/app/accounting/mappings/{mappingId}")" title="Open the exact mapping version used by the selected package">Open mapping</a>
        }
        <a href="/app/accounting/evidence" title="Open the scoped TB, GL and account-area evidence queue">TB/GL and evidence</a>
        <a href="/app/accounting/reviews" title="Open approval history for current validated packages in scope">Approval history</a>
      </p>
    }
    else
    {
      <p class="muted">Choose a visible period to pin its reporting context here. This selection does not broaden access.</p>
    }
  </section>
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="workspaces-heading" role="region">
    <h2 id="workspaces-heading">Client accounting tabs</h2>
    <p class="muted">Each tab keeps the current client scope. Detail pages are available only when an exact persisted record exists.</p>
    <div class="workspace-tab-grid">
      <article id="tb-gl"><h3>TB / GL</h3><p>Source imports, completeness and account-area evidence.</p><a href="/app/accounting/evidence" title="Open the scoped TB, GL and account-area evidence queue">Open evidence</a></article>
      <article id="coa"><h3>COA</h3><p>Client chart applicability is shown through each exact mapping version.</p><a href="/app/accounting/mappings" title="Review scoped client-chart and mapping versions">Open COA and mappings</a></article>
      <article id="mapping"><h3>Mapping</h3><p>Review immutable allocations, lineage and review-only suggestions.</p><a href="/app/accounting/mappings" title="Review immutable mapping versions">Open mappings</a></article>
      <article id="reconciliations"><h3>Reconciliations</h3><p>Review source-bound accounting evidence and freshness.</p><a href="/app/accounting/evidence#reconciliations" title="Open scoped reconciliation and evidence records">Open reconciliations</a></article>
      <article id="adjustments"><h3>Adjustments</h3><p>Review adjustment journals without changing the client source ledger.</p><a href="/app/accounting/journals" title="Review scoped adjustment journals">Open adjustments</a></article>
      <article id="differences"><h3>Differences</h3><p>Review gross/net differences, correction state and journal lineage.</p><a href="/app/accounting/differences" title="Review scoped audit differences">Open differences</a></article>
      <article id="statements"><h3>Statements</h3><p>Open the exact package when the selected period has one.</p>@if (SelectedContext?.PackageId is { } selectedPackageId) { <a href="@($"/app/accounting/packages/{selectedPackageId}")" title="Open the exact selected financial statement package">Open selected package</a> } else { <a href="/app/accounting/reviews" title="Open the package review queue when no package is selected">Open package queue</a> }</article>
      <article id="approval-history"><h3>Approval history</h3><p>Review exact package-stage decisions and current applicability.</p><a href="/app/accounting/reviews" title="Open package approval history">Open approvals</a></article>
    </div>
  </MudPaper>
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="context-heading" role="region">
    <h2 id="context-heading">Current accounting context</h2>
    <div class="table-wrap">
      <MudTable Items="_clients" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Legal entity</MudTh><MudTh scope="col">Currency</MudTh><MudTh scope="col">Periods</MudTh><MudTh scope="col">Latest chart</MudTh><MudTh scope="col">Latest import</MudTh></HeaderContent>
  <RowTemplate>          <MudTd><strong>@context.Name</strong></MudTd><MudTd><code>@context.Currency</code></MudTd><MudTd>@context.Periods</MudTd><MudTd>@context.ChartStatus</MudTd><MudTd>@context.ImportStatus</MudTd></RowTemplate>
</MudTable>
    </div>
  </MudPaper>
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="period-control-heading" role="region">
    <h2 id="period-control-heading">Period control and handoffs</h2>
    @if (_periods.Count == 0)
    {
      <p class="muted">No reporting periods are available in the current scope.</p>
    }
    else
    {
      <div class="table-wrap">
        <MudTable Items="_periods" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Legal entity</MudTh><MudTh scope="col">Engagement</MudTh><MudTh scope="col">Period</MudTh><MudTh scope="col">Book</MudTh><MudTh scope="col">Currency</MudTh><MudTh scope="col">Package</MudTh><MudTh scope="col">Status</MudTh><MudTh scope="col">Handoffs</MudTh></HeaderContent>
  <RowTemplate>              <MudTd><strong>@context.ClientName</strong></MudTd>
              <MudTd>@context.Engagement</MudTd>
              <MudTd>@context.PeriodCode · @context.Basis<br /><span class="muted">@context.StartDate.ToString("yyyy-MM-dd") — @context.EndDate.ToString("yyyy-MM-dd")</span></MudTd>
              <MudTd>@context.Book</MudTd>
              <MudTd><code>@context.Currency</code></MudTd>
              <MudTd>
                @if (context.PackageId is { } packageId)
                {
                  <a href="@($"/app/accounting/packages/{packageId}")" title="Open the exact package version for this context">@context.Package</a>
                }
                else
                {
                  @context.Package
                }
              </MudTd>
              <MudTd><StatusChip Status="@context.Status" /></MudTd>
              <MudTd>
                @if (context.MappingId is { } mappingId)
                {
                  <a href="@($"/app/accounting/mappings/{mappingId}")" title="Open the exact mapping version used by this package">Mapping</a><span aria-hidden="true"> · </span>
                }
                <a href="/app/accounting/rollforward" title="Create a new draft context from this scoped context">Roll forward</a><span aria-hidden="true"> · </span><a href="/app/accounting/restatements" title="Review an authorized amendment without rewriting the issued package">Restatements</a>
              </MudTd></RowTemplate>
</MudTable>
      </div>
    }
  </MudPaper>
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="routes-heading" role="region">
    <h2 id="routes-heading">Accounting workbenches</h2>
    <div style="display:flex;gap:.75rem;flex-wrap:wrap">
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/consolidation" Class="button">Group consolidation</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting/evidence" Class="button">Account-area evidence</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting/rollforward" Class="button">Period roll-forward</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting/mappings" Class="button">COA and mappings</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting/journals" Class="button">Adjustments and journals</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting/differences" Class="button">Differences</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting/reviews" Class="button">Package review queue</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting/restatements" Class="button">Period restatements</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting/remeasurement" Class="button">Currency remeasurement</MudButton>
    </div>
  </MudPaper>
}

@code {
  private static readonly string[] AccountingRoles = ["Administrator", "Partner", "Manager", "AccountingPreparer", "AccountingReviewer"];

  private sealed record ClientRow(string Name, string Currency, int Periods, string ChartStatus, string ImportStatus);
  private sealed record PeriodRow(Guid Id, Guid ClientId, string ClientName, string Engagement, string PeriodCode, string Basis, DateOnly StartDate, DateOnly EndDate,
    string Book, string Currency, string Package, Guid? PackageId, Guid? MappingId, string Status, long Revision);
  private sealed record DashboardRow(Guid PeriodId, string ClientName, string PeriodCode, string State, string NextOwner,
    string DueDate, string Href, string Action);
  private sealed record PbcTask(Guid EngagementId, string OwnerName, string DueDate, string State);
  private sealed record WorkTaskSummary(string OwnerName, string DueDate, string State);
  private ActorContext? _actor;
  private bool _loading = true;
  private bool _authorized;
  private int _profileCount;
  private int _openPeriodCount;
  private int _sealedImportCount;
  private int _requiredCount;
  private int _completeCount;
  private int _staleCount;
  private int _blockedCount;
  private bool _hasClientScope;
  private string _scopeDescription = "No active client or engagement grant";
  private string? _error;
  private string _selectedContextKey = string.Empty;
  private List<ClientRow> _clients = [];
  private List<PeriodRow> _periods = [];
  private List<DashboardRow> _dashboardRows = [];
  private PeriodRow? SelectedContext => Guid.TryParse(_selectedContextKey, out var id)
    ? _periods.FirstOrDefault(x => x.Id == id)
    : null;

  protected override Task OnInitializedAsync() => LoadAccountingContextAsync();

  private async Task LoadAccountingContextAsync()
  {
    _loading = true;
    _authorized = false;
    _actor = null;
    _profileCount = _openPeriodCount = _sealedImportCount = 0;
    _requiredCount = _completeCount = _staleCount = _blockedCount = 0;
    _hasClientScope = false;
    _scopeDescription = "No active client or engagement grant";
    _selectedContextKey = string.Empty;
    _clients = [];
    _periods = [];
    _dashboardRows = [];
    _error = null;
    try
    {
      await LoadAccountingContextCoreAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to refresh the client accounting workspace.");
      _actor = null;
      _authorized = false;
      _clients = [];
      _periods = [];
      _dashboardRows = [];
      _error = "The accounting workspace could not be refreshed. Retry when the connection is available.";
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task LoadAccountingContextCoreAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
        new AuthorizationRequest(_actor.FirmId, RequiredRoles: AccountingRoles, InternalOnly: true));
      if (authorization.Succeeded)
      {
      _authorized = true;
      var grants = await db.RoleGrants.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.UserId == _actor.UserId &&
          x.RevokedAt == null && AccountingRoles.Contains(x.Role))
        .Select(x => new { x.ClientId, x.EngagementId }).ToListAsync();
      var firmWide = grants.Any(x => x.ClientId is null && x.EngagementId is null);
      var grantedClientIds = grants.Where(x => x.ClientId.HasValue && x.EngagementId is null).Select(x => x.ClientId!.Value).ToArray();
      var engagementIds = grants.Where(x => x.EngagementId.HasValue).Select(x => x.EngagementId!.Value).ToArray();
      var engagementClients = engagementIds.Length == 0 ? new Dictionary<Guid, Guid>() : await db.Engagements.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId && engagementIds.Contains(x.Id))
        .ToDictionaryAsync(x => x.Id, x => x.PracticeClientId);
      var scopedGrantEngagementIds = grants.Where(x => x.ClientId.HasValue && x.EngagementId.HasValue &&
        engagementClients.TryGetValue(x.EngagementId.Value, out var clientId) && clientId == x.ClientId.Value)
        .Select(x => x.EngagementId!.Value).Distinct().ToArray();
      var engagementClientIds = scopedGrantEngagementIds.Select(x => engagementClients[x]).ToArray();
      var clientIds = grantedClientIds.Concat(engagementClientIds).Distinct().ToArray();
      var scopedEngagementIds = firmWide ? [] : await db.Engagements.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId && (grantedClientIds.Contains(x.PracticeClientId) || scopedGrantEngagementIds.Contains(x.Id)))
        .Select(x => x.Id).ToArrayAsync();
      _hasClientScope = firmWide || clientIds.Length > 0;
      _scopeDescription = firmWide ? "Firm-wide grant" : $"{clientIds.Length} explicitly granted legal entit{(clientIds.Length == 1 ? "y" : "ies")}";
      var profiles = await db.ClientAccountingProfiles.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).ToListAsync();
      var clients = await db.PracticeClients.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.Id))).ToDictionaryAsync(x => x.Id);
      var periods = await db.ClientReportingPeriods.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).ToListAsync();
      var periodIds = periods.Select(x => x.Id).ToArray();
      var workflowTasks = periodIds.Length == 0 ? [] : await db.WorkTasks.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        x.ReportingPeriodId.HasValue && periodIds.Contains(x.ReportingPeriodId.Value) &&
        (firmWide ||
          (!x.EngagementId.HasValue && x.ClientId.HasValue && grantedClientIds.Contains(x.ClientId.Value)) ||
          (x.EngagementId.HasValue && scopedEngagementIds.Contains(x.EngagementId.Value) &&
            db.Engagements.Any(e => e.Id == x.EngagementId.Value && e.FirmId == x.FirmId && e.PracticeClientId == x.ClientId))) &&
        (x.Status == PracticeTimeStates.TaskOpen || x.Status == PracticeTimeStates.TaskInProgress))
        .OrderBy(x => x.DueDate).ThenBy(x => x.CreatedAt).ToListAsync();
      var books = await db.ClientReportingBooks.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).ToListAsync();
      var engagements = await db.Engagements.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || scopedEngagementIds.Contains(x.Id))).ToListAsync();
      var packages = await db.FinancialPackages.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || grantedClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId))).ToListAsync();
      var charts = await db.ClientChartVersions.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || clientIds.Contains(x.ClientId))).GroupBy(x => x.ClientId)
        .Select(x => new { ClientId = x.Key, Status = x.OrderByDescending(y => y.Version).Select(y => y.Status).First() }).ToListAsync();
      var imports = await db.SourceImportBatches.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || grantedClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId))).GroupBy(x => x.ClientId)
        .Select(x => new { ClientId = x.Key, Status = x.OrderByDescending(y => y.CreatedAt).Select(y => y.Status).First() }).ToListAsync();
      var pbcRequests = await db.PbcRequests.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.State != PbcStates.Closed &&
        (firmWide || grantedClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId))).OrderBy(x => x.DueDate).ToListAsync();
      var pbcOwnerIds = pbcRequests.Select(x => x.FirmOwnerUserId).Distinct().ToArray();
      var pbcOwners = await db.Users.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && pbcOwnerIds.Contains(x.Id))
        .ToDictionaryAsync(x => x.Id, x => string.IsNullOrWhiteSpace(x.DisplayName) ? x.Email : x.DisplayName);
      var pbcByPeriod = pbcRequests.GroupBy(x => PeriodKey(x.ClientId, x.PeriodStart, x.PeriodEnd))
        .ToDictionary(x => x.Key, x =>
        {
          var request = x.First();
          return new PbcTask(request.EngagementId, pbcOwners.GetValueOrDefault(request.FirmOwnerUserId, "Assigned firm owner"),
            string.IsNullOrWhiteSpace(request.DueDate) ? "Not recorded" : request.DueDate, request.State);
        });
      var taskOwnerIds = workflowTasks.Where(x => x.AssigneeUserId.HasValue).Select(x => x.AssigneeUserId!.Value).Distinct().ToArray();
      var taskOwners = await db.Users.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && taskOwnerIds.Contains(x.Id))
        .ToDictionaryAsync(x => x.Id, x => string.IsNullOrWhiteSpace(x.DisplayName) ? x.Email : x.DisplayName);
      var taskByPeriod = workflowTasks.Where(x => x.ReportingPeriodId.HasValue).GroupBy(x => x.ReportingPeriodId!.Value)
        .ToDictionary(x => x.Key, x =>
        {
          var task = x.First();
          return new WorkTaskSummary(taskOwners.GetValueOrDefault(task.AssigneeUserId ?? Guid.Empty, "Assigned staff"),
            task.DueDate?.ToString("yyyy-MM-dd") ?? "Not recorded", task.Status);
        });
      _profileCount = profiles.Count;
      _openPeriodCount = periods.Count(x => x.Status != AccountingWorkflowStates.Closed);
      _sealedImportCount = await db.SourceImportBatches.AsNoTracking().CountAsync(x => x.FirmId == _actor.FirmId && x.Status == "SEALED" &&
        (firmWide || grantedClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId)));
      _blockedCount = periods.Count(x => x.Status is AccountingWorkflowStates.Stale or AccountingWorkflowStates.Rejected);
      _periods = periods.OrderByDescending(x => x.EndDate).ThenBy(x => x.PeriodCode).Select(x =>
      {
        var package = packages.Where(p => p.ClientId == x.ClientId && p.PeriodId == x.Id)
          .OrderByDescending(p => p.CreatedAt).FirstOrDefault();
        return new PeriodRow(
          x.Id, x.ClientId, clients.GetValueOrDefault(x.ClientId)?.LegalName ?? "Scoped client",
          engagements.Where(e => e.PracticeClientId == x.ClientId).OrderByDescending(e => e.CreatedAt).Select(e => e.ServiceRoute).FirstOrDefault() ?? "No engagement",
          x.PeriodCode, x.Basis, x.StartDate, x.EndDate,
          books.FirstOrDefault(b => b.ClientId == x.ClientId && b.PeriodId == x.Id)?.Code ?? "No book",
          x.Currency,
          package is null ? "NO_PACKAGE" : $"{package.Status} · v{package.Revision}", package?.Id, package?.MappingVersionId,
          x.Status, x.Revision);
      }).ToList();
      _dashboardRows = _periods.Select(x => ToDashboardRow(x, pbcByPeriod, taskByPeriod)).ToList();
      _requiredCount = _dashboardRows.Count(x => x.State == "REQUIRED");
      _completeCount = _dashboardRows.Count(x => x.State == "COMPLETE");
      _staleCount = _dashboardRows.Count(x => x.State == "STALE");
      _blockedCount = _dashboardRows.Count(x => x.State == "BLOCKED");
      _selectedContextKey = _periods.FirstOrDefault()?.Id.ToString("D") ?? string.Empty;
      _clients = profiles.Where(x => clients.ContainsKey(x.ClientId)).Select(x => new ClientRow(
        clients[x.ClientId].LegalName, x.FunctionalCurrency, periods.Count(p => p.ClientId == x.ClientId),
        charts.SingleOrDefault(c => c.ClientId == x.ClientId)?.Status ?? "NO_CHART",
        imports.SingleOrDefault(i => i.ClientId == x.ClientId)?.Status ?? "NO_IMPORT")).OrderBy(x => x.Name).ToList();
      }
      else
      {
        _actor = null;
      }
    }
  }

  private static DashboardRow ToDashboardRow(PeriodRow row, IReadOnlyDictionary<string, PbcTask> pbcByPeriod,
    IReadOnlyDictionary<Guid, WorkTaskSummary> taskByPeriod)
  {
    var pbc = pbcByPeriod.GetValueOrDefault(PeriodKey(row.ClientId, row.StartDate.ToString("yyyy-MM-dd"), row.EndDate.ToString("yyyy-MM-dd")));
    var task = taskByPeriod.GetValueOrDefault(row.Id);
    var state = row.Status == AccountingWorkflowStates.Stale ? "STALE"
      : row.Status == AccountingWorkflowStates.Rejected || row.Package.Contains(AccountingWorkflowStates.Rejected, StringComparison.OrdinalIgnoreCase) ? "BLOCKED"
      : task is not null || pbc is not null && pbc.State is not (PbcStates.Accepted or PbcStates.Closed) ? "REQUIRED"
      : row.Package.StartsWith(AccountingPackageStates.PackageValidated, StringComparison.Ordinal) ? "COMPLETE"
      : "REQUIRED";
    var owner = task?.OwnerName ?? (pbc is not null && pbc.State is not (PbcStates.Accepted or PbcStates.Closed) ? pbc.OwnerName : state switch
    {
      "STALE" or "BLOCKED" => "Engagement manager",
      "COMPLETE" => "No action",
      _ when row.PackageId is null => "Accounting preparer",
      _ => "Accounting reviewer"
    });
    var href = task is not null ? $"/app/accounting/periods/{row.Id}"
      : pbc is not null && pbc.State is not (PbcStates.Accepted or PbcStates.Closed) && row.PackageId is null && row.MappingId is null
      ? $"/app/engagements/{pbc.EngagementId}/pbc"
      : row.PackageId is { } packageId ? $"/app/accounting/packages/{packageId}"
      : row.MappingId is { } mappingId ? $"/app/accounting/mappings/{mappingId}" : $"/app/accounting/periods/{row.Id}";
    var action = task is not null ? "Open period workflow"
      : pbc is not null && pbc.State is not (PbcStates.Accepted or PbcStates.Closed) && row.PackageId is null && row.MappingId is null
      ? "Open PBC request" : row.PackageId is not null ? "Open package" : row.MappingId is not null ? "Open mapping" : "Open period";
    return new(row.Id, row.ClientName, row.PeriodCode, state, owner, task?.DueDate ?? pbc?.DueDate ?? "Not recorded", href, action);
  }

  private static string PeriodKey(Guid clientId, string start, string end) => string.Concat(clientId.ToString("D"), "|", start, "|", end);
}
