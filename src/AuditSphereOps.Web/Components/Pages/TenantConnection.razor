@page "/app/administration/microsoft365/tenant-connection"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Abstractions
@using AuditSphereOps.Application.Microsoft365
@using AuditSphereOps.Infrastructure.Persistence
@using AuditSphereOps.Web.Authentication
@using Microsoft.EntityFrameworkCore
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation

<PageTitle>Microsoft 365 tenant connection</PageTitle>
<MudLink Href="/app/administration" Class="back-link mb-2 d-inline-block">← Firm administration</MudLink>
<PageHeader Title="Microsoft 365 tenant connection" Description="Connect only the configured tenant through Microsoft administrator consent. Each capability is verified separately." />

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading tenant connection…" />
}
else if (_actor is null || _snapshot is null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">
    Current firm-wide AuditSphere Administrator access is required.
  </MudAlert>
}
else
{
  @if (!string.IsNullOrEmpty(_error))
  {
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@_error</MudAlert>
  }
  @if (Result == "returned")
  {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
      Microsoft returned from administrator consent. This is not yet proof that any capability is granted; the separate provider checks remain required.
    </MudAlert>
  }
  else if (Result == "blocked")
  {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
      The consent return was denied or invalid. Check the configured tenant, current administrator session and Microsoft consent policy.
    </MudAlert>
  }
  <MudPaper Class="pa-4 my-4" Elevation="1" aria-labelledby="tenant-connection-heading" role="region">
    <h2 id="tenant-connection-heading">Tenant connection</h2>
    <dl class="details">
      <dt>Expected tenant</dt><dd>@(_snapshot.ExpectedTenantId ?? "Not saved")</dd>
      <dt>Setup draft</dt><dd>@(_snapshot.DraftState ?? "Not prepared")</dd>
      <dt>Connection revision</dt><dd>@(_snapshot.ConnectionState ?? "Not prepared")</dd>
      <dt>Consent record</dt><dd>@(_snapshot.ConsentState ?? "Not recorded")</dd>
      <dt>Last consent return</dt><dd>@(_snapshot.LastAttemptState ?? "Not started")</dd>
      <dt>Last attempt</dt><dd>@(_snapshot.LastAttemptAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
      <dt>Directory reader</dt><dd>Blocked until a separate reader registration, consent and exact-tenant verification are configured.</dd>
      <dt>Selected SharePoint</dt><dd>Verify the saved site, library and root separately in Microsoft 365 setup.</dd>
    </dl>
    <p class="field-help">The Microsoft sign-in and consent screen collects the tenant administrator's credentials; AuditSphere never does. The callback records only a returned claim and cannot identify the person who clicked Grant from that claim alone.</p>
    @if (!_consentConfigured)
    {
      <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
        Tenant consent is not configured. A deployment operator must provide a separate approved directory-reader client ID and exact registered callback URL through private configuration.
      </MudAlert>
    }
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConnectAsync"
      Disabled="@(_busy || !_consentConfigured || _snapshot.DraftId is null)">
      @(_busy ? "Opening Microsoft…" : "Connect Microsoft 365 tenant")
    </MudButton>
    <MudLink Href="/app/administration/microsoft365" Class="ms-2">Review setup draft</MudLink>
  </MudPaper>
}

@code {
  [SupplyParameterFromQuery] public string? Result { get; set; }
  private ActorContext? _actor;
  private TenantConnectionSnapshot? _snapshot;
  private bool _loading = true;
  private bool _busy;
  private bool _consentConfigured;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await TenantConnectionQuery.GetAsync(db, _actor);
      if (result.Succeeded) _snapshot = result.Value;
    }
    _consentConfigured = Configuration.GetValue<bool>("TenantConsent:Enabled") &&
      !string.Equals(Configuration["TenantConsent:ClientId"], Configuration["Identity:ClientId"], StringComparison.OrdinalIgnoreCase) &&
      TenantConsentRedirect.Build(
      Configuration["Identity:TenantId"], Configuration["TenantConsent:ClientId"],
      Configuration["TenantConsent:RedirectUri"], "preview", Environment.IsDevelopment()) is not null;
    _loading = false;
  }

  private async Task ConnectAsync()
  {
    if (!_consentConfigured || _actor is null || _snapshot?.DraftId is not { } draftId) return;
    _busy = true;
    _error = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var start = await TenantConsentService.BeginAsync(db, _actor, draftId,
        Configuration["Identity:TenantId"] ?? string.Empty,
        Configuration["TenantConsent:ClientId"] ?? string.Empty, DateTimeOffset.UtcNow);
      if (!start.Succeeded)
      {
        _error = "Current administrator access and a matching prepared tenant draft are required.";
        return;
      }
      var redirect = TenantConsentRedirect.Build(
        Configuration["Identity:TenantId"], Configuration["TenantConsent:ClientId"],
        Configuration["TenantConsent:RedirectUri"], start.Value!.State, Environment.IsDevelopment());
      if (redirect is null)
      {
        _error = "The deployment-owned consent callback is not configured correctly.";
        return;
      }
      Navigation.NavigateTo(redirect.AbsoluteUri, forceLoad: true);
    }
    finally { _busy = false; }
  }
}
