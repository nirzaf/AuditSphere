@page "/app/administration/microsoft365/tenant-connection"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Abstractions
@using AuditSphereOps.Application.Microsoft365
@using AuditSphereOps.Infrastructure.Persistence
@using AuditSphereOps.Web.Authentication
@using Microsoft.EntityFrameworkCore
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation
@inject IMicrosoftDirectoryReader DirectoryReader
@inject TenantAdministrationSettings AdminSettings

<PageTitle>Microsoft 365 tenant connection</PageTitle>
<MudLink Href="/app/administration" Class="back-link mb-2 d-inline-block">← Firm administration</MudLink>
<PageHeader Title="Microsoft 365 tenant connection" Description="Connect only the configured tenant through Microsoft administrator consent. Each capability is verified separately." />

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading tenant connection…" />
}
else if (_actor is null || _snapshot is null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">
    Current firm-wide AuditSphere Administrator access is required.
  </MudAlert>
}
else
{
  @if (!string.IsNullOrEmpty(_error))
  {
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@_error</MudAlert>
  }
  @if (Result == "verified")
  {
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">
      Tenant administrator consent was verified for the configured tenant, and each capability was checked separately. Review the capability results below; one verified capability does not imply the others.
    </MudAlert>
  }
  else if (Result == "identity-blocked")
  {
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">
      The Microsoft administrator sign-in could not be verified: wrong tenant, external/guest identity, replayed or expired request. No connection state was changed. Start the connection again.
    </MudAlert>
  }
  else if (Result == "returned")
  {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
      Microsoft returned from administrator consent. This is not yet proof that any capability is granted; the separate provider checks remain required.
    </MudAlert>
  }
  else if (Result == "blocked")
  {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
      The consent return was denied or invalid. Check the configured tenant, current administrator session and Microsoft consent policy.
    </MudAlert>
  }
  <MudPaper Class="pa-4 my-4" Elevation="1" aria-labelledby="tenant-connection-heading" role="region">
    <h2 id="tenant-connection-heading">Tenant connection</h2>
    <dl class="details">
      <dt>Expected tenant</dt><dd>@(_snapshot.ExpectedTenantId ?? "Not saved")</dd>
      <dt>Setup draft</dt><dd>@(_snapshot.DraftState ?? "Not prepared")</dd>
      <dt>Connection revision</dt><dd>@(_snapshot.ConnectionState ?? "Not prepared")</dd>
      <dt>Consent record</dt><dd>@(_snapshot.ConsentState ?? "Not recorded")</dd>
      <dt>Last consent return</dt><dd>@(_snapshot.LastAttemptState ?? "Not started")</dd>
      <dt>Last attempt</dt><dd>@(_snapshot.LastAttemptAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
      <dt>Directory reader</dt><dd>@(_directoryConfigured ? "Configured for bounded live search; verify each result before local access assignment." : "Blocked until a separate reader registration, certificate and User.Read.All consent are configured.")</dd>
      <dt>Directory exact-member read check</dt><dd>@_snapshot.DirectoryCapabilityState (last checked @(_snapshot.DirectoryLastCheckedAt?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "never"))</dd>
      <dt>Selected SharePoint</dt><dd>Verify the saved site, library and root separately in Microsoft 365 setup.</dd>
      <dt>Consenting administrator</dt><dd>@(_consentingAdmin ?? "Not verified")</dd>
    </dl>
    @if (_capabilities.Count > 0)
    {
      <MudSimpleTable Dense="true" Class="my-2" aria-label="Capability status">
        <thead><tr><th>Capability</th><th>Permission</th><th>State</th><th>Last verification</th></tr></thead>
        <tbody>
          @foreach (var capability in _capabilities)
          {
            <tr><td>@capability.DisplayName</td><td><code>@capability.Permission</code></td><td><StatusChip Status="@capability.State" /></td><td>@(capability.LastVerifiedAt?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Never")</td></tr>
          }
        </tbody>
      </MudSimpleTable>
    }
    @if (AdminSettings.Simulation)
    {
      <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">Simulation mode: Microsoft pages are simulated for local development and tests. No real tenant is contacted.</MudAlert>
    }
    <p class="field-help">The Microsoft sign-in and consent screen collects the tenant administrator's credentials; AuditSphere never does. The callback records only a returned claim and cannot identify the person who clicked Grant from that claim alone.</p>
    @if (!_consentConfigured)
    {
      <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
        Tenant consent is not configured. A deployment operator must provide a separate approved directory-reader client ID and exact registered callback URL through private configuration.
      </MudAlert>
    }
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConnectAsync"
      Disabled="@(_busy || !_consentConfigured || _snapshot.DraftId is null)">
      @(_busy ? "Opening Microsoft…" : "Connect Microsoft 365 tenant")
    </MudButton>
    <MudLink Href="/app/administration/microsoft365" Class="ms-2">Review setup draft</MudLink>
    <div class="mt-3">
      <MudButton Variant="Variant.Outlined" OnClick="VerifyDirectoryAsync"
        Disabled="@(_verifyBusy || !_directoryConfigured || _snapshot.DraftId is null)">
        @(_verifyBusy ? "Checking Microsoft…" : "Verify directory access")
      </MudButton>
      @if (!string.IsNullOrEmpty(_verifyMessage))
      {
        <MudAlert Severity="@(_verifyPassed ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined" role="status">@_verifyMessage</MudAlert>
      }
    </div>
  </MudPaper>
  <MudPaper Class="pa-4 my-4" Elevation="1" aria-labelledby="directory-search-heading" role="region">
    <h2 id="directory-search-heading">Microsoft directory search</h2>
    <p class="field-help">Searches at most 25 matching users per page from the configured tenant. A search result grants no AuditSphere access.</p>
    @if (!_directoryConfigured)
    {
      <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">The separate read-only directory reader is disabled or incomplete.</MudAlert>
    }
    else
    {
      <MudTextField T="string" Label="Display name or user principal name prefix" @bind-Value="_searchPrefix" Immediate="true" MaxLength="80" />
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SearchDirectoryAsync" Disabled="@_searchBusy">@(_searchBusy ? "Searching…" : "Search directory")</MudButton>
      @if (!string.IsNullOrEmpty(_searchError))
      {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">@_searchError</MudAlert>
      }
      @if (_searchPage is not null)
      {
        <p class="field-help" role="status">Live read returned. Provider access for this request does not activate the tenant connection.</p>
        @if (_searchPage.Users.Count == 0)
        {
          <p>No matching users in this page.</p>
        }
        else
        {
          <MudTable Items="_searchPage.Users" Dense="true" Elevation="0">
            <HeaderContent><MudTh>Name</MudTh><MudTh>Microsoft identity</MudTh><MudTh>State</MudTh><MudTh>Local binding</MudTh></HeaderContent>
            <RowTemplate>
              <MudTd DataLabel="Name">@context.DisplayName</MudTd>
              <MudTd DataLabel="Microsoft identity">@context.UserPrincipalName<br /><code>@context.ObjectId</code></MudTd>
              <MudTd DataLabel="State">@(context.AccountEnabled ? "Enabled" : "Disabled") (@context.UserType)</MudTd>
              <MudTd DataLabel="Local binding">
                @if (context.AccountEnabled && context.UserType == "Member")
                {
                  <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@_bindBusy"
                    OnClick="() => BindDirectoryMemberAsync(context.ObjectId)">Bind exact identity</MudButton>
                }
                else { <span>Unavailable for this account type</span> }
              </MudTd>
            </RowTemplate>
          </MudTable>
        }
        @if (_searchPage.NextPageToken is not null)
        {
          <MudButton Variant="Variant.Outlined" OnClick="NextDirectoryPageAsync" Disabled="@_searchBusy">Next 25</MudButton>
        }
        @if (!string.IsNullOrWhiteSpace(_bindError))
        {
          <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">@_bindError</MudAlert>
        }
        @if (_boundUserId is { } boundUserId)
        {
          <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">
            Exact Microsoft identity bound locally. No new role has been granted.
            <MudLink Href="@($"/app/administration?selectedUserId={boundUserId:D}")">Review role and scope</MudLink>
          </MudAlert>
        }
      }
    }
  </MudPaper>
}

@code {
  [SupplyParameterFromQuery] public string? Result { get; set; }
  private ActorContext? _actor;
  private TenantConnectionSnapshot? _snapshot;
  private bool _loading = true;
  private bool _busy;
  private bool _consentConfigured;
  private bool _directoryConfigured;
  private string? _error;
  private string _searchPrefix = string.Empty;
  private string? _searchError;
  private DirectoryCandidatePage? _searchPage;
  private bool _searchBusy;
  private bool _bindBusy;
  private Guid? _boundUserId;
  private string? _bindError;
  private bool _verifyBusy;
  private bool _verifyPassed;
  private string? _verifyMessage;
  private IReadOnlyList<CapabilityStatus> _capabilities = [];
  private string? _consentingAdmin;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await TenantConnectionQuery.GetAsync(db, _actor);
      if (result.Succeeded) _snapshot = result.Value;
    }
    if (_actor is not null && _snapshot is not null)
    {
      await using var statusDb = await DbFactory.CreateDbContextAsync();
      _capabilities = await TenantCapabilityService.StatusesAsync(statusDb, _actor.FirmId, AdminSettings.Options, DateTimeOffset.UtcNow);
      _consentingAdmin = await statusDb.TenantConsentAttempts.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId && x.State == AuditSphereOps.Domain.Microsoft365.TenantConsentAttemptStates.ConsentVerified)
        .OrderByDescending(x => x.ConsentVerifiedAt)
        .Select(x => x.ConsentingTenantId + " / " + x.ConsentingObjectId)
        .FirstOrDefaultAsync();
    }
    _consentConfigured = AdminSettings.Simulation || Configuration.GetValue<bool>("TenantConsent:Enabled") &&
      !string.Equals(Configuration["TenantConsent:ClientId"], Configuration["Identity:ClientId"], StringComparison.OrdinalIgnoreCase) &&
      TenantConsentRedirect.Build(
      Configuration["Identity:TenantId"], Configuration["TenantConsent:ClientId"],
      Configuration["TenantConsent:RedirectUri"], "preview", Environment.IsDevelopment()) is not null;
    _directoryConfigured = AdminSettings.Simulation || Configuration.GetValue<bool>("DirectoryReader:Enabled") &&
      Guid.TryParse(Configuration["DirectoryReader:ClientId"], out _) &&
      string.Equals(Configuration["DirectoryReader:ClientId"], Configuration["TenantConsent:ClientId"], StringComparison.OrdinalIgnoreCase) &&
      !string.IsNullOrWhiteSpace(Configuration["DirectoryReader:CertificatePath"]) &&
      !string.IsNullOrWhiteSpace(Configuration["DirectoryReader:PrivateKeyPath"]);
    _loading = false;
  }

  private Task SearchDirectoryAsync() => RunSearchAsync(null);
  private Task NextDirectoryPageAsync() => RunSearchAsync(_searchPage?.NextPageToken);

  private async Task RunSearchAsync(string? pageToken)
  {
    if (!_directoryConfigured || _actor is null)
    {
      _searchError = "Directory search requires the configured reader and a current administrator session.";
      return;
    }
    _searchBusy = true;
    _searchError = null;
    _searchPage = null;
    _boundUserId = null;
    _bindError = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await DirectoryDiscoveryService.SearchAsync(db, _actor, DirectoryReader,
        AdminSettings.Options.TenantId, _searchPrefix, pageToken);
      if (result.Succeeded) _searchPage = result.Value;
      else _searchError = result.Message ?? "Directory access is unavailable.";
    }
    finally { _searchBusy = false; }
  }

  private async Task BindDirectoryMemberAsync(string objectId)
  {
    if (!_directoryConfigured || _actor is null || !Guid.TryParse(objectId, out var exactId)) return;
    _bindBusy = true;
    _bindError = null;
    _boundUserId = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await DirectoryUserBindingService.BindMemberAsync(db, _actor, DirectoryReader,
        AdminSettings.Options.TenantId, exactId);
      if (result.Succeeded) _boundUserId = result.Value;
      else _bindError = result.Message ?? "The Microsoft identity could not be bound.";
    }
    finally { _bindBusy = false; }
  }

  private async Task VerifyDirectoryAsync()
  {
    if (!_directoryConfigured || _actor is null) return;
    _verifyBusy = true;
    _verifyMessage = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await DirectoryCapabilityVerificationService.VerifyAsync(db, _actor,
        DirectoryReader, AdminSettings.Options.TenantId,
        AdminSettings.Simulation ? "00000000-0000-0000-0000-00000000c0de" : Configuration["DirectoryReader:ClientId"] ?? string.Empty,
        DateTimeOffset.UtcNow);
      _verifyPassed = result.Succeeded;
      _verifyMessage = result.Succeeded
        ? "A bounded Graph read verified the separate directory reader for this connection revision. Tenant consent and other capabilities remain separate."
        : result.Message ?? "Directory access could not be verified.";
      var snapshot = await TenantConnectionQuery.GetAsync(db, _actor);
      if (snapshot.Succeeded) _snapshot = snapshot.Value;
    }
    finally { _verifyBusy = false; }
  }

  private async Task ConnectAsync()
  {
    if (!_consentConfigured || _actor is null || _snapshot?.DraftId is not { } draftId) return;
    _busy = true;
    _error = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var start = await TenantConsentService.BeginAsync(db, _actor, draftId,
        AdminSettings.Options.TenantId,
        AdminSettings.Simulation ? "00000000-0000-0000-0000-00000000c0de" : Configuration["TenantConsent:ClientId"] ?? string.Empty,
        DateTimeOffset.UtcNow);
      if (!start.Succeeded)
      {
        _error = "Current administrator access and a matching prepared tenant draft are required.";
        return;
      }
      if (AdminSettings.Simulation)
      {
        Navigation.NavigateTo($"/auth/m365-consent/simulated-consent?state={Uri.EscapeDataString(start.Value!.State)}", forceLoad: true);
        return;
      }
      var redirect = TenantConsentRedirect.Build(
        Configuration["Identity:TenantId"], Configuration["TenantConsent:ClientId"],
        Configuration["TenantConsent:RedirectUri"], start.Value!.State, Environment.IsDevelopment());
      if (redirect is null)
      {
        _error = "The deployment-owned consent callback is not configured correctly.";
        return;
      }
      Navigation.NavigateTo(redirect.AbsoluteUri, forceLoad: true);
    }
    finally { _busy = false; }
  }
}
