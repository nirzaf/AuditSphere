@page "/app/practice/proposals/{Id:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Security
@using AuditSphereOps.Domain.Practice
@using AuditSphereOps.Web.Components.Commercial
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject ILogger<ProposalDetail> Logger

<PageTitle>Proposal — AuditSphereOps</PageTitle>

<div class="page-header">
  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a href="/app">Portfolio</a> /
    <a href="/app/practice/leads">Leads &amp; Opportunities</a> /
    <span>Proposal</span>
  </nav>
  <PageHeader Title="Proposal" Eyebrow="Practice commercial" Description="Persisted proposal revision, terms, review and client response recorded for the opportunity." />
</div>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading proposal…" />
}
else if (_actor is null || !_isAuthorized)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">Sign in with an authorized firm-wide commercial identity to view proposals.</MudText>
  </MudAlert>
}
else if (_loadError is not null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Proposal could not be loaded</h2>
    <MudText Typo="Typo.body2">@_loadError</MudText>
  </MudAlert>
}
else if (_proposal is null || _opportunity is null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Proposal unavailable</h2>
    <MudText Typo="Typo.body2">The requested proposal is not available in the current firm scope.</MudText>
  </MudAlert>
}
else
{
  <div class="audit-record-toolbar" aria-label="Proposal navigation">
    <StatusChip Status="@_proposal.Status" />
    <MudLink Href="/app/practice/leads">Leads &amp; opportunities</MudLink>
  </div>
  <MudGrid Spacing="2" Class="audit-accounting-metrics my-3" aria-label="Proposal summary">
    <MudItem xs="6" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Revision</MudText><MudText Typo="Typo.h4">@_proposal.Revision</MudText></MudPaper></MudItem>
    <MudItem xs="6" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Proposed fee (@_proposal.Currency)</MudText><MudText Typo="Typo.h4">@_proposal.Fee.ToString("N2")</MudText></MudPaper></MudItem>
    <MudItem xs="12" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Recorded versions</MudText><MudText Typo="Typo.h4">@_versions.Count</MudText></MudPaper></MudItem>
  </MudGrid>
  <MudButton Variant="Variant.Outlined" Class="btn-secondary mb-2" OnClick="RefreshProposalAsync">Refresh proposal</MudButton>

  <MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" aria-labelledby="proposal-details-heading" role="region">
    <p class="eyebrow">Status: @_proposal.Status · Revision @_proposal.Revision</p>
    <h2 id="proposal-details-heading">@_clientName</h2>
    <dl class="detail-grid">
      <dt>Proposal ID</dt><dd><code>@_proposal.Id</code></dd>
      <dt>Opportunity stage</dt><dd>@_opportunity.Stage</dd>
      <dt>Lead</dt><dd>@_leadName</dd>
      <dt>Service profile</dt><dd>@_proposal.ServiceProfileId</dd>
      <dt>Entity scope</dt><dd>@_opportunity.EntityScope</dd>
      <dt>Service route</dt><dd>@_opportunity.ServiceRoute</dd>
      <dt>Period</dt><dd>@_proposal.PeriodStart to @_proposal.PeriodEnd</dd>
      <dt>Proposed fee</dt><dd>@_proposal.Fee.ToString("N2") @_proposal.Currency</dd>
      <dt>Commercial owner</dt><dd>@_ownerName</dd>
      <dt>Proposal author</dt><dd>@_authorName</dd>
      <dt>Validity</dt><dd>Not recorded in the current proposal schema</dd>
      <dt>Internal review</dt><dd>@_reviewerName @(_proposal.ApprovedAt.HasValue ? $"· {_proposal.ApprovedAt.Value.ToString("yyyy-MM-dd HH:mm")} UTC" : "· Not recorded")</dd>
      <dt>Delivery</dt><dd>@(_proposal.SentAt.HasValue ? $"Recorded sent {_proposal.SentAt.Value.ToString("yyyy-MM-dd HH:mm")} UTC" : "Not recorded as sent")</dd>
      <dt>Client response</dt><dd>@(_proposal.ResponseAt.HasValue ? $"{_proposal.Status} · {_proposal.ResponseAt.Value.ToString("yyyy-MM-dd HH:mm")} UTC" : "Not recorded")</dd>
      @if (!string.IsNullOrWhiteSpace(_proposal.ResponseReason))
      {
        <dt>Response note</dt><dd>@_proposal.ResponseReason</dd>
      }
      @if (_proposal.SupersedesId.HasValue)
      {
        <dt>Supersedes</dt><dd><code>@_proposal.SupersedesId</code></dd>
      }
    </dl>
  </MudPaper>

  <MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" aria-labelledby="terms-heading" role="region">
    <h2 id="terms-heading">Proposal terms</h2>
    <dl class="detail-grid">
      <dt>Scope</dt><dd>@_proposal.Scope</dd>
      <dt>Exclusions</dt><dd>@(string.IsNullOrWhiteSpace(_proposal.Exclusions) ? "Not specified" : _proposal.Exclusions)</dd>
      <dt>Deliverables</dt><dd>@_proposal.Deliverables</dd>
      <dt>Dependencies</dt><dd>@(string.IsNullOrWhiteSpace(_proposal.Dependencies) ? "Not specified" : _proposal.Dependencies)</dd>
    </dl>
  </MudPaper>

  <MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" aria-labelledby="versions-heading" role="region">
    <h2 id="versions-heading">Proposal versions</h2>
    <MudTable Items="_versions" Dense="true" Hover="true" Elevation="0">
      <HeaderContent>
        <MudTh>Revision</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Fee</MudTh>
        <MudTh>Created</MudTh>
        <MudTh>Sent</MudTh>
        <MudTh>Response</MudTh>
      </HeaderContent>
      <RowTemplate>
        <MudTd DataLabel="Revision">@context.Revision</MudTd>
        <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
        <MudTd DataLabel="Fee">@context.Fee.ToString("N2") @context.Currency</MudTd>
        <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</MudTd>
        <MudTd DataLabel="Sent">@(context.SentAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudTd>
        <MudTd DataLabel="Response">@(context.ResponseAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudTd>
      </RowTemplate>
      <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
      </PagerContent>
    </MudTable>
  </MudPaper>

  @if (_flash is not null)
  {
    <p class="command-result success-text" role="status">@_flash</p>
  }
  <QuotationWorkbench @key="_proposal.Id" Proposal="_proposal" OnChanged="ChangedAsync" />
  <FeeAgreementPanel @key="@($"fee-{_proposal.Id}")" Proposal="_proposal" OnChanged="ChangedAsync" />
  <ProposalWorkflowPanel @key="@($"flow-{_proposal.Id}")" Proposal="_proposal" LeadName="@_leadName" OnChanged="ChangedAsync" />
}

@code {
  [Parameter] public Guid Id { get; set; }

  private static readonly string[] CommercialRoles = ["Administrator", "Partner", "Manager", "RelationshipManager"];

  private ActorContext? _actor;
  private Proposal? _proposal;
  private Opportunity? _opportunity;
  private bool _loading = true;
  private bool _isAuthorized;
  private string? _loadError;
  private int _loadGeneration;
  private string _clientName = string.Empty;
  private string _leadName = string.Empty;
  private string _ownerName = "Not assigned";
  private string _authorName = "Not recorded (legacy proposal)";
  private string _reviewerName = "Not recorded";
  private List<ProposalVersionRow> _versions = [];

  private sealed record ProposalVersionRow(
    long Revision, string Status, decimal Fee, string Currency,
    DateTimeOffset CreatedAt, DateTimeOffset? SentAt, DateTimeOffset? ResponseAt);

  private Task RefreshProposalAsync() => OnParametersSetAsync();

  // A child's confirmation must survive the reload that follows a successful command, so the parent keeps it.
  private string? _flash;
  private Guid _flashFor;

  private async Task ChangedAsync(string message)
  {
    _flash = message;
    _flashFor = Id;
    await OnParametersSetAsync();
  }

  protected override async Task OnParametersSetAsync()
  {
    var generation = ++_loadGeneration;
    if (_flashFor != Id) _flash = null;
    var actor = (ActorContext?)null;
    var authorized = false;
    ClearProjection();
    _loading = true;
    try
    {
      actor = await ActorResolver.ResolveAsync();
      if (generation != _loadGeneration || actor is null) return;

      await using var db = await DbFactory.CreateDbContextAsync();
      var authorization = await AuthorizationDecision.AuthorizeAsync(db, actor,
        new AuthorizationRequest(actor.FirmId, RequiredRoles: CommercialRoles,
          InternalOnly: true, RequireFirmWide: true));
      if (generation != _loadGeneration || !authorization.Succeeded) return;
      authorized = true;
      _actor = actor;
      _isAuthorized = true;

      var proposal = await db.Proposals.AsNoTracking()
        .SingleOrDefaultAsync(x => x.Id == Id && x.FirmId == actor.FirmId);
      if (generation != _loadGeneration) return;
      if (proposal is null) return;

      var opportunity = await db.Opportunities.AsNoTracking()
        .SingleOrDefaultAsync(x => x.Id == proposal.OpportunityId && x.FirmId == actor.FirmId);
      if (generation != _loadGeneration) return;
      if (opportunity is null) return;
      var lead = await db.Leads.AsNoTracking()
        .SingleOrDefaultAsync(x => x.Id == opportunity.LeadId && x.FirmId == actor.FirmId);
      if (generation != _loadGeneration) return;
      if (lead is null) return;

      var clientName = lead.Name;
      var clientId = proposal.PracticeClientId ?? opportunity.PracticeClientId;
      if (clientId.HasValue)
      {
        var client = await db.PracticeClients.AsNoTracking()
          .SingleOrDefaultAsync(x => x.Id == clientId.Value && x.FirmId == actor.FirmId);
        if (generation != _loadGeneration) return;
        if (client is null) return;
        clientName = client.LegalName;
      }

      var ownerName = "Not assigned";
      var ownerId = opportunity.OwnerUserId ?? lead.OwnerUserId;
      if (ownerId.HasValue)
        ownerName = await db.Users.AsNoTracking()
          .Where(x => x.Id == ownerId.Value && x.FirmId == actor.FirmId && !x.Disabled)
          .Select(x => x.DisplayName).SingleOrDefaultAsync() ?? "Not assigned";

      var authorName = proposal.PreparedByUserId.HasValue
        ? await db.Users.AsNoTracking()
          .Where(x => x.Id == proposal.PreparedByUserId.Value && x.FirmId == actor.FirmId)
          .Select(x => x.DisplayName).SingleOrDefaultAsync() ?? "Author unavailable"
        : "Not recorded (legacy proposal)";

      var reviewerName = "Not recorded";
      if (proposal.ApprovedByUserId.HasValue)
        reviewerName = await db.Users.AsNoTracking()
          .Where(x => x.Id == proposal.ApprovedByUserId.Value && x.FirmId == actor.FirmId)
          .Select(x => x.DisplayName).SingleOrDefaultAsync() ?? "Reviewer unavailable";

      var versions = (await db.Proposals.AsNoTracking()
          .Where(x => x.FirmId == actor.FirmId && x.OpportunityId == opportunity.Id)
          .OrderBy(x => x.Revision).ToListAsync())
        .Select(x => new ProposalVersionRow(x.Revision, x.Status, x.Fee, x.Currency,
          x.CreatedAt, x.SentAt, x.ResponseAt)).ToList();
      if (generation != _loadGeneration) return;

      _proposal = proposal;
      _opportunity = opportunity;
      _clientName = clientName;
      _leadName = lead.Name;
      _ownerName = ownerName;
      _authorName = authorName;
      _reviewerName = reviewerName;
      _versions = versions;
    }
    catch (Exception ex)
    {
      if (generation == _loadGeneration)
      {
        Logger.LogError(ex, "Failed to load proposal detail for route {ProposalId}", Id);
        _actor = actor;
        _isAuthorized = authorized;
        _loadError = "The proposal details could not be loaded. Retry by refreshing this page.";
      }
    }
    finally
    {
      if (generation == _loadGeneration) _loading = false;
    }
  }

  private void ClearProjection()
  {
    _actor = null;
    _proposal = null;
    _opportunity = null;
    _isAuthorized = false;
    _loadError = null;
    _clientName = string.Empty;
    _leadName = string.Empty;
    _ownerName = "Not assigned";
    _authorName = "Not recorded (legacy proposal)";
    _reviewerName = "Not recorded";
    _versions.Clear();
  }
}
