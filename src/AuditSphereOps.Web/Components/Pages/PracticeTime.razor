@page "/app/practice/time"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Accounting
@using AuditSphereOps.Application.Practice
@using AuditSphereOps.Domain.Practice
@using AuditSphereOps.Domain.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Time & work records</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Practice time &amp; task records" Description="Time entries are recorded against assigned firm tasks with exact integer minutes, immutable rate snapshots, and independent approval segregation." />

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading time records…" />
}
else if (_actor is null || !_isStaff)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">Sign in with an authorized internal staff identity to view and record time.</MudText>
  </MudAlert>
}
else
{
  <p class="scope-note">Time entries are recorded against assigned firm tasks with exact integer minutes, immutable rate snapshots, and independent approval segregation.</p>

  @if (_result is not null)
  {
    <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">
      @(_result.Succeeded ? (_successMessage ?? "Action completed successfully.") : "Blocked: " + _result.ErrorCode)
    </p>
  }

  <section class="card" aria-labelledby="task-heading" data-draft-scope="practice-task">
    <h2 id="task-heading">Create work task</h2>
    <p class="scope-note">Link an optional accounting period when the task belongs to a client reporting workflow. Due dates are optional and are never inferred.</p>
<!-- Native controls retained: both <form> elements are draft-state.js boundaries (auto-discovered form scopes; the "Record time draft" region is E2E-pinned) and the script reads/writes control.value + checked with change-event restore. -->
    <form @onsubmit="CreateTaskAsync" @onsubmit:preventDefault="true" style="display: grid; gap: 0.75rem; max-width: 32rem;">
      <label>
        Task title <span class="required-marker" aria-hidden="true">*</span>
        <input class="input" @bind="_taskTitle" required disabled="@_busy" title="Short description of the work to be completed." autocomplete="off" />
      </label>
      <label>
        Reporting period <span class="optional-label">(optional)</span>
        <select class="input" @bind="_taskPeriodKey" data-optional="true" disabled="@_busy" title="Link this task to the exact client reporting period shown on the accounting dashboard.">
          <option value="" disabled="@(!_firmWide)">No period link (firm-wide task)</option>
          @foreach (var period in _periodOptions)
          {
            <option value="@period.Id">@period.Label</option>
          }
        </select>
      </label>
      <label>
        Due date <span class="optional-label">(optional)</span>
        <input class="input" type="date" @bind="_taskDueDate" data-optional="true" disabled="@_busy" title="Persist the agreed deadline; leave blank when no deadline has been recorded." />
      </label>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" ButtonType="ButtonType.Submit" Disabled="@_busy">Create task</MudButton>
    </form>
  </section>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="log-heading" role="region">
    <h2 id="log-heading">Record time draft</h2>
    @if (_availableTasks.Count == 0)
    {
      <p class="muted">No open tasks are currently available to book time against. Create or assign an open task first.</p>
    }
    else
    {
      <form @onsubmit="SaveTimeDraftAsync" @onsubmit:preventDefault="true" style="display: grid; gap: 0.75rem; max-width: 32rem;">
        <label>
          Work task
          <select class="input" @bind="_selectedTaskId" required disabled="@_busy">
            @foreach (var task in _availableTasks)
            {
              <option value="@task.Id">@task.Title (@task.Status)</option>
            }
          </select>
        </label>
        <div style="display: flex; gap: 0.75rem;">
          <label style="flex: 1;">
            Date
            <input class="input" type="date" @bind="_workDate" required disabled="@_busy" />
          </label>
          <label style="flex: 1;">
            Duration (minutes)
            <input class="input" type="number" min="15" step="15" @bind="_durationMinutes" required disabled="@_busy" />
          </label>
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <label style="flex: 1;">
            Role
            <input class="input" @bind="_role" placeholder="Staff, Manager, Partner" required disabled="@_busy" />
          </label>
          <label style="flex: 1;">
            Activity
            <input class="input" @bind="_activity" placeholder="Fieldwork, Review, Planning" required disabled="@_busy" />
          </label>
        </div>
        <label style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" @bind="_isBillable" disabled="@_busy" data-optional="true" />
          Billable to client (optional)
        </label>
        <label>
          Narrative (optional)
          <textarea class="input" @bind="_narrative" rows="2" placeholder="Summary of work performed" disabled="@_busy" data-optional="true"></textarea>
        </label>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" ButtonType="ButtonType.Submit" Disabled="@_busy">Save time draft</MudButton>
      </form>
    }
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="my-time-heading" role="region">
    <h2 id="my-time-heading">My recorded time</h2>
    @if (_myEntries.Count == 0)
    {
      <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">You have not recorded any time entries in the current firm scope.</MudText>
    }
    else
    {
      <div class="table-wrap">
        <MudTable Items="_myEntries" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Date</MudTh>
              <MudTh scope="col">Task</MudTh>
              <MudTh scope="col">Duration</MudTh>
              <MudTh scope="col">Classification</MudTh>
              <MudTh scope="col">Status</MudTh>
              <MudTh scope="col"><span class="sr-only">Actions</span></MudTh></HeaderContent>
  <RowTemplate>
            @{ var taskTitle = _taskMap.TryGetValue(context.TaskId, out var t) ? t : context.TaskId.ToString(); }
              <MudTd>@context.WorkDate.ToString("yyyy-MM-dd")</MudTd>
              <MudTd>@taskTitle</MudTd>
              <MudTd>@(context.DurationMinutes)m (@((context.DurationMinutes / 60.0).ToString("0.0"))h)</MudTd>
              <MudTd>@context.BillableClassification</MudTd>
              <MudTd><StatusChip Status="@context.Status" /></MudTd>
              <MudTd>
                @if (context.Status == PracticeTimeStates.TimeDraft)
                {
                  <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button small" OnClick="() => SubmitTimeAsync(context.Id)" Disabled="@_busy" Size="Size.Small">Submit</MudButton>
                }
                else
                {
                  <span class="muted">@context.Status</span>
                }
              </MudTd></RowTemplate>
</MudTable>
      </div>
    }
  </MudPaper>

  @if (_isApprover)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="queue-heading" role="region">
      <h2 id="queue-heading">Time approval queue</h2>
      <p class="scope-note">Independent approval segregation: managers and partners cannot approve their own time entries.</p>
      @if (_submittedEntries.Count == 0)
      {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">No pending submitted time entries awaiting approval.</MudText>
      }
      else
      {
        <div class="table-wrap">
          <MudTable Items="_submittedEntries" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Date</MudTh>
                <MudTh scope="col">Staff User</MudTh>
                <MudTh scope="col">Task</MudTh>
                <MudTh scope="col">Duration</MudTh>
                <MudTh scope="col">Activity</MudTh>
                <MudTh scope="col">Narrative</MudTh>
                <MudTh scope="col"><span class="sr-only">Action</span></MudTh></HeaderContent>
  <RowTemplate>
            @{ var taskTitle = _taskMap.TryGetValue(context.TaskId, out var t) ? t : context.TaskId.ToString(); }
                <MudTd>@context.WorkDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd><code>@context.UserId</code></MudTd>
                <MudTd>@taskTitle</MudTd>
                <MudTd>@(context.DurationMinutes)m</MudTd>
                <MudTd>@context.Activity</MudTd>
                <MudTd>@context.Narrative</MudTd>
                <MudTd>
                  <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button small" OnClick="() => ApproveTimeAsync(context.Id)" Disabled="@_busy" Size="Size.Small">Approve</MudButton>
                </MudTd></RowTemplate>
</MudTable>
        </div>
      }
    </MudPaper>
  }
}

@code {
  private sealed record PeriodOption(Guid Id, Guid ClientId, Guid? EngagementId, string Label);
  private static readonly string[] WorkRoles = ["Staff", "Manager", "Partner", "Administrator"];
  private static readonly string[] ApprovalRoles = ["Manager", "Partner", "Administrator"];
  private ActorContext? _actor;
  private bool _isStaff;
  private bool _isApprover;
  private bool _firmWide;
  private List<WorkTask> _availableTasks = [];
  private List<PeriodOption> _periodOptions = [];
  private Dictionary<Guid, string> _taskMap = [];
  private List<TimeEntry> _myEntries = [];
  private List<TimeEntry> _submittedEntries = [];
  private CommandResult? _result;
  private string? _successMessage;
  private bool _loading = true;
  private bool _busy;

  private Guid _selectedTaskId;
  private DateOnly _workDate = DateOnly.FromDateTime(DateTime.UtcNow);
  private int _durationMinutes = 60;
  private string _role = "Staff";
  private string _activity = "Fieldwork";
  private bool _isBillable = true;
  private string _narrative = string.Empty;
  private string _taskTitle = string.Empty;
  private string _taskPeriodKey = string.Empty;
  private DateOnly? _taskDueDate;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    await LoadDataAsync();
    _loading = false;
  }

  private async Task LoadDataAsync()
  {
    _availableTasks = [];
    _periodOptions = [];
    _taskMap = [];
    _myEntries = [];
    _submittedEntries = [];
    _isStaff = false;
    _isApprover = false;
    _firmWide = false;
    if (_actor is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
      new AuthorizationRequest(_actor.FirmId, RequiredRoles: WorkRoles, InternalOnly: true));
    if (!authorization.Succeeded)
    {
      _actor = null;
      return;
    }
    var grants = await db.RoleGrants.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.UserId == _actor.UserId && x.RevokedAt == null)
      .Select(x => new { x.Role, x.ClientId, x.EngagementId }).ToListAsync();
    var workGrants = grants.Where(x => WorkRoles.Contains(x.Role)).ToArray();
    var approvalGrants = grants.Where(x => ApprovalRoles.Contains(x.Role)).ToArray();
    _firmWide = workGrants.Any(x => x.ClientId is null && x.EngagementId is null);
    var directClientIds = workGrants.Where(x => x.ClientId.HasValue && x.EngagementId is null)
      .Select(x => x.ClientId!.Value).Distinct().ToArray();
    var grantEngagementIds = workGrants.Concat(approvalGrants).Where(x => x.EngagementId.HasValue)
      .Select(x => x.EngagementId!.Value).Distinct().ToArray();
    var engagementClients = grantEngagementIds.Length == 0 ? new Dictionary<Guid, Guid>() : await db.Engagements.AsNoTracking()
      .Where(x => x.FirmId == _actor.FirmId && grantEngagementIds.Contains(x.Id))
      .ToDictionaryAsync(x => x.Id, x => x.PracticeClientId);
    var grantedEngagementIds = workGrants.Where(x => x.ClientId.HasValue && x.EngagementId.HasValue &&
        engagementClients.TryGetValue(x.EngagementId.Value, out var clientId) && clientId == x.ClientId.Value)
      .Select(x => x.EngagementId!.Value).Distinct().ToArray();
    var reviewFirmWide = approvalGrants.Any(x => x.ClientId is null && x.EngagementId is null);
    var reviewClientIds = approvalGrants.Where(x => x.ClientId.HasValue && x.EngagementId is null)
      .Select(x => x.ClientId!.Value).Distinct().ToArray();
    var reviewEngagementIds = approvalGrants.Where(x => x.ClientId.HasValue && x.EngagementId.HasValue &&
        engagementClients.TryGetValue(x.EngagementId.Value, out var clientId) && clientId == x.ClientId.Value)
      .Select(x => x.EngagementId!.Value).Distinct().ToArray();
    _isStaff = _firmWide || directClientIds.Length > 0 || grantedEngagementIds.Length > 0;
    _isApprover = reviewFirmWide || reviewClientIds.Length > 0 || reviewEngagementIds.Length > 0;
    if (!_isStaff) return;

    var periods = await db.ClientReportingPeriods.AsNoTracking()
      .Where(x => x.FirmId == _actor.FirmId && (_firmWide || directClientIds.Contains(x.ClientId)))
      .OrderByDescending(x => x.EndDate).ThenBy(x => x.PeriodCode).ToListAsync();
    var periodClientNames = await db.PracticeClients.AsNoTracking()
      .Where(x => x.FirmId == _actor.FirmId && periods.Select(p => p.ClientId).Contains(x.Id))
      .ToDictionaryAsync(x => x.Id, x => x.LegalName);
    _periodOptions = periods.Select(x => new PeriodOption(x.Id, x.ClientId, null,
      $"{periodClientNames.GetValueOrDefault(x.ClientId, "Scoped client")} · {x.PeriodCode} · {x.Currency}")).ToList();

    var scopedEngagementIds = _firmWide ? [] : await db.Engagements.AsNoTracking()
      .Where(x => x.FirmId == _actor.FirmId && (directClientIds.Contains(x.PracticeClientId) || grantedEngagementIds.Contains(x.Id)))
      .Select(x => x.Id).ToArrayAsync();
    var scopedEngagementClients = await db.Engagements.AsNoTracking()
      .Where(x => x.FirmId == _actor.FirmId && (_firmWide || scopedEngagementIds.Contains(x.Id)))
      .ToDictionaryAsync(x => x.Id, x => x.PracticeClientId);
    var tasks = await db.WorkTasks.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
      (_firmWide || (x.EngagementId.HasValue && scopedEngagementIds.Contains(x.EngagementId.Value)) ||
        (!x.EngagementId.HasValue && x.ClientId.HasValue && directClientIds.Contains(x.ClientId.Value))))
      .OrderBy(x => x.Title).ToListAsync();
    var visibleTasks = tasks.Where(x => x.EngagementId is null ||
      (x.ClientId.HasValue && scopedEngagementClients.TryGetValue(x.EngagementId.Value, out var clientId) && clientId == x.ClientId.Value)).ToList();
    var taskById = visibleTasks.ToDictionary(x => x.Id);
    _availableTasks = visibleTasks.Where(x => x.Status != PracticeTimeStates.TaskCancelled && x.Status != PracticeTimeStates.TaskCompleted).ToList();

    if (_selectedTaskId == Guid.Empty && _availableTasks.Count > 0)
    {
      _selectedTaskId = _availableTasks[0].Id;
    }

    _taskMap = visibleTasks.ToDictionary(x => x.Id, x => x.Title);

    var myEntries = await db.TimeEntries.AsNoTracking()
      .Where(x => x.FirmId == _actor.FirmId && x.UserId == _actor.UserId &&
        (_firmWide || (x.EngagementId.HasValue && scopedEngagementIds.Contains(x.EngagementId.Value)) ||
          (!x.EngagementId.HasValue && x.ClientId.HasValue && directClientIds.Contains(x.ClientId.Value))))
      .OrderByDescending(x => x.WorkDate)
      .ThenByDescending(x => x.CreatedAt)
      .ToListAsync();
    _myEntries = myEntries.Where(x => taskById.TryGetValue(x.TaskId, out var task) &&
      task.ClientId == x.ClientId && task.EngagementId == x.EngagementId).ToList();

    if (_isApprover)
    {
      var reviewScopedEngagementIds = reviewFirmWide ? [] : await db.Engagements.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId && (reviewClientIds.Contains(x.PracticeClientId) || reviewEngagementIds.Contains(x.Id)))
        .Select(x => x.Id).ToArrayAsync();
      var submittedEntries = await db.TimeEntries.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId &&
          (reviewFirmWide || (x.EngagementId.HasValue && reviewScopedEngagementIds.Contains(x.EngagementId.Value)) ||
            (!x.EngagementId.HasValue && x.ClientId.HasValue && reviewClientIds.Contains(x.ClientId.Value))) &&
          x.Status == PracticeTimeStates.TimeSubmitted && x.UserId != _actor.UserId)
        .OrderBy(x => x.WorkDate)
        .ToListAsync();
      _submittedEntries = submittedEntries.Where(x =>
        taskById.TryGetValue(x.TaskId, out var task) && task.ClientId == x.ClientId && task.EngagementId == x.EngagementId &&
        (reviewFirmWide || (x.EngagementId.HasValue && reviewScopedEngagementIds.Contains(x.EngagementId.Value)) ||
          (!x.EngagementId.HasValue && x.ClientId.HasValue && reviewClientIds.Contains(x.ClientId.Value)))).ToList();
    }
  }

  private async Task SaveTimeDraftAsync()
  {
    if (_actor is null || _selectedTaskId == Guid.Empty || _busy) return;
    _busy = true;
    _result = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var req = new SaveTimeDraftRequest(
        TaskId: _selectedTaskId,
        WorkDate: _workDate,
        StartMinute: 540, // 09:00 AM
        DurationMinutes: _durationMinutes,
        Role: _role,
        Activity: _activity,
        BillableClassification: _isBillable ? PracticeTimeStates.Billable : PracticeTimeStates.NonBillable,
        Narrative: _narrative,
        NarrativeVisibility: PracticeTimeStates.NarrativeInternal,
        Currency: "QAR"
      );
      var res = await PracticeTimeService.SaveTimeDraftAsync(db, _actor, req);
      _result = res.Succeeded ? CommandResult.Ok() : CommandResult.Fail(res.ErrorCode!, res.Message!);
      if (res.Succeeded)
      {
        _successMessage = $"Time draft recorded ({_durationMinutes}m).";
        _narrative = string.Empty;
        await LoadDataAsync();
      }
      else if (res.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale) ClearScope();
    }
    finally { _busy = false; }
  }

  private async Task CreateTaskAsync()
  {
    if (_actor is null || _busy) return;
    _busy = true;
    _result = null;
    try
    {
      var period = Guid.TryParse(_taskPeriodKey, out var periodId)
        ? _periodOptions.FirstOrDefault(x => x.Id == periodId) : null;
      if (period is null && !_firmWide)
      {
        _result = CommandResult.Fail(ErrorCodes.ScopeDenied, "Select an authorized client reporting period to scope this task.");
        return;
      }
      await using var db = await DbFactory.CreateDbContextAsync();
      var res = await PracticeTimeService.CreateTaskAsync(db, _actor,
        new CreateTaskRequest(_taskTitle, ClientId: period?.ClientId, EngagementId: period?.EngagementId,
          ReportingPeriodId: period?.Id, DueDate: _taskDueDate));
      _result = res.Succeeded ? CommandResult.Ok() : CommandResult.Fail(res.ErrorCode!, res.Message!);
      if (res.Succeeded)
      {
        _successMessage = "Work task created.";
        _taskTitle = string.Empty;
        _taskPeriodKey = string.Empty;
        _taskDueDate = null;
        await LoadDataAsync();
      }
      else if (res.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale) ClearScope();
    }
    finally { _busy = false; }
  }

  private async Task SubmitTimeAsync(Guid entryId)
  {
    if (_actor is null || _busy) return;
    _busy = true;
    _result = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var res = await PracticeTimeService.SubmitTimeAsync(db, _actor, entryId);
      _result = res;
      if (res.Succeeded)
      {
        _successMessage = "Time entry was submitted for approval.";
        await LoadDataAsync();
      }
      else if (res.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale) ClearScope();
    }
    finally { _busy = false; }
  }

  private async Task ApproveTimeAsync(Guid entryId)
  {
    if (_actor is null || _busy) return;
    _busy = true;
    _result = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var res = await PracticeTimeService.ApproveTimeAsync(db, _actor, entryId);
      _result = res;
      if (res.Succeeded)
      {
        _successMessage = "Time entry was approved.";
        await LoadDataAsync();
      }
      else if (res.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale) ClearScope();
    }
    finally { _busy = false; }
  }

  private void ClearScope()
  {
    _actor = null;
    _isStaff = false;
    _isApprover = false;
    _firmWide = false;
    _availableTasks = [];
    _periodOptions = [];
    _taskMap = [];
    _myEntries = [];
    _submittedEntries = [];
    _selectedTaskId = Guid.Empty;
  }
}
