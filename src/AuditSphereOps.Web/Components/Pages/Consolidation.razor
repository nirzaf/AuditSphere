@page "/app/consolidation"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Security
@using AuditSphereOps.Domain.Accounting
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Group consolidation</PageTitle>
<a class="back-link" href="/app/accounting">← Back to accounting workspace</a>
<h1>Group consolidation</h1>
<p class="scope-note">Only explicitly granted group scopes appear here. The enabled first profile is same-currency, fully-owned consolidation; configured foreign-operation translation is shown separately, while advanced methods remain fail-closed until approved source-bound schedules and execution verification are complete.</p>

@if (_loading)
{
  <p role="status">Loading approved group scopes…</p>
}
else if (_groups.Count == 0)
{
  <section class="notice"><h2>No group access</h2><p>No explicit group access grant is available for the current identity.</p></section>
}
else
{
  <nav class="accounting-tabs" aria-label="Group consolidation tabs">
    <a href="#perimeter" title="Review versioned group membership, method and reporting currency.">Perimeter</a>
    <a href="#packs" title="Review internal and external component-pack counts and approval readiness.">Component packs</a>
    <a href="#fx" title="Review explicitly pinned rate-set and translation-policy state; missing or stale rates block calculation.">FX</a>
    <a href="#advanced" title="Review method-specific advanced schedules and whether a gated profile has approved inputs.">Advanced schedules</a>
    <a href="#intercompany" title="Review grouped matches, outside-perimeter reviews and unresolved differences.">Intercompany</a>
    <a href="#eliminations" title="Review persisted group-only elimination journals and their approval state.">Eliminations</a>
  </nav>

  <section class="card" id="perimeter" aria-labelledby="perimeter-heading">
    <h2 id="perimeter-heading">Perimeter</h2>
    @foreach (var group in _groups)
    {
      <h3 id="group-@group.Id">@group.Name <code>@group.Code</code></h3>
      @if (group.Scopes.Count == 0)
      {
        <p class="muted">No consolidation perimeter versions are available.</p>
      }
      else
      {
        <div class="table-wrap"><table>
          <caption class="sr-only">Consolidation scopes for @group.Name</caption>
          <thead><tr><th scope="col">Version</th><th scope="col">Method</th><th scope="col">Currency</th><th scope="col" title="Approved ownership relationships pinned to this scope">Ownership edges</th><th scope="col" title="Grouped intercompany rows needing a complete review">Grouped matches</th><th scope="col" title="Related-party reviews retained outside automatic elimination">Outside reviews</th><th scope="col">Perimeter</th><th scope="col">Latest run</th><th scope="col"><span class="sr-only">Workflow</span></th></tr></thead>
          <tbody>
          @foreach (var scope in group.Scopes)
          {
            <tr><td>v@(scope.Version)</td><td><code>@scope.Method</code></td><td>@scope.Currency</td><td>@scope.OwnershipEdges</td><td>@scope.GroupedMatches</td><td>@scope.OutsideReviews</td><td><span class="status">@scope.Status</span></td><td><span class="status">@scope.RunStatus</span></td><td>@if (AdvancedConsolidationMethods.All.Contains(scope.Method)) { <a href="@($"/app/consolidation/advanced/{scope.Id:D}")" title="Open the guarded schedule, maker/checker approval and execution workflow for this advanced scope">Open workflow</a> }</td></tr>
          }
          </tbody>
        </table></div>
      }
    }
  </section>

  <section class="card" id="packs" aria-labelledby="packs-heading">
    <h2 id="packs-heading">Component packs</h2>
    <p class="muted">Counts show what is persisted for each approved scope. Consolidation consumes only approved compatible packs; missing packs are not treated as zero.</p>
    <div class="table-wrap"><table>
      <caption class="sr-only">Group component-pack readiness</caption>
      <thead><tr><th scope="col">Group / scope</th><th scope="col">Components</th><th scope="col">Approved components</th><th scope="col">External packs</th><th scope="col">Approved packs</th></tr></thead>
      <tbody>@foreach (var scope in AllScopes) { <tr><td>@scope.GroupName · v@(scope.Version)</td><td>@scope.ComponentCount</td><td>@scope.ApprovedComponentCount</td><td>@scope.ExternalPackCount</td><td>@scope.ApprovedExternalPackCount</td></tr> }</tbody>
    </table></div>
  </section>

  <section class="card" id="fx" aria-labelledby="fx-heading">
    <h2 id="fx-heading">FX</h2>
    <p class="muted">The enabled first profile is same-currency. Foreign-operation translation is shown only when the scope pins both a rate set and a translation policy; no rate of 1 is inferred.</p>
    <div class="table-wrap"><table>
      <caption class="sr-only">Group FX configuration</caption>
      <thead><tr><th scope="col">Group / scope</th><th scope="col">Reporting currency</th><th scope="col">Rate set</th><th scope="col">Translation policy</th></tr></thead>
      <tbody>@foreach (var scope in AllScopes) { <tr><td>@scope.GroupName · v@(scope.Version)</td><td><code>@scope.Currency</code></td><td><span class="status">@scope.RateSetStatus</span></td><td><span class="status">@scope.TranslationPolicyStatus</span></td></tr> }</tbody>
    </table></div>
  </section>

  <section class="card" id="advanced" aria-labelledby="advanced-heading">
    <h2 id="advanced-heading">Advanced schedules</h2>
    <p class="muted">Advanced-method schedules are source-bound, maker/checker-reviewed inputs. A complete approved schedule is necessary but does not enable an advanced profile until balanced current/comparative statement evidence is verified and separately approved.</p>
    <div class="table-wrap"><table>
      <caption class="sr-only">Advanced consolidation schedule readiness</caption>
      <thead><tr><th scope="col">Group / scope</th><th scope="col" title="The selected consolidation method for this scope">Method</th><th scope="col" title="Persisted method schedules awaiting independent approval">Submitted</th><th scope="col" title="Schedules approved by a separate reviewer and still pinned to the scope revision">Approved</th><th scope="col" title="Verified and approved statement executions for the pinned schedule">Executions</th><th scope="col" title="Readiness requires the schedule, balanced statements and separate review">Readiness</th></tr></thead>
      <tbody>
      @foreach (var scope in AllScopes)
      {
        <tr><td>@scope.GroupName · v@(scope.Version)</td><td><code>@scope.Method</code></td><td>@scope.AdvancedScheduleCount</td><td>@scope.ApprovedAdvancedScheduleCount</td><td>@scope.AdvancedExecutionCount / @scope.ApprovedAdvancedExecutionCount</td><td><span class="status" title="@scope.AdvancedScheduleGuidance">@scope.AdvancedScheduleStatus</span></td></tr>
      }
      </tbody>
    </table></div>
  </section>

  <section class="card" id="intercompany" aria-labelledby="intercompany-heading">
    <h2 id="intercompany-heading">Intercompany</h2>
    <p class="muted">Grouped matches, outside-perimeter reviews and unresolved match rows remain visible before any automatic elimination.</p>
    <div class="table-wrap"><table>
      <caption class="sr-only">Group intercompany review counts</caption>
      <thead><tr><th scope="col">Group / scope</th><th scope="col">Grouped matches</th><th scope="col">Outside reviews</th><th scope="col">Open matches</th></tr></thead>
      <tbody>@foreach (var scope in AllScopes) { <tr><td>@scope.GroupName · v@(scope.Version)</td><td>@scope.GroupedMatches</td><td>@scope.OutsideReviews</td><td><span class="status">@scope.OpenMatchCount</span></td></tr> }</tbody>
    </table></div>
  </section>

  <section class="card" id="eliminations" aria-labelledby="eliminations-heading">
    <h2 id="eliminations-heading">Eliminations</h2>
    <p class="muted">Persisted consolidation journals are separate from component books. Unsupported elimination natures fail closed in the calculation service.</p>
    <div class="table-wrap"><table>
      <caption class="sr-only">Group elimination journal counts</caption>
      <thead><tr><th scope="col">Group / scope</th><th scope="col">Journals</th><th scope="col">Approved journals</th><th scope="col">Latest run</th></tr></thead>
      <tbody>@foreach (var scope in AllScopes) { <tr><td>@scope.GroupName · v@(scope.Version)</td><td>@scope.EliminationJournalCount</td><td>@scope.ApprovedEliminationJournalCount</td><td><span class="status">@scope.RunStatus</span></td></tr> }</tbody>
    </table></div>
  </section>

  <section class="card" id="group-report" aria-labelledby="group-report-heading">
    <h2 id="group-report-heading">Approved group reports</h2>
    <p class="muted">Only the latest approved report with inputs that still match its manifest is shown. This group-level summary does not grant access to component workpapers.</p>
    @foreach (var scope in AllScopes)
    {
      <h3>@scope.GroupName · v@(scope.Version)</h3>
      @if (AdvancedConsolidationMethods.All.Contains(scope.Method))
      {
        <p class="muted">Open the method workflow for its separately reviewed statement execution.</p>
      }
      else if (scope.Report is { State: "CURRENT_APPROVED" } report)
      {
        <p class="status">Run @report.RunId · approved @report.ApprovedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
        <div class="table-wrap"><table>
          <caption class="sr-only">Current approved group report for @scope.GroupName version @scope.Version</caption>
          <thead><tr><th scope="col">Component / adjustment</th><th scope="col">Reporting code</th><th scope="col">Component</th><th scope="col">Alignment</th><th scope="col">Elimination</th><th scope="col">Consolidated</th><th scope="col">Currency</th></tr></thead>
          <tbody>
          @foreach (var line in report.Lines)
          {
            <tr><td>@line.Component</td><td><code>@line.TaxonomyCode</code></td><td>@line.ComponentAmount.ToString("N2")</td><td>@line.AlignmentAmount.ToString("N2")</td><td>@line.EliminationAmount.ToString("N2")</td><td>@line.ConsolidatedAmount.ToString("N2")</td><td>@line.Currency</td></tr>
          }
          </tbody>
          <tfoot><tr><th colspan="5">Net total</th><td>@report.Lines.Sum(x => x.ConsolidatedAmount).ToString("N2")</td><td>@scope.Currency</td></tr></tfoot>
        </table></div>
      }
      else if (scope.Report is { State: "STALE" })
      {
        <p class="notice-text" role="status">The latest approval is historical: a current component, perimeter, rate, match or group journal no longer matches the run. The result is withheld; rebuild and review the group run.</p>
      }
      else
      {
        <p class="muted">No current approved group report is available. Latest run state: @scope.RunStatus.</p>
      }
    }
  </section>
}

@code {
  private sealed record ScopeRow
  {
    public Guid Id { get; init; }
    public string GroupName { get; init; } = string.Empty;
    public int Version { get; init; }
    public string Method { get; init; } = string.Empty;
    public string Currency { get; init; } = string.Empty;
    public int OwnershipEdges { get; init; }
    public int GroupedMatches { get; init; }
    public int OutsideReviews { get; init; }
    public int OpenMatchCount { get; init; }
    public int ComponentCount { get; init; }
    public int ApprovedComponentCount { get; init; }
    public int ExternalPackCount { get; init; }
    public int ApprovedExternalPackCount { get; init; }
    public int AdvancedScheduleCount { get; init; }
    public int ApprovedAdvancedScheduleCount { get; init; }
    public int AdvancedExecutionCount { get; init; }
    public int ApprovedAdvancedExecutionCount { get; init; }
    public string AdvancedScheduleStatus { get; init; } = string.Empty;
    public string AdvancedScheduleGuidance { get; init; } = string.Empty;
    public string RateSetStatus { get; init; } = string.Empty;
    public string TranslationPolicyStatus { get; init; } = string.Empty;
    public int EliminationJournalCount { get; init; }
    public int ApprovedEliminationJournalCount { get; init; }
    public string Status { get; init; } = string.Empty;
    public string RunStatus { get; init; } = string.Empty;
    public ConsolidationReport? Report { get; init; }
  }
  private sealed record GroupRow(Guid Id, string Code, string Name, IReadOnlyList<ScopeRow> Scopes);
  private List<GroupRow> _groups = [];
  private bool _loading = true;
  private IEnumerable<ScopeRow> AllScopes => _groups.SelectMany(x => x.Scopes);

  protected override async Task OnInitializedAsync()
  {
    var actor = await ActorResolver.ResolveAsync();
    if (actor is not null)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var candidateGroupIds = await db.GroupAccessGrants.AsNoTracking().Where(x => x.FirmId == actor.FirmId && x.UserId == actor.UserId && x.RevokedAt == null)
        .Select(x => x.GroupId).Distinct().ToArrayAsync();
      var groupIds = new List<Guid>(candidateGroupIds.Length);
      foreach (var groupId in candidateGroupIds)
      {
        var access = await AuthorizationDecision.AuthorizeGroupAsync(db, actor, groupId,
          ["AccountingPreparer", "AccountingReviewer", "Manager", "Partner", "Administrator"]);
        if (access.Succeeded) groupIds.Add(groupId);
      }
      var groups = await db.ClientGroups.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.Id)).OrderBy(x => x.Name).ToListAsync();
      var scopes = await db.ConsolidationScopeVersions.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId)).ToListAsync();
      var ownershipCounts = await db.OwnershipInterestVersions.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId) &&
        x.Status == AccountingWorkflowStates.Approved).GroupBy(x => x.ScopeVersionId).Select(x => new { ScopeId = x.Key, Count = x.Count() })
        .ToDictionaryAsync(x => x.ScopeId, x => x.Count);
      var matchCounts = await db.IntercompanyMatches.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId) &&
        x.Status != AccountingWorkflowStates.Rejected).GroupBy(x => x.ScopeVersionId).Select(x => new
        {
          ScopeId = x.Key,
          Grouped = x.Count(y => y.MatchMode == IntercompanyMatchModes.Grouped),
          Outside = x.Count(y => y.OutsidePerimeterReview),
          Open = x.Count(y => y.Status != AccountingWorkflowStates.Approved)
        }).ToDictionaryAsync(x => x.ScopeId);
      var componentCounts = await db.ConsolidationComponents.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId))
        .GroupBy(x => x.ScopeVersionId).Select(x => new { ScopeId = x.Key, Count = x.Count(), Approved = x.Count(y => y.Status == AccountingWorkflowStates.Approved) })
        .ToDictionaryAsync(x => x.ScopeId);
      var packCounts = await db.ExternalComponentPacks.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId))
        .GroupBy(x => x.ScopeVersionId).Select(x => new { ScopeId = x.Key, Count = x.Count(), Approved = x.Count(y => y.Status == ExternalComponentPackStates.Approved) })
        .ToDictionaryAsync(x => x.ScopeId);
      var advancedScheduleCounts = await db.AdvancedConsolidationMethodSchedules.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId))
        .GroupBy(x => x.ScopeVersionId).Select(x => new { ScopeId = x.Key, Count = x.Count(), Approved = x.Count(y => y.Status == AdvancedConsolidationMethodScheduleStates.Approved) })
        .ToDictionaryAsync(x => x.ScopeId);
      var advancedExecutionCounts = await db.AdvancedConsolidationExecutions.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId))
        .GroupBy(x => x.ScopeVersionId).Select(x => new { ScopeId = x.Key, Count = x.Count(), Approved = x.Count(y => y.Status == AdvancedConsolidationExecutionStates.Approved) })
        .ToDictionaryAsync(x => x.ScopeId);
      var journalCounts = await db.ConsolidationJournals.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId))
        .GroupBy(x => x.ScopeVersionId).Select(x => new { ScopeId = x.Key, Count = x.Count(), Approved = x.Count(y => y.Status == AccountingWorkflowStates.Approved) })
        .ToDictionaryAsync(x => x.ScopeId);
      var runStatuses = await db.ConsolidationRuns.AsNoTracking().Where(x => x.FirmId == actor.FirmId && groupIds.Contains(x.GroupId))
        .GroupBy(x => x.ScopeVersionId).Select(x => new { ScopeId = x.Key, Status = x.OrderByDescending(y => y.CreatedAt)
          .ThenByDescending(y => y.Id).Select(y => y.Status).First() }).ToDictionaryAsync(x => x.ScopeId, x => x.Status);
      var reports = new Dictionary<Guid, ConsolidationReport>();
      foreach (var scope in scopes.Where(x => !AdvancedConsolidationMethods.All.Contains(x.Method) &&
        runStatuses.GetValueOrDefault(x.Id) == AccountingWorkflowStates.Approved))
      {
        var report = await ConsolidationService.GetLatestReportAsync(db, actor, scope.Id);
        if (report.Succeeded && report.Value is not null)
          reports[scope.Id] = report.Value;
      }
      var rateSetIds = scopes.Where(x => x.ExchangeRateSetVersionId.HasValue).Select(x => x.ExchangeRateSetVersionId!.Value).Distinct().ToArray();
      var rateSets = await db.ExchangeRateSetVersions.AsNoTracking().Where(x => x.FirmId == actor.FirmId && rateSetIds.Contains(x.Id))
        .ToDictionaryAsync(x => x.Id, x => x.Status);
      var translationPolicyIds = scopes.Where(x => x.TranslationPolicyVersionId.HasValue).Select(x => x.TranslationPolicyVersionId!.Value).Distinct().ToArray();
      var translationPolicies = await db.TranslationPolicyVersions.AsNoTracking().Where(x => x.FirmId == actor.FirmId && translationPolicyIds.Contains(x.Id))
        .ToDictionaryAsync(x => x.Id, x => x.Status);
      _groups = groups.Select(group => new GroupRow(group.Id, group.Code, group.Name, scopes.Where(x => x.GroupId == group.Id)
        .OrderByDescending(x => x.Version).Select(x =>
        {
          var matches = matchCounts.GetValueOrDefault(x.Id);
          var components = componentCounts.GetValueOrDefault(x.Id);
          var packs = packCounts.GetValueOrDefault(x.Id);
          var advancedSchedules = advancedScheduleCounts.GetValueOrDefault(x.Id);
          var advancedExecutions = advancedExecutionCounts.GetValueOrDefault(x.Id);
          var advancedRequired = AdvancedConsolidationMethods.All.Contains(x.Method);
          var advancedStatus = !advancedRequired ? "NOT_APPLICABLE" : advancedSchedules is null ? "REQUIRED" :
            advancedSchedules.Approved != advancedSchedules.Count || advancedSchedules.Count == 0 ? "REVIEW_REQUIRED" :
            advancedExecutions is null ? "EXECUTION_REQUIRED" : advancedExecutions.Approved > 0 ? "APPROVED" : "EXECUTION_REVIEW_REQUIRED";
          var journals = journalCounts.GetValueOrDefault(x.Id);
          return new ScopeRow
          {
            Id = x.Id,
            GroupName = group.Name,
            Version = x.Version,
            Method = x.Method,
            Currency = x.ReportingCurrency,
            OwnershipEdges = ownershipCounts.GetValueOrDefault(x.Id),
            GroupedMatches = matches?.Grouped ?? 0,
            OutsideReviews = matches?.Outside ?? 0,
            OpenMatchCount = matches?.Open ?? 0,
            ComponentCount = components?.Count ?? 0,
            ApprovedComponentCount = components?.Approved ?? 0,
            ExternalPackCount = packs?.Count ?? 0,
            ApprovedExternalPackCount = packs?.Approved ?? 0,
            AdvancedScheduleCount = advancedSchedules?.Count ?? 0,
            ApprovedAdvancedScheduleCount = advancedSchedules?.Approved ?? 0,
            AdvancedExecutionCount = advancedExecutions?.Count ?? 0,
            ApprovedAdvancedExecutionCount = advancedExecutions?.Approved ?? 0,
            AdvancedScheduleStatus = advancedStatus,
            AdvancedScheduleGuidance = advancedRequired
              ? "Readiness requires an approved current/comparative statement execution and separate reviewer approval; local evidence does not prove methodology or live acceptance."
              : "The selected bounded profile does not require an advanced-method schedule.",
            RateSetStatus = x.ExchangeRateSetVersionId is { } rateSetId ? rateSets.GetValueOrDefault(rateSetId, "MISSING") : "SAME_CURRENCY_PROFILE",
            TranslationPolicyStatus = x.TranslationPolicyVersionId is { } policyId ? translationPolicies.GetValueOrDefault(policyId, "MISSING") : "NOT_CONFIGURED",
            EliminationJournalCount = journals?.Count ?? 0,
            ApprovedEliminationJournalCount = journals?.Approved ?? 0,
            Status = x.Status,
            RunStatus = runStatuses.GetValueOrDefault(x.Id, "NO_RUN"),
            Report = reports.GetValueOrDefault(x.Id)
          };
        }).ToArray())).ToList();
    }
    _loading = false;
  }
}
