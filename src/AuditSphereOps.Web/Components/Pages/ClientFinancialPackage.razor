@page "/portal/accounting/packages/{PackageId:guid}"
@rendermode InteractiveServer
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@using AuditSphereOps.Domain.Shared

<PageTitle>Financial package — management review</PageTitle>
<MudLink Href="/portal" Class="back-link mb-2 d-inline-block">← Back to client portal</MudLink>
<PageHeader Title="Financial package" Description="Client-visible validated package, decisions, and release evidence." />
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button-secondary" OnClick="RefreshAsync" Disabled="@(_loading || _busy)">Refresh package</MudButton>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading the package…" />
}
else if (_actor is null || _view is null)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Package unavailable</h2><p>@(_loadError ?? "This package is not available in the current client scope.")</p></MudAlert>
}
else
{
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="package-heading" role="region">
    <p class="eyebrow">@_view.ManagementDecision</p>
    <h2 id="package-heading">Management review</h2>
    <p class="scope-note">This is a management acknowledgement of the supplied reporting package. It is not an audit opinion, assurance conclusion or proof that an external ledger has been posted.</p>
    <dl class="details">
      <dt>Framework</dt><dd>@_view.Framework</dd>
      <dt>Period</dt><dd>@_view.PeriodStart to @_view.PeriodEnd</dd>
      <dt>Currency</dt><dd>@_view.Currency</dd>
      <dt>Template</dt><dd>@_view.TemplateVersion</dd>
      <dt>Package hash</dt><dd><code>@_view.PackageHash</code></dd>
      <dt>Supporting information</dt><dd>@(_view.HasCashFlow && _view.HasDisclosures ? "Cash flow and disclosures supplied" : "Incomplete supporting information")</dd>
    </dl>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="totals-heading" role="region">
    <h2 id="totals-heading">Statement totals</h2>
    <MudTable Items="_view.StatementTotals" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Section</MudTh><MudTh scope="col">Amount</MudTh></HeaderContent>
  <RowTemplate>        <MudTd>@context.StatementSection</MudTd><MudTd>@context.Amount.ToString("N2") @_view.Currency</MudTd></RowTemplate>
</MudTable>
  </MudPaper>

  @if (_view.ManagementDecision == "PENDING" || _view.ManagementDecision == FinancialPackageReviewDecisions.ChangesRequired)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="decision-heading" role="region">
      <h2 id="decision-heading">Record management decision</h2>
      <p class="muted">Your authenticated client identity records the management decision against this exact package version. A changed package requires a new decision.</p>
      <div class="form-grid">
        <label for="management-decision">Decision<MudSelect T="string" @bind-Value="_decision" id="management-decision" required>
          @foreach (var decision in FinancialPackageReviewDecisions.All)
          {
            <MudSelectItem Value="@decision">@decision</MudSelectItem>
          }
        </MudSelect></label>
        <label for="evidence-reference">Evidence reference<MudTextField T="string" @bind-Value="_evidenceReference" MaxLength="2000" id="evidence-reference" autocomplete="off" required /></label>
      </div>
      <label for="management-comment">Comment<MudTextField T="string" @bind-Value="_comment" MaxLength="4000" Lines="4" id="management-comment" data-optional="true" /></label>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="RecordAsync" Disabled="@_busy">@(_busy ? "Recording…" : "Record management decision")</MudButton>
      @if (_result is not null)
      {
        <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">
          @(_result.Succeeded ? "Management decision recorded." : $"Blocked: {_result.ErrorCode}")
        </p>
      }
    </MudPaper>
  }
  else if (_view.ManagementDecision == FinancialPackageReviewDecisions.Approved)
  {
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="notice success my-4" role="status"><h2>Management approval recorded</h2><p>@(_view.ManagementDecidedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Current package version")</p></MudAlert>
  }
  else
  {
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="status"><h2>Management changes required</h2><p>Internal staff must issue a new package version before another management decision can be recorded.</p></MudAlert>
  }
}

@code {
  [Parameter] public Guid PackageId { get; set; }
  private ActorContext? _actor;
  private ClientFinancialPackageView? _view;
  private CommandResult<Guid>? _result;
  private string? _loadError;
  private string _decision = FinancialPackageReviewDecisions.Approved;
  private string _evidenceReference = string.Empty;
  private string _comment = string.Empty;
  private bool _loading = true;
  private bool _busy;
  private Guid? _loadedPackageId;
  private long _loadGeneration;

  protected override Task OnParametersSetAsync()
  {
    if (_loadedPackageId == PackageId)
      return Task.CompletedTask;
    _loadedPackageId = PackageId;
    return RefreshAsync();
  }

  private async Task RefreshAsync()
  {
    var generation = ++_loadGeneration;
    var packageId = PackageId;
    _actor = null;
    _view = null;
    _result = null;
    _loadError = null;
    _decision = FinancialPackageReviewDecisions.Approved;
    _evidenceReference = string.Empty;
    _comment = string.Empty;
    _loading = true;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (generation != _loadGeneration || packageId != PackageId)
        return;
      if (actor is null)
      {
        _loadError = "This package is not available in the current client scope.";
        return;
      }
      await using var db = await DbFactory.CreateDbContextAsync();
      var view = await FinancialPackageReviewService.GetClientViewAsync(db, actor, packageId);
      if (generation != _loadGeneration || packageId != PackageId)
        return;
      if (view.Succeeded && view.Value is not null)
      {
        _actor = actor;
        _view = view.Value;
        return;
      }
      _loadError = view.Message;
    }
    finally
    {
      if (generation == _loadGeneration)
        _loading = false;
    }
  }

  private async Task RecordAsync()
  {
    if (_actor is null || _view is null || _busy) return;
    var actor = _actor;
    var packageId = PackageId;
    var generation = _loadGeneration;
    var decision = _decision;
    var evidenceReference = _evidenceReference;
    var comment = _comment;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      if (generation != _loadGeneration || packageId != PackageId)
        return;
      var result = await FinancialPackageReviewService.RecordAsync(db, actor,
        new FinancialPackageReviewRequest(packageId, FinancialPackageReviewStages.ManagementApproval,
          decision, FinancialPackageReviewEvidenceModes.SignedIn, evidenceReference, comment));
      if (generation != _loadGeneration || packageId != PackageId)
        return;
      _result = result;
      if (!_result.Succeeded && _result.ErrorCode is (ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale))
      {
        _actor = null;
        _view = null;
        _result = null;
        _decision = FinancialPackageReviewDecisions.Approved;
        _evidenceReference = string.Empty;
        _comment = string.Empty;
        _loadError = "Your access changed. Sign in again to continue.";
        return;
      }
      if (_result.Succeeded)
      {
        _evidenceReference = string.Empty;
        _comment = string.Empty;
        await RefreshAsync();
      }
    }
    finally { _busy = false; }
  }
}
