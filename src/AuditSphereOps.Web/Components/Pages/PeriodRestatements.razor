@page "/app/accounting/restatements"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Accounting
@using AuditSphereOps.Domain.Accounting
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Period restatements</PageTitle>
<MudLink Href="/app/accounting" Class="back-link mb-2 d-inline-block">← Back to accounting workspace</MudLink>
<PageHeader Title="Period restatements" Description="Authorized post-close amendments recorded with immutable lineage; issued packages are never rewritten." />

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading scoped restatements…" />
}
else if (_actor is null || !_isStaff)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Access unavailable</h2><p>Sign in with an authorized accounting identity to manage period restatements.</p></MudAlert>
}
else
{
  <p class="scope-note">A restatement links two validated immutable packages for one closed period. Creation and independent review remain separate actions.</p>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="create-heading" role="region">
    <h2 id="create-heading">Request a restatement</h2>
    <div class="form-grid">
      <label>Client<MudSelect T="string" @bind-Value="_selectedClientId" required Disabled="@(_busy || _selectionBusy)" title="Choose the client whose closed reporting period is being restated."><MudSelectItem Value="@string.Empty">Select a client</MudSelectItem>@foreach (var client in _clients) { <MudSelectItem Value="@client.Id.ToString()">@client.Name</MudSelectItem> }</MudSelect></label>
      <label>Closed period<MudSelect T="string" @bind-Value="_selectedPeriodId" required title="Choose the closed period that both immutable packages belong to."><MudSelectItem Value="@string.Empty">Select a period</MudSelectItem>@foreach (var period in _periods) { <MudSelectItem Value="@period.Id.ToString()">@period.Label</MudSelectItem> }</MudSelect></label>
      <label>Original package<MudSelect T="string" @bind-Value="_selectedOriginalPackageId" required title="Choose the original validated package version."><MudSelectItem Value="@string.Empty">Select package</MudSelectItem>@foreach (var package in _packages) { <MudSelectItem Value="@package.Id.ToString()">@package.Label</MudSelectItem> }</MudSelect></label>
      <label>Revised package<MudSelect T="string" @bind-Value="_selectedRevisedPackageId" required title="Choose the revised validated package version; it must differ from the original."><MudSelectItem Value="@string.Empty">Select package</MudSelectItem>@foreach (var package in _packages) { <MudSelectItem Value="@package.Id.ToString()">@package.Label</MudSelectItem> }</MudSelect></label>
      <label>Revised basis<MudTextField T="string" @bind-Value="_revisedBasis" MaxLength="200" required /></label>
      <label>Change type<MudSelect T="string" @bind-Value="_changeType" required title="Supported IAS 8 treatment; estimate changes use prospective treatment and never silently restate prior periods.">
        <MudSelectItem Value="@string.Empty">Select change type</MudSelectItem>
        <MudSelectItem Value="@PeriodRestatementChangeTypes.Reclassified">Reclassified presentation</MudSelectItem>
        <MudSelectItem Value="@PeriodRestatementChangeTypes.RestatedError">Prior-period error restated</MudSelectItem>
        <MudSelectItem Value="@PeriodRestatementChangeTypes.PolicyTransition">Accounting policy transition</MudSelectItem>
        <MudSelectItem Value="@PeriodRestatementChangeTypes.ProspectiveEstimateChange">Prospective estimate change</MudSelectItem>
      </MudSelect></label>
      <label>Affected periods (comma-separated codes)<MudTextField T="string" @bind-Value="_affectedPeriods" MaxLength="500" title="Period codes the approved treatment affects; required for prospective estimate changes." /></label>
      <label>Evidence reference<MudTextField T="string" @bind-Value="_evidenceReference" MaxLength="2000" required /></label>
    </div>
    <label>Reason<MudTextField T="string" @bind-Value="_reason" MaxLength="4000" Lines="3" required /></label>
    <div style="display:flex;gap:.75rem;align-items:center;margin-top:1rem;flex-wrap:wrap">
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="LoadSelectionAsync" Disabled="@(_busy || _selectionBusy)">@(_selectionBusy ? "Loading…" : "Load closed-period packages")</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="CreateAsync" Disabled="@(_busy || _selectionBusy)">@(_busy ? "Saving…" : "Create restatement request")</MudButton>
    </div>
  </MudPaper>

  @if (_result is not null)
  {
    <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">
      @(_result.Succeeded ? (_successMessage ?? "Action completed successfully.") : "Blocked: " + _result.ErrorCode)
    </p>
  }

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="history-heading" role="region">
    <h2 id="history-heading">Restatement history</h2>
    @if (_restatements.Count == 0)
    {
      <p class="muted">No restatement requests are available in the current scope.</p>
    }
    else
    {
      <MudTable Items="_restatements" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Client</MudTh><MudTh scope="col">Period</MudTh><MudTh scope="col">Basis</MudTh><MudTh scope="col">Status</MudTh><MudTh scope="col">Evidence</MudTh><MudTh scope="col">Action</MudTh></HeaderContent>
  <RowTemplate>            <MudTd>@context.ClientName</MudTd>
            <MudTd>@context.PeriodCode</MudTd>
            <MudTd>@context.RevisedBasis</MudTd>
            <MudTd><StatusChip Status="@context.Status" /></MudTd>
            <MudTd><code>@context.EvidenceReference</code></MudTd>
            <MudTd>@if (context.Status == AccountingWorkflowStates.Submitted && CanReview(context.ClientId)) { <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="() => ApproveAsync(context.Id)" Disabled="@(_busy || _selectionBusy)">Approve independently</MudButton> } else { <span class="muted">—</span> }</MudTd></RowTemplate>
</MudTable>
    }
  </MudPaper>
}

@code {
  private static readonly string[] AccountingRoles = ["Administrator", "Partner", "Manager", "AccountingPreparer", "AccountingReviewer"];
  private static readonly string[] ReviewerRoles = ["Administrator", "Partner", "Manager", "AccountingReviewer"];

  private sealed record ClientOption(Guid Id, string Name);
  private sealed record PeriodOption(Guid Id, string Label);
  private sealed record PackageOption(Guid Id, string Label);
  private sealed record RestatementRow(Guid Id, Guid ClientId, string ClientName, string PeriodCode, string RevisedBasis, string Status, string EvidenceReference);

  private ActorContext? _actor;
  private bool _loading = true;
  private bool _busy;
  private bool _selectionBusy;
  private bool _isStaff;
  private bool _reviewFirmWide;
  private Guid[] _reviewClientIds = [];
  private long _selectionGeneration;
  private List<ClientOption> _clients = [];
  private List<PeriodOption> _periods = [];
  private List<PackageOption> _packages = [];
  private List<RestatementRow> _restatements = [];
  private string _selectedClientId = string.Empty;
  private string _selectedPeriodId = string.Empty;
  private string _selectedOriginalPackageId = string.Empty;
  private string _selectedRevisedPackageId = string.Empty;
  private string _revisedBasis = string.Empty;
  private string _changeType = string.Empty;
  private string _affectedPeriods = string.Empty;
  private string _reason = string.Empty;
  private string _evidenceReference = string.Empty;
  private CommandResult? _result;
  private string? _successMessage;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      await LoadDataAsync();
      if (_isStaff && _clients.Count > 0)
      {
        _selectedClientId = _clients[0].Id.ToString();
        await LoadSelectionAsync();
      }
    }
    _loading = false;
  }

  private async Task LoadDataAsync()
  {
    if (_actor is null) return;
    _clients = [];
    _periods = [];
    _packages = [];
    _restatements = [];
    _reviewClientIds = [];
    _reviewFirmWide = false;
    await using var db = await DbFactory.CreateDbContextAsync();
    var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
      new AuthorizationRequest(_actor.FirmId, RequiredRoles: AccountingRoles, InternalOnly: true));
    if (!authorization.Succeeded)
    {
      ClearScope();
      return;
    }
    var grants = await db.RoleGrants.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.UserId == _actor.UserId &&
      x.RevokedAt == null && AccountingRoles.Contains(x.Role))
      .Select(x => new { x.Role, x.ClientId, x.EngagementId }).ToListAsync();
    var firmWide = grants.Any(x => x.ClientId is null && x.EngagementId is null);
    var scopedClientIds = grants.Where(x => x.ClientId.HasValue && x.EngagementId is null).Select(x => x.ClientId!.Value).Distinct().ToArray();
    _reviewFirmWide = grants.Any(x => ReviewerRoles.Contains(x.Role) && x.ClientId is null && x.EngagementId is null);
    _reviewClientIds = grants.Where(x => ReviewerRoles.Contains(x.Role) && x.ClientId.HasValue && x.EngagementId is null)
      .Select(x => x.ClientId!.Value).Distinct().ToArray();
    _isStaff = firmWide || scopedClientIds.Length > 0;
    if (!_isStaff) return;
    var clients = await db.PracticeClients.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
      (firmWide || scopedClientIds.Contains(x.Id))).OrderBy(x => x.LegalName).ToListAsync();
    var periods = await db.ClientReportingPeriods.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
      (firmWide || scopedClientIds.Contains(x.ClientId))).ToDictionaryAsync(x => x.Id);
    _clients = clients.Select(x => new ClientOption(x.Id, x.LegalName)).ToList();
    var restatements = await db.ClientPeriodRestatements.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
      (firmWide || scopedClientIds.Contains(x.ClientId))).OrderByDescending(x => x.CreatedAt).ToListAsync();
    _restatements = restatements.Select(x => new RestatementRow(x.Id, x.ClientId,
      clients.FirstOrDefault(c => c.Id == x.ClientId)?.LegalName ?? "Scoped client",
      periods.GetValueOrDefault(x.PeriodId)?.PeriodCode ?? "Unknown period", x.RevisedBasis, x.Status, x.EvidenceReference)).ToList();
  }

  private async Task LoadSelectionAsync()
  {
    if (_actor is null || _selectionBusy || !Guid.TryParse(_selectedClientId, out var clientId)) return;
    var generation = ++_selectionGeneration;
    _selectionBusy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
        new AuthorizationRequest(_actor.FirmId, ClientId: clientId, RequiredRoles: AccountingRoles, InternalOnly: true));
      if (!authorization.Succeeded)
      {
        _periods = [];
        _packages = [];
        _selectedPeriodId = _selectedOriginalPackageId = _selectedRevisedPackageId = string.Empty;
        return;
      }
      var periods = await db.ClientReportingPeriods.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.ClientId == clientId && x.Status == AccountingWorkflowStates.Closed)
        .OrderByDescending(x => x.EndDate).ToListAsync();
      if (generation != _selectionGeneration) return;
      _periods = periods.Select(x => new PeriodOption(x.Id, $"{x.PeriodCode} ({x.StartDate:yyyy-MM-dd} to {x.EndDate:yyyy-MM-dd})")).ToList();
      _selectedPeriodId = _periods.FirstOrDefault()?.Id.ToString() ?? string.Empty;
      _selectedOriginalPackageId = string.Empty;
      _selectedRevisedPackageId = string.Empty;
      _packages = [];
      if (Guid.TryParse(_selectedPeriodId, out var periodId))
      {
        var period = periods.Single(x => x.Id == periodId);
        var packages = await db.FinancialPackages.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.ClientId == clientId &&
          x.Status == AccountingPackageStates.PackageValidated && x.PeriodStart == period.StartDate.ToString("yyyy-MM-dd") && x.PeriodEnd == period.EndDate.ToString("yyyy-MM-dd"))
          .OrderBy(x => x.CreatedAt).ToListAsync();
        if (generation != _selectionGeneration) return;
        _packages = packages.Select(x => new PackageOption(x.Id, $"{x.Id} · {x.Currency} · {x.CalculationHash[..Math.Min(12, x.CalculationHash.Length)]}")).ToList();
      }
    }
    finally
    {
      _selectionBusy = false;
    }
  }

  private async Task CreateAsync()
  {
    if (_actor is null || _busy || !Guid.TryParse(_selectedClientId, out var clientId) || !Guid.TryParse(_selectedPeriodId, out var periodId) ||
        !Guid.TryParse(_selectedOriginalPackageId, out var originalId) || !Guid.TryParse(_selectedRevisedPackageId, out var revisedId))
    {
      _result = CommandResult.Fail(ErrorCodes.Accounting.ReconciliationRejected, "Select one client, closed period and two distinct validated packages.");
      return;
    }
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var created = await ClientAccountingService.CreatePeriodRestatementAsync(db, _actor,
        new CreatePeriodRestatementRequest(clientId, periodId, originalId, revisedId, _revisedBasis, _reason,
          _evidenceReference, _changeType, _affectedPeriods));
      if (created.Succeeded)
      {
        _result = CommandResult.Ok();
        _successMessage = "Restatement request created; an independent reviewer must approve it.";
        await LoadDataAsync();
      }
      else
        _result = CommandResult.Fail(created.ErrorCode ?? ErrorCodes.Accounting.ReconciliationRejected, created.Message ?? "Restatement request was blocked.");
    }
    finally { _busy = false; }
  }

  private async Task ApproveAsync(Guid restatementId)
  {
    if (_actor is null || _busy) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      _result = await ClientAccountingService.ApprovePeriodRestatementAsync(db, _actor, restatementId);
      if (_result.Succeeded)
      {
        _successMessage = "Restatement independently approved.";
        await LoadDataAsync();
      }
    }
    finally { _busy = false; }
  }

  private bool CanReview(Guid clientId) => _reviewFirmWide || _reviewClientIds.Contains(clientId);

  private void ClearScope()
  {
    _actor = null;
    _isStaff = false;
    _reviewFirmWide = false;
    _reviewClientIds = [];
    _clients = [];
    _periods = [];
    _packages = [];
    _restatements = [];
  }
}
