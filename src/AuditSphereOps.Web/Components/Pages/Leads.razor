@page "/app/practice/leads"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Practice
@using AuditSphereOps.Domain.Practice
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Practice leads</PageTitle>
<MudLink Href="/app">← Back to portfolio</MudLink>
<PageHeader Title="Practice leads" Description="Commercial opportunity progression for the current firm scope only. Converting a qualified lead requires separate client acceptance and credit decisions." />
<MudButton Color="Color.Primary" Variant="Variant.Outlined" Class="button-secondary" OnClick="LoadLeadsAsync" Disabled="@(_loading || _busy)">Refresh leads</MudButton>

@if (_loading)
{
  <MudProgressLinear Color="Color.Primary" Indeterminate="true" aria-label="Loading practice leads" />
  <LoadingState IsLoading="true" LoadingMessage="Loading practice leads…" />
}
else if (_actor is null || !_isAuthorized)
{
  <MudAlert Severity="Severity.Error" Dense="true"><h2>Access unavailable</h2>Sign in with an authorized commercial identity to view practice leads.</MudAlert>
}
else
{
  @if (_result is not null)
  {
    <MudAlert Severity="@(_result.Succeeded ? Severity.Success : Severity.Error)" Dense="true">
      @(_result.Succeeded ? (_successMessage ?? "Action completed successfully.") : "Blocked: " + _result.ErrorCode)
    </MudAlert>
  }

  <MudCard Class="mb-4" data-draft-scope="practice-lead-new">
    <MudCardHeader><h2 id="new-lead-heading">Record new lead</h2></MudCardHeader>
    <MudCardContent>
      <MudGrid>
        <MudItem xs="12" sm="6">
          <MudTextField T="string" Label="Lead / organization name" @bind-Value="_newName"
                        Placeholder="e.g. Acme Corp" Required="true" RequiredError="Lead name is required."
                        Disabled="_busy" data-draft-field="new-lead-name" />
        </MudItem>
        <MudItem xs="12" sm="6">
          <MudTextField T="string" Label="Source" @bind-Value="_newSource"
                        Placeholder="e.g. Referral, Website" Required="true" RequiredError="Source is required."
                        Disabled="_busy" data-draft-field="new-lead-source" />
        </MudItem>
        <MudItem xs="12" sm="6">
          <MudTextField T="string" Label="Primary contact name (optional)" @bind-Value="_newContactName"
                        Placeholder="e.g. Jane Doe" Disabled="_busy" data-draft-field="new-lead-contact" />
        </MudItem>
        <MudItem xs="12" sm="6">
          <MudTextField T="string" Label="Primary contact email (optional)" @bind-Value="_newContactEmail"
                        Placeholder="e.g. jane@example.com" InputType="InputType.Email"
                        Disabled="_busy" data-draft-field="new-lead-email" />
        </MudItem>
      </MudGrid>
      <p class="draft-status" data-draft-status role="status" aria-live="polite"></p>
    </MudCardContent>
    <MudCardActions>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateLeadAsync" Disabled="_busy">Create lead</MudButton>
    </MudCardActions>
  </MudCard>

  <MudCard>
    <MudCardHeader><h2 id="leads-table-heading">Active leads (@_leads.Count)</h2></MudCardHeader>
    <MudCardContent>
      @if (_leads.Count == 0)
      {
        <MudAlert Severity="Severity.Info" Dense="true">No commercial leads are currently recorded for this firm.</MudAlert>
      }
      else
      {
        <MudTable Items="_leads" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
          <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Contact</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Recorded</MudTh>
            <MudTh>Action</MudTh>
          </HeaderContent>
          <RowTemplate>
            <MudTd DataLabel="Name"><strong>@context.Name</strong></MudTd>
            <MudTd DataLabel="Source">@context.Source</MudTd>
            <MudTd DataLabel="Contact">@(context.PrimaryContactName ?? "—") @(context.PrimaryContactEmail != null ? $"({context.PrimaryContactEmail})" : "")</MudTd>
            <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
            <MudTd DataLabel="Recorded">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Action">
              @if (context.Status == CrmStates.LeadNew)
              {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                           OnClick="@(() => ConfirmQualifyAsync(context))" Disabled="_busy">Qualify</MudButton>
              }
            </MudTd>
          </RowTemplate>
          <PagerContent>
            <MudTablePager PageSizeOptions="[10, 25]" />
          </PagerContent>
        </MudTable>
      }
    </MudCardContent>
  </MudCard>
}

@code {
  private ActorContext? _actor;
  private bool _isAuthorized;
  private List<PracticeLeadListItem> _leads = [];
  private CommandResult? _result;
  private string? _successMessage;
  private bool _loading = true;
  private bool _busy;
  private long _loadGeneration;

  private string _newName = string.Empty;
  private string _newSource = string.Empty;
  private string? _newContactName;
  private string? _newContactEmail;

  protected override Task OnInitializedAsync() => LoadLeadsAsync();

  private void ClearProtectedState()
  {
    _actor = null;
    _isAuthorized = false;
    _leads = [];
    _result = null;
    _successMessage = null;
    _newName = _newSource = string.Empty;
    _newContactName = _newContactEmail = null;
  }

  private async Task LoadLeadsAsync()
  {
    var generation = ++_loadGeneration;
    _loading = true;
    ClearProtectedState();
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null || generation != _loadGeneration) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await PracticeLeadQuery.ListAsync(db, actor);
      if (!result.Succeeded || generation != _loadGeneration) return;
      var currentActor = await ActorResolver.ResolveAsync();
      if (currentActor is null || currentActor.UserId != actor.UserId ||
          currentActor.FirmId != actor.FirmId || currentActor.SessionEpoch != actor.SessionEpoch ||
          generation != _loadGeneration) return;
      _actor = currentActor;
      _isAuthorized = true;
      _leads = result.Value!.ToList();
    }
    finally { if (generation == _loadGeneration) _loading = false; }
  }

  private async Task<ActorContext?> CurrentCommercialActorAsync()
  {
    if (_actor is null) return null;
    var current = await ActorResolver.ResolveAsync();
    if (current is null || current.UserId != _actor.UserId ||
        current.FirmId != _actor.FirmId || current.SessionEpoch != _actor.SessionEpoch)
    {
      ClearProtectedState();
      return null;
    }
    return current;
  }

  private async Task CreateLeadAsync()
  {
    if (_busy) return;
    _busy = true;
    try
    {
      var actor = await CurrentCommercialActorAsync();
      if (actor is null) return;
      if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newSource))
      {
        _result = CommandResult.Fail("leads.validation", "Lead name and source are required.");
        return;
      }
      var request = new CreateLeadRequest(
        _newName, _newSource, _newContactName, _newContactEmail, OwnerUserId: actor.UserId);
      await using var db = await DbFactory.CreateDbContextAsync();
      var res = await PracticeCrmService.CreateLeadAsync(db, actor, request);
      if (res.Succeeded)
      {
        await LoadLeadsAsync();
        if (_isAuthorized)
        {
          _result = CommandResult.Ok();
          _successMessage = "The lead was recorded successfully.";
          Snackbar.Add(_successMessage, Severity.Success);
        }
      }
      else if (res.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale)
        ClearProtectedState();
      else
        _result = CommandResult.Fail(res.ErrorCode!, res.Message!);
    }
    finally { _busy = false; }
  }

  private async Task ConfirmQualifyAsync(PracticeLeadListItem lead)
  {
    if (await CurrentCommercialActorAsync() is null) return;
    var parameters = new DialogParameters<ConfirmDialog>
    {
      { x => x.Message, $"Qualify lead '{lead.Name}'? Qualification continues to separate client acceptance and credit decisions." },
      { x => x.RecordIdentity, $"{lead.Name} ({lead.Id:D})" },
      { x => x.ConfirmText, "Qualify" },
    };
    var dialog = await Dialogs.ShowAsync<ConfirmDialog>("Qualify lead", parameters);
    var result = await dialog.Result;
    if (result is null || result.Canceled) return;
    await QualifyLeadAsync(lead.Id);
  }

  private async Task QualifyLeadAsync(Guid leadId)
  {
    if (_busy) return;
    _busy = true;
    try
    {
      var actor = await CurrentCommercialActorAsync();
      if (actor is null) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var res = await PracticeCrmService.QualifyLeadAsync(db, actor, leadId);
      if (res.Succeeded)
      {
        await LoadLeadsAsync();
        if (_isAuthorized)
        {
          _result = res;
          _successMessage = "The lead was qualified.";
          Snackbar.Add(_successMessage, Severity.Success);
        }
      }
      else if (res.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale)
        ClearProtectedState();
      else
        _result = res;
    }
    finally { _busy = false; }
  }
}
