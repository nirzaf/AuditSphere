@page "/app/audit/library"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Abstractions
@using AuditSphereOps.Application.Audit
@using AuditSphereOps.Application.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Audit program library — AuditSphereOps</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Audit program library" Description="The controlled versioned program template library. Published versions are immutable; changes require a new version." />
<p class="scope-note">The controlled, versioned template library preserves the exact source wording of @AuditProgramCatalog.Items.Count procedures across 20 audit sections. Published versions are immutable; a change requires a new version.</p>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading the audit program library…" />
}
else if (_actor is null)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Access unavailable</h2><p>Sign in with an authorized internal staff identity to view the audit program library.</p></MudAlert>
}
else if (_result is not null && !_result.Succeeded)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Access blocked</h2><p>@(_result.ErrorCode)</p></MudAlert>
}
else if (_library is null || _library.Versions.Count == 0)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="status">
    <h2>No published library version</h2>
    <p>No audit program library version exists for this firm yet. Publishing is performed from an engagement's fieldwork workspace, which adopts the exact published version.</p>
  </MudAlert>
}
else
{
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="version-heading" role="region">
    <h2 id="version-heading">Library versions</h2>
    <label>
      Version
      <MudSelect T="string" @bind-Value="_selectedVersion" @bind-Value:after="LoadAsync" Disabled="@_busy">
        @foreach (var version in _library.Versions)
        {
          <MudSelectItem Value="@version.Version.ToString()">@version.ProgramCode v@version.Version · @version.Status · @version.ProcedureCount procedures</MudSelectItem>
        }
      </MudSelect>
    </label>
    @if (_library.SelectedVersion is { } selected)
    {
      <dl class="detail-grid">
        <dt>Status</dt><dd>@selected.Status</dd>
        <dt>Source hash</dt><dd><code>@selected.SourceHash</code></dd>
        <dt>Procedures</dt><dd>@selected.ProcedureCount</dd>
        <dt>Sections</dt><dd>@selected.SectionCount</dd>
        <dt>Published</dt><dd>@(selected.ApprovedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Not published")</dd>
      </dl>
    }
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="sections-heading" role="region">
    <h2 id="sections-heading">Sections</h2>
    <div class="table-wrap">
      <MudTable Items="_library.Sections" Dense="true" Hover="true" Elevation="0" Class="data-table">
  <HeaderContent><MudTh scope="col">#</MudTh><MudTh scope="col">Section</MudTh><MudTh scope="col">Procedures</MudTh><MudTh scope="col"><span class="sr-only">Action</span></MudTh></HeaderContent>
  <RowTemplate>            <MudTd>@context.SectionNumber</MudTd>
            <MudTd>@context.SectionTitle</MudTd>
            <MudTd>@context.ProcedureCount</MudTd>
            <MudTd><MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button small" OnClick="() => OpenSectionAsync(context.SectionNumber)" Disabled="@_busy" Size="Size.Small">Browse</MudButton></MudTd></RowTemplate>
</MudTable>
    </div>
  </MudPaper>

  @if (_sectionPage is not null)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="procedures-heading" role="region">
      <h2 id="procedures-heading">Section @_sectionPage.SectionNumber — @_sectionPage.SectionTitle</h2>
      <form @onsubmit="SearchAsync" @onsubmit:preventDefault="true" style="display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap;">
        <label style="flex: 1; min-width: 16rem;">
          Search procedures
          <MudTextField T="string" @bind-Value="_search" Placeholder="AWP-02 or confirmations" data-optional="true" Disabled="@_busy" />
        </label>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" ButtonType="ButtonType.Submit" Disabled="@_busy">Search</MudButton>
        @if (!string.IsNullOrWhiteSpace(_search))
        {
          <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="ClearSearchAsync" Disabled="@_busy">Clear</MudButton>
        }
      </form>
      @if (_sectionPage.Items.Count == 0)
      {
        <p class="muted">No procedures in this section match the search term.</p>
      }
      else
      {
        <div class="table-wrap">
          <MudTable Items="_sectionPage.Items" Dense="true" Hover="true" Elevation="0" Class="data-table">
  <HeaderContent><MudTh scope="col">Source ID</MudTh><MudTh scope="col">Exact source procedure</MudTh></HeaderContent>
  <RowTemplate>                <MudTd><code>@context.SourceProcedureId</code></MudTd>
                <MudTd>@context.SourceWording</MudTd></RowTemplate>
</MudTable>
        </div>
        <p class="muted">Showing @_sectionPage.Items.Count of @_sectionPage.TotalCount procedures.</p>
      }
    </MudPaper>
  }
}

@code {
  private ActorContext? _actor;
  private AuditProgramLibraryView? _library;
  private AuditProgramSectionPage? _sectionPage;
  private CommandResult? _result;
  private bool _loading = true;
  private bool _busy;
  private string _selectedVersion = string.Empty;
  private string _search = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
      await LoadAsync();
    else
      _loading = false;
  }

  private async Task LoadAsync()
  {
    if (_actor is null || _busy) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var library = await AuditProgramLibraryQuery.GetLibraryAsync(db, _actor,
        string.IsNullOrWhiteSpace(_selectedVersion) ? null : _selectedVersion);
      if (!library.Succeeded)
      {
        Clear();
        _result = CommandResult.Fail(library.ErrorCode!, library.Message!);
        return;
      }
      _library = library.Value;
      _result = null;
      if (_library?.SelectedVersion is { } selected)
        _selectedVersion = selected.Version;
      _sectionPage = null;
      _search = string.Empty;
    }
    finally
    {
      _busy = false;
      _loading = false;
    }
  }

  private async Task OpenSectionAsync(int sectionNumber)
  {
    if (_actor is null || _library?.SelectedVersion is not { } selected || _busy) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var page = await AuditProgramLibraryQuery.GetSectionAsync(db, _actor,
        selected.ProgramVersionId, sectionNumber);
      _result = page.Succeeded ? null : CommandResult.Fail(page.ErrorCode!, page.Message!);
      if (page.Succeeded)
      {
        _sectionPage = page.Value;
        _search = string.Empty;
      }
    }
    finally { _busy = false; }
  }

  private async Task SearchAsync()
  {
    if (_sectionPage is null) return;
    if (_actor is null || _library?.SelectedVersion is not { } selected || _busy) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var page = await AuditProgramLibraryQuery.GetSectionAsync(db, _actor,
        selected.ProgramVersionId, _sectionPage.SectionNumber, string.IsNullOrWhiteSpace(_search) ? null : _search);
      _result = page.Succeeded ? null : CommandResult.Fail(page.ErrorCode!, page.Message!);
      if (page.Succeeded) _sectionPage = page.Value;
    }
    finally { _busy = false; }
  }

  private async Task ClearSearchAsync() => await SearchAsync();

  private void Clear()
  {
    _actor = null;
    _library = null;
    _sectionPage = null;
  }
}
