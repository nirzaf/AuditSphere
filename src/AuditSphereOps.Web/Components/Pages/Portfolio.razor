@page "/app"
@page "/app/overview"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Portfolio</PageTitle>
<PageHeader Title="Portfolio" Description="Staff portfolio overview. Live projections for the current explicit scope; counts are read from PostgreSQL." />
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button-secondary" OnClick="LoadPortfolioAsync" Disabled="@_loading">Refresh portfolio</MudButton>

@if (_loading)
{
  <MudProgressLinear Color="Color.Primary" Indeterminate="true" aria-label="Loading current scope" />
  <LoadingState IsLoading="true" LoadingMessage="Loading current scope…" />
}
else if (_actor is null)
{
  <MudAlert Severity="Severity.Warning" Dense="true"><h2>Sign-in required</h2>This staff view needs an authenticated identity mapped to an active AuditSphereOps user. No local demo actor is available.</MudAlert>
  @if (OidcConfigured)
  {
    <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/auth/sign-in?returnUrl=%2Fauth%2Flanding">Sign in with Entra</MudButton>
  }
  else
  {
    <MudAlert Severity="Severity.Info" Dense="true">Entra OIDC is not configured in this environment.</MudAlert>
  }
}
else if (!IsStaff)
{
  <MudAlert Severity="Severity.Error" Dense="true"><h2>Access unavailable</h2>This staff shell is not available for the current role.</MudAlert>
}
else if (_error is not null)
{
  <MudAlert Severity="Severity.Error" Dense="true"><h2>Unable to load portfolio</h2>@_error</MudAlert>
}
else
{
  @if (!_m365Ready)
  {
    <MudAlert Severity="Severity.Warning" Dense="true"><h2>Microsoft 365 configuration required</h2>SharePoint-backed workspace effects remain disabled until an authorized administrator verifies and activates a configuration revision. <MudLink Href="/app/administration/microsoft365">Review Microsoft 365 setup</MudLink></MudAlert>
  }
  @if (!_hasScope)
  {
    <MudAlert Severity="Severity.Info" Dense="true"><h2>No firm, client or engagement scope</h2>Ask a firm administrator for an active grant before using the portfolio. No firm data is shown without an explicit scope.</MudAlert>
  }
  <MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="6" sm="4" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.overline">Clients</MudText><MudText Typo="Typo.h4">@_metrics.Clients</MudText></MudPaper></MudItem>
    <MudItem xs="6" sm="4" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.overline">Engagements</MudText><MudText Typo="Typo.h4">@_metrics.Engagements</MudText></MudPaper></MudItem>
    <MudItem xs="6" sm="4" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.overline">Open holds</MudText><MudText Typo="Typo.h4">@_metrics.OpenHolds</MudText></MudPaper></MudItem>
    <MudItem xs="6" sm="4" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.overline">Pending ops</MudText><MudText Typo="Typo.h4">@_metrics.PendingOperations</MudText></MudPaper></MudItem>
    <MudItem xs="6" sm="4" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.overline">Ready</MudText><MudText Typo="Typo.h4">@_metrics.ReadyCandidates</MudText></MudPaper></MudItem>
    <MudItem xs="6" sm="4" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.overline">Issued</MudText><MudText Typo="Typo.h4">@_metrics.IssuedReleases</MudText></MudPaper></MudItem>
  </MudGrid>

  @if (_hasScope)
  {
    <MudPaper Class="pa-4 mb-4">
      <h2 id="scope-search-heading">Scoped client search and export</h2>
      <MudText Typo="Typo.body2">Search is limited to the current explicit grant scope.</MudText>
      <MudStack Row="true" Spacing="2" Class="mt-2">
        <MudTextField T="string" Label="Search current scope (optional)" @bind-Value="_search" Immediate="true"
                      Placeholder="Client name, ID or status" />
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="DownloadPortfolioCsvAsync" Disabled="@_loading">Download scoped CSV</MudButton>
      </MudStack>
      @if (!VisibleClients.Any())
      {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">No clients match the current search.</MudAlert>
      }
      else
      {
        <MudTable Items="VisibleClients.ToList()" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm" Class="mt-2">
          <HeaderContent><MudTh>Client</MudTh><MudTh>Client ID</MudTh><MudTh>Visible engagements</MudTh></HeaderContent>
          <RowTemplate>
            <MudTd DataLabel="Client"><strong>@context.Name</strong></MudTd>
            <MudTd DataLabel="Client ID"><code>@context.Id</code></MudTd>
            <MudTd DataLabel="Visible engagements">@context.Engagements</MudTd>
          </RowTemplate>
          <PagerContent><MudTablePager PageSizeOptions="[10, 25]" /></PagerContent>
        </MudTable>
      }
    </MudPaper>
  }

  <MudPaper Class="pa-4 mb-4">
    <h2 id="quick-routes-heading">Practice & operational surfaces</h2>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mt-2">
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/practice/leads">Practice leads</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/practice/time">Time tracking & approvals</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/finance">Firm ledger & periods</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/accounting">Client accounting workspace</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/consolidation">Group consolidation</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/operations">Durable operations & recovery</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/administration">Firm administration</MudButton>
    </MudStack>
  </MudPaper>

  <MudPaper Class="pa-4 mb-4">
    <h2 id="candidate-title">Release candidates</h2>
    @if (!VisibleCandidates.Any())
    {
      <MudAlert Severity="Severity.Info" Dense="true">No release candidates match the current scope and search.</MudAlert>
    }
    else
    {
      <MudTable Items="VisibleCandidates.ToList()" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent><MudTh>Client</MudTh><MudTh>Candidate</MudTh><MudTh>Revision</MudTh><MudTh>Status</MudTh><MudTh>Created</MudTh><MudTh>Action</MudTh></HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Client">@context.ClientName</MudTd>
          <MudTd DataLabel="Candidate"><code>@context.Id</code></MudTd>
          <MudTd DataLabel="Revision">@context.TargetRevision</MudTd>
          <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
          <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
          <MudTd DataLabel="Action"><MudLink Href="@($"/app/releases/{context.Id}")">Open</MudLink></MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager PageSizeOptions="[10, 25]" /></PagerContent>
      </MudTable>
    }
  </MudPaper>

  <MudPaper Class="pa-4 mb-4">
    <h2 id="package-title">Financial-statement packages</h2>
    @if (!VisiblePackages.Any())
    {
      <MudAlert Severity="Severity.Info" Dense="true">No financial-statement packages match the current scope and search.</MudAlert>
    }
    else
    {
      <MudTable Items="VisiblePackages.ToList()" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent><MudTh>Client</MudTh><MudTh>Package</MudTh><MudTh>Framework</MudTh><MudTh>Period</MudTh><MudTh>Status</MudTh><MudTh>Action</MudTh></HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Client">@context.ClientName</MudTd>
          <MudTd DataLabel="Package"><code>@context.Id</code></MudTd>
          <MudTd DataLabel="Framework">@context.Framework</MudTd>
          <MudTd DataLabel="Period">@context.PeriodStart to @context.PeriodEnd</MudTd>
          <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
          <MudTd DataLabel="Action"><MudLink Href="@($"/app/accounting/packages/{context.Id}")">Open</MudLink></MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager PageSizeOptions="[10, 25]" /></PagerContent>
      </MudTable>
    }
  </MudPaper>
}

@code {
  private ActorContext? _actor;
  private PortfolioMetrics _metrics;
  private List<CandidateRow> _candidates = [];
  private List<PackageRow> _packages = [];
  private List<ClientRow> _clients = [];
  private bool _loading = true;
  private bool _m365Ready;
  private bool _hasScope;
  private string _search = string.Empty;
  private string? _error;
  private long _loadGeneration;
  private static readonly string[] PortfolioRoles = ["Administrator", "Partner", "Manager", "Reviewer", "Staff"];

  private IEnumerable<ClientRow> VisibleClients => Filter(_clients, x => $"{x.Name} {x.Id}");
  private IEnumerable<CandidateRow> VisibleCandidates => Filter(_candidates, x => $"{x.ClientName} {x.Id} {x.Status}");
  private IEnumerable<PackageRow> VisiblePackages => Filter(_packages, x => $"{x.ClientName} {x.Id} {x.Framework} {x.Status} {x.PeriodStart} {x.PeriodEnd}");

  private bool OidcConfigured => !string.IsNullOrWhiteSpace(Configuration["Identity:TenantId"]) &&
                                 !string.IsNullOrWhiteSpace(Configuration["Identity:ClientId"]);
  private bool IsStaff => _actor is not null && _actor.Roles.Any(PortfolioRoles.Contains);

  protected override Task OnInitializedAsync() => LoadPortfolioAsync();

  private async Task LoadPortfolioAsync()
  {
    var generation = ++_loadGeneration;
    _loading = true;
    _actor = null;
    _metrics = default;
    _candidates = [];
    _packages = [];
    _clients = [];
    _hasScope = false;
    _m365Ready = false;
    _error = null;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null || generation != _loadGeneration) return;
      if (!actor.Roles.Any(PortfolioRoles.Contains))
      {
        _actor = actor;
        return;
      }
      await using var db = await DbFactory.CreateDbContextAsync();
      var grantScopes = await db.RoleGrants.AsNoTracking().Where(x => x.FirmId == actor.FirmId &&
          x.UserId == actor.UserId && x.RevokedAt == null && PortfolioRoles.Contains(x.Role))
        .Select(x => new { x.ClientId, x.EngagementId }).Distinct().ToListAsync();
      var authorizedScopes = new List<(Guid? ClientId, Guid? EngagementId)>();
      foreach (var scope in grantScopes)
      {
        var authorization = await AuthorizationDecision.AuthorizeAsync(db, actor,
          new AuthorizationRequest(actor.FirmId, scope.ClientId, scope.EngagementId, PortfolioRoles,
            InternalOnly: true, RequireFirmWide: scope.ClientId is null && scope.EngagementId is null));
        if (authorization.Succeeded) authorizedScopes.Add((scope.ClientId, scope.EngagementId));
      }

      var firmWide = authorizedScopes.Contains((null, null));
      var directClientIds = authorizedScopes.Where(x => x.ClientId.HasValue && x.EngagementId is null)
        .Select(x => x.ClientId!.Value).Distinct().ToArray();
      var grantedEngagementIds = authorizedScopes.Where(x => x.EngagementId.HasValue)
        .Select(x => x.EngagementId!.Value).Distinct().ToArray();
      var engagementClientIds = authorizedScopes.Where(x => x.EngagementId.HasValue && x.ClientId.HasValue)
        .Select(x => x.ClientId!.Value).Distinct().ToArray();
      var clientIds = directClientIds.Concat(engagementClientIds).Distinct().ToArray();
      var scopedEngagementIds = firmWide ? Array.Empty<Guid>() : await db.Engagements.AsNoTracking()
        .Where(x => x.FirmId == actor.FirmId &&
          (directClientIds.Contains(x.PracticeClientId) ||
           (grantedEngagementIds.Contains(x.Id) && clientIds.Contains(x.PracticeClientId))))
        .Select(x => x.Id).ToArrayAsync();
      var hasScope = firmWide || directClientIds.Length > 0 || scopedEngagementIds.Length > 0;
      if (!hasScope)
      {
        if (generation == _loadGeneration) _actor = actor;
        return;
      }
      var m365Ready = await db.Microsoft365ConnectionRevisions.AsNoTracking()
        .AnyAsync(x => x.FirmId == actor.FirmId && x.State == Domain.Microsoft365.Microsoft365RevisionStates.Active);
      var clients = await db.PracticeClients.AsNoTracking()
        .Where(x => x.FirmId == actor.FirmId && (firmWide || clientIds.Contains(x.Id)))
        .Select(x => new { x.Id, x.LegalName }).ToDictionaryAsync(x => x.Id, x => x.LegalName);
      var engagementCounts = await db.Engagements.AsNoTracking()
        .Where(x => x.FirmId == actor.FirmId && (firmWide || scopedEngagementIds.Contains(x.Id)))
        .GroupBy(x => x.PracticeClientId).ToDictionaryAsync(x => x.Key, x => x.Count());
      var clientRows = clients.OrderBy(x => x.Value)
        .Select(x => new ClientRow(x.Key, x.Value, engagementCounts.GetValueOrDefault(x.Key))).ToList();
      var metrics = new PortfolioMetrics(
        await db.PracticeClients.CountAsync(x => x.FirmId == actor.FirmId && (firmWide || clientIds.Contains(x.Id))),
        await db.Engagements.CountAsync(x => x.FirmId == actor.FirmId && (firmWide || scopedEngagementIds.Contains(x.Id))),
        await db.EngagementHolds.CountAsync(x => x.FirmId == actor.FirmId && !x.Released && (firmWide || scopedEngagementIds.Contains(x.EngagementId))),
        await db.DurableOperations.CountAsync(x => x.FirmId == actor.FirmId &&
          (firmWide ||
           (x.ClientId.HasValue && directClientIds.Contains(x.ClientId.Value)) ||
           (x.EngagementId.HasValue && scopedEngagementIds.Contains(x.EngagementId.Value))) &&
          x.Status != Domain.Completion.OperationState.COMPLETED && x.Status != Domain.Completion.OperationState.CANCELLED_WITH_DISPOSITION),
        await db.ReleaseCandidates.CountAsync(x => x.FirmId == actor.FirmId &&
          (firmWide || directClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId)) && x.Status == ReleaseStates.Ready),
        await db.Releases.CountAsync(x => x.FirmId == actor.FirmId &&
          (firmWide || directClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId))));
      var candidates = await db.ReleaseCandidates.AsNoTracking().Where(x => x.FirmId == actor.FirmId &&
        (firmWide || directClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId)))
        .OrderByDescending(x => x.CreatedAt).Take(25)
        .Select(x => new CandidateRow(x.Id, x.ClientId, x.TargetRevision, x.Status, x.CreatedAt)).ToListAsync();
      var packages = await db.FinancialPackages.AsNoTracking().Where(x => x.FirmId == actor.FirmId &&
        (firmWide || directClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId)))
        .OrderByDescending(x => x.CreatedAt).Take(25)
        .Select(x => new PackageRow(x.Id, x.ClientId, x.Framework, x.PeriodStart, x.PeriodEnd, x.Status)).ToListAsync();
      if (generation != _loadGeneration) return;
      var currentActor = await ActorResolver.ResolveAsync();
      if (currentActor is null || currentActor.UserId != actor.UserId ||
          currentActor.FirmId != actor.FirmId || currentActor.SessionEpoch != actor.SessionEpoch ||
          generation != _loadGeneration) return;
      foreach (var scope in authorizedScopes)
      {
        var currentGrant = await AuthorizationDecision.AuthorizeAsync(db, currentActor,
          new AuthorizationRequest(actor.FirmId, scope.ClientId, scope.EngagementId, PortfolioRoles,
            InternalOnly: true, RequireFirmWide: scope.ClientId is null && scope.EngagementId is null));
        if (!currentGrant.Succeeded || generation != _loadGeneration) return;
      }
      _actor = currentActor;
      _hasScope = hasScope;
      _m365Ready = m365Ready;
      _clients = clientRows;
      _metrics = metrics;
      _candidates = candidates.Select(x => x with { ClientName = clients.GetValueOrDefault(x.ClientId, "Scoped client") }).ToList();
      _packages = packages.Select(x => x with { ClientName = clients.GetValueOrDefault(x.ClientId, "Scoped client") }).ToList();
    }
    catch (Exception ex)
    {
      if (generation == _loadGeneration)
        _error = "The scoped portfolio could not be loaded.";
      Console.Error.WriteLine($"Portfolio load failed: {ex.GetType().Name}");
    }
    finally { if (generation == _loadGeneration) _loading = false; }
  }

  private async Task DownloadPortfolioCsvAsync()
  {
    await LoadPortfolioAsync();
    if (_actor is null || !_hasScope || _error is not null) return;
    try
    {
      await JS.InvokeVoidAsync("auditSphereExports.downloadText", "auditsphere-portfolio.csv",
        BuildPortfolioCsv(), "text/csv;charset=utf-8");
    }
    catch (JSException)
    {
      _error = "The scoped portfolio CSV could not be downloaded.";
    }
  }

  private readonly record struct PortfolioMetrics(int Clients, int Engagements, int OpenHolds, int PendingOperations, int ReadyCandidates, int IssuedReleases);
  private sealed record ClientRow(Guid Id, string Name, int Engagements);
  private sealed record CandidateRow(Guid Id, Guid ClientId, long TargetRevision, string Status, DateTimeOffset CreatedAt)
  {
    public string ClientName { get; init; } = "Scoped client";
  }
  private sealed record PackageRow(Guid Id, Guid ClientId, string Framework, string PeriodStart, string PeriodEnd, string Status)
  {
    public string ClientName { get; init; } = "Scoped client";
  }

  private IEnumerable<T> Filter<T>(IEnumerable<T> rows, Func<T, string> searchable)
  {
    var term = _search.Trim();
    return string.IsNullOrEmpty(term) ? rows : rows.Where(row => searchable(row).Contains(term, StringComparison.OrdinalIgnoreCase));
  }

  private string BuildPortfolioCsv()
  {
    var lines = new List<string> { "record_type,client,identifier,status,period,details" };
    lines.AddRange(VisibleClients.Select(x => string.Join(',', Csv("CLIENT"), Csv(x.Name), Csv(x.Id.ToString("D")), Csv("SCOPED"), Csv(string.Empty), Csv($"Visible engagements: {x.Engagements}"))));
    lines.AddRange(VisibleCandidates.Select(x => string.Join(',', Csv("RELEASE_CANDIDATE"), Csv(x.ClientName), Csv(x.Id.ToString("D")), Csv(x.Status), Csv(string.Empty), Csv($"Target revision: {x.TargetRevision}"))));
    lines.AddRange(VisiblePackages.Select(x => string.Join(',', Csv("FINANCIAL_PACKAGE"), Csv(x.ClientName), Csv(x.Id.ToString("D")), Csv(x.Status), Csv($"{x.PeriodStart} to {x.PeriodEnd}"), Csv(x.Framework))));
    return string.Join('\n', lines);
  }

  private static string Csv(string value)
  {
    var firstContent = value.AsSpan().TrimStart();
    var formula = firstContent.Length > 0 && firstContent[0] is '=' or '+' or '-' or '@';
    var controlPrefix = value.Length > 0 && value[0] is '\t' or '\r' or '\n';
    var safeValue = formula || controlPrefix ? "'" + value : value;
    return $"\"{safeValue.Replace("\"", "\"\"")}\"";
  }
}
