@page "/app"
@page "/app/overview"
@rendermode InteractiveServer
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IConfiguration Configuration

<PageTitle>Portfolio</PageTitle>
<h1>Portfolio</h1>

@if (_loading)
{
  <p role="status">Loading current scope…</p>
}
else if (_actor is null)
{
  <section class="notice" role="alert">
    <h2>Sign-in required</h2>
    <p>This staff view needs an authenticated identity mapped to an active AuditSphereOps user. No local demo actor is available.</p>
    @if (OidcConfigured)
    {
      <a class="button" href="/auth/sign-in?returnUrl=%2Fapp">Sign in with Entra</a>
    }
    else
    {
      <p class="muted">Entra OIDC is not configured in this environment.</p>
    }
  </section>
}
else if (!IsStaff)
{
  <section class="notice" role="alert">
    <h2>Access unavailable</h2>
    <p>This staff shell is not available for the current role.</p>
  </section>
}
else if (_error is not null)
{
  <section class="notice error" role="alert"><h2>Unable to load portfolio</h2><p>@_error</p></section>
}
else
{
  <p class="scope-note">Live projections for the current explicit scope in firm <code>@_actor.FirmId</code>. Counts are read from PostgreSQL and are not synthetic.</p>
  @if (!_m365Ready)
  {
    <section class="notice" role="status"><h2>Microsoft 365 configuration required</h2><p>SharePoint-backed workspace effects remain disabled until an authorized administrator verifies and activates a configuration revision.</p><a href="/app/administration/microsoft365">Review Microsoft 365 setup</a></section>
  }
  @if (!_hasScope)
  {
    <section class="notice" role="status"><h2>No firm, client or engagement scope</h2><p>Ask a firm administrator for an active grant before using the portfolio. No firm data is shown without an explicit scope.</p></section>
  }
  <section class="metric-grid" aria-label="Portfolio metrics">
    <article class="metric card"><span class="metric-label">Clients</span><strong class="metric-value">@_metrics.Clients</strong></article>
    <article class="metric card"><span class="metric-label">Engagements</span><strong class="metric-value">@_metrics.Engagements</strong></article>
    <article class="metric card"><span class="metric-label">Open holds</span><strong class="metric-value">@_metrics.OpenHolds</strong></article>
    <article class="metric card"><span class="metric-label">Pending operations</span><strong class="metric-value">@_metrics.PendingOperations</strong></article>
    <article class="metric card"><span class="metric-label">Ready candidates</span><strong class="metric-value">@_metrics.ReadyCandidates</strong></article>
    <article class="metric card"><span class="metric-label">Issued releases</span><strong class="metric-value">@_metrics.IssuedReleases</strong></article>
  </section>

  @if (_hasScope)
  {
    <section class="card" aria-labelledby="scope-search-heading">
      <h2 id="scope-search-heading">Scoped client search and export</h2>
      <p class="field-help">Search is limited to the current explicit grant scope. The download contains only the filtered client, release-candidate and package rows visible below.</p>
      <div class="action-bar">
        <label class="field">
          Search current scope (optional)
          <input class="input" @bind="_search" @bind:event="oninput" placeholder="Client name, ID or status" data-optional="true" title="Filter the currently authorized portfolio rows without changing their scope." />
        </label>
        <a class="button" href="@PortfolioCsvHref" download="auditsphere-portfolio.csv" title="Download the currently filtered, scope-bound portfolio rows as CSV">Download scoped CSV</a>
      </div>
      @if (!VisibleClients.Any())
      {
        <p class="muted">No clients match the current search.</p>
      }
      else
      {
        <div class="table-wrap">
          <table>
            <caption class="sr-only">Clients in the current explicit scope</caption>
            <thead><tr><th scope="col">Client</th><th scope="col">Client ID</th><th scope="col">Visible engagements</th></tr></thead>
            <tbody>
            @foreach (var client in VisibleClients)
            {
              <tr><td><strong>@client.Name</strong></td><td><code>@client.Id</code></td><td>@client.Engagements</td></tr>
            }
            </tbody>
          </table>
        </div>
      }
    </section>
  }

  <section class="card" aria-labelledby="quick-routes-heading">
    <h2 id="quick-routes-heading">Practice & operational surfaces</h2>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <a class="button" href="/app/practice/leads">Practice leads</a>
      <a class="button" href="/app/practice/time">Time tracking & approvals</a>
      <a class="button" href="/app/finance">Firm ledger & periods</a>
      <a class="button" href="/app/accounting">Client accounting workspace</a>
      <a class="button" href="/app/consolidation">Group consolidation</a>
      <a class="button" href="/app/operations">Durable operations & recovery</a>
      <a class="button" href="/app/administration">Firm administration</a>
    </div>
  </section>

  <section class="card" aria-labelledby="candidate-title">
    <h2 id="candidate-title">Release candidates</h2>
    @if (!VisibleCandidates.Any())
    {
      <p class="muted">No release candidates match the current scope and search.</p>
    }
    else
    {
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Release candidates in the current firm scope</caption>
          <thead><tr><th scope="col">Client</th><th scope="col">Candidate</th><th scope="col">Revision</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
          <tbody>
          @foreach (var candidate in VisibleCandidates)
          {
            <tr>
              <td>@candidate.ClientName</td>
              <td><code>@candidate.Id</code></td>
              <td>@candidate.TargetRevision</td>
              <td><span class="status">@candidate.Status</span></td>
              <td>@candidate.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
              <td><a href="/app/releases/@candidate.Id">Open</a></td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </section>

  <section class="card" aria-labelledby="package-title">
    <h2 id="package-title">Financial-statement packages</h2>
    @if (!VisiblePackages.Any())
    {
      <p class="muted">No financial-statement packages match the current scope and search.</p>
    }
    else
    {
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Financial-statement packages in the current firm scope</caption>
          <thead><tr><th scope="col">Client</th><th scope="col">Package</th><th scope="col">Framework</th><th scope="col">Period</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
          <tbody>
          @foreach (var package in VisiblePackages)
          {
            <tr>
              <td>@package.ClientName</td>
              <td><code>@package.Id</code></td>
              <td>@package.Framework</td>
              <td>@package.PeriodStart to @package.PeriodEnd</td>
              <td><span class="status">@package.Status</span></td>
              <td><a href="/app/accounting/packages/@package.Id">Open</a></td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </section>
}

@code {
  private ActorContext? _actor;
  private PortfolioMetrics _metrics;
  private List<CandidateRow> _candidates = [];
  private List<PackageRow> _packages = [];
  private List<ClientRow> _clients = [];
  private bool _loading = true;
  private bool _m365Ready;
  private bool _hasScope;
  private string _search = string.Empty;
  private string? _error;

  private IEnumerable<ClientRow> VisibleClients => Filter(_clients, x => $"{x.Name} {x.Id}");
  private IEnumerable<CandidateRow> VisibleCandidates => Filter(_candidates, x => $"{x.ClientName} {x.Id} {x.Status}");
  private IEnumerable<PackageRow> VisiblePackages => Filter(_packages, x => $"{x.ClientName} {x.Id} {x.Framework} {x.Status} {x.PeriodStart} {x.PeriodEnd}");
  private string PortfolioCsvHref => "data:text/csv;charset=utf-8," + Uri.EscapeDataString(BuildPortfolioCsv());

  private bool OidcConfigured => !string.IsNullOrWhiteSpace(Configuration["Identity:TenantId"]) &&
                                 !string.IsNullOrWhiteSpace(Configuration["Identity:ClientId"]);
  private bool IsStaff => _actor is not null &&
    _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "Reviewer" or "Staff");

  protected override async Task OnInitializedAsync()
  {
    try
    {
      _actor = await ActorResolver.ResolveAsync();
      if (_actor is null || !IsStaff) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      _m365Ready = await db.Microsoft365ConnectionRevisions.AsNoTracking()
        .AnyAsync(x => x.FirmId == _actor.FirmId && x.State == Domain.Microsoft365.Microsoft365RevisionStates.Active);
      var grants = await db.RoleGrants.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        x.UserId == _actor.UserId && x.RevokedAt == null).Select(x => new { x.ClientId, x.EngagementId }).ToListAsync();
      var firmWide = grants.Any(x => x.ClientId is null && x.EngagementId is null);
      var directClientIds = grants.Where(x => x.ClientId.HasValue && x.EngagementId is null).Select(x => x.ClientId!.Value).ToArray();
      var grantedEngagementIds = grants.Where(x => x.EngagementId.HasValue).Select(x => x.EngagementId!.Value).ToArray();
      var engagementClientIds = grantedEngagementIds.Length == 0 ? [] : await db.Engagements.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId && grantedEngagementIds.Contains(x.Id))
        .Select(x => x.PracticeClientId).ToArrayAsync();
      var clientIds = directClientIds.Concat(engagementClientIds).Distinct().ToArray();
      var scopedEngagementIds = firmWide ? Array.Empty<Guid>() : await db.Engagements.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId && (directClientIds.Contains(x.PracticeClientId) || grantedEngagementIds.Contains(x.Id)))
        .Select(x => x.Id).ToArrayAsync();
      _hasScope = firmWide || directClientIds.Length > 0 || grantedEngagementIds.Length > 0;
      if (!_hasScope) return;
      var clients = await db.PracticeClients.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId && (firmWide || clientIds.Contains(x.Id)))
        .Select(x => new { x.Id, x.LegalName }).ToDictionaryAsync(x => x.Id, x => x.LegalName);
      var engagementCounts = await db.Engagements.AsNoTracking()
        .Where(x => x.FirmId == _actor.FirmId && (firmWide || scopedEngagementIds.Contains(x.Id)))
        .GroupBy(x => x.PracticeClientId).ToDictionaryAsync(x => x.Key, x => x.Count());
      _clients = clients.OrderBy(x => x.Value)
        .Select(x => new ClientRow(x.Key, x.Value, engagementCounts.GetValueOrDefault(x.Key))).ToList();
      _metrics = new PortfolioMetrics(
        await db.PracticeClients.CountAsync(x => x.FirmId == _actor.FirmId && (firmWide || clientIds.Contains(x.Id))),
        await db.Engagements.CountAsync(x => x.FirmId == _actor.FirmId && (firmWide || scopedEngagementIds.Contains(x.Id))),
        await db.EngagementHolds.CountAsync(x => x.FirmId == _actor.FirmId && !x.Released && (firmWide || scopedEngagementIds.Contains(x.EngagementId))),
        await db.DurableOperations.CountAsync(x => x.FirmId == _actor.FirmId &&
          (firmWide || (x.ClientId == null && x.EngagementId == null) ||
           (x.ClientId.HasValue && directClientIds.Contains(x.ClientId.Value)) ||
           (x.EngagementId.HasValue && scopedEngagementIds.Contains(x.EngagementId.Value))) &&
          x.Status != Domain.Completion.OperationState.COMPLETED && x.Status != Domain.Completion.OperationState.CANCELLED_WITH_DISPOSITION),
        await db.ReleaseCandidates.CountAsync(x => x.FirmId == _actor.FirmId &&
          (firmWide || directClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId)) && x.Status == ReleaseStates.Ready),
        await db.Releases.CountAsync(x => x.FirmId == _actor.FirmId &&
          (firmWide || directClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId))));
      _candidates = await db.ReleaseCandidates.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || directClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId)))
        .OrderByDescending(x => x.CreatedAt).Take(25)
        .Select(x => new CandidateRow(x.Id, x.ClientId, x.TargetRevision, x.Status, x.CreatedAt)).ToListAsync();
      _packages = await db.FinancialPackages.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        (firmWide || directClientIds.Contains(x.ClientId) || scopedEngagementIds.Contains(x.EngagementId)))
        .OrderByDescending(x => x.CreatedAt).Take(25)
        .Select(x => new PackageRow(x.Id, x.ClientId, x.Framework, x.PeriodStart, x.PeriodEnd, x.Status)).ToListAsync();
      _candidates = _candidates.Select(x => x with { ClientName = clients.GetValueOrDefault(x.ClientId, "Scoped client") }).ToList();
      _packages = _packages.Select(x => x with { ClientName = clients.GetValueOrDefault(x.ClientId, "Scoped client") }).ToList();
    }
    catch (Exception ex)
    {
      _error = "The scoped portfolio could not be loaded.";
      Console.Error.WriteLine($"Portfolio load failed: {ex.GetType().Name}");
    }
    finally { _loading = false; }
  }

  private readonly record struct PortfolioMetrics(int Clients, int Engagements, int OpenHolds, int PendingOperations, int ReadyCandidates, int IssuedReleases);
  private sealed record ClientRow(Guid Id, string Name, int Engagements);
  private sealed record CandidateRow(Guid Id, Guid ClientId, long TargetRevision, string Status, DateTimeOffset CreatedAt)
  {
    public string ClientName { get; init; } = "Scoped client";
  }
  private sealed record PackageRow(Guid Id, Guid ClientId, string Framework, string PeriodStart, string PeriodEnd, string Status)
  {
    public string ClientName { get; init; } = "Scoped client";
  }

  private IEnumerable<T> Filter<T>(IEnumerable<T> rows, Func<T, string> searchable)
  {
    var term = _search.Trim();
    return string.IsNullOrEmpty(term) ? rows : rows.Where(row => searchable(row).Contains(term, StringComparison.OrdinalIgnoreCase));
  }

  private string BuildPortfolioCsv()
  {
    var lines = new List<string> { "record_type,client,identifier,status,period,details" };
    lines.AddRange(VisibleClients.Select(x => string.Join(',', Csv("CLIENT"), Csv(x.Name), Csv(x.Id.ToString("D")), Csv("SCOPED"), Csv(string.Empty), Csv($"Visible engagements: {x.Engagements}"))));
    lines.AddRange(VisibleCandidates.Select(x => string.Join(',', Csv("RELEASE_CANDIDATE"), Csv(x.ClientName), Csv(x.Id.ToString("D")), Csv(x.Status), Csv(string.Empty), Csv($"Target revision: {x.TargetRevision}"))));
    lines.AddRange(VisiblePackages.Select(x => string.Join(',', Csv("FINANCIAL_PACKAGE"), Csv(x.ClientName), Csv(x.Id.ToString("D")), Csv(x.Status), Csv($"{x.PeriodStart} to {x.PeriodEnd}"), Csv(x.Framework))));
    return string.Join('\n', lines);
  }

  private static string Csv(string value) => $"\"{value.Replace("\"", "\"\"")}\"";
}
