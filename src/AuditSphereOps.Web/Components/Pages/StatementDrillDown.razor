@page "/app/engagements/{EngagementId:guid}/statements"
@rendermode InteractiveServer
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Financial statements</PageTitle>
<PageHeader Title="Financial statements" Eyebrow="Engagement" Description="Profit or loss and financial position generated from the current approved mapping over the sealed trial balance. Select a line to see its audit procedures." />
<MudLink Href="@($"/app/engagements/{EngagementId}")" Class="back-link mb-2 d-inline-block">← Back to engagement</MudLink>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Building statements…" />
}
else if (_view is null)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Statements unavailable</h2><p>@_message</p></MudAlert>
}
else
{
  <p class="scope-note">Mapping version @_view.MappingVersion over trial balance <code>@_view.DatasetDigest[..12]</code>, @_view.Currency. @(_view.Balances ? "The statements agree." : "The statements do not agree; review the mapping.")</p>
  @foreach (var statement in new[] { _view.ProfitOrLoss, _view.FinancialPosition })
  {
    <MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="1" role="region" aria-label="@statement.Title">
      <h2>@statement.Title</h2>
      <table class="statement-table">
        <thead><tr><th scope="col">Line</th><th scope="col">Section</th><th scope="col" class="num">Amount</th><th scope="col">Audit procedures</th></tr></thead>
        <tbody>
          @foreach (var line in statement.Lines)
          {
            var key = statement.Title + line.DestinationCode;
            <tr>
              <th scope="row"><button type="button" class="linklike" aria-expanded="@(_open == key)" @onclick="@(() => _open = _open == key ? null : key)">@line.DestinationCode</button></th>
              <td>@line.StatementSection</td>
              <td class="num">@line.Amount.ToString("N2")</td>
              <td>@line.Procedures.Count</td>
            </tr>
            @if (_open == key)
            {
              <tr class="statement-drill"><td colspan="4">
                <p class="muted">Audit area <strong>@line.AuditArea</strong>; source accounts @string.Join(", ", line.SourceAccounts).</p>
                @if (line.Procedures.Count == 0) { <p>No audit procedures cover this area yet. <MudLink Href="@($"/app/engagements/{EngagementId}/audit-fieldwork")">Insert an ad hoc step</MudLink>.</p> }
                else
                {
                  <ul aria-label="@($"Procedures for {line.DestinationCode}")">
                    @foreach (var p in line.Procedures)
                    {
                      <li><MudLink Href="@($"/app/engagements/{EngagementId}/audit-fieldwork#procedure-{p.ProcedureId}")">@p.SourceProcedureId · @p.Title</MudLink> <StatusChip Status="@p.Status" /></li>
                    }
                  </ul>
                }
              </td></tr>
            }
          }
        </tbody>
        <tfoot><tr><th scope="row">@statement.TotalLabel</th><td></td><td class="num"><strong>@statement.Total.ToString("N2")</strong></td><td></td></tr></tfoot>
      </table>
    </MudPaper>
  }
}

@code {
  [Parameter] public Guid EngagementId { get; set; }
  private StatementDrillDownView? _view;
  private string? _message, _open;
  private bool _loading = true;

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null) { _message = "Sign in with an authorized staff identity."; return; }
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await FinancialStatementDrillDownQuery.GetAsync(db, actor, EngagementId);
      _view = result.Succeeded ? result.Value : null;
      _message = result.Message;
    }
    finally { _loading = false; }
  }
}
