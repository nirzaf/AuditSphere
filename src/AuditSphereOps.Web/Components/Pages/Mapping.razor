@page "/app/accounting/mappings/{MappingId:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Security
@using AuditSphereOps.Domain.Accounting
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Accounting mapping</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Accounting mapping" Description="Client chart and reporting taxonomy mappings, lineage, validation, and report impact." />
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button-secondary" OnClick="LoadMappingAsync" Disabled="@_loading">Refresh mapping</MudButton>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading the scoped mapping…" />
}
else if (_actor is null || !IsStaff)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">Sign in with an authorized staff identity to view this mapping.</MudText>
  </MudAlert>
}
else if (_mapping is null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Mapping unavailable</h2>
    <MudText Typo="Typo.body2">The mapping is not available in the current firm scope.</MudText>
  </MudAlert>
}
else
{
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="mapping-heading" role="region">
    <p class="eyebrow"><StatusChip Status="@_mapping.Status" /></p>
    <h2 id="mapping-heading"><code>@_mapping.Id</code></h2>
    <dl class="details">
      <dt>Dataset</dt><dd><code>@_mapping.DatasetId</code></dd>
      <dt>Client chart</dt><dd>@(_chart is null ? "Legacy/unbound" : $"v{_chart.Version} · {_chart.SourceScope} · {_chart.Status}")</dd>
      <dt>Taxonomy</dt><dd>@_mapping.TaxonomyVersion</dd>
      <dt>Taxonomy scope</dt><dd>@(_taxonomy is null ? "Unavailable" : $"{_taxonomy.OverlayScope} · base {_taxonomy.BaseTaxonomyVersionId?.ToString("D") ?? "none"}")</dd>
      <dt>Period</dt><dd>@_mapping.PeriodStart to @_mapping.PeriodEnd</dd>
      <dt>Version</dt><dd>@_mapping.Version</dd>
      <dt>Generation</dt><dd>@_mapping.Generation</dd>
    </dl>
  </MudPaper>

  <MudGrid Spacing="3" Class="metric-grid my-3" aria-label="Mapping workbench counts">
    <MudItem xs="12" sm="6" md="3">
      <MudPaper Class="pa-4 h-100" Elevation="1">
        <span class="metric-label">Source accounts</span>
        <strong class="metric-value">@_sourceAccounts.Count</strong>
      </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
      <MudPaper Class="pa-4 h-100" Elevation="1">
        <span class="metric-label">Unmapped</span>
        <strong class="metric-value">@_unmappedAccounts.Count</strong>
      </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
      <MudPaper Class="pa-4 h-100" Elevation="1">
        <span class="metric-label">Split accounts</span>
        <strong class="metric-value">@_splitAccounts.Count</strong>
      </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
      <MudPaper Class="pa-4 h-100" Elevation="1">
        <span class="metric-label">Report destinations</span>
        <strong class="metric-value">@_reportImpacts.Count</strong>
      </MudPaper>
    </MudItem>
  </MudGrid>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="lineage-heading" role="region">
    <h2 id="lineage-heading">Mapping lineage</h2>
    <p class="muted">Mappings are immutable versions. A new source dataset, chart or taxonomy requires a new applicability decision.</p>
    @if (_priorMapping is null)
    {
      <p>This is the first mapping version in the current engagement.</p>
    }
    else
    {
      <p>Prior version: <a href="/app/accounting/mappings/@_priorMapping.Id" title="Open the previous immutable mapping version">v@_priorMapping.Version</a>
        <span class="muted">(@_priorMapping.Status, @_priorAllocationCount allocations)</span></p>
    }
    <p class="status" title="Applicability is bound to this immutable dataset and approved taxonomy version">@(_mapping.Status == AccountingPackageStates.MappingApproved ? "APPLICABLE: exact dataset and taxonomy approved" : "APPLICABILITY PENDING: independent mapping approval required")</p>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="comparison-heading" role="region">
    <h2 id="comparison-heading">Current and prior allocation comparison</h2>
    <p class="muted">This comparison is read-only. A changed source, chart or taxonomy must be reviewed in a new mapping version; prior allocations are never silently reused.</p>
    @if (_comparison.Count == 0)
    {
      <p>No prior allocation comparison is available.</p>
    }
    else
    {
      <MudTable Items="_comparison" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Source account</MudTh><MudTh scope="col">Prior allocation</MudTh><MudTh scope="col">Current allocation</MudTh><MudTh scope="col">Change</MudTh></HeaderContent>
  <RowTemplate>          <MudTd><code>@context.SourceAccountCode</code></MudTd><MudTd>@context.Prior</MudTd><MudTd>@context.Current</MudTd><MudTd><StatusChip Status="@context.Status" /></MudTd></RowTemplate>
</MudTable>
    }
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="unmapped-heading" role="region">
    <h2 id="unmapped-heading">Unmapped source accounts</h2>
    @if (_unmappedAccounts.Count == 0)
    {
      <p class="notice success" role="status">Every non-zero source account has an allocation.</p>
    }
    else
    {
      <p class="muted">These accounts must be resolved in a new mapping version before the package can be built.</p>
      <MudTable Items="_unmappedAccounts" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Account</MudTh><MudTh scope="col">Name</MudTh><MudTh scope="col">Balance</MudTh><MudTh scope="col">Currency</MudTh></HeaderContent>
  <RowTemplate>          <MudTd><code>@context.AccountCode</code></MudTd><MudTd>@context.AccountName</MudTd><MudTd>@context.Amount.ToString("N2")</MudTd><MudTd>@context.Currency</MudTd></RowTemplate>
</MudTable>
    }
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="suggestions-heading" role="region">
    <h2 id="suggestions-heading">Review-only mapping suggestions</h2>
    <p class="muted">Suggestions use account-name tokens only. They are not allocations and must be independently reviewed before anyone creates a new mapping version.</p>
    @if (_suggestions.Count == 0)
    {
      <p>No review-only candidates are available for the unresolved accounts.</p>
    }
    else
    {
      <MudTable Items="_suggestions" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Account</MudTh><MudTh scope="col">Candidate destinations</MudTh><MudTh scope="col">Review state</MudTh></HeaderContent>
  <RowTemplate>            <MudTd><code>@context.AccountCode</code><br /><span class="muted">@context.AccountName</span></MudTd>
            <MudTd>@string.Join(", ", context.Candidates.Select(x => $"{x.Code} ({x.Name})"))</MudTd>
            <MudTd><span class="status" title="A context never changes the immutable mapping">@context.State</span></MudTd></RowTemplate>
</MudTable>
    }
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="split-heading" role="region">
    <h2 id="split-heading">Split and ambiguous allocations</h2>
    @if (_splitAccounts.Count == 0)
    {
      <p>No source account is split across multiple destinations.</p>
    }
    else
    {
      <p class="muted">Splits are deliberate allocations and must total 100%; review the rationale before approval.</p>
      <MudTable Items="_splitAccounts" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Account</MudTh><MudTh scope="col">Destinations</MudTh><MudTh scope="col">Total fraction</MudTh></HeaderContent>
  <RowTemplate>          <MudTd><code>@context.AccountCode</code></MudTd><MudTd>@context.DestinationCount</MudTd><MudTd>@context.TotalFraction.ToString("P2")</MudTd></RowTemplate>
</MudTable>
    }
    <p class="muted">Automatic suggestions are not treated as approved mappings; unresolved suggestions remain visible as unmapped accounts.</p>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="impact-heading" role="region">
    <h2 id="impact-heading">Report impact</h2>
    <MudTable Items="_reportImpacts" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Destination</MudTh><MudTh scope="col">Statement section</MudTh><MudTh scope="col">Source accounts</MudTh><MudTh scope="col">Amount</MudTh></HeaderContent>
  <RowTemplate>        <MudTd>@context.DestinationCode</MudTd><MudTd>@context.StatementSection</MudTd><MudTd>@context.SourceCount</MudTd><MudTd>@context.Amount.ToString("N2")</MudTd></RowTemplate>
</MudTable>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="allocation-heading" role="region">
    <h2 id="allocation-heading">Allocations</h2>
    <div class="table-wrap">
      <MudTable Items="_allocations" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Source account</MudTh><MudTh scope="col">Destination</MudTh><MudTh scope="col">Statement section</MudTh><MudTh scope="col">Fraction</MudTh><MudTh scope="col">Rationale</MudTh></HeaderContent>
  <RowTemplate>            <MudTd><code>@context.SourceAccountCode</code></MudTd>
            <MudTd>@context.DestinationCode</MudTd>
            <MudTd>@context.StatementSection</MudTd>
            <MudTd>@context.Fraction.ToString("P2")</MudTd>
            <MudTd>@context.Rationale</MudTd></RowTemplate>
</MudTable>
    </div>
  </MudPaper>

  @if (_mapping.Status == AccountingPackageStates.MappingDraft)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="approve-heading" role="region">
      <h2 id="approve-heading">Approve mapping</h2>
      <p class="muted">Approval rechecks the accepted dataset, full allocation and current firm/client generation.</p>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="ApproveAsync" Disabled="@_busy">@(_busy ? "Approving…" : "Approve mapping")</MudButton>
      @if (_result is not null)
      {
        <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">@(_result.Succeeded ? "Mapping approved." : $"Blocked: {_result.ErrorCode}")</p>
      }
    </MudPaper>
  }
  else
  {
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="notice success my-4" role="status"><h2>Reviewed mapping</h2><p>This version is immutable and can be used by a package build.</p></MudAlert>
  }
}

@code {
  [Parameter] public Guid MappingId { get; set; }
  private ActorContext? _actor;
  private MappingVersion? _mapping;
  private MappingVersion? _priorMapping;
  private ReportingTaxonomyVersion? _taxonomy;
  private ClientChartVersion? _chart;
  private List<MappingAllocation> _allocations = [];
  private List<SourceRow> _sourceAccounts = [];
  private List<SourceRow> _unmappedAccounts = [];
  private List<SplitRow> _splitAccounts = [];
  private List<SuggestionRow> _suggestions = [];
  private List<ImpactRow> _reportImpacts = [];
  private List<ComparisonRow> _comparison = [];
  private int _priorAllocationCount;
  private CommandResult? _result;
  private bool _loading = true;
  private bool _busy;
  private bool IsStaff => _actor is not null && _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "Reviewer" or "Staff" or "AccountingPreparer" or "AccountingReviewer");

  protected override Task OnParametersSetAsync() => LoadMappingAsync();

  private async Task LoadMappingAsync()
  {
    _loading = true;
    _actor = null;
    _mapping = null;
    _priorMapping = null;
    _taxonomy = null;
    _chart = null;
    _allocations.Clear();
    _sourceAccounts.Clear();
    _unmappedAccounts.Clear();
    _splitAccounts.Clear();
    _suggestions.Clear();
    _reportImpacts.Clear();
    _comparison.Clear();
    _priorAllocationCount = 0;
    _result = null;
    try { await LoadMappingCoreAsync(); }
    finally { _loading = false; }
  }

  private async Task LoadMappingCoreAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null && IsStaff)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var candidate = await db.MappingVersions.AsNoTracking()
        .SingleOrDefaultAsync(x => x.Id == MappingId && x.FirmId == _actor.FirmId);
      if (candidate is not null)
      {
        var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
          new AuthorizationRequest(_actor.FirmId, candidate.ClientId, candidate.EngagementId,
            ["Administrator", "Partner", "Manager", "AccountingPreparer", "AccountingReviewer"], InternalOnly: true));
        if (!authorization.Succeeded)
        {
          return;
        }
        _mapping = candidate;
        _taxonomy = await db.ReportingTaxonomyVersions.AsNoTracking().SingleOrDefaultAsync(x =>
          x.FirmId == _actor.FirmId && x.Code == _mapping.TaxonomyVersion);
        _chart = _mapping.ClientChartVersionId is { } chartId
          ? await db.ClientChartVersions.AsNoTracking().SingleOrDefaultAsync(x =>
            x.FirmId == _actor.FirmId && x.ClientId == _mapping.ClientId && x.Id == chartId)
          : null;
        _allocations = await db.MappingAllocations.AsNoTracking()
          .Where(x => x.FirmId == _actor.FirmId && x.ClientId == _mapping.ClientId &&
                      x.EngagementId == _mapping.EngagementId && x.MappingVersionId == _mapping.Id)
          .OrderBy(x => x.SourceAccountCode).ThenBy(x => x.DestinationCode).ToListAsync();
        var rows = await db.TrialBalanceRows.AsNoTracking().Where(x => x.DatasetId == _mapping.DatasetId)
          .OrderBy(x => x.AccountCode).Select(x => new SourceRow(x.AccountCode, x.AccountName, x.Amount, x.Currency)).ToListAsync();
        _sourceAccounts = rows.GroupBy(x => x.AccountCode, StringComparer.Ordinal)
          .Select(x => new SourceRow(x.Key, x.First().AccountName, x.Sum(y => y.Amount), x.First().Currency)).ToList();
        var mappedCodes = _allocations.Select(x => x.SourceAccountCode).ToHashSet(StringComparer.Ordinal);
        _unmappedAccounts = _sourceAccounts.Where(x => x.Amount != 0m && !mappedCodes.Contains(x.AccountCode)).ToList();
        // ponytail: token heuristic keeps suggestions review-only; add governed aliases/rules when candidate precision matters.
        var taxonomyNodes = _taxonomy is null ? [] : await db.ReportingTaxonomyNodes.AsNoTracking()
          .Where(x => x.FirmId == _actor.FirmId && x.TaxonomyVersionId == _taxonomy.Id && x.IsPosting)
          .Select(x => new TaxonomyCandidate(x.Code, x.Name)).ToListAsync();
        _suggestions = _unmappedAccounts.Select(account =>
          {
            var accountTokens = Tokens(account.AccountName);
            var ranked = taxonomyNodes.Select(node => new
              {
                Node = node,
                Score = accountTokens.Intersect(Tokens(node.Name), StringComparer.OrdinalIgnoreCase).Count()
              }).Where(x => x.Score > 0).OrderByDescending(x => x.Score).ThenBy(x => x.Node.Code, StringComparer.Ordinal)
              .ToArray();
            var best = ranked.FirstOrDefault()?.Score ?? 0;
            var candidates = ranked.Where(x => x.Score == best).Select(x => x.Node).Take(5).ToArray();
            return new SuggestionRow(account.AccountCode, account.AccountName, candidates,
              candidates.Length > 1 ? "AMBIGUOUS · REVIEW" : candidates.Length == 1 ? "CANDIDATE · REVIEW" : "NO CANDIDATE");
          }).Where(x => x.Candidates.Count > 0).ToList();
        _splitAccounts = _allocations.GroupBy(x => x.SourceAccountCode, StringComparer.Ordinal).Where(x => x.Count() > 1)
          .Select(x => new SplitRow(x.Key, x.Select(y => y.DestinationCode).Distinct(StringComparer.OrdinalIgnoreCase).Count(), x.Sum(y => y.Fraction))).ToList();
        var sourceAmounts = _sourceAccounts.ToDictionary(x => x.AccountCode, x => x.Amount, StringComparer.Ordinal);
        _reportImpacts = _allocations.GroupBy(x => new { x.DestinationCode, x.StatementSection })
          .Select(x => new ImpactRow(x.Key.DestinationCode, x.Key.StatementSection,
            MoneyPolicy.Normalize(x.Sum(y => sourceAmounts.GetValueOrDefault(y.SourceAccountCode) * y.Fraction)),
            x.Select(y => y.SourceAccountCode).Distinct(StringComparer.Ordinal).Count())).OrderBy(x => x.DestinationCode).ToList();
        _priorMapping = await db.MappingVersions.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
          x.ClientId == _mapping.ClientId && x.EngagementId == _mapping.EngagementId && x.Version < _mapping.Version)
          .OrderByDescending(x => x.Version).FirstOrDefaultAsync();
        if (_priorMapping is not null)
        {
          var priorAllocations = await db.MappingAllocations.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.MappingVersionId == _priorMapping.Id)
            .OrderBy(x => x.SourceAccountCode).ThenBy(x => x.DestinationCode).ToListAsync();
          _priorAllocationCount = priorAllocations.Count;
          var currentBySource = _allocations.GroupBy(x => x.SourceAccountCode, StringComparer.Ordinal)
            .ToDictionary(x => x.Key, AllocationSummary, StringComparer.Ordinal);
          var priorBySource = priorAllocations.GroupBy(x => x.SourceAccountCode, StringComparer.Ordinal)
            .ToDictionary(x => x.Key, AllocationSummary, StringComparer.Ordinal);
          _comparison = currentBySource.Keys.Concat(priorBySource.Keys).Distinct(StringComparer.Ordinal).OrderBy(x => x, StringComparer.Ordinal)
            .Select(code =>
            {
              var prior = priorBySource.GetValueOrDefault(code, "—");
              var current = currentBySource.GetValueOrDefault(code, "—");
              return new ComparisonRow(code, prior, current, prior == "—" ? "NEW" : current == "—" ? "REMOVED" :
                string.Equals(prior, current, StringComparison.Ordinal) ? "UNCHANGED" : "CHANGED");
            }).ToList();
        }
      }
    }
  }

  private sealed record SourceRow(string AccountCode, string AccountName, decimal Amount, string Currency);
  private sealed record TaxonomyCandidate(string Code, string Name);
  private sealed record SuggestionRow(string AccountCode, string AccountName, IReadOnlyList<TaxonomyCandidate> Candidates, string State);
  private sealed record SplitRow(string AccountCode, int DestinationCount, decimal TotalFraction);
  private sealed record ImpactRow(string DestinationCode, string StatementSection, decimal Amount, int SourceCount);
  private sealed record ComparisonRow(string SourceAccountCode, string Prior, string Current, string Status);

  private static HashSet<string> Tokens(string value) => value.Split(
    [' ', '/', '-', '_', '.', ',', ':', ';', '(', ')'], StringSplitOptions.RemoveEmptyEntries)
    .Where(x => x.Length >= 3).ToHashSet(StringComparer.OrdinalIgnoreCase);

  private static string AllocationSummary(IEnumerable<MappingAllocation> rows) =>
    string.Join("; ", rows.OrderBy(x => x.DestinationCode, StringComparer.Ordinal)
      .Select(x => $"{x.DestinationCode} ({x.Fraction:P2})"));

  private async Task ApproveAsync()
  {
    if (_actor is null || _mapping is null || _busy) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      _result = await FinancialStatementService.ApproveMappingAsync(db, _actor, _mapping.Id, _mapping.Version);
      if (_result.Succeeded) _mapping.Status = AccountingPackageStates.MappingApproved;
    }
    finally { _busy = false; }
  }
}
