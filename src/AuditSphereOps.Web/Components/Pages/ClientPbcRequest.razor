@page "/portal/requests/{RequestId:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using AuditSphereOps.Application.Operations
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Client request</PageTitle>
<a class="back-link" href="/portal">← Back to client portal</a>
<h1>PBC request</h1>

@if (_loading)
{
  <p role="status">Loading the request…</p>
}
else if (_actor is null || _request is null)
{
  <section class="notice" role="alert"><h2>Request unavailable</h2><p>This request is not available in the current client scope.</p></section>
}
else
{
  <section class="card" aria-labelledby="request-heading">
    <p class="eyebrow">@_request.State</p>
    <h2 id="request-heading">@_request.Area</h2>
    <dl class="details">
      <dt>Objective</dt><dd>@_request.Objective</dd>
      <dt>Period</dt><dd>@_request.PeriodStart to @_request.PeriodEnd</dd>
      <dt>Requested format</dt><dd>@_request.RequestedFormat</dd>
      <dt>Due</dt><dd>@_request.DueDate</dd>
      <dt>Acceptance criteria</dt><dd>@_request.AcceptanceCriteria</dd>
    </dl>
  </section>

  <section class="card" aria-labelledby="upload-heading" data-draft-scope="pbc-upload-@RequestId">
    <h2 id="upload-heading">Prepare a controlled upload</h2>
    <p class="muted">This creates a request-bound, expiring transfer intent. Content bytes are not accepted through the interactive circuit and are not marked received until a trusted completion boundary verifies the staged file.</p>
    <div class="field"><label for="@FileInputId">File</label><input id="@FileInputId" type="file" required title="Select the file to transfer; browser security prevents retaining the file itself after navigation." /></div>
    <div class="field"><label for="file-name">File name</label><input id="file-name" @bind="_fileName" maxlength="255" readonly title="Filled from the selected file before the upload starts." /></div>
    <div class="field"><label for="content-type">Content type</label><input id="content-type" @bind="_contentType" maxlength="200" readonly title="Filled from the selected file before the upload starts." /></div>
    <div class="field"><label for="byte-count">Declared bytes</label><input id="byte-count" type="number" min="1" max="262144000" @bind="_byteCount" readonly title="Filled from the selected file before the upload starts." /></div>
    <div class="field"><label for="content-hash">Declared SHA-256</label><input id="content-hash" data-draft-field="declared-sha256" @bind="_contentHash" @bind:event="oninput" maxlength="64" autocomplete="off" required aria-describedby="content-hash-help content-hash-state" title="Enter the lowercase or uppercase SHA-256 digest used to verify the upload." /><span id="content-hash-help" class="muted">Enter the 64-character digest of the exact file selected above.</span><span id="content-hash-state" class="sr-only" aria-live="polite">@(_contentHash.Length == 64 ? "SHA-256 digest entered." : string.Empty)</span></div>
    <button class="button" @onclick="StartUploadAsync" disabled="@_busy">@(_busy ? "Preparing…" : "Prepare upload")</button>
    @if (_result is not null)
    {
      <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">@(_result.Succeeded ? "Transfer intent created; continue through the approved upload transport." : $"Blocked: {_result.ErrorCode} — {_result.Message}")</p>
    }
    @if (!string.IsNullOrWhiteSpace(_uploadMessage))
    {
      <p class="muted" role="status">@_uploadMessage</p>
    }
  </section>

  <section class="card" aria-labelledby="conversation-heading" data-draft-scope="pbc-client-reply-@RequestId">
    <h2 id="conversation-heading">Conversation timeline</h2>
    <ol class="timeline">
      @foreach (var item in Timeline())
      {
        <li><strong>@item.Label</strong> <span class="muted">@item.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span><p>@item.Body</p></li>
      }
    </ol>
    @if (_request.State is not (PbcStates.Accepted or PbcStates.Closed))
    {
      <div class="field"><label for="client-reply">Reply to the assigned auditor or accountant</label><textarea id="client-reply" @bind="_reply" maxlength="4000" required title="Add a response or explain the files you uploaded."></textarea></div>
      <button class="button" @onclick="ReplyAsync" disabled="@_busy" title="Add this response to the request timeline.">Send reply</button>
      @if (_replyResult is not null)
      {
        <p class="command-result @(_replyResult.Succeeded ? "success-text" : "error-text")" role="status">@(_replyResult.Succeeded ? "Reply added to the request timeline." : $"Blocked: {_replyResult.ErrorCode} — {_replyResult.Message}")</p>
      }
    }
  </section>

  <section class="card" aria-labelledby="receipt-heading">
    <h2 id="receipt-heading">Transfer receipts</h2>
    @if (_uploads.Count == 0)
    {
      <p class="muted">No transfer intents are recorded for this request.</p>
    }
    else
    {
      <div class="table-wrap"><table><caption class="sr-only">PBC upload receipts</caption><thead><tr><th scope="col">File</th><th scope="col">Bytes</th><th scope="col">State</th><th scope="col">Expires</th></tr></thead><tbody>
      @foreach (var upload in _uploads)
      {
        <tr><td>@upload.FileName</td><td>@upload.ReceivedByteCount / @upload.DeclaredByteCount</td><td><span class="status">@upload.State</span></td><td>@upload.ExpiresAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td></tr>
      }
      </tbody></table></div>
    }
  </section>
}

@code {
  [Parameter] public Guid RequestId { get; set; }
  private string FileInputId => $"pbc-file-{RequestId:N}";
  private ActorContext? _actor;
  private PbcRequest? _request;
  private List<PbcUploadIntent> _uploads = [];
  private List<PbcCommunication> _communications = [];
  private Dictionary<Guid, string> _userNames = [];
  private CommandResult<PbcUploadReceipt>? _result;
  private CommandResult? _replyResult;
  private string _fileName = string.Empty;
  private string _contentType = "application/octet-stream";
  private long _byteCount;
  private string _contentHash = string.Empty;
  private string? _uploadMessage;
  private string _reply = string.Empty;
  private bool _loading = true;
  private bool _busy;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var candidate = await db.PbcRequests.AsNoTracking().Where(x =>
          x.Id == RequestId && x.FirmId == _actor.FirmId && x.ClientOwnerUserId == _actor.UserId)
        .Select(x => new { x.ClientId, x.EngagementId })
        .SingleOrDefaultAsync();
      if (candidate is not null)
      {
        var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
          new AuthorizationRequest(_actor.FirmId, candidate.ClientId, candidate.EngagementId, ["ClientUser"]));
        if (authorization.Succeeded)
          _request = await db.PbcRequests.AsNoTracking().SingleOrDefaultAsync(x =>
            x.Id == RequestId && x.FirmId == _actor.FirmId && x.ClientOwnerUserId == _actor.UserId);
      }
      if (_request is not null)
        await LoadThreadAsync(db);
    }
    _loading = false;
  }

  private async Task StartUploadAsync()
  {
    if (_actor is null || _request is null || _busy) return;
    _busy = true;
    try
    {
      var metadata = await JS.InvokeAsync<PbcFileMetadata?>("auditSpherePbc.readFileMetadata", FileInputId);
      if (metadata is null)
      {
        _result = CommandResult<PbcUploadReceipt>.Fail("pbc.file-required", "Select a file before preparing the upload.");
        return;
      }
      _fileName = metadata.Name;
      _contentType = metadata.Type;
      _byteCount = metadata.Size;
      await using (var db = await DbFactory.CreateDbContextAsync())
      {
        _result = await PbcService.StartUploadAsync(db, _actor,
          new StartPbcUploadRequest(_request.Id, _fileName, _contentType, _byteCount, _contentHash));
      }
      if (_result.Succeeded)
      {
        _uploadMessage = await JS.InvokeAsync<string>("auditSpherePbc.uploadChunks", FileInputId,
          _result.Value!.UploadIntentId, _result.Value.Capability!);
        await JS.InvokeVoidAsync("auditSphereDrafts.clear", $"pbc-upload-{RequestId}");
        await using var refreshDb = await DbFactory.CreateDbContextAsync();
        await LoadThreadAsync(refreshDb);
      }
      else if (IsAuthorizationFailure(_result.ErrorCode))
      {
        await DenyAndClearAsync();
      }
    }
    catch (JSException ex)
    {
      _uploadMessage = $"Transfer stopped before trusted completion: {ex.Message}";
    }
    finally { _busy = false; }
  }

  private async Task ReplyAsync()
  {
    if (_actor is null || _request is null || _busy) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      _replyResult = await PbcService.ReplyAsync(db, _actor, _request.Id, _reply);
      if (_replyResult.Succeeded)
      {
        _reply = string.Empty;
        _request = await db.PbcRequests.AsNoTracking().SingleAsync(x =>
          x.FirmId == _actor.FirmId && x.Id == RequestId);
        await LoadThreadAsync(db);
        await JS.InvokeVoidAsync("auditSphereDrafts.clear", $"pbc-client-reply-{RequestId}");
      }
      else if (IsAuthorizationFailure(_replyResult.ErrorCode))
      {
        await DenyAndClearAsync();
      }
    }
    finally { _busy = false; }
  }

  private async Task LoadThreadAsync(IAuditSphereDbContext db)
  {
    var actor = _actor!;
    _uploads = await db.PbcUploadIntents.AsNoTracking().Where(x =>
      x.FirmId == actor.FirmId && x.PbcRequestId == RequestId).OrderByDescending(x => x.CreatedAt).ToListAsync();
    _communications = await db.PbcCommunications.AsNoTracking().Where(x =>
      x.FirmId == actor.FirmId && x.PbcRequestId == RequestId).OrderBy(x => x.CreatedAt).ToListAsync();
    var userIds = _communications.Select(x => x.AuthorUserId).Distinct().ToArray();
    _userNames = await db.Users.AsNoTracking().Where(x => x.FirmId == actor.FirmId && userIds.Contains(x.Id))
      .ToDictionaryAsync(x => x.Id, x => string.IsNullOrWhiteSpace(x.DisplayName) ? x.Email : x.DisplayName);
  }

  private IEnumerable<TimelineItem> Timeline() => _communications.Select(x => new TimelineItem(
      x.CreatedAt,
      x.Kind == PbcCommunicationKinds.Email ? $"Email notification {x.DeliveryState?.ToLowerInvariant()}" :
      x.Kind == PbcCommunicationKinds.ClientMessage ? $"You — {Name(x.AuthorUserId)}" : $"Firm — {Name(x.AuthorUserId)}",
      x.Body))
    .Concat(_uploads.Select(x => new TimelineItem(x.CreatedAt, $"You uploaded {x.FileName}",
      $"{x.ReceivedByteCount} of {x.DeclaredByteCount} bytes — {x.State}")))
    .OrderBy(x => x.At);

  private string Name(Guid userId) => _userNames.GetValueOrDefault(userId, "User");
  private static bool IsAuthorizationFailure(string? errorCode) =>
    errorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale;

  private async Task DenyAndClearAsync()
  {
    _request = null;
    _uploads.Clear();
    _communications.Clear();
    _userNames.Clear();
    _reply = string.Empty;
    _fileName = string.Empty;
    _contentType = "application/octet-stream";
    _byteCount = 0;
    _contentHash = string.Empty;
    _uploadMessage = null;
    _result = null;
    _replyResult = null;
    try
    {
      await JS.InvokeVoidAsync("auditSphereDrafts.clear", $"pbc-upload-{RequestId}");
      await JS.InvokeVoidAsync("auditSphereDrafts.clear", $"pbc-client-reply-{RequestId}");
      await JS.InvokeVoidAsync("auditSpherePbc.clearFile", FileInputId);
    }
    catch (JSException) { }
  }

  private sealed record TimelineItem(DateTimeOffset At, string Label, string Body);

  private sealed record PbcFileMetadata(string Name, string Type, long Size);

  public async ValueTask DisposeAsync()
  {
    try { await JS.InvokeVoidAsync("auditSpherePbc.clearFile", FileInputId); }
    catch (JSDisconnectedException) { }
  }
}
