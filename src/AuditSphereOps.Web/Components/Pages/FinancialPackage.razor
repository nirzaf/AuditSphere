@page "/app/accounting/packages/{PackageId:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Accounting
@using AuditSphereOps.Domain.Shared
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Financial statement package</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Financial statement package" Description="Deterministic package calculations, validation status, immutable review decisions, and artifact outputs." />
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button-secondary" OnClick="LoadPackageAsync" Disabled="@_loading">Refresh package</MudButton>
@if (_loadError is not null)
{
  <p class="notice-text" role="status">@_loadError</p>
}

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading the scoped package…" />
}
else if (_denied || _actor is null || !IsStaff)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">Sign in with an authorized staff identity to view this package.</MudText>
  </MudAlert>
}
else if (_package is null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Package unavailable</h2>
    <MudText Typo="Typo.body2">The package is not available in the current firm scope.</MudText>
  </MudAlert>
}
else
{
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="package-heading" role="region">
    <p class="eyebrow"><StatusChip Status="@_package.Status" /></p>
    <h2 id="package-heading"><code>@_package.Id</code></h2>
    <dl class="details">
      <dt>Framework</dt><dd>@_package.Framework</dd>
      <dt>Period</dt><dd>@_package.PeriodStart to @_package.PeriodEnd</dd>
      <dt>Currency</dt><dd>@_package.Currency</dd>
      <dt>Template</dt><dd>@_package.TemplateVersion</dd>
      <dt>Calculation hash</dt><dd><code>@_package.CalculationHash</code></dd>
      @if (_package.SupplementaryHash is not null)
      {
        <dt>Supplementary hash</dt><dd><code>@_package.SupplementaryHash</code></dd>
      }
    </dl>
  </MudPaper>

  @if (_package.Status == AccountingPackageStates.PackageReviewRequired)
  {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="notice my-4" role="status">
      <h2>Review required</h2>
      <MudText Typo="Typo.body2">Cash-flow workings and disclosure responses are not part of this package. It cannot satisfy a complete financial-statement gate.</MudText>
    </MudAlert>
  }
  else
  {
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="notice success my-4" role="status">
      <h2>Inputs validated</h2>
      <MudText Typo="Typo.body2">Supplementary information reconciles deterministically. Accounting and management approval are still separate decisions.</MudText>
    </MudAlert>
  }

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="validation-heading" role="region">
    <h2 id="validation-heading">Validation results</h2>
    <MudTable Items="_validations" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Check</MudTh><MudTh scope="col">Result</MudTh><MudTh scope="col">Detail</MudTh></HeaderContent>
  <RowTemplate>        <MudTd>@context.Code</MudTd><MudTd><span class="status">@(context.Passed ? "PASS" : "REVIEW")</span></MudTd><MudTd>@context.Detail</MudTd></RowTemplate>
</MudTable>
  </MudPaper>

  @if (_canReview)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="review-heading" role="region">
      <h2 id="review-heading">Package review decisions</h2>
      <p class="scope-note">Every decision is recorded against this package's exact revision, generation and calculation hash. Decisions are append-only; a changed package must be reviewed again.</p>
      @if (_package.Status == AccountingPackageStates.PackageValidated)
      {
        <div class="form-grid">
          <label>Stage<select @bind="_reviewStage" required>
            @foreach (var stage in ReviewStages)
            {
              <option value="@stage">@stage</option>
            }
          </select></label>
          <label>Decision<select @bind="_reviewDecision" required>
            @foreach (var decision in FinancialPackageReviewDecisions.All)
            {
              <option value="@decision">@decision</option>
            }
          </select></label>
          <label>Evidence mode<select @bind="_reviewEvidenceMode" required>
            <option value="@FinancialPackageReviewEvidenceModes.SignedIn">SIGNED_IN</option>
            <option value="@FinancialPackageReviewEvidenceModes.Offline">OFFLINE</option>
          </select></label>
          <label>Evidence reference<input @bind="_reviewEvidenceReference" maxlength="2000" required /></label>
        </div>
        <label>Comment<textarea @bind="_reviewComment" maxlength="4000" rows="3" data-optional="true"></textarea></label>
        <div style="display:flex;gap:.75rem;align-items:center;margin-top:1rem;flex-wrap:wrap">
          <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="RecordReviewAsync" Disabled="@_reviewBusy">@(_reviewBusy ? "Recording…" : "Record decision")</MudButton>
          <span class="muted">Management approval uses offline evidence on this staff surface; signed-in management approval must be completed by the authorized client-user surface.</span>
        </div>
      }
      else
      {
        <p class="muted">Review decisions are available only after the package reaches <code>@AccountingPackageStates.PackageValidated</code>.</p>
      }
      @if (_reviewResult is not null)
      {
        <p class="command-result @(_reviewResult.Succeeded ? "success-text" : "error-text")" role="status">
          @(_reviewResult.Succeeded ? (_reviewSuccessMessage ?? "Decision recorded.") : "Blocked: " + _reviewResult.ErrorCode)
        </p>
      }
      <div class="table-wrap" style="margin-top:1rem"><table>
        <caption class="sr-only">Immutable package review decisions</caption>
        <thead><tr><th scope="col">Stage</th><th scope="col">Decision</th><th scope="col">Evidence</th><th scope="col">Package hash</th><th scope="col">Decided at</th></tr></thead>
        <tbody>
        @if (_reviews.Count == 0)
        {
          <tr><td colspan="5" class="muted">No decisions recorded for this package version.</td></tr>
        }
        else
        {
          @foreach (var review in _reviews)
          {
            <tr><td>@review.Stage</td><td><StatusChip Status="@review.Decision" /></td><td>@review.EvidenceMode: @review.EvidenceReference</td><td><code>@review.PackageHash[..Math.Min(12, review.PackageHash.Length)]</code></td><td>@review.DecidedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td></tr>
          }
        }
        </tbody>
      </table></div>
    </MudPaper>
  }

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="statement-heading" role="region">
    <h2 id="statement-heading">Mapped statement totals</h2>
    <MudTable Items="_statementTotals" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Section</MudTh><MudTh scope="col">Amount</MudTh></HeaderContent>
  <RowTemplate>        <MudTd>@context.Key</MudTd><MudTd>@context.Value.ToString("N2") @_package.Currency</MudTd></RowTemplate>
</MudTable>
  </MudPaper>

  @if (_cashFlowLines.Count > 0)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="cash-flow-heading" role="region">
      <h2 id="cash-flow-heading">Cash-flow workings</h2>
      <p class="scope-note">Opening @_package.CashBeginning?.ToString("N2") @_package.Currency; closing @_package.CashEnding?.ToString("N2") @_package.Currency.</p>
      <MudTable Items="_cashFlowLines" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Section</MudTh><MudTh scope="col">Description</MudTh><MudTh scope="col">Amount</MudTh></HeaderContent>
  <RowTemplate> <MudTd>@context.Section</MudTd><MudTd>@context.Description</MudTd><MudTd>@context.Amount.ToString("N2") @_package.Currency</MudTd> </RowTemplate>
</MudTable>
    </MudPaper>
  }

  @if (_disclosures.Count > 0)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="disclosure-heading" role="region">
      <h2 id="disclosure-heading">Disclosure responses</h2>
      <MudTable Items="_disclosures" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Code</MudTh><MudTh scope="col">Response</MudTh><MudTh scope="col">Status</MudTh></HeaderContent>
  <RowTemplate> <MudTd>@context.Code</MudTd><MudTd>@(context.NotApplicable ? context.Rationale : context.Response)</MudTd><MudTd>@(context.NotApplicable ? "Not applicable" : "Answered")</MudTd> </RowTemplate>
</MudTable>
    </MudPaper>
  }

  @if (_artifact is not null)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="artifact-heading" role="region">
      <h2 id="artifact-heading">Deterministic package artifact</h2>
      <p class="scope-note">This is the persisted artifact for the exact package revision and template. Downloading it does not release or deliver the package.</p>
      <dl class="details">
        <dt>Artifact SHA-256</dt><dd><code>@_artifact.ArtifactSha256Hex</code></dd>
        <dt>Artifact size</dt><dd>@_artifact.ArtifactBytes.Length bytes</dd>
      </dl>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="DownloadArtifactAsync" Disabled="@_artifactBusy">@(_artifactBusy ? "Preparing…" : "Download artifact")</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="() => DownloadOfficeArtifactAsync(FinancialPackageArtifactVersions.Workbook)" Disabled="@_artifactBusy">Download workbook</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="() => DownloadOfficeArtifactAsync(FinancialPackageArtifactVersions.ControlledWorkbook)" Disabled="@_artifactBusy">Download controlled workbook</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="() => DownloadOfficeArtifactAsync(FinancialPackageArtifactVersions.Word)" Disabled="@_artifactBusy">Download Word document</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="() => DownloadOfficeArtifactAsync(FinancialPackageArtifactVersions.Pdf)" Disabled="@_artifactBusy">Download PDF</MudButton>
      @if (!string.IsNullOrWhiteSpace(_artifactStatus))
      {
        <p class="notice-text" role="status" aria-live="polite">@_artifactStatus</p>
      }
      <details style="margin-top: 1rem;">
        <summary>View canonical artifact text</summary>
        <pre class="code-block" style="white-space: pre-wrap; font-family: monospace; background: var(--bg-surface-secondary, #f4f4f5); padding: 1rem; border-radius: 4px; overflow-x: auto;"><code>@_artifact.RenderedText</code></pre>
      </details>
    </MudPaper>
  }
}

@code {
  [Parameter] public Guid PackageId { get; set; }
  private ActorContext? _actor;
  private FinancialPackageEntity? _package;
  private FinancialStatementPackageArtifact? _artifact;
  private List<FinancialPackageValidation> _validations = [];
  private List<FinancialPackageLine> _lines = [];
  private List<FinancialPackageCashFlowLine> _cashFlowLines = [];
  private List<FinancialPackageDisclosure> _disclosures = [];
  private List<FinancialPackageReviewSummary> _reviews = [];
  private bool _loading = true;
  private bool _denied;
  private string? _loadError;
  private bool _reviewBusy;
  private bool _artifactBusy;
  private string? _artifactStatus;
  private CommandResult<Guid>? _reviewResult;
  private string? _reviewSuccessMessage;
  private string _reviewStage = FinancialPackageReviewStages.AccountingReview;
  private string _reviewDecision = FinancialPackageReviewDecisions.Approved;
  private string _reviewEvidenceMode = FinancialPackageReviewEvidenceModes.SignedIn;
  private string _reviewEvidenceReference = string.Empty;
  private string _reviewComment = string.Empty;
  private bool IsStaff => _actor is not null && _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "Reviewer" or "Staff" or "AccountingPreparer" or "AccountingReviewer");
  private bool _canReview => _actor is not null && _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "AccountingReviewer" or "AccountingPreparer");
  private IReadOnlyList<string> ReviewStages => _actor?.Roles.Any(x => x is "Partner" or "Administrator") == true
    ? [FinancialPackageReviewStages.ManagementApproval, FinancialPackageReviewStages.AccountingReview, FinancialPackageReviewStages.PartnerApproval]
    : [FinancialPackageReviewStages.ManagementApproval, FinancialPackageReviewStages.AccountingReview];
  private IEnumerable<KeyValuePair<string, decimal>> _statementTotals => _lines
    .GroupBy(x => x.StatementSection, StringComparer.Ordinal)
    .OrderBy(x => x.Key, StringComparer.Ordinal)
    .Select(x => new KeyValuePair<string, decimal>(x.Key, MoneyPolicy.Normalize(x.Sum(y => y.Amount))));

  protected override Task OnInitializedAsync() => LoadPackageAsync();

  private async Task LoadPackageAsync()
  {
    _loading = true;
    _denied = false;
    _loadError = null;
    _actor = null;
    _package = null;
    _artifact = null;
    _validations.Clear();
    _lines.Clear();
    _cashFlowLines.Clear();
    _disclosures.Clear();
    _reviews.Clear();
    try
    {
      _actor = await ActorResolver.ResolveAsync();
      if (_actor is not null && IsStaff)
      {
        await using var db = await DbFactory.CreateDbContextAsync();
        var candidate = await db.FinancialPackages.AsNoTracking()
          .SingleOrDefaultAsync(x => x.Id == PackageId && x.FirmId == _actor.FirmId);
        if (candidate is not null)
        {
          var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
            new AuthorizationRequest(candidate.FirmId, candidate.ClientId, candidate.EngagementId,
              ["Administrator", "Partner", "Manager", "Reviewer", "Staff", "AccountingPreparer", "AccountingReviewer"], InternalOnly: true));
          if (!authorization.Succeeded)
          {
            _denied = true;
            return;
          }
          _package = candidate;
          _validations = await db.FinancialPackageValidations.AsNoTracking()
            .Where(x => x.FirmId == _actor.FirmId && x.FinancialPackageId == _package.Id)
            .OrderBy(x => x.Code).ToListAsync();
          _lines = await db.FinancialPackageLines.AsNoTracking()
            .Where(x => x.FirmId == _actor.FirmId && x.ClientId == _package.ClientId && x.EngagementId == _package.EngagementId && x.FinancialPackageId == _package.Id)
            .OrderBy(x => x.StatementSection).ThenBy(x => x.DestinationCode).ToListAsync();
          _cashFlowLines = await db.FinancialPackageCashFlowLines.AsNoTracking()
            .Where(x => x.FirmId == _actor.FirmId && x.ClientId == _package.ClientId && x.EngagementId == _package.EngagementId && x.FinancialPackageId == _package.Id)
            .OrderBy(x => x.Section).ThenBy(x => x.Description).ToListAsync();
          _disclosures = await db.FinancialPackageDisclosures.AsNoTracking()
            .Where(x => x.FirmId == _actor.FirmId && x.ClientId == _package.ClientId && x.EngagementId == _package.EngagementId && x.FinancialPackageId == _package.Id)
            .OrderBy(x => x.Code).ToListAsync();
          var storedArtifact = await db.FinancialPackageArtifacts.AsNoTracking().SingleOrDefaultAsync(x =>
            x.FirmId == _package.FirmId && x.ClientId == _package.ClientId && x.EngagementId == _package.EngagementId &&
            x.FinancialPackageId == _package.Id && x.PackageRevision == _package.Revision &&
            x.PackageGeneration == _package.Generation && x.PackageHash == _package.CalculationHash &&
            x.ArtifactVersion == FinancialPackageArtifactVersions.Text);
          if (storedArtifact is { ArtifactBytes.Length: > 0 })
            _artifact = new FinancialStatementPackageArtifact(storedArtifact.FinancialPackageId,
              storedArtifact.PackageHash, storedArtifact.ArtifactSha256Hex, storedArtifact.ArtifactBytes,
              System.Text.Encoding.UTF8.GetString(storedArtifact.ArtifactBytes), storedArtifact.Id);
          var reviews = await FinancialPackageReviewService.GetAsync(db, _actor, _package.Id);
          if (reviews.Succeeded)
            _reviews = reviews.Value?.ToList() ?? [];
          else if (IsStaleSession(reviews.ErrorCode))
          {
            DenyAndClear();
            return;
          }
        }
      }
    }
    catch
    {
      _actor = null;
      _package = null;
      _artifact = null;
      _validations.Clear();
      _lines.Clear();
      _cashFlowLines.Clear();
      _disclosures.Clear();
      _reviews.Clear();
      _loadError = "The package could not be refreshed. Try again; previously loaded package data was cleared.";
    }
    finally { _loading = false; }
  }

  private async Task RecordReviewAsync()
  {
    if (_actor is null || _package is null || _reviewBusy) return;
    _reviewBusy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      _reviewResult = await FinancialPackageReviewService.RecordAsync(db, _actor,
        new FinancialPackageReviewRequest(_package.Id, _reviewStage, _reviewDecision, _reviewEvidenceMode,
          _reviewEvidenceReference, _reviewComment));
      if (IsStaleSession(_reviewResult.ErrorCode))
      {
        DenyAndClear();
        return;
      }
      if (_reviewResult.Succeeded)
      {
        _reviewSuccessMessage = "Decision recorded against the current package version.";
        _reviewEvidenceReference = string.Empty;
        _reviewComment = string.Empty;
        var reviews = await FinancialPackageReviewService.GetAsync(db, _actor, _package.Id);
        if (reviews.Succeeded)
          _reviews = reviews.Value?.ToList() ?? [];
        else if (IsStaleSession(reviews.ErrorCode))
        {
          DenyAndClear();
          return;
        }
      }
    }
    finally { _reviewBusy = false; }
  }

  private async Task DownloadArtifactAsync()
  {
    if (_actor is null || _package is null || _artifact is null || _artifactBusy) return;
    _artifactBusy = true;
    _artifactStatus = "Preparing the persisted exact artifact…";
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await FinancialStatementService.GetStoredPackageArtifactAsync(db, _actor, _package.Id);
      if (!result.Succeeded || result.Value is null)
      {
        if (IsStaleSession(result.ErrorCode))
        {
          DenyAndClear();
          return;
        }
        _artifact = null;
        _artifactStatus = result.Message ?? "The current artifact is unavailable; no download occurred.";
        return;
      }
      await JS.InvokeVoidAsync("auditSphereExports.downloadText",
        $"auditsphere-financial-package-{result.Value.PackageId:D}-r{_package.Revision}.txt", result.Value.RenderedText, "text/plain;charset=utf-8");
      _artifactStatus = "Artifact download started. Release and delivery remain separate controls.";
    }
    catch (JSDisconnectedException)
    {
      _artifactStatus = "The download acknowledgement was interrupted; reopen the page and retry.";
    }
    catch (JSException ex)
    {
      _artifactStatus = $"Download failed without changing the package: {ex.Message}";
    }
    finally { _artifactBusy = false; }
  }

  private async Task DownloadOfficeArtifactAsync(string artifactVersion)
  {
    if (_actor is null || _package is null || _artifactBusy) return;
    _artifactBusy = true;
    _artifactStatus = "Preparing the version-bound export artifact…";
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await FinancialStatementService.RenderPackageOfficeArtifactAsync(db, _actor, _package.Id, artifactVersion);
      if (!result.Succeeded || result.Value is null)
      {
        if (IsStaleSession(result.ErrorCode))
        {
          DenyAndClear();
          return;
        }
        _artifactStatus = result.Message ?? "Export artifact generation was blocked.";
        return;
      }
      await JS.InvokeVoidAsync("auditSphereExports.downloadBytes",
        $"auditsphere-financial-package-{_package.Id:D}-r{_package.Revision}.{result.Value.FileExtension}",
        result.Value.ArtifactBytes, result.Value.ContentType);
      _artifactStatus = $"{result.Value.FileExtension.ToUpperInvariant()} download started. Release and delivery remain separate controls.";
    }
    catch (JSDisconnectedException)
    {
      _artifactStatus = "The download acknowledgement was interrupted; reopen the page and retry.";
    }
    catch (JSException ex)
    {
      _artifactStatus = $"Download failed without changing the package: {ex.Message}";
    }
    finally { _artifactBusy = false; }
  }

  private static bool IsStaleSession(string? errorCode) => errorCode == ErrorCodes.GenerationStale;

  private void DenyAndClear()
  {
    _denied = true;
    _package = null;
    _artifact = null;
    _validations.Clear();
    _lines.Clear();
    _cashFlowLines.Clear();
    _disclosures.Clear();
    _reviews.Clear();
  }
}
