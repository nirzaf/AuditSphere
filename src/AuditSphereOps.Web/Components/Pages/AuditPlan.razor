@page "/app/audit/plans/{Id:guid}"
@page "/app/engagements/{EngagementId:guid}/audit-plan"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Audit
@using AuditSphereOps.Domain.Engagements
@using AuditSphereOps.Domain.Security
@using AuditSphereOps.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Audit Plan — AuditSphereOps</PageTitle>

<div class="page-header">
    <nav class="breadcrumb-nav">
        <a href="/app">Portfolio</a> /
        @if (_effectiveEngagementId.HasValue)
        {
            <a href="@($"/app/engagements/{_effectiveEngagementId}")">Engagement</a>
            <span> / </span>
        }
        <span>Audit Plan</span>
    </nav>
    <h1>Audit Plan &amp; Strategy</h1>
    <span class="status-badge badge-blue">@_status</span>
</div>

@if (_loading)
{
    <p role="status">Loading plan…</p>
}
else if (_actor is null || !_isStaff)
{
    <section class="notice" role="alert">
        <h2>Access unavailable</h2>
        <p>Sign in with an authorized internal staff identity to view audit plans.</p>
    </section>
}
else if (_engagement is null)
{
    <section class="notice" role="alert">
        <h2>Plan unavailable</h2>
        <p>The requested engagement or plan was not found in the current firm scope.</p>
    </section>
}
else
{
    <div class="plan-shell">

        <!-- Materiality -->
        <section class="card" aria-labelledby="materiality-heading">
            <h2 id="materiality-heading">Materiality (§19.2)</h2>
            @if (_materiality is not null)
            {
                <dl class="detail-grid">
                    <dt>Overall</dt><dd>@_materiality.Currency @_materiality.Overall.ToString("N0")</dd>
                    <dt>Performance</dt><dd>@_materiality.Currency @_materiality.Performance.ToString("N0")</dd>
                    <dt>Clearly trivial</dt><dd>@_materiality.Currency @_materiality.ClearlyTrivial.ToString("N0")</dd>
                    <dt>Benchmark</dt><dd>@_materiality.Benchmark</dd>
                    <dt>Status</dt><dd>@_materiality.Status</dd>
                </dl>
            }
            else
            {
                <p class="empty-state">No materiality assessment created yet.</p>
                <button class="btn-small" @onclick="NewMateriality">Create Assessment</button>
            }
        </section>

        <!-- Risks -->
        <section class="card" aria-labelledby="risks-heading">
            <h2 id="risks-heading">Identified Risks (§19.3)</h2>
            @if (_risks.Count == 0)
            {
                <p class="empty-state">No audit risks identified yet.</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr><th>Description</th><th>Assertion</th><th>Severity</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _risks)
                        {
                            <tr>
                                <td>@r.Description</td>
                                <td>@r.Assertion</td>
                                <td><span class="badge @(r.Severity == "CRITICAL" || r.Severity == "HIGH" || r.Severity == "Significant" ? "badge-red" : "badge-yellow")">@r.Severity</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <button class="btn-small mt-2" @onclick="NewRisk">Add Risk</button>
        </section>

        <!-- Programs / Workpapers -->
        <section class="card" aria-labelledby="workpapers-heading">
            <h2 id="workpapers-heading">Audit Workpapers (§21.1)</h2>
            @if (_workpapers.Count == 0)
            {
                <p class="empty-state">No workpapers created for this audit plan yet.</p>
            }
            else
            {
                <ul class="program-list">
                    @foreach (var wp in _workpapers)
                    {
                        <li>
                            <span class="program-name">@wp.Title</span>
                            <span class="program-status">State: @wp.State · Generation @wp.Generation</span>
                            <a class="btn-small" href="/app/audit/workpapers/@wp.Id">Open</a>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public Guid? EngagementId { get; set; }

    Guid? _effectiveEngagementId;
    AuditSphereOps.Application.Abstractions.ActorContext? _actor;
    bool _isStaff;
    bool _loading = true;
    string _status = "IN_PROGRESS";

    Engagement? _engagement;

    record MaterialityRow(string Currency, decimal Overall, decimal Performance, decimal ClearlyTrivial, string Benchmark, string Status);
    record RiskRow(string Description, string Assertion, string Severity);

    MaterialityRow? _materiality;
    List<RiskRow> _risks = [];
    List<AuditSphereOps.Domain.Audit.Workpaper> _workpapers = [];

    void NewMateriality() => Nav.NavigateTo($"/app/audit/plans/{_effectiveEngagementId}/materiality/new");
    void NewRisk() => Nav.NavigateTo($"/app/audit/plans/{_effectiveEngagementId}/risks/new");

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _actor = await ActorResolver.ResolveAsync();
        _isStaff = _actor is not null && _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "Staff" or "EngagementLeader" or "Auditor");

        _effectiveEngagementId = EngagementId ?? Id;
        if (_actor is null || !_isStaff || !_effectiveEngagementId.HasValue)
        {
            _loading = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _engagement = await db.Engagements.AsNoTracking()
            .FirstOrDefaultAsync(e => e.Id == _effectiveEngagementId.Value && e.FirmId == _actor.FirmId);

        if (_engagement is null)
        {
            _loading = false;
            return;
        }

        _status = _engagement.ProfessionalWorkBlocked ? "PLANNING_BLOCKED" : "PLANNING_ACTIVE";

        // Query real materiality assessment
        var mat = await db.Database.SqlQueryRaw<MaterialityDto>(
            """
            SELECT currency AS "Currency", overall_amount AS "Overall",
                   performance_amount AS "Performance", clearly_trivial_amount AS "ClearlyTrivial",
                   benchmark_type AS "Benchmark", status AS "Status"
            FROM materiality_assessments
            WHERE engagement_id = {0}
            ORDER BY created_at DESC
            LIMIT 1
            """, _engagement.Id).FirstOrDefaultAsync();

        if (mat is not null)
        {
            _materiality = new(mat.Currency, mat.Overall, mat.Performance, mat.ClearlyTrivial, mat.Benchmark, mat.Status);
        }

        // Query real audit risks
        var risks = await db.AuditRisks.AsNoTracking()
            .Where(r => r.EngagementId == _engagement.Id)
            .OrderBy(r => r.CreatedAt)
            .ToListAsync();

        _risks = risks.Select(r => new RiskRow(r.Description, r.Assertion, r.Severity)).ToList();

        // Query real workpapers
        _workpapers = await db.Workpapers.AsNoTracking()
            .Where(w => w.EngagementId == _engagement.Id)
            .OrderBy(w => w.Title)
            .ToListAsync();

        _loading = false;
    }

    private sealed class MaterialityDto
    {
        public string Currency { get; set; } = string.Empty;
        public decimal Overall { get; set; }
        public decimal Performance { get; set; }
        public decimal ClearlyTrivial { get; set; }
        public string Benchmark { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }
}
