@page "/app/reviews/{Id:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Audit
@using AuditSphereOps.Domain.Reviews
@using AuditSphereOps.Domain.Security
@using AuditSphereOps.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Review Point — AuditSphereOps</PageTitle>

<div class="page-header">
    <nav class="breadcrumb-nav">
        <a href="/app">Portfolio</a> /
        @if (_point is not null)
        {
            <a href="@($"/app/engagements/{_point.EngagementId}")">Engagement</a>
            <span> / </span>
        }
        <span>Review @Id</span>
    </nav>
    <h1>Review Point</h1>
    <span class="status-badge @_statusClass">@_status</span>
</div>

@if (_loading)
{
    <p role="status">Loading review point…</p>
}
else if (_actor is null || !_isStaff)
{
    <section class="notice" role="alert">
        <h2>Access unavailable</h2>
        <p>Sign in with an authorized internal staff identity to view review points.</p>
    </section>
}
else if (_point is null)
{
    <section class="notice" role="alert">
        <h2>Review point unavailable</h2>
        <p>The requested review point was not found in the current firm scope.</p>
    </section>
}
else
{
    <div class="review-shell">

        <section class="card" aria-labelledby="context-heading">
            <h2 id="context-heading">Review Context</h2>
            <dl class="detail-grid">
                <dt>Target Kind</dt><dd>@_point.TargetKind</dd>
                <dt>Target ID</dt><dd>@_point.TargetId</dd>
                <dt>Target Revision</dt><dd>@_point.TargetRevision</dd>
                <dt>Raised By</dt><dd>User @_point.RaisedByUserId.ToString()[..8]</dd>
                <dt>Raised At</dt><dd>@_point.RaisedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                <dt>Blocks gate</dt><dd>@(_point.Significant ? "Yes (Significant)" : "No")</dd>
                <dt>Status</dt><dd><span class="badge @_statusClass">@_status</span></dd>
            </dl>
        </section>

        <section class="card" aria-labelledby="comment-heading">
            <h2 id="comment-heading">Review Comment</h2>
            <p>@_point.Comment</p>
        </section>

        <section class="card" aria-labelledby="actions-heading">
            <h2 id="actions-heading">Review Disposition</h2>
            @if (_actionSuccess)
            {
                <div class="alert alert-success" style="margin-bottom:0.75rem;">Disposition updated successfully.</div>
            }
            @if (_actionError is not null)
            {
                <p class="command-result error-text" role="status">Disposition was not updated: @_actionError</p>
            }
            <div class="action-bar" style="display:flex; gap:0.75rem;">
                @if (!_point.Cleared)
                {
                    <button class="btn-primary btn-green" @onclick="ClearPoint" disabled="@_busy">Clear Review Point</button>
                }
                else
                {
                    <button class="btn-secondary btn-red" @onclick="ReopenPoint" disabled="@_busy">Reopen Review Point</button>
                }
                <a class="button" href="/app/engagements/@_point.EngagementId">Back to Engagement</a>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    AuditSphereOps.Application.Abstractions.ActorContext? _actor;
    bool _isStaff;
    bool _loading = true;
    bool _busy;
    bool _actionSuccess;
    string? _actionError;

    AuditSphereOps.Domain.Reviews.ReviewPoint? _point;
    string _status = "OPEN";
    string _statusClass = "badge-red";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _actor = await ActorResolver.ResolveAsync();
        _isStaff = _actor is not null && _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "Staff" or "EngagementLeader" or "Auditor");

        if (_actor is null || !_isStaff)
        {
            _loading = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var candidate = await db.ReviewPoints.AsNoTracking().Where(rp =>
                rp.Id == Id && rp.FirmId == _actor.FirmId)
            .Select(rp => new { rp.ClientId, rp.EngagementId })
            .SingleOrDefaultAsync();
        if (candidate is not null)
        {
            var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
                new AuthorizationRequest(_actor.FirmId, candidate.ClientId, candidate.EngagementId,
                    ["Administrator", "Partner", "Manager", "Staff", "EngagementLeader", "Auditor"],
                    InternalOnly: true));
            if (authorization.Succeeded)
                _point = await db.ReviewPoints.AsNoTracking().SingleOrDefaultAsync(rp =>
                    rp.Id == Id && rp.FirmId == _actor.FirmId && rp.ClientId == candidate.ClientId &&
                    rp.EngagementId == candidate.EngagementId);
        }

        UpdateStatusBadge();
        _loading = false;
    }

    private void UpdateStatusBadge()
    {
        if (_point is null) return;
        if (_point.Cleared)
        {
            _status = "CLEARED";
            _statusClass = "badge-green";
        }
        else if (_point.Significant)
        {
            _status = "BLOCKING";
            _statusClass = "badge-red";
        }
        else
        {
            _status = "OPEN";
            _statusClass = "badge-yellow";
        }
    }

    Task ClearPoint() => SetDispositionAsync(cleared: true);

    Task ReopenPoint() => SetDispositionAsync(cleared: false);

    private async Task SetDispositionAsync(bool cleared)
    {
        var point = _point;
        var actor = _actor;
        if (point is null || actor is null || _busy) return;
        _busy = true;
        _actionSuccess = false;
        _actionError = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await AuditPlanningService.SetReviewPointDispositionAsync(db, actor, point.Id, cleared);
            if (!result.Succeeded && (result.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale))
            {
                _point = null;
                return;
            }
            if (result.Succeeded)
            {
                point.Cleared = cleared;
                UpdateStatusBadge();
                _actionSuccess = true;
            }
            else
            {
                _actionError = ErrorCatalog.ForUi(result.ErrorCode);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
