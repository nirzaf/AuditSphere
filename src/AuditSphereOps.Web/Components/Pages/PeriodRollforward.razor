@page "/app/accounting/rollforward"
@rendermode InteractiveServer
@using System.Globalization
@using AuditSphereOps.Application.Accounting
@using AuditSphereOps.Domain.Accounting
@using AuditSphereOps.Domain.Shared
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Period roll-forward</PageTitle>
<MudLink Href="/app/accounting" Class="back-link mb-2 d-inline-block">← Back to accounting workspace</MudLink>
<PageHeader Title="Period roll-forward" Description="New draft reporting period created with explicit opening-balance evidence." />

@if (_loading || _selectionBusy)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading scoped periods…" />
}
else if (_actor is null || !_isStaff)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Access unavailable</h2><p>Sign in with an authorized accounting identity to roll a client period forward.</p></MudAlert>
}
else
{
  <p class="scope-note">Roll-forward creates a new draft period and draft books. Prior approvals are not copied; opening balances require explicit source evidence and remain separately reviewable.</p>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="rollforward-heading" role="region">
    <h2 id="rollforward-heading">Create next period</h2>
    <div class="form-grid">
      <label>Client<MudSelect T="string" @bind-Value="_selectedClientId" required Disabled="@(_busy || _selectionBusy)" title="Choose the client whose closed period is being carried forward."><MudSelectItem Value="@string.Empty">Select a client</MudSelectItem>@foreach (var client in _clients) { <MudSelectItem Value="@client.Id.ToString()">@client.Name</MudSelectItem> }</MudSelect></label>
      <label>Closed prior period<MudSelect T="string" @bind-Value="_selectedPriorPeriodId" required title="Choose a closed period; the new period must follow it."><MudSelectItem Value="@string.Empty">Select a period</MudSelectItem>@foreach (var period in _closedPeriods) { <MudSelectItem Value="@period.Id.ToString()">@period.Label</MudSelectItem> }</MudSelect></label>
      <label>New period code<MudTextField T="string" @bind-Value="_periodCode" MaxLength="50" required /></label>
      <label>Start date (yyyy-MM-dd)<MudTextField T="string" @bind-Value="_startDate" MaxLength="10" inputmode="@InputMode.numeric" required /></label>
      <label>End date (yyyy-MM-dd)<MudTextField T="string" @bind-Value="_endDate" MaxLength="10" inputmode="@InputMode.numeric" required /></label>
      <label>Basis<MudTextField T="string" @bind-Value="_basis" MaxLength="50" required /></label>
      <label>Currency<MudTextField T="string" @bind-Value="_currency" MaxLength="3" required /></label>
      <label>Validated source package (optional)<MudSelect T="string" @bind-Value="_selectedSourcePackageId" data-optional="true"><MudSelectItem Value="@string.Empty">Use external source evidence</MudSelectItem>@foreach (var package in _sourcePackages) { <MudSelectItem Value="@package.Id.ToString()">@package.Label</MudSelectItem> }</MudSelect></label>
      <label>Prior closing amount<MudTextField T="string" @bind-Value="_priorClosingAmount" inputmode="@InputMode.numeric" required /></label>
      <label>Current opening amount<MudTextField T="string" @bind-Value="_currentOpeningAmount" inputmode="@InputMode.numeric" required /></label>
      <label>Source SHA-256<MudTextField T="string" @bind-Value="_sourceHash" MaxLength="64" required /></label>
      <label>Evidence reference<MudTextField T="string" @bind-Value="_evidenceReference" MaxLength="2000" required /></label>
    </div>
    <div style="display:flex;gap:.75rem;align-items:center;margin-top:1rem;flex-wrap:wrap">
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="LoadClientAsync" Disabled="@(_busy || _selectionBusy)">@(_selectionBusy ? "Loading…" : "Load closed periods")</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="RollForwardAsync" Disabled="@(_busy || _selectionBusy)">@(_busy ? "Saving…" : "Create draft period")</MudButton>
    </div>
  </MudPaper>

  @if (_result is not null)
  {
    <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">
      @(_result.Succeeded ? (_successMessage ?? "Action completed successfully.") : "Blocked: " + _result.ErrorCode + " — " + _result.Message)
    </p>
  }

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="history-heading" role="region">
    <h2 id="history-heading">Scoped period history</h2>
    @if (_history.Count == 0)
    {
      <p class="muted">No reporting periods are available in the current scope.</p>
    }
    else
    {
      <MudTable Items="_history" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Client</MudTh><MudTh scope="col">Period</MudTh><MudTh scope="col">Dates</MudTh><MudTh scope="col">Status</MudTh><MudTh scope="col">Revision</MudTh><MudTh scope="col">Prior period</MudTh></HeaderContent>
  <RowTemplate>          <MudTd>@context.ClientName</MudTd><MudTd>@context.PeriodCode</MudTd><MudTd>@context.StartDate.ToString("yyyy-MM-dd") — @context.EndDate.ToString("yyyy-MM-dd")</MudTd><MudTd><StatusChip Status="@context.Status" /></MudTd><MudTd>@context.Revision</MudTd><MudTd>@context.PriorPeriodCode</MudTd></RowTemplate>
</MudTable>
    }
  </MudPaper>
}

@code {
  private static readonly string[] AccountingRoles = ["Administrator", "Partner", "Manager", "AccountingPreparer", "AccountingReviewer"];

  private sealed record ClientOption(Guid Id, string Name);
  private sealed record PeriodOption(Guid Id, string Label);
  private sealed record PackageOption(Guid Id, string Label);
  private sealed record PeriodRow(Guid Id, string ClientName, string PeriodCode, DateOnly StartDate, DateOnly EndDate, string Status, long Revision, string PriorPeriodCode);

  private ActorContext? _actor;
  private bool _loading = true;
  private bool _busy;
  private bool _selectionBusy;
  private bool _isStaff;
  private long _selectionGeneration;
  private List<ClientOption> _clients = [];
  private List<PeriodOption> _closedPeriods = [];
  private List<PackageOption> _sourcePackages = [];
  private List<PeriodRow> _history = [];
  private string _selectedClientId = string.Empty;
  private string _selectedPriorPeriodId = string.Empty;
  private string _selectedSourcePackageId = string.Empty;
  private string _periodCode = string.Empty;
  private string _startDate = string.Empty;
  private string _endDate = string.Empty;
  private string _basis = "STATUTORY";
  private string _currency = AccountingDefaults.DefaultCurrency;
  private string _priorClosingAmount = "0";
  private string _currentOpeningAmount = "0";
  private string _sourceHash = string.Empty;
  private string _evidenceReference = string.Empty;
  private CommandResult? _result;
  private string? _successMessage;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      await LoadDataAsync();
      if (_isStaff && _clients.Count > 0)
      {
        _selectedClientId = _clients[0].Id.ToString();
        await LoadClientAsync();
      }
    }
    _loading = false;
  }

  private async Task LoadDataAsync()
  {
    _actor = null;
    _isStaff = false;
    _clients = [];
    _closedPeriods = [];
    _sourcePackages = [];
    _history = [];
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is null)
    {
      ClearScope();
      return;
    }
    await using var db = await DbFactory.CreateDbContextAsync();
    var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
      new AuthorizationRequest(_actor.FirmId, RequiredRoles: AccountingRoles, InternalOnly: true));
    if (!authorization.Succeeded)
    {
      ClearScope();
      return;
    }
    var grants = await db.RoleGrants.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.UserId == _actor.UserId &&
      x.RevokedAt == null && AccountingRoles.Contains(x.Role))
      .Select(x => new { x.ClientId, x.EngagementId }).ToListAsync();
    var firmWide = grants.Any(x => x.ClientId is null && x.EngagementId is null);
    var scopedClientIds = grants.Where(x => x.ClientId.HasValue && x.EngagementId is null).Select(x => x.ClientId!.Value).Distinct().ToArray();
    _isStaff = firmWide || scopedClientIds.Length > 0;
    if (!_isStaff)
    {
      ClearScope();
      return;
    }
    var clients = await db.PracticeClients.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
      (firmWide || scopedClientIds.Contains(x.Id))).OrderBy(x => x.LegalName).ToListAsync();
    var periods = await db.ClientReportingPeriods.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
      (firmWide || scopedClientIds.Contains(x.ClientId))).OrderByDescending(x => x.EndDate).ToListAsync();
    var byId = periods.ToDictionary(x => x.Id);
    _clients = clients.Select(x => new ClientOption(x.Id, x.LegalName)).ToList();
    _history = periods.Select(x => new PeriodRow(x.Id, clients.FirstOrDefault(c => c.Id == x.ClientId)?.LegalName ?? "Scoped client",
      x.PeriodCode, x.StartDate, x.EndDate, x.Status, x.Revision,
      x.PriorPeriodId is { } priorId && byId.TryGetValue(priorId, out var prior) ? prior.PeriodCode : "—")).ToList();
  }

  private async Task LoadClientAsync()
  {
    if (_actor is null || _selectionBusy || !Guid.TryParse(_selectedClientId, out var clientId)) return;
    var generation = ++_selectionGeneration;
    _selectionBusy = true;
    try
    {
      await LoadDataAsync();
      if (_actor is null || !_isStaff) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
        new AuthorizationRequest(_actor.FirmId, ClientId: clientId, RequiredRoles: AccountingRoles, InternalOnly: true));
      if (!authorization.Succeeded)
      {
        ClearScope();
        return;
      }
      var periods = await db.ClientReportingPeriods.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
        x.ClientId == clientId && x.Status == AccountingWorkflowStates.Closed).OrderByDescending(x => x.EndDate).ToListAsync();
      if (generation != _selectionGeneration) return;
      _closedPeriods = periods.Select(x => new PeriodOption(x.Id, $"{x.PeriodCode} ({x.StartDate:yyyy-MM-dd} to {x.EndDate:yyyy-MM-dd})")).ToList();
      _selectedPriorPeriodId = _closedPeriods.FirstOrDefault()?.Id.ToString() ?? string.Empty;
      _sourcePackages = [];
      _selectedSourcePackageId = string.Empty;
      if (periods.FirstOrDefault() is { } prior)
      {
        _currency = prior.Currency;
        _basis = prior.Basis;
        _periodCode = (int.TryParse(prior.PeriodCode, out var year) ? (year + 1).ToString(CultureInfo.InvariantCulture) : prior.PeriodCode + "-NEXT");
        _startDate = prior.EndDate.AddDays(1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _endDate = new DateOnly(prior.EndDate.AddDays(1).Year, 12, 31).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        await LoadPackagesAsync(db, clientId, prior, generation);
      }
    }
    finally
    {
      _selectionBusy = false;
    }
  }

  private async Task LoadPackagesAsync(AuditSphereDbContext db, Guid clientId, ClientReportingPeriod period, long generation)
  {
    var start = period.StartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var end = period.EndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var packages = await db.FinancialPackages.AsNoTracking().Where(x => x.FirmId == _actor!.FirmId && x.ClientId == clientId &&
      x.Status == AccountingPackageStates.PackageValidated && x.PeriodStart == start && x.PeriodEnd == end).OrderBy(x => x.CreatedAt).ToListAsync();
    if (generation != _selectionGeneration) return;
    _sourcePackages = packages.Select(x => new PackageOption(x.Id,
      $"{x.Id} · {x.Currency} · {x.CalculationHash[..Math.Min(12, x.CalculationHash.Length)]}")).ToList();
  }

  private async Task RollForwardAsync()
  {
    if (_actor is null || _busy || !Guid.TryParse(_selectedClientId, out var clientId) || !Guid.TryParse(_selectedPriorPeriodId, out var priorPeriodId) ||
        !DateOnly.TryParseExact(_startDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var startDate) ||
        !DateOnly.TryParseExact(_endDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var endDate) ||
        !decimal.TryParse(_priorClosingAmount, NumberStyles.Number, CultureInfo.InvariantCulture, out var priorClosing) ||
        !decimal.TryParse(_currentOpeningAmount, NumberStyles.Number, CultureInfo.InvariantCulture, out var currentOpening))
    {
      _result = CommandResult.Fail(ErrorCodes.Accounting.ReconciliationRejected, "Select a closed period and enter valid ISO dates and decimal opening amounts.");
      return;
    }
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var sourcePackageId = Guid.TryParse(_selectedSourcePackageId, out var parsedPackageId) ? parsedPackageId : (Guid?)null;
      var created = await ClientAccountingService.RollForwardPeriodAsync(db, _actor,
        new RollForwardPeriodRequest(clientId, priorPeriodId, _periodCode, startDate, endDate, _basis, _currency,
          _sourceHash, priorClosing, currentOpening, _evidenceReference, sourcePackageId));
      if (created.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale)
      {
        ClearScope();
        return;
      }
      _result = created.Succeeded ? CommandResult.Ok() : CommandResult.Fail(created.ErrorCode ?? ErrorCodes.Accounting.ReconciliationRejected, created.Message ?? "Roll-forward was blocked.");
      if (created.Succeeded)
      {
        _successMessage = "Draft period and opening bridge created; a reviewer must approve the opening bridge separately.";
        await LoadDataAsync();
        await LoadClientAsync();
      }
    }
    finally { _busy = false; }
  }

  private void ClearScope()
  {
    _actor = null;
    _isStaff = false;
    _clients = [];
    _closedPeriods = [];
    _sourcePackages = [];
    _history = [];
    _selectedClientId = _selectedPriorPeriodId = _selectedSourcePackageId = string.Empty;
    _periodCode = _startDate = _endDate = _basis = _currency = string.Empty;
    _priorClosingAmount = _currentOpeningAmount = _sourceHash = _evidenceReference = string.Empty;
    _result = null;
    _successMessage = null;
    ++_selectionGeneration;
  }

}
