@page "/app/accounting/remeasurement"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Accounting
@using AuditSphereOps.Domain.Practice
@using AuditSphereOps.Domain.Engagements
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Currency remeasurement</PageTitle>
<MudLink Href="/app/accounting" Class="back-link mb-2 d-inline-block">← Back to accounting workspace</MudLink>
<PageHeader Title="Currency remeasurement workpapers" />

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading scoped periods and approved inputs…" />
}
else if (!_authorized)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Access unavailable</h2><MudText Typo="Typo.body2">An explicitly scoped internal accounting-preparer or reviewer grant is required.</MudText></MudAlert>
}
else
{
  <p class="scope-note">Create a source-evidence-linked calculation using an approved rate set and translation policy. Independent approval rechecks the source, policy, rate and totals. Approval records a workpaper only; it does not post an adjustment journal or clear any release/records gate.</p>
  @* draft-state.js boundary: the section element and the draft-tracked select/date controls stay native
     because the script reads control.value of [data-draft-field] input/select/textarea nodes and the
     restore journey re-reads these exact GUID/ISO values after reload. Text and numeric fields are
     MudBlazor controls whose inner input carries the forwarded data-draft-field attribute. *@
  <section class="card" aria-labelledby="prepare-heading" data-draft-scope="@DraftScope" data-draft-server-managed>
    <h2 id="prepare-heading">Prepare workpaper</h2>
    <p class="muted"><span class="required-mark">*</span> Required. Link each item to an imported GL line and an evidence snapshot. The GL link is corroborating lineage only; it does not prove the amount is still outstanding. Confirm open-item status, amount and classification against period-end evidence. Historical rate date is required for non-monetary historical-cost items.</p>
    <p class="muted">Unsubmitted fields are saved in this browser's local storage for this signed-in user and cleared after a confirmed submission. Do not use a shared browser profile for confidential work.</p>
    <div class="form-grid">
      <label>Client period and engagement <span class="required-mark">*</span>
        <select data-draft-field="context" @bind="_contextId" @bind:after="ContextChangedAsync" required title="Only periods and engagements within your current accounting grants are listed.">
          <option value="">Select a scoped period</option>
          @foreach (var context in _contexts) { <option value="@context.Id">@context.ClientName · @context.PeriodCode · @context.EndDate.ToString("yyyy-MM-dd") · @context.EngagementLabel</option> }
        </select>
      </label>
      <label>Approved rate set <span class="required-mark">*</span>
        <select data-draft-field="rate-set" @bind="_rateSetId" required title="Only approved firm rate sets effective on the period end are available."><option value="">Select an approved rate set</option>@foreach (var rate in _rateSets) { <option value="@rate.Id">@rate.Label</option> }</select>
      </label>
      <label>Approved translation policy <span class="required-mark">*</span>
        <select data-draft-field="translation-policy" @bind="_policyId" required title="The policy chooses the closing rate for monetary items and historical rate for historical-cost non-monetary items."><option value="">Select an approved policy</option>@foreach (var policy in _policies) { <option value="@policy.Id">@policy.Label</option> }</select>
      </label>
    </div>
    @if (_lines.Count == 0) { <p class="muted">Select a period to add evidence-backed line items.</p> }
    @for (var index = 0; index < _lines.Count; index++)
    {
      var line = _lines[index];
      <fieldset class="card" @key="line">
        <legend>Item @(index + 1)</legend>
        <div class="form-grid">
          <label>Stable source reference <span class="required-mark">*</span>
            <MudTextField T="string" Immediate="true" @bind-Value="line.Reference" MaxLength="200"
              data-draft-field="@($"reference-{index}")" required inputmode="@InputMode.text"
              title="Use a stable transaction or balance reference from the cited evidence." />
          </label>
          <label>Evidence snapshot ID <span class="required-mark">*</span>
            <MudTextField T="string" Immediate="true" @bind-Value="line.SnapshotId"
              data-draft-field="@($"snapshot-{index}")" required
              title="Paste the exact snapshot ID from the scoped source document. The service verifies firm, client and engagement ownership." />
          </label>
          <label>Imported GL source line <span class="required-mark">*</span>
            <select data-draft-field="source-line-@index" @bind="line.SourceLineId" @bind:after="() => SourceLineChangedAsync(line)" required title="Choose a sealed foreign-currency GL line from this exact engagement and period. The linked source is revalidated at approval.">
              <option value="">Select a sealed GL line</option>
              @foreach (var source in _glLines) { <option value="@source.Id">@source.Label</option> }
            </select>
          </label>
          @if (_glLines.FirstOrDefault(x => x.Id.ToString("D") == line.SourceLineId) is { } selectedSource)
          {
            <p class="muted">GL source: @selectedSource.Currency @selectedSource.OriginalAmount · functional @selectedSource.FunctionalAmount @_functionalCurrency · @selectedSource.Label. Enter the independently confirmed open balance below.</p>
          }
          <label>Classification <span class="required-mark">*</span><select data-draft-field="monetary-@index" @bind="line.IsMonetary" title="Monetary items use the policy closing rate; historical-cost non-monetary items use the historical rate."><option value="true">Monetary — closing rate</option><option value="false">Non-monetary — historical cost</option></select></label>
          <label>Foreign currency <span class="required-mark">*</span>
            <MudTextField T="string" Immediate="true" @bind-Value="line.Currency" MaxLength="3"
              data-draft-field="@($"currency-{index}")" required pattern="[A-Za-z]{3}"
              title="Three-letter ISO currency code, different from the functional currency." />
          </label>
          <label>Foreign-currency amount <span class="required-mark">*</span>
            <MudNumericField T="decimal?" Immediate="true" @bind-Value="line.ForeignAmount" Step="0.000001m"
              data-draft-field="@($"foreign-amount-{index}")" required
              title="Amount in the item's foreign currency, as shown in the source evidence." />
          </label>
          <label>Prior functional carrying amount <span class="required-mark">*</span>
            <MudNumericField T="decimal?" Immediate="true" @bind-Value="line.PriorCarrying" Step="0.000001m"
              data-draft-field="@($"prior-carrying-{index}")" required
              title="Prior carrying value already expressed in the client's functional currency." />
          </label>
          <label>Historical rate date @if (!line.IsMonetary) { <span class="required-mark">*</span> } else { <span class="muted">optional for monetary items</span> }
            <input data-draft-field="@($"historical-date-{index}")" @bind="line.HistoricalRateDate" type="date" required="@(!line.IsMonetary)" title="Required only for non-monetary historical-cost items; must be on or before period end." />
          </label>
        <div><MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveLineAsync(line)" title="Remove this unsubmitted line from the current workpaper." Disabled="@_busy">Remove item</MudButton></div>
        </div>
      </fieldset>
    }
    <div class="action-bar">
      <MudButton Variant="Variant.Outlined" OnClick="AddLineAsync" Disabled="@(_busy || _contextId.Length == 0 || _lines.Count >= 500)" title="Add another evidence-linked calculation line, up to 500 per schedule.">Add item</MudButton>
      <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PrepareAsync" Disabled="@_busy" title="Validate exact source snapshot ownership and approved rates, calculate, then persist an immutable submitted schedule.">@(_busy ? "Saving…" : "Prepare workpaper")</MudButton>
    </div>
  </section>

  @if (_message is not null) { <p class="command-result @(_error ? "error-text" : "success-text")" role="status">@_message</p> }
  @if (_schedule is not null)
  {
    <MudPaper Class="pa-4 my-4" Elevation="1" aria-labelledby="schedule-heading" role="region">
      <h2 id="schedule-heading">Workpaper · @_schedule.Status</h2>
      <p>As of @_schedule.AsOfDate · functional currency @_schedule.FunctionalCurrency · @_schedule.ItemCount item(s) · FX adjustment <strong>@_schedule.TotalForeignExchangeAdjustment.ToString("0.000000") @_schedule.FunctionalCurrency</strong></p>
      <p>Manifest <code>@_schedule.InputHash</code></p>
      <MudTable T="CurrencyRemeasurementItemView" Items="_schedule.Items" Hover="false" Breakpoint="Breakpoint.None" Class="table-wrap" aria-label="Currency remeasurement item calculations">
        <HeaderContent>
          <MudTh>Reference</MudTh>
          <MudTh>Evidence snapshot / SHA-256</MudTh>
          <MudTh>Imported GL line / digest</MudTh>
          <MudTh>Classification</MudTh>
          <MudTh>Rate</MudTh>
          <MudTh>Remeasured</MudTh>
          <MudTh>FX adjustment</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Reference">@context.StableItemReference</MudTd>
          <MudTd DataLabel="Evidence snapshot"><code>@context.EvidenceSnapshotId</code><br /><code>@context.EvidenceSha256</code></MudTd>
          <MudTd DataLabel="Imported GL line"><code>@context.SourceGeneralLedgerLineId</code><br /><code>@context.SourceGlLineDigest</code></MudTd>
          <MudTd DataLabel="Classification">@(context.IsMonetary ? "Monetary" : "Historical-cost non-monetary")</MudTd>
          <MudTd DataLabel="Rate">@context.RateType · @context.RateDate · @context.AppliedRate</MudTd>
          <MudTd DataLabel="Remeasured">@context.RemeasuredFunctionalAmount</MudTd>
          <MudTd DataLabel="FX adjustment">@context.ForeignExchangeAdjustment</MudTd>
        </RowTemplate>
      </MudTable>
      @if (_schedule.Status == AccountingWorkflowStates.Submitted && _schedule.CreatedByUserId != _actor!.UserId)
      {
        <div class="action-bar">
          <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApproveAsync" Disabled="@_busy" title="Independently revalidate current source evidence, approved rate/policy and calculations before approving this workpaper.">Approve independently</MudButton>
        </div>
      }
      <p class="muted">Prepared by <code>@_schedule.CreatedByUserId</code>@if (_schedule.ApprovedByUserId is { } approvedBy) { <span> · Approved by <code>@approvedBy</code></span> }</p>
    </MudPaper>
  }
  <MudPaper Class="pa-4 my-4" Elevation="1" aria-labelledby="history-heading" role="region">
    <h2 id="history-heading">Recent scoped workpapers</h2>
    @if (_history.Count == 0) { <p class="muted">No saved workpapers are available in the current scope.</p> }
    else
    {
      <MudTable T="ScheduleRow" Items="_history" Hover="false" Breakpoint="Breakpoint.None" Class="table-wrap" aria-label="Recent scoped currency remeasurement workpapers">
        <HeaderContent>
          <MudTh>Client</MudTh>
          <MudTh>Period</MudTh>
          <MudTh>Status</MudTh>
          <MudTh>Created</MudTh>
          <MudTh>Action</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Client">@context.ClientName</MudTd>
          <MudTd DataLabel="Period">@context.PeriodCode</MudTd>
          <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
          <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</MudTd>
          <MudTd DataLabel="Action"><MudButton Variant="Variant.Text" OnClick="() => OpenScheduleAsync(context.Id)" title="Load this schedule only if the current exact client and engagement grant allows access.">Open / review</MudButton></MudTd>
        </RowTemplate>
      </MudTable>
    }
  </MudPaper>
}

@code {
  private static readonly string[] Roles = ["Administrator", "Partner", "Manager", "AccountingPreparer", "AccountingReviewer"];
  private sealed record ContextOption(Guid Id, Guid ClientId, Guid EngagementId, string ClientName, string PeriodCode, DateOnly EndDate, string EngagementLabel);
  private sealed record IdOption(Guid Id, string Label);
  private sealed record GlLineOption(Guid Id, string Currency, decimal OriginalAmount, decimal FunctionalAmount, string Label);
  private sealed record ScheduleRow(Guid Id, string ClientName, string PeriodCode, string Status, DateTimeOffset CreatedAt);
  private sealed class LineInput
  {
    public string Reference { get; set; } = string.Empty;
    public string SnapshotId { get; set; } = string.Empty;
    public string SourceLineId { get; set; } = string.Empty;
    public bool IsMonetary { get; set; } = true;
    public string Currency { get; set; } = string.Empty;
    public decimal? ForeignAmount { get; set; }
    public decimal? PriorCarrying { get; set; }
    public DateTime? HistoricalRateDate { get; set; }
  }

  private ActorContext? _actor;
  private bool _loading = true;
  private bool _authorized;
  private bool _busy;
  private bool _error;
  private bool _draftRestoreAttempted;
  private bool _saveDraftAfterRender;
  private string _contextId = string.Empty;
  private string _loadedContextId = string.Empty;
  private string _rateSetId = string.Empty;
  private string _policyId = string.Empty;
  private string? _message;
  private List<ContextOption> _contexts = [];
  private List<IdOption> _rateSets = [];
  private List<IdOption> _policies = [];
  private List<GlLineOption> _glLines = [];
  private List<ScheduleRow> _history = [];
  private List<LineInput> _lines = [];
  private CurrencyRemeasurementScheduleView? _schedule;
  private string _functionalCurrency = string.Empty;
  private string DraftScope => $"accounting-remeasurement-{_actor?.FirmId:D}-{_actor?.UserId:D}";

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
        new AuthorizationRequest(_actor.FirmId, RequiredRoles: Roles, InternalOnly: true));
      if (authorization.Succeeded)
      {
        _authorized = true;
        var grants = await db.RoleGrants.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.UserId == _actor.UserId &&
          x.RevokedAt == null && Roles.Contains(x.Role)).Select(x => new { x.ClientId, x.EngagementId }).ToListAsync();
        var firmWide = grants.Any(x => x.ClientId is null && x.EngagementId is null);
        var grantedClientIds = grants.Where(x => x.ClientId.HasValue && x.EngagementId is null).Select(x => x.ClientId!.Value).Distinct().ToArray();
        var grantedEngagementIds = grants.Where(x => x.EngagementId.HasValue).Select(x => x.EngagementId!.Value).Distinct().ToArray();
        var engagements = await db.Engagements.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
          (firmWide || grantedClientIds.Contains(x.PracticeClientId) || grantedEngagementIds.Contains(x.Id))).ToListAsync();
        var permitted = engagements.Where(e => firmWide || grants.Any(g => g.ClientId == e.PracticeClientId && g.EngagementId is null) ||
          grants.Any(g => g.ClientId == e.PracticeClientId && g.EngagementId == e.Id)).ToArray();
        var clientIds = permitted.Select(x => x.PracticeClientId).Distinct().ToArray();
        var engagementIds = permitted.Select(x => x.Id).ToArray();
        var periods = await db.ClientReportingPeriods.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && clientIds.Contains(x.ClientId)).ToListAsync();
        var clients = await db.PracticeClients.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && clientIds.Contains(x.Id))
          .ToDictionaryAsync(x => x.Id, x => x.LegalName);
        _contexts = periods.SelectMany(p => permitted.Where(e => e.PracticeClientId == p.ClientId).Select(e => new ContextOption(
          p.Id, p.ClientId, e.Id, clients.GetValueOrDefault(p.ClientId, "Scoped client"), p.PeriodCode, p.EndDate, e.ServiceRoute)))
          .OrderByDescending(x => x.EndDate).ThenBy(x => x.ClientName).ToList();
        _history = await db.CurrencyRemeasurementSchedules.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
          (firmWide || grantedClientIds.Contains(x.ClientId) || engagementIds.Contains(x.EngagementId)))
          .OrderByDescending(x => x.CreatedAt).Take(50).Join(db.ClientReportingPeriods.AsNoTracking(),
            schedule => schedule.PeriodId, period => period.Id, (schedule, period) => new { schedule, period })
          .Join(db.PracticeClients.AsNoTracking(), x => x.schedule.ClientId, client => client.Id,
            (x, client) => new ScheduleRow(x.schedule.Id, client.LegalName, x.period.PeriodCode, x.schedule.Status, x.schedule.CreatedAt)).ToListAsync();
        if (_contexts.Count > 0)
        {
          _contextId = _contexts[0].Id.ToString("D");
          await LoadChoicesAsync();
        }
      }
    }
    _loading = false;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!_draftRestoreAttempted && !_loading && _authorized && _actor is not null)
    {
      _draftRestoreAttempted = true;
      try
      {
        var scope = $"accounting-remeasurement-{_actor.FirmId:D}-{_actor.UserId:D}";
        var json = await JS.InvokeAsync<string?>("auditSphereDrafts.readScopedDraft", scope);
        if (!string.IsNullOrWhiteSpace(json))
        {
          using var document = System.Text.Json.JsonDocument.Parse(json);
          var fields = document.RootElement.GetProperty("fields");
          string Value(string key) => fields.TryGetProperty(key, out var value) ? value.ToString() : string.Empty;
          if (Guid.TryParse(Value("context"), out var periodId) && _contexts.Any(x => x.Id == periodId))
          {
            _contextId = periodId.ToString("D");
            await LoadChoicesAsync();
            _rateSetId = _rateSets.Any(x => x.Id.ToString("D") == Value("rate-set")) ? Value("rate-set") : string.Empty;
            _policyId = _policies.Any(x => x.Id.ToString("D") == Value("translation-policy")) ? Value("translation-policy") : string.Empty;
            var count = fields.EnumerateObject().Select(x => x.Name).Where(x => x.StartsWith("reference-", StringComparison.Ordinal))
              .Select(x => int.TryParse(x.AsSpan("reference-".Length), out var index) ? index + 1 : 0).DefaultIfEmpty(1).Max();
            _lines = Enumerable.Range(0, Math.Min(count, 500)).Select(index => new LineInput
            {
              Reference = Value($"reference-{index}"), SnapshotId = Value($"snapshot-{index}"),
              SourceLineId = _glLines.Any(g => g.Id.ToString("D") == Value($"source-line-{index}")) ? Value($"source-line-{index}") : string.Empty,
              IsMonetary = bool.TryParse(Value($"monetary-{index}"), out var monetary) && monetary,
              Currency = Value($"currency-{index}"),
              ForeignAmount = decimal.TryParse(Value($"foreign-amount-{index}"), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var foreign) ? foreign : null,
              PriorCarrying = decimal.TryParse(Value($"prior-carrying-{index}"), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var carrying) ? carrying : null,
              HistoricalRateDate = DateTime.TryParse(Value($"historical-date-{index}"), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date) ? date : null
            }).ToList();
            if (_lines.Count == 0) _lines.Add(new LineInput());
            StateHasChanged();
          }
        }
      }
      catch (JSException) { /* Browser storage can be unavailable; keep the workbench usable for this session. */ }
      catch (System.Text.Json.JsonException) { /* Ignore a damaged browser draft; never block the workbench. */ }
    }
    if (_saveDraftAfterRender)
    {
      _saveDraftAfterRender = false;
      try { await JS.InvokeVoidAsync("auditSphereDrafts.saveAll"); } catch (JSException) { }
    }
  }

  private async Task LoadChoicesAsync()
  {
    _rateSets = [];
    _policies = [];
    _glLines = [];
    _functionalCurrency = string.Empty;
    _rateSetId = _policyId = string.Empty;
    if (_actor is null || !Guid.TryParse(_contextId, out var periodId)) return;
    var context = _contexts.FirstOrDefault(x => x.Id == periodId);
    if (context is null) return;
    _loadedContextId = _contextId;
    await using var db = await DbFactory.CreateDbContextAsync();
    var profile = await db.ClientAccountingProfiles.AsNoTracking().SingleOrDefaultAsync(x => x.FirmId == _actor.FirmId && x.ClientId == context.ClientId);
    if (profile is null) return;
    _functionalCurrency = profile.FunctionalCurrency;
    var rateSets = await db.ExchangeRateSetVersions.AsNoTracking().Where(x => x.FirmId == _actor.FirmId && x.Status == AccountingWorkflowStates.Approved &&
      (x.EffectiveFrom == null || x.EffectiveFrom <= context.EndDate) && (x.EffectiveTo == null || x.EffectiveTo >= context.EndDate))
      .OrderByDescending(x => x.ApprovedAt).ToListAsync();
    var policies = await db.TranslationPolicyVersions.AsNoTracking().Where(x => x.FirmId == _actor.FirmId &&
      x.Status == AccountingWorkflowStates.Approved && x.FunctionalCurrency == profile.FunctionalCurrency).OrderByDescending(x => x.ApprovedAt).ToListAsync();
    _glLines = await (from line in db.GeneralLedgerLines.AsNoTracking()
      join batch in db.SourceImportBatches.AsNoTracking() on new
        { line.FirmId, line.ClientId, line.EngagementId, line.ImportBatchId }
        equals new { batch.FirmId, batch.ClientId, batch.EngagementId, ImportBatchId = batch.Id }
      join transaction in db.GeneralLedgerTransactions.AsNoTracking() on new
        { line.FirmId, line.ClientId, line.EngagementId, line.TransactionId }
        equals new { transaction.FirmId, transaction.ClientId, transaction.EngagementId, TransactionId = transaction.Id }
      where line.FirmId == _actor.FirmId && line.ClientId == context.ClientId && line.EngagementId == context.EngagementId &&
        batch.PeriodId == periodId && batch.SourceKind == "GL" && batch.Status == "SEALED" &&
        batch.NormalizedDatasetDigest.Length == 64 && line.OriginalCurrency != profile.FunctionalCurrency
      orderby transaction.PostingDate descending, transaction.StableJournalId, line.StableLineId
      select new { Line = line, Transaction = transaction }).Take(500).Select(x => new GlLineOption(x.Line.Id,
        x.Line.OriginalCurrency, x.Line.OriginalAmount, x.Line.FunctionalAmount,
        $"{x.Transaction.PostingDate:yyyy-MM-dd} · {x.Transaction.StableJournalId} / {x.Line.StableLineId} · {x.Line.AccountCode}"))
      .ToListAsync();
    _rateSets = rateSets.Select(x => new IdOption(x.Id, $"{x.Code} v{x.Version} · {x.Source}")).ToList();
    _policies = policies.Select(x => new IdOption(x.Id, $"{x.Code} · {x.FunctionalCurrency} · closing {x.ClosingRateRule} / historical {x.HistoricalRateRule}")).ToList();
    if (_rateSets.Count == 1) _rateSetId = _rateSets[0].Id.ToString("D");
    if (_policies.Count == 1) _policyId = _policies[0].Id.ToString("D");
    if (_lines.Count == 0) _lines.Add(new LineInput());
  }

  private async Task ContextChangedAsync()
  {
    if (_loadedContextId != _contextId) await LoadChoicesAsync();
    _saveDraftAfterRender = true;
  }
  private async Task SourceLineChangedAsync(LineInput line)
  {
    if (_glLines.FirstOrDefault(x => x.Id.ToString("D") == line.SourceLineId) is { } source)
      line.Currency = source.Currency;
    _saveDraftAfterRender = true;
  }
  private Task AddLineAsync()
  {
    if (_lines.Count < 500) _lines.Add(new LineInput());
    _saveDraftAfterRender = true;
    return Task.CompletedTask;
  }
  private Task RemoveLineAsync(LineInput line)
  {
    _lines.Remove(line);
    if (_lines.Count == 0) _lines.Add(new LineInput());
    _saveDraftAfterRender = true;
    return Task.CompletedTask;
  }
  private async Task PrepareAsync()
  {
    _message = null;
    if (_busy || _actor is null || !Guid.TryParse(_contextId, out var periodId) ||
        !Guid.TryParse(_rateSetId, out var rateSetId) || !Guid.TryParse(_policyId, out var policyId) || _lines.Count == 0)
    { _error = true; _message = "Select a scoped period, approved inputs and at least one complete evidence line."; return; }
    var context = _contexts.FirstOrDefault(x => x.Id == periodId);
    if (context is null || !_lines.All(x => Guid.TryParse(x.SnapshotId, out _) && Guid.TryParse(x.SourceLineId, out _) && !string.IsNullOrWhiteSpace(x.Reference) &&
        x.ForeignAmount.HasValue && x.PriorCarrying.HasValue && (x.IsMonetary || x.HistoricalRateDate.HasValue)))
    { _error = true; _message = "Complete each required field and provide a valid source snapshot ID; historical rate dates are required for non-monetary items."; return; }
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var request = new CurrencyRemeasurementScheduleRequest(context.ClientId, context.EngagementId, periodId, rateSetId, policyId,
        context.EndDate, _lines.Select(x => new CurrencyRemeasurementItemRequest(x.Reference.Trim(), Guid.Parse(x.SnapshotId), x.IsMonetary,
          x.Currency, x.ForeignAmount!.Value, x.PriorCarrying!.Value, x.HistoricalRateDate.HasValue ? DateOnly.FromDateTime(x.HistoricalRateDate.Value) : null,
          Guid.Parse(x.SourceLineId))).ToArray());
      var result = await CurrencyRemeasurementService.PrepareAsync(db, _actor, request);
      if (!result.Succeeded) { _error = true; _message = $"Blocked: {result.ErrorCode} — {result.Message}"; return; }
      var saved = await db.CurrencyRemeasurementSchedules.AsNoTracking().SingleAsync(x => x.Id == result.Value && x.FirmId == _actor.FirmId);
      await LoadScheduleAsync(result.Value);
      _history = _history.Where(x => x.Id != result.Value).Prepend(new ScheduleRow(result.Value, context.ClientName,
        context.PeriodCode, saved.Status, saved.CreatedAt)).Take(50).ToList();
      try { await JS.InvokeVoidAsync("auditSphereDrafts.clear", $"accounting-remeasurement-{_actor.FirmId:D}-{_actor.UserId:D}"); } catch (JSException) { }
      _error = false;
      _message = "Submitted workpaper saved. Review the source and calculation before independent approval.";
    }
    catch (Exception ex) when (ex is DbUpdateException or InvalidOperationException or ArgumentException)
    { _error = true; _message = "Workpaper was not confirmed as saved. Refresh the schedule list or retry only after checking whether the submission exists."; }
    finally { _busy = false; }
  }

  private async Task ApproveAsync()
  {
    if (_actor is null || _schedule is null || _busy) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await CurrencyRemeasurementService.ApproveAsync(db, _actor, _schedule.Id);
      if (!result.Succeeded) { _error = true; _message = $"Approval blocked: {result.ErrorCode} — {result.Message}"; return; }
      await LoadScheduleAsync(_schedule.Id);
      _error = false;
      _message = "Independent approval recorded after current evidence and calculation revalidation. No journal was posted.";
    }
    catch (Exception) { _error = true; _message = "Approval outcome could not be confirmed. Reopen this workpaper before retrying."; }
    finally { _busy = false; }
  }

  private async Task LoadScheduleAsync(Guid id)
  {
    _schedule = null;
    await using var db = await DbFactory.CreateDbContextAsync();
    var result = await CurrencyRemeasurementService.GetAsync(db, _actor!, id);
    if (result.Succeeded) _schedule = result.Value;
    else { _error = true; _message = "Schedule saved, but its scoped readback could not be confirmed."; }
  }

  private async Task OpenScheduleAsync(Guid id)
  {
    _message = null;
    await LoadScheduleAsync(id);
    if (_schedule is null && _message is null) { _error = true; _message = "Schedule is unavailable in the current authorization scope."; }
  }
}
