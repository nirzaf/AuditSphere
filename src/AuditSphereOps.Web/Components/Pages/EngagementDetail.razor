@page "/app/engagements/{EngagementId:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Engagements
@using AuditSphereOps.Domain.Practice
@using AuditSphereOps.Domain.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Engagement details</PageTitle>
<a class="back-link" href="/app">← Back to portfolio</a>
<h1>Engagement details</h1>

@if (_loading)
{
  <p role="status">Loading engagement…</p>
}
else if (_actor is null || !_isStaff)
{
  <section class="notice" role="alert"><h2>Access unavailable</h2><p>Sign in with an authorized internal staff identity to view this engagement.</p></section>
}
else if (_engagement is null)
{
  <section class="notice" role="alert"><h2>Engagement unavailable</h2><p>The requested engagement was not found in the current firm scope.</p></section>
}
else
{
  <section class="card" aria-labelledby="eng-heading">
    <p class="eyebrow">Status: @_engagement.Status (Generation @_engagement.Generation)</p>
    <h2 id="eng-heading">@_engagement.ServiceRoute — @_clientName</h2>
    <dl class="details">
      <dt>Engagement ID</dt><dd><code>@_engagement.Id</code></dd>
      <dt>Client</dt><dd><a href="/app/clients/@_engagement.PracticeClientId">@_clientName</a></dd>
      <dt>Reporting Period</dt><dd>@_engagement.PeriodStart to @_engagement.PeriodEnd</dd>
      <dt>Service Profile</dt><dd>@(_engagement.ServiceProfileId ?? "Standard")</dd>
      <dt>Professional Work Blocked</dt>
      <dd>
        @if (_engagement.ProfessionalWorkBlocked)
        {
          <span class="error-text"><strong>BLOCKED</strong> (Professional work blocked until active holds are released)</span>
        }
        else
        {
          <span class="success-text"><strong>CLEAR</strong> (Authorized professional work may proceed)</span>
        }
      </dd>
      <dt>Created</dt><dd>@_engagement.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
    </dl>
  </section>

  <section class="card" aria-labelledby="actions-heading">
    <h2 id="actions-heading">Work surfaces</h2>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <a class="button" href="/app/engagements/@_engagement.Id/pbc">Open PBC requests</a>
      <a class="button" href="/app/clients/@_engagement.PracticeClientId">View client profile</a>
    </div>
  </section>

  <section class="card" aria-labelledby="holds-heading">
    <h2 id="holds-heading">Engagement holds & clearance gates</h2>
    @if (_holds.Count == 0)
    {
      <p class="muted">No holds are recorded against this engagement.</p>
    }
    else
    {
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Engagement holds and status</caption>
          <thead>
            <tr>
              <th scope="col">Hold Kind</th>
              <th scope="col">Reason</th>
              <th scope="col">Status</th>
              <th scope="col">Recorded</th>
              <th scope="col">Released</th>
            </tr>
          </thead>
          <tbody>
          @foreach (var hold in _holds)
          {
            <tr>
              <td><strong>@hold.HoldKind</strong></td>
              <td>@hold.Reason</td>
              <td>
                @if (hold.Released)
                {
                  <span class="success-text">Released</span>
                }
                else
                {
                  <span class="error-text">Active hold</span>
                }
              </td>
              <td>@hold.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
              <td>@(hold.ReleasedAt.HasValue ? hold.ReleasedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </section>
}

@code {
  [Parameter] public Guid EngagementId { get; set; }
  private ActorContext? _actor;
  private bool _isStaff;
  private Engagement? _engagement;
  private string _clientName = "Client";
  private List<EngagementHold> _holds = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      _isStaff = _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "Staff" or "EngagementLeader" or "Auditor");
      if (_isStaff)
      {
        await LoadEngagementAsync();
      }
    }
    _loading = false;
  }

  private async Task LoadEngagementAsync()
  {
    if (_actor is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    _engagement = await db.Engagements.AsNoTracking()
      .SingleOrDefaultAsync(x => x.Id == EngagementId && x.FirmId == _actor.FirmId);
    if (_engagement is not null)
    {
      var client = await db.PracticeClients.AsNoTracking()
        .SingleOrDefaultAsync(x => x.Id == _engagement.PracticeClientId && x.FirmId == _actor.FirmId);
      if (client is not null)
      {
        _clientName = client.LegalName;
      }

      _holds = await db.EngagementHolds.AsNoTracking()
        .Where(x => x.EngagementId == _engagement.Id && x.FirmId == _actor.FirmId)
        .OrderByDescending(x => x.CreatedAt)
        .ToListAsync();
    }
  }
}
