@page "/app/engagements/{EngagementId:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Engagements
@using AuditSphereOps.Domain.Practice
@using AuditSphereOps.Domain.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Engagement details</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Engagement details" Description="Engagement context, authorization scope, holds, and work surface handoffs." />

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading engagement…" />
}
else if (_actor is null || !_isStaff)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Access unavailable</h2><p>Sign in with an authorized internal staff identity to view this engagement.</p></MudAlert>
}
else if (_engagement is null)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Engagement unavailable</h2><p>The requested engagement was not found in the current firm scope.</p></MudAlert>
}
else
{
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="eng-heading" role="region">
    <p class="eyebrow">Status: @_engagement.Status (Generation @_engagement.Generation)</p>
    <h2 id="eng-heading">@_engagement.ServiceRoute — @_clientName</h2>
    <dl class="details">
      <dt>Engagement ID</dt><dd><code>@_engagement.Id</code></dd>
      <dt>Client</dt><dd><a href="/app/clients/@_engagement.PracticeClientId">@_clientName</a></dd>
      <dt>Reporting Period</dt><dd>@_engagement.PeriodStart to @_engagement.PeriodEnd</dd>
      <dt>Service Profile</dt><dd>@(_engagement.ServiceProfileId ?? "Standard")</dd>
      <dt>Professional Work Blocked</dt>
      <dd>
        @if (_engagement.ProfessionalWorkBlocked)
        {
          <span class="error-text"><strong>BLOCKED</strong> (Professional work blocked until active holds are released)</span>
        }
        else
        {
          <span class="success-text"><strong>CLEAR</strong> (Authorized professional work may proceed)</span>
        }
      </dd>
      <dt>Created</dt><dd>@_engagement.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
    </dl>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="actions-heading" role="region">
    <h2 id="actions-heading">Work surfaces</h2>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="@($"/app/engagements/{_engagement.Id}/pbc")" Class="button">Open PBC requests</MudButton>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="@($"/app/clients/{_engagement.PracticeClientId}")" Class="button">View client profile</MudButton>
    </div>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="holds-heading" role="region">
    <h2 id="holds-heading">Engagement holds & clearance gates</h2>
    @if (_holds.Count == 0)
    {
      <p class="muted">No holds are recorded against this engagement.</p>
    }
    else
    {
      <div class="table-wrap">
        <MudTable Items="_holds" Dense="true" Hover="true" Elevation="0">
  <HeaderContent><MudTh scope="col">Hold Kind</MudTh>
              <MudTh scope="col">Reason</MudTh>
              <MudTh scope="col">Status</MudTh>
              <MudTh scope="col">Recorded</MudTh>
              <MudTh scope="col">Released</MudTh></HeaderContent>
  <RowTemplate>              <MudTd><strong>@context.HoldKind</strong></MudTd>
              <MudTd>@context.Reason</MudTd>
              <MudTd>
                @if (context.Released)
                {
                  <span class="success-text">Released</span>
                }
                else
                {
                  <span class="error-text">Active context</span>
                }
              </MudTd>
              <MudTd>@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
              <MudTd>@(context.ReleasedAt.HasValue ? context.ReleasedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")</MudTd></RowTemplate>
</MudTable>
      </div>
    }
  </MudPaper>
}

@code {
  [Parameter] public Guid EngagementId { get; set; }
  private ActorContext? _actor;
  private bool _isStaff;
  private Engagement? _engagement;
  private string _clientName = "Client";
  private List<EngagementHold> _holds = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      _isStaff = _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "Staff" or "EngagementLeader" or "Auditor");
      if (_isStaff)
      {
        await LoadEngagementAsync();
      }
    }
    _loading = false;
  }

  private async Task LoadEngagementAsync()
  {
    if (_actor is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
      new AuthorizationRequest(_actor.FirmId, EngagementId: EngagementId,
        RequiredRoles: ["Administrator", "Partner", "Manager", "Staff", "EngagementLeader", "Auditor"],
        InternalOnly: true));
    if (!authorization.Succeeded) return;

    _engagement = await db.Engagements.AsNoTracking()
      .SingleOrDefaultAsync(x => x.Id == EngagementId && x.FirmId == _actor.FirmId);
    if (_engagement is not null)
    {
      var client = await db.PracticeClients.AsNoTracking()
        .SingleOrDefaultAsync(x => x.Id == _engagement.PracticeClientId && x.FirmId == _actor.FirmId);
      if (client is not null)
      {
        _clientName = client.LegalName;
      }

      _holds = await db.EngagementHolds.AsNoTracking()
        .Where(x => x.EngagementId == _engagement.Id && x.FirmId == _actor.FirmId)
        .OrderByDescending(x => x.CreatedAt)
        .ToListAsync();
    }
  }
}
