@page "/app/practice/invoices/{InvoiceId:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Practice
@using AuditSphereOps.Domain.Practice
@using AuditSphereOps.Domain.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory

<PageTitle>Invoice</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Practice invoice" Description="Client invoice record, line items, and receipt allocations under practice billing controls." />

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading invoice…" />
}
else if (_actor is null || !_isAuthorized)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">Sign in with an authorized finance identity to view this invoice.</MudText>
  </MudAlert>
}
else if (_invoice is null)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Invoice unavailable</h2>
    <MudText Typo="Typo.body2">The requested invoice was not found in the current firm scope.</MudText>
  </MudAlert>
}
else
{
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="invoice-heading" role="region">
    <p class="eyebrow">Status: @_invoice.Status (Rev @_invoice.Revision)</p>
    <h2 id="invoice-heading">@_invoice.InvoiceNumber</h2>
    <dl class="details">
      <dt>Invoice ID</dt><dd><code>@_invoice.Id</code></dd>
      <dt>Currency</dt><dd>@(_invoice.Currency ?? "Default")</dd>
      <dt>Subtotal</dt><dd>@_invoice.Subtotal.ToString("N2")</dd>
      <dt>Tax</dt><dd>@_invoice.Tax.ToString("N2")</dd>
      <dt>Total Amount</dt><dd><strong>@_invoice.Total.ToString("N2")</strong></dd>
      <dt>Balance Outstanding</dt><dd><strong>@_balance.ToString("N2")</strong></dd>
      <dt>Created</dt><dd>@_invoice.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
      @if (_invoice.PostedAt.HasValue)
      {
        <dt>Posted</dt><dd>@_invoice.PostedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</dd>
      }
    </dl>
  </MudPaper>

  @if (_result is not null)
  {
    <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">
      @(_result.Succeeded ? (_successMessage ?? "Action completed successfully.") : "Blocked: " + _result.ErrorCode)
    </p>
  }

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="lines-heading" role="region">
    <h2 id="lines-heading">Invoice line items</h2>
    @if (_lines.Count == 0)
    {
      <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">No line items recorded on this invoice.</MudText>
    }
    else
    {
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Invoice lines</caption>
          <thead>
            <tr>
              <th scope="col">Description</th>
              <th scope="col" style="text-align: right;">Quantity</th>
              <th scope="col" style="text-align: right;">Unit Price</th>
              <th scope="col" style="text-align: right;">Total</th>
            </tr>
          </thead>
          <tbody>
          @foreach (var line in _lines)
          {
            <tr>
              <td>@line.Description</td>
              <td style="text-align: right;">@line.Quantity.ToString("N2")</td>
              <td style="text-align: right;">@line.UnitPrice.ToString("N2")</td>
              <td style="text-align: right;">@line.LineTotal.ToString("N2")</td>
            </tr>
          }
          </tbody>
          <tfoot>
            <tr style="font-weight: bold;">
              <td colspan="3" style="text-align: right;">Total</td>
              <td style="text-align: right;">@_lines.Sum(x => x.LineTotal).ToString("N2")</td>
            </tr>
          </tfoot>
        </table>
      </div>
    }
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="alloc-heading" role="region">
    <h2 id="alloc-heading">Receipt allocations</h2>
    @if (_allocations.Count == 0)
    {
      <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">No payments or receipts allocated to this invoice.</MudText>
    }
    else
    {
      <MudTable Items="_allocations" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
          <MudTh>Receipt ID</MudTh>
          <MudTh>Date</MudTh>
          <MudTh Style="text-align: right;">Allocated Amount</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Receipt ID"><code>@context.ReceiptId</code></MudTd>
          <MudTd DataLabel="Date">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
          <MudTd DataLabel="Allocated Amount" Style="text-align: right;">@context.Amount.ToString("N2")</MudTd>
        </RowTemplate>
        <PagerContent>
          <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
      </MudTable>
    }
  </MudPaper>

  @if (_canAct)
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="workflow-heading" role="region">
      <h2 id="workflow-heading">Invoice workflow actions</h2>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        @if (_invoice.Status == BillingStates.InvoiceReviewRequired)
        {
          <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="ApproveInvoiceAsync" Disabled="@_busy">Approve invoice</MudButton>
        }
        else if (_invoice.Status == BillingStates.InvoiceApproved)
        {
          <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="PostInvoiceAsync" Disabled="@_busy">Post invoice (Freeze &amp; Emit ledger event)</MudButton>
        }
        else if (_invoice.Status == BillingStates.InvoicePosted)
        {
          <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="SendInvoiceAsync" Disabled="@_busy">Mark sent to client</MudButton>
        }
      </div>
    </MudPaper>
  }
}

@code {
  [Parameter] public Guid InvoiceId { get; set; }
  private ActorContext? _actor;
  private bool _isAuthorized;
  private bool _canAct;
  private Invoice? _invoice;
  private decimal _balance;
  private List<InvoiceLine> _lines = [];
  private List<ReceiptAllocation> _allocations = [];
  private CommandResult? _result;
  private string? _successMessage;
  private bool _loading = true;
  private bool _busy;
  private Guid? _loadedInvoiceId;
  private bool _routeInitialized;
  private long _loadGeneration;

  protected override async Task OnParametersSetAsync()
  {
    if (_routeInitialized && _loadedInvoiceId == InvoiceId) return;
    _routeInitialized = true;
    _loadedInvoiceId = InvoiceId;
    var generation = ++_loadGeneration;
    ClearInvoice();
    _loading = true;
    try
    {
      _actor = await ActorResolver.ResolveAsync();
      if (_actor is not null)
      {
        _isAuthorized = _actor.Roles.Any(x => x is "FinanceManager" or "FinanceReviewer");
        _canAct = _isAuthorized;
        if (_isAuthorized)
          await LoadInvoiceAsync(InvoiceId, generation);
      }
    }
    finally
    {
      if (generation == _loadGeneration) _loading = false;
    }
  }

  private async Task LoadInvoiceAsync(Guid invoiceId, long generation)
  {
    var actor = _actor;
    if (actor is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    var detail = await BillingService.GetInvoiceDetailAsync(db, actor, invoiceId);
    if (generation != _loadGeneration) return;
    if (!detail.Succeeded || detail.Value is null)
    {
      ClearInvoice();
      return;
    }
    _invoice = detail.Value.Invoice;
    _lines = detail.Value.Lines.ToList();
    _allocations = detail.Value.Allocations.ToList();
    _balance = detail.Value.Balance.Outstanding;
  }

  private void ClearInvoice()
  {
    _actor = null;
    _isAuthorized = false;
    _canAct = false;
    _invoice = null;
    _balance = 0;
    _lines = [];
    _allocations = [];
    _result = null;
    _successMessage = null;
  }

  private void ApplyCommandResult(CommandResult result, string successMessage, long generation)
  {
    if (generation != _loadGeneration) return;
    _result = result;
    _successMessage = result.Succeeded ? successMessage : null;
    if (!result.Succeeded && result.ErrorCode is ErrorCodes.ScopeDenied or ErrorCodes.GenerationStale)
      ClearInvoice();
  }

  private async Task ApproveInvoiceAsync()
  {
    var actor = _actor;
    var invoice = _invoice;
    var generation = _loadGeneration;
    if (actor is null || invoice is null || _busy) return;
    _busy = true;
    _result = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await BillingService.ApproveInvoiceAsync(db, actor, invoice.Id);
      ApplyCommandResult(result, "Invoice approved.", generation);
      if (result.Succeeded && generation == _loadGeneration) await LoadInvoiceAsync(invoice.Id, generation);
    }
    finally { _busy = false; }
  }

  private async Task PostInvoiceAsync()
  {
    var actor = _actor;
    var invoice = _invoice;
    var generation = _loadGeneration;
    if (actor is null || invoice is null || _busy) return;
    _busy = true;
    _result = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await BillingService.PostInvoiceAsync(db, actor, invoice.Id);
      ApplyCommandResult(result, "Invoice posted and frozen.", generation);
      if (result.Succeeded && generation == _loadGeneration) await LoadInvoiceAsync(invoice.Id, generation);
    }
    finally { _busy = false; }
  }

  private async Task SendInvoiceAsync()
  {
    var actor = _actor;
    var invoice = _invoice;
    var generation = _loadGeneration;
    if (actor is null || invoice is null || _busy) return;
    _busy = true;
    _result = null;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await BillingService.SendInvoiceAsync(db, actor, invoice.Id);
      ApplyCommandResult(result, "Invoice marked as sent.", generation);
      if (result.Succeeded && generation == _loadGeneration) await LoadInvoiceAsync(invoice.Id, generation);
    }
    finally { _busy = false; }
  }
}
