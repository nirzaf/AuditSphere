@page "/app/audit/populations/{Id:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Security
@using AuditSphereOps.Domain.Audit
@using AuditSphereOps.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Population — AuditSphereOps</PageTitle>

<div class="page-header">
    <nav class="breadcrumb-nav">
        <a href="/app">Portfolio</a> /
        @if (_population is not null)
        {
            <a href="@($"/app/engagements/{_population.EngagementId}/audit-fieldwork")">Fieldwork</a>
            <span> / </span>
        }
        <span>Population</span>
    </nav>
    <PageHeader Title="Population Record" Eyebrow="Audit sampling" Description="Scoped audit population rows, sampling evidence, and objective-level progression." />
</div>

@if (_loading)
{
    <LoadingState IsLoading="true" LoadingMessage="Loading…" />
}
else if (_actor is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert">
        <h2>Sign in required</h2>
        <p>An authenticated staff session is required to view a population.</p>
    </MudAlert>
}
else if (_population is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert">
        <h2>Population unavailable</h2>
        <p>The requested population is unavailable in your current scope.</p>
    </MudAlert>
}
else
{
    <div class="audit-record-toolbar" aria-label="Population navigation">
        <StatusChip Status="@_population.Status" />
        <MudLink Href="@($"/app/engagements/{_population.EngagementId}/audit-fieldwork")">Fieldwork control center</MudLink>
        <MudLink Href="@($"/app/engagements/{_population.EngagementId}/audit-plan")">Audit plan</MudLink>
    </div>
    <MudGrid Spacing="2" Class="audit-accounting-metrics my-3" aria-label="Scoped population summary">
        <MudItem xs="6" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Population rows</MudText><MudText Typo="Typo.h4">@_population.RowCount.ToString("N0")</MudText></MudPaper></MudItem>
        <MudItem xs="6" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Selection sets</MudText><MudText Typo="Typo.h4">@_selections.Count</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="4"><MudPaper Class="audit-metric pa-3"><MudText Typo="Typo.overline">Reviewed item tests</MudText><MudText Typo="Typo.h4">@_selections.Sum(x => x.ReviewedTestCount)</MudText></MudPaper></MudItem>
    </MudGrid>
    <div class="population-shell">
        <MudPaper Class="audit-workspace-panel audit-record-summary pa-4 my-4" Elevation="0">
            <h2>Population Details (§20.1)</h2>
            <dl class="audit-population-facts">
                <div><dt>Purpose</dt><dd>@_population.Purpose</dd></div>
                <div><dt>Assertion</dt><dd>@_population.Assertion</dd></div>
                <div><dt>Source receipt reference</dt><dd>@_population.SourceReceiptReference</dd></div>
                <div><dt>Extraction parameters</dt><dd>@_population.ExtractionParameters</dd></div>
                <div><dt>Row count</dt><dd>@_population.RowCount.ToString("N0")</dd></div>
                <div><dt>Monetary control total</dt><dd>@_population.Currency @_population.MonetaryControlTotal.ToString("N2")</dd></div>
                <div><dt>Exclusions</dt><dd>@(_population.Exclusions ?? "None recorded")</dd></div>
                <div><dt>Status</dt><dd>@_population.Status</dd></div>
                <div><dt>Extracted</dt><dd>@_population.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</dd></div>
            </dl>
        </MudPaper>

        <MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="0">
            <h2>Selections and test results</h2>
            <p class="field-help">Counts repeat recorded selections and item-test reviews for this population version. They do not establish sampling sufficiency or an audit conclusion.</p>
            @if (_selections.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No selection has been recorded for this population version.</MudAlert>
            }
            else
            {
                <div class="table-wrap">
                    <MudTable Items="_selections" Dense="true" Hover="true" Elevation="0" HorizontalScrollbar="true" Class="data-table audit-population-table">
  <HeaderContent><MudTh scope="col">Method</MudTh><MudTh scope="col">Status</MudTh><MudTh scope="col">Items</MudTh><MudTh scope="col">Tests</MudTh><MudTh scope="col">Reviewed tests</MudTh><MudTh scope="col">Rationale</MudTh></HeaderContent>
  <RowTemplate>                                    <MudTd DataLabel="Method">@context.Method</MudTd>
                                    <MudTd DataLabel="Status"><StatusChip Status="@context.Status" /></MudTd>
                                    <MudTd DataLabel="Items">@context.ItemCount</MudTd>
                                    <MudTd DataLabel="Tests">@context.TestCount</MudTd>
                                    <MudTd DataLabel="Reviewed tests">@context.ReviewedTestCount</MudTd>
                                    <MudTd DataLabel="Rationale" Class="audit-population-rationale"><span>@context.Rationale</span></MudTd></RowTemplate>
</MudTable>
                </div>
            }
        </MudPaper>

        <MudPaper Class="audit-workspace-panel pa-4 my-4" Elevation="0">
            <h2>Linked evidence</h2>
            @if (_evidence.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No source receipts are linked to this engagement as evidence.</MudAlert>
            }
            else
            {
                <ul class="program-list">
                    @foreach (var link in _evidence)
                    {
                        <li>
                            <span class="program-name">@link.Purpose (@link.Assertion)</span>
                            <span class="program-status">Receipt @_receiptTokens[link.SourceReceiptId]</span>
                        </li>
                    }
                </ul>
            }
        </MudPaper>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AuditSphereOps.Application.Abstractions.ActorContext? _actor;
    private PopulationVersion? _population;
    private List<EvidenceLink> _evidence = [];
    private Dictionary<Guid, string> _receiptTokens = new();
    private List<SelectionSummary> _selections = [];
    private bool _loading = true;

    private sealed record SelectionSummary(string Method, string Status, string Rationale, int ItemCount, int TestCount, int ReviewedTestCount);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        ClearPopulation();
        _actor = await ActorResolver.ResolveAsync();
        if (_actor is not null) await LoadPopulationAsync(_actor);
        _loading = false;
    }

    private async Task LoadPopulationAsync(AuditSphereOps.Application.Abstractions.ActorContext actor)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var scope = await db.PopulationVersions.AsNoTracking()
            .Where(p => p.Id == Id && p.FirmId == actor.FirmId)
            .Select(p => new { p.ClientId, p.EngagementId })
            .SingleOrDefaultAsync();
        if (scope is null) return;

        var authorization = await AuthorizationDecision.AuthorizeAsync(db, actor,
            new AuthorizationRequest(actor.FirmId, ClientId: scope.ClientId,
                EngagementId: scope.EngagementId,
                RequiredRoles: ["Administrator", "Partner", "Manager", "SeniorManager", "Senior", "Staff", "EngagementLeader", "Auditor"],
                InternalOnly: true));
        if (!authorization.Succeeded) return;

        _population = await db.PopulationVersions.AsNoTracking()
            .FirstOrDefaultAsync(p => p.Id == Id && p.FirmId == actor.FirmId &&
                p.ClientId == scope.ClientId && p.EngagementId == scope.EngagementId);
        if (_population is null) return;

        _evidence = await db.EvidenceLinks.AsNoTracking()
            .Where(e => e.FirmId == actor.FirmId && e.ClientId == scope.ClientId && e.EngagementId == scope.EngagementId)
            .OrderByDescending(e => e.CreatedAt)
            .ToListAsync();
        var receiptIds = _evidence.Select(e => e.SourceReceiptId).Distinct().ToArray();
        _receiptTokens = await db.SourceReceipts.AsNoTracking()
            .Where(r => r.FirmId == actor.FirmId && r.ClientId == scope.ClientId &&
                r.EngagementId == scope.EngagementId && receiptIds.Contains(r.Id))
            .ToDictionaryAsync(r => r.Id, r => r.ReceiptToken);

        var selectionRows = await db.AuditSelections.AsNoTracking()
            .Where(s => s.FirmId == actor.FirmId && s.ClientId == scope.ClientId &&
                s.EngagementId == scope.EngagementId && s.PopulationVersionId == _population.Id)
            .OrderBy(s => s.CreatedAt)
            .ToListAsync();
        var selectionIds = selectionRows.Select(s => s.Id).ToArray();
        var itemRows = await db.AuditSelectionItems.AsNoTracking()
            .Where(i => i.FirmId == actor.FirmId && i.ClientId == scope.ClientId &&
                i.EngagementId == scope.EngagementId && selectionIds.Contains(i.SelectionId))
            .Select(i => new { i.Id, i.SelectionId }).ToListAsync();
        var itemIds = itemRows.Select(i => i.Id).ToArray();
        var testRows = await db.AuditItemTests.AsNoTracking()
            .Where(t => t.FirmId == actor.FirmId && t.ClientId == scope.ClientId &&
                t.EngagementId == scope.EngagementId && itemIds.Contains(t.SelectionItemId))
            .Select(t => new { t.Id, t.SelectionId }).ToListAsync();
        var testIds = testRows.Select(t => t.Id).ToArray();
        var reviewedTestIds = await db.AuditItemTestReviews.AsNoTracking()
            .Where(r => r.FirmId == actor.FirmId && r.ClientId == scope.ClientId &&
                r.EngagementId == scope.EngagementId && testIds.Contains(r.AuditItemTestId) &&
                r.Decision == AuditItemTestReviewDecisions.Reviewed)
            .Select(r => r.AuditItemTestId).Distinct().ToListAsync();
        _selections = selectionRows.Select(s => new SelectionSummary(
            s.Method, s.Status, s.Rationale,
            itemRows.Count(i => i.SelectionId == s.Id),
            testRows.Count(t => t.SelectionId == s.Id),
            testRows.Count(t => t.SelectionId == s.Id && reviewedTestIds.Contains(t.Id)))).ToList();
    }

    private void ClearPopulation()
    {
        _population = null;
        _evidence.Clear();
        _receiptTokens.Clear();
        _selections.Clear();
    }
}
