@page "/app/audit/populations/{Id:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Domain.Audit
@using AuditSphereOps.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Population — AuditSphereOps</PageTitle>

<div class="page-header">
    <nav class="breadcrumb-nav">
        <a href="/app">Portfolio</a> /
        <span>Population</span>
    </nav>
    <h1>Population Record</h1>
    <span class="status-badge badge-blue">@(_population?.Status)</span>
</div>

@if (_loading)
{
    <p role="status">Loading…</p>
}
else if (_actor is null)
{
    <section class="notice" role="alert">
        <h2>Sign in required</h2>
        <p>An authenticated staff session is required to view a population.</p>
    </section>
}
else if (_population is null)
{
    <section class="notice" role="alert">
        <h2>Population unavailable</h2>
        <p>The requested population was not found in the current firm scope.</p>
    </section>
}
else
{
    <div class="population-shell">
        <section class="card">
            <h2>Population Details (§20.1)</h2>
            <dl class="detail-grid">
                <dt>Purpose</dt><dd>@_population.Purpose</dd>
                <dt>Assertion</dt><dd>@_population.Assertion</dd>
                <dt>Source receipt reference</dt><dd>@_population.SourceReceiptReference</dd>
                <dt>Extraction parameters</dt><dd>@_population.ExtractionParameters</dd>
                <dt>Row count</dt><dd>@_population.RowCount.ToString("N0")</dd>
                <dt>Monetary control total</dt><dd>@_population.Currency @_population.MonetaryControlTotal.ToString("N2")</dd>
                <dt>Exclusions</dt><dd>@(_population.Exclusions ?? "None recorded")</dd>
                <dt>Status</dt><dd>@_population.Status</dd>
                <dt>Extracted</dt><dd>@_population.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</dd>
            </dl>
        </section>

        <section class="card">
            <h2>Selections and test results</h2>
            @if (_selections.Count == 0)
            {
                <p class="empty-state">No selection has been recorded for this population version.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <caption class="sr-only">Selections and item-test review status</caption>
                        <thead>
                            <tr><th scope="col">Method</th><th scope="col">Status</th><th scope="col">Items</th><th scope="col">Tests</th><th scope="col">Reviewed tests</th><th scope="col">Rationale</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var selection in _selections)
                            {
                                <tr>
                                    <td>@selection.Method</td>
                                    <td>@selection.Status</td>
                                    <td>@selection.ItemCount</td>
                                    <td>@selection.TestCount</td>
                                    <td>@selection.ReviewedTestCount</td>
                                    <td>@selection.Rationale</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="card">
            <h2>Linked evidence</h2>
            @if (_evidence.Count == 0)
            {
                <p class="empty-state">No source receipts are linked to this engagement as evidence.</p>
            }
            else
            {
                <ul class="program-list">
                    @foreach (var link in _evidence)
                    {
                        <li>
                            <span class="program-name">@link.Purpose (@link.Assertion)</span>
                            <span class="program-status">Receipt @_receiptTokens[link.SourceReceiptId]</span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AuditSphereOps.Application.Abstractions.ActorContext? _actor;
    private PopulationVersion? _population;
    private List<EvidenceLink> _evidence = [];
    private Dictionary<Guid, string> _receiptTokens = new();
    private List<SelectionSummary> _selections = [];
    private bool _loading = true;

    private sealed record SelectionSummary(string Method, string Status, string Rationale, int ItemCount, int TestCount, int ReviewedTestCount);

    protected override async Task OnInitializedAsync()
    {
        _actor = await ActorResolver.ResolveAsync();
        if (_actor is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _population = await db.PopulationVersions.AsNoTracking()
                .FirstOrDefaultAsync(p => p.Id == Id && p.FirmId == _actor.FirmId);
            if (_population is not null)
            {
                _evidence = await db.EvidenceLinks.AsNoTracking()
                    .Where(e => e.FirmId == _population.FirmId && e.EngagementId == _population.EngagementId)
                    .OrderByDescending(e => e.CreatedAt)
                    .ToListAsync();
                var receiptIds = _evidence.Select(e => e.SourceReceiptId).Distinct().ToArray();
                _receiptTokens = await db.SourceReceipts.AsNoTracking()
                    .Where(r => receiptIds.Contains(r.Id))
                    .ToDictionaryAsync(r => r.Id, r => r.ReceiptToken);

                var selectionRows = await db.AuditSelections.AsNoTracking()
                    .Where(s => s.FirmId == _population.FirmId && s.ClientId == _population.ClientId &&
                        s.EngagementId == _population.EngagementId && s.PopulationVersionId == _population.Id)
                    .OrderBy(s => s.CreatedAt)
                    .ToListAsync();
                var selectionIds = selectionRows.Select(s => s.Id).ToArray();
                var itemRows = await db.AuditSelectionItems.AsNoTracking()
                    .Where(i => selectionIds.Contains(i.SelectionId)).Select(i => new { i.Id, i.SelectionId }).ToListAsync();
                var itemIds = itemRows.Select(i => i.Id).ToArray();
                var testRows = await db.AuditItemTests.AsNoTracking()
                    .Where(t => itemIds.Contains(t.SelectionItemId)).Select(t => new { t.Id, t.SelectionId }).ToListAsync();
                var testIds = testRows.Select(t => t.Id).ToArray();
                var reviewedTestIds = await db.AuditItemTestReviews.AsNoTracking()
                    .Where(r => testIds.Contains(r.AuditItemTestId) && r.Decision == AuditItemTestReviewDecisions.Reviewed)
                    .Select(r => r.AuditItemTestId).Distinct().ToListAsync();
                _selections = selectionRows.Select(s => new SelectionSummary(
                    s.Method, s.Status, s.Rationale,
                    itemRows.Count(i => i.SelectionId == s.Id),
                    testRows.Count(t => t.SelectionId == s.Id),
                    testRows.Count(t => t.SelectionId == s.Id && reviewedTestIds.Contains(t.Id)))).ToList();
            }
        }
        _loading = false;
    }
}
