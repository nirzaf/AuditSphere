@page "/app/administration"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Security
@using AuditSphereOps.Domain.Microsoft365
@using AuditSphereOps.Domain.Security
@using Microsoft.JSInterop
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Firm administration</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Firm administration &amp; security" Description="System and firm-level administrative configuration (§43.2). Versioned configuration and role grants; direct database manipulation consoles are prohibited." />
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button-secondary" OnClick="RefreshAdministrationAsync" Disabled="@(_loading || _roleBusy)">Refresh administration</MudButton>

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading administration details…" />
}
else if (_actor is null || !_isAdmin)
{
  <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="notice my-4" role="alert">
    <h2>Access unavailable</h2>
    <MudText Typo="Typo.body2">Sign in with an authorized Administrator or Partner identity to view firm administration.</MudText>
  </MudAlert>
}
else
{
  <p class="scope-note">System and firm-level administrative configuration (§43.2). Versioned configuration and role grants; direct database manipulation consoles are prohibited.</p>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="safety-heading" role="region">
    <h2 id="safety-heading">Firm safety state</h2>
    <dl class="details">
      <dt>Firm ID</dt><dd><code>@_actor.FirmId</code></dd>
      <dt>Operating Mode</dt>
      <dd>
        @if (_safetyState?.OperatingMode == "RECOVERY_QUARANTINE")
        {
          <span class="error-text"><strong>RECOVERY_QUARANTINE</strong> (New operations halted; manual operator review required)</span>
        }
        else
        {
          <span class="success-text"><strong>@(_safetyState?.OperatingMode ?? "LOCAL_ONLY")</strong> (Normal operations active)</span>
        }
      </dd>
      <dt>Deployment Epoch</dt><dd>@(_safetyState?.DeploymentEpoch ?? 1)</dd>
      <dt>Operations Panel</dt><dd><MudLink Href="/app/operations">Manage durable operations &amp; recovery</MudLink></dd>
    </dl>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="env-heading" role="region">
    <h2 id="env-heading">Runtime environment &amp; security fences</h2>
    <dl class="details">
      <dt>Hosting Environment</dt><dd>@Configuration["ASPNETCORE_ENVIRONMENT"]</dd>
      <dt>External Effects Enabled</dt><dd><code>@Configuration["ExternalEffects:Enabled"]</code> (Strictly fenced)</dd>
      <dt>Simulation Adapters Allowed</dt><dd><code>@Configuration["ExternalEffects:AllowSimulationAdapters"]</code></dd>
      <dt>System Liveness</dt><dd><a href="/health/live" target="_blank">Check /health/live</a></dd>
      <dt>System Readiness</dt><dd><a href="/health/ready" target="_blank">Check /health/ready (migration verified)</a></dd>
    </dl>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="m365-heading" role="region">
    <h2 id="m365-heading">Microsoft 365 onboarding</h2>
    <p class="field-help">Connection, selected-resource verification, role assignment, and client workspace provisioning are separate revisions. An unconfigured or unverified integration cannot create outward effects.</p>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/app/administration/microsoft365" Class="button">Open Microsoft 365 setup</MudButton>
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="roles-heading" role="region">
    <h2 id="roles-heading">Firm role grants</h2>
    @if (_grants.Count == 0)
    {
      <MudText Typo="Typo.body2" Color="Color.Secondary" Class="muted">No role grants found in current firm scope.</MudText>
    }
    else
    {
      <MudTable Items="_grants" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
          <MudTh>Identity</MudTh>
          <MudTh>Role</MudTh>
          <MudTh>Client Scope</MudTh>
          <MudTh>Engagement Scope</MudTh>
          <MudTh>Granted</MudTh>
          <MudTh>Invitation / evidence</MudTh>
          <MudTh>State / action</MudTh>
        </HeaderContent>
        <RowTemplate>
          @{
            _usersById.TryGetValue(context.UserId, out var user);
            _invitationsByGrant.TryGetValue(context.Id, out var invitation);
            DirectoryUserObservation? observation = null;
            if (user is not null)
              _directoryByIdentity.TryGetValue((user.TenantId, user.Subject), out observation);
          }
          <MudTd DataLabel="Identity">
            @if (user is null)
            {
              <span class="error-text">Identity record unavailable</span>
            }
            else
            {
              <strong>@user.DisplayName</strong><br />
              <span>@user.Email (@user.UserKind)</span><br />
              <code title="Immutable Microsoft identity binding">@user.TenantId / @user.Subject</code>
            }
          </MudTd>
          <MudTd DataLabel="Role"><strong>@context.Role</strong></MudTd>
          <MudTd DataLabel="Client Scope">@(context.ClientId.HasValue ? context.ClientId.Value.ToString() : "Firm-wide")</MudTd>
          <MudTd DataLabel="Engagement Scope">@(context.EngagementId.HasValue ? context.EngagementId.Value.ToString() : "—")</MudTd>
          <MudTd DataLabel="Granted">@context.GrantedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
          <MudTd DataLabel="Invitation / evidence">
            <div>Invitation: <strong>@(invitation?.DeliveryState ?? "NOT_CREATED")</strong></div>
            <div>First access: @(invitation?.FirstAccessAt?.ToString("yyyy-MM-dd HH:mm") ?? "Not recorded")</div>
            <div>Directory: @(observation?.EnabledState ?? "NOT_OBSERVED") @(observation is null ? string.Empty : $"({observation.Source}, {observation.ObservedAt:yyyy-MM-dd HH:mm})")</div>
            @if (invitation is not null && context.RevokedAt is null)
            {
              <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="btn-secondary" OnClick="() => CopyExistingInvitationAsync(invitation)" Disabled="@_roleBusy">Copy invitation</MudButton>
            }
          </MudTd>
          <MudTd DataLabel="State / action">
            @if (context.RevokedAt is null)
            {
              <MudButton Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Class="button" OnClick="() => RevokeRoleAsync(context.Id)" Disabled="@_roleBusy">Revoke</MudButton>
            }
            else
            {
              <span class="muted">Revoked @context.RevokedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
            }
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="btn-secondary" OnClick="() => ToggleGrantHistory(context.Id)">@(_expandedGrantId == context.Id ? "Hide history" : "View history")</MudButton>
            @if (_expandedGrantId == context.Id)
            {
              <div class="mt-2">
                <strong>Access history</strong>
                @if (!_grantHistoryByGrant.TryGetValue(context.Id, out var history) || history.Count == 0)
                {
                  <div class="muted">No recorded evidence for this grant.</div>
                }
                else
                {
                  <ul class="history-list">
                  @foreach (var evidence in history)
                  {
                    <li><strong>@evidence.Action</strong> — @evidence.Source — @evidence.CreatedAt.ToString("yyyy-MM-dd HH:mm") — actor <code>@evidence.ActorUserId</code></li>
                  }
                  </ul>
                }
              </div>
            }
          </MudTd>
        </RowTemplate>
        <PagerContent>
          <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
      </MudTable>
    }
  </MudPaper>

  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="role-change-heading" role="region">
    <h2 id="role-change-heading">Verified roster role administration</h2>
    <p class="field-help">Live Graph directory browsing is blocked until the narrow DEC-01 exception is approved. This local fallback accepts an administrator-provided or exact verified-sign-in identity; email and display name never identify a user.</p>
    <div class="form-group"><label for="roster-tenant">Tenant ID <span class="required-marker">*</span><MudTextField T="string" @bind-Value="_rosterTenant" MaxLength="200" id="roster-tenant" required title="Exact verified Entra tenant ID (tid)." /></label></div>
    <div class="form-group"><label for="roster-subject">Object ID / subject <span class="required-marker">*</span><MudTextField T="string" @bind-Value="_rosterSubject" MaxLength="200" id="roster-subject" required title="Immutable verified Entra object/subject identifier (oid/sub)." /></label></div>
    <div class="form-group"><label for="roster-email">Email <span class="required-marker">*</span><MudTextField T="string" @bind-Value="_rosterEmail" InputType="InputType.Email" MaxLength="320" id="roster-email" required title="Display/contact data only; it cannot merge identities." /></label></div>
    <div class="form-group"><label for="roster-name">Display name <span class="required-marker">*</span><MudTextField T="string" @bind-Value="_rosterName" MaxLength="300" id="roster-name" required /></label></div>
    <div class="form-group"><label for="roster-kind">Application identity kind <span class="required-marker">*</span><MudSelect T="string" @bind-Value="_rosterKind" id="roster-kind" title="Staff and client identities use different landing areas and role policies."><MudSelectItem Value="@("Staff")">Staff</MudSelectItem><MudSelectItem Value="@("Client")">Client</MudSelectItem></MudSelect></label></div>
    <div class="form-group"><label for="roster-source">Identity evidence <span class="required-marker">*</span><MudSelect T="string" @bind-Value="_rosterSource" id="roster-source" title="Record whether this exact identity came from an approved roster or a verified sign-in."><MudSelectItem Value="@("APPROVED_ROSTER")">Approved roster</MudSelectItem><MudSelectItem Value="@("VERIFIED_SIGN_IN")">Verified sign-in</MudSelectItem></MudSelect></label></div>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="OnboardUserAsync" Disabled="@_roleBusy">@(_roleBusy ? "Saving…" : "Bind user")</MudButton>
    @if (_selectedUserId.HasValue)
    {
      <p class="field-help">Selected local user: <code>@_selectedUserId</code>. No role is granted until the explicit plan below is applied.</p>
      <div class="form-group"><label for="role-name">Application role <span class="required-marker">*</span><MudSelect T="string" @bind-Value="_roleName" id="role-name" title="Canonical local role only; Entra job title, group and email domain do not grant authority.">@foreach (var roleCode in RoleAdministrationService.RoleCodes) { <MudSelectItem Value="@roleCode">@roleCode</MudSelectItem> }</MudSelect></label></div>
      <div class="form-group"><label for="scope-kind">Scope <span class="required-marker">*</span><MudSelect T="string" @bind-Value="_scopeKind" id="scope-kind" title="An empty scope is never inferred as firm-wide; choose it explicitly."><MudSelectItem Value="@("FIRM_WIDE")">Firm-wide</MudSelectItem><MudSelectItem Value="@("CLIENT")">Selected client</MudSelectItem><MudSelectItem Value="@("ENGAGEMENT")">Selected engagement</MudSelectItem></MudSelect></label></div>
      @if (_scopeKind is "CLIENT" or "ENGAGEMENT")
      { <div class="form-group"><label for="scope-client">Client ID <span class="required-marker">*</span><MudTextField T="string" @bind-Value="_scopeClientIdText" MaxLength="36" id="scope-client" title="Exact client ID in the current firm." /></label></div> }
      @if (_scopeKind == "ENGAGEMENT")
      { <div class="form-group"><label for="scope-engagement">Engagement ID <span class="required-marker">*</span><MudTextField T="string" @bind-Value="_scopeEngagementIdText" MaxLength="36" id="scope-engagement" title="Exact engagement ID; its client relationship is revalidated server-side." /></label></div> }
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="ApplyRoleAsync" Disabled="@_roleBusy">Save access and create invitation</MudButton>
      @if (!string.IsNullOrWhiteSpace(_invitationLink))
      {
        <div class="notice" role="status">
          <strong>Invitation link — not sent by AuditSphere</strong>
          <p class="field-help">This link contains no bearer token or role data. The recipient must authenticate with Microsoft and still pass the local grant check.</p>
          <MudTextField T="string" Value="@_invitationLink" ReadOnly="true" title="Safe application landing path; copy and share only with the confirmed recipient." />
          <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="btn-secondary" OnClick="CopyInvitationAsync" Disabled="@_roleBusy">Copy invitation</MudButton>
          @if (!string.IsNullOrWhiteSpace(_invitationMessage)) { <span class="success-text">@_invitationMessage</span> }
        </div>
      }
    }
    @if (!string.IsNullOrWhiteSpace(_roleMessage)) { <p class="notice" role="status">@_roleMessage</p> }
    @if (!string.IsNullOrWhiteSpace(_roleError)) { <p class="notice error" role="alert">@_roleError</p> }
  </MudPaper>
}

@code {
  private ActorContext? _actor;
  private bool _isAdmin;
  private FirmSafetyState? _safetyState;
  private List<RoleGrant> _grants = [];
  private bool _loading = true;
  private bool _roleBusy;
  private Guid? _selectedUserId;
  private string _rosterTenant = string.Empty, _rosterSubject = string.Empty, _rosterEmail = string.Empty, _rosterName = string.Empty;
  private string _rosterSource = "APPROVED_ROSTER", _rosterKind = "Staff", _roleName = "Staff", _scopeKind = "FIRM_WIDE";
  private string _scopeClientIdText = string.Empty, _scopeEngagementIdText = string.Empty;
  private Dictionary<Guid, AppUser> _usersById = [];
  private Dictionary<Guid, UserAccessInvitation> _invitationsByGrant = [];
  private Dictionary<(string TenantId, string Subject), DirectoryUserObservation> _directoryByIdentity = [];
  private Dictionary<Guid, List<RoleGrantChangeEvidence>> _grantHistoryByGrant = [];
  private Guid? _expandedGrantId;
  private Guid? _invitationId;
  private string _invitationLink = string.Empty, _invitationMessage = string.Empty;
  private string _roleMessage = string.Empty, _roleError = string.Empty;
  private long _loadGeneration;

  protected override Task OnInitializedAsync() => LoadAdministrationAsync();

  private Task RefreshAdministrationAsync() => LoadAdministrationAsync();

  private void ClearProtectedState(bool clearForms)
  {
    _actor = null;
    _isAdmin = false;
    _safetyState = null;
    _grants = [];
    _usersById = [];
    _invitationsByGrant = [];
    _directoryByIdentity = [];
    _grantHistoryByGrant = [];
    _expandedGrantId = null;
    if (clearForms)
    {
      _selectedUserId = null;
      _rosterTenant = _rosterSubject = _rosterEmail = _rosterName = string.Empty;
      _rosterSource = "APPROVED_ROSTER";
      _rosterKind = "Staff";
      _roleName = "Staff";
      _scopeKind = "FIRM_WIDE";
      _scopeClientIdText = _scopeEngagementIdText = string.Empty;
      _invitationId = null;
      _invitationLink = _invitationMessage = string.Empty;
      _roleMessage = _roleError = string.Empty;
    }
  }

  private async Task LoadAdministrationAsync(bool clearForms = true)
  {
    var generation = ++_loadGeneration;
    _loading = true;
    ClearProtectedState(clearForms);
    try
    {
      var actor = await ActorResolver.ResolveAsync();
      if (actor is null || generation != _loadGeneration) return;
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await FirmAdministrationQuery.GetAsync(db, actor);
      if (!result.Succeeded || generation != _loadGeneration)
      {
        if (generation == _loadGeneration) ClearProtectedState(clearForms: true);
        return;
      }
      var currentActor = await ActorResolver.ResolveAsync();
      if (currentActor is null || currentActor.UserId != actor.UserId ||
          currentActor.FirmId != actor.FirmId || currentActor.SessionEpoch != actor.SessionEpoch ||
          generation != _loadGeneration)
      {
        if (generation == _loadGeneration) ClearProtectedState(clearForms: true);
        return;
      }
      var snapshot = result.Value!;
      _actor = currentActor;
      _isAdmin = true;
      _safetyState = snapshot.SafetyState;
      _grants = snapshot.Grants;
      _usersById = snapshot.UsersById;
      _invitationsByGrant = snapshot.InvitationsByGrant;
      _directoryByIdentity = snapshot.DirectoryByIdentity;
      _grantHistoryByGrant = snapshot.GrantHistoryByGrant;
    }
    finally { if (generation == _loadGeneration) _loading = false; }
  }

  private void ToggleGrantHistory(Guid grantId) => _expandedGrantId = _expandedGrantId == grantId ? null : grantId;

  private async Task OnboardUserAsync()
  {
    if (_actor is null) return;
    _roleMessage = _roleError = string.Empty; _roleBusy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await RoleAdministrationService.EnsureUserAsync(db, _actor,
        new(_rosterTenant, _rosterSubject, _rosterEmail, _rosterName, _rosterKind, _rosterSource));
      if (!result.Succeeded) { _roleError = result.Message ?? "The user could not be bound."; return; }
      _selectedUserId = result.Value;
      _invitationId = null; _invitationLink = string.Empty; _invitationMessage = string.Empty;
      _roleMessage = "Exact identity bound. Review the explicit role and scope before applying it.";
      await LoadAdministrationAsync(clearForms: false);
    }
    finally { _roleBusy = false; }
  }

  private async Task ApplyRoleAsync()
  {
    if (_actor is null || !_selectedUserId.HasValue) return;
    _roleMessage = _roleError = string.Empty; _roleBusy = true;
    try
    {
      Guid? clientId = null, engagementId = null;
      if (_scopeKind is "CLIENT" or "ENGAGEMENT")
      {
        if (!Guid.TryParse(_scopeClientIdText, out var parsedClient)) { _roleError = "A valid client ID is required for this scope."; return; }
        clientId = parsedClient;
      }
      if (_scopeKind == "ENGAGEMENT")
      {
        if (!Guid.TryParse(_scopeEngagementIdText, out var parsedEngagement)) { _roleError = "A valid engagement ID is required for this scope."; return; }
        engagementId = parsedEngagement;
      }
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await RoleAdministrationService.ApplyRoleGrantAndInvitationAsync(db, _actor,
        new(_selectedUserId.Value, _roleName, _scopeKind, clientId, engagementId));
      if (!result.Succeeded) { _roleError = result.Message ?? "The role grant was rejected."; return; }
      _invitationId = result.Value!.InvitationId;
      _invitationLink = BuildInvitationLink(result.Value.DestinationPath);
      _roleMessage = "Role grant and invitation intent saved atomically; target sessions were invalidated.";
      await LoadAdministrationAsync(clearForms: false);
    }
    finally { _roleBusy = false; }
  }

  private Task CopyInvitationAsync() => _invitationId.HasValue
    ? CopyInvitationCoreAsync(_invitationId.Value, existing: false) : Task.CompletedTask;

  private Task CopyExistingInvitationAsync(UserAccessInvitation invitation) =>
    CopyInvitationCoreAsync(invitation.Id, existing: true);

  private async Task CopyInvitationCoreAsync(Guid invitationId, bool existing)
  {
    if (_actor is null) return;
    var actor = _actor;
    _roleBusy = true; _invitationMessage = string.Empty; _roleError = string.Empty;
    try
    {
      var currentActor = await ActorResolver.ResolveAsync();
      if (currentActor is null || currentActor.UserId != actor.UserId ||
          currentActor.FirmId != actor.FirmId || currentActor.SessionEpoch != actor.SessionEpoch)
      {
        await LoadAdministrationAsync();
        return;
      }
      await using var db = await DbFactory.CreateDbContextAsync();
      var copyable = await FirmAdministrationQuery.GetCopyableInvitationAsync(db, currentActor, invitationId);
      if (!copyable.Succeeded)
      {
        await LoadAdministrationAsync();
        return;
      }
      await JS.InvokeVoidAsync("auditSphereExports.copyText", BuildInvitationLink(copyable.Value!.DestinationPath));
      var result = await RoleAdministrationService.MarkInvitationCopiedAsync(db, currentActor, invitationId);
      var message = result.Succeeded
        ? existing ? $"Copied invitation for {copyable.Value.RecipientEmail}." : "Copied and recorded."
        : result.Message ?? "Copied locally; the status could not be recorded.";
      await LoadAdministrationAsync(clearForms: false);
      if (_isAdmin) _invitationMessage = message;
    }
    catch (JSException)
    {
      await LoadAdministrationAsync(clearForms: false);
      if (_isAdmin) _invitationMessage = "Copy was unavailable; select the link and copy it manually.";
    }
    finally { _roleBusy = false; }
  }

  private string BuildInvitationLink(string path)
  {
    var configured = Configuration["Application:PublicBaseUrl"];
    if (Uri.TryCreate(configured, UriKind.Absolute, out var baseUri) && baseUri.Scheme is "http" or "https")
      return new Uri(baseUri, path.TrimStart('/')).AbsoluteUri;
    return path;
  }

  private async Task RevokeRoleAsync(Guid grantId)
  {
    if (_actor is null) return;
    _roleMessage = _roleError = string.Empty; _roleBusy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await RoleAdministrationService.RevokeRoleGrantAsync(db, _actor, new(grantId));
      if (!result.Succeeded) { _roleError = result.Message ?? "The role grant could not be revoked."; return; }
      _roleMessage = "Role grant revoked and the target session epoch was invalidated.";
      await LoadAdministrationAsync(clearForms: false);
    }
    finally { _roleBusy = false; }
  }
}
