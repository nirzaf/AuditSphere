@page "/app/administration"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Security
@using AuditSphereOps.Domain.Security
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject IConfiguration Configuration

<PageTitle>Firm administration</PageTitle>
<a class="back-link" href="/app">← Back to portfolio</a>
<h1>Firm administration & security</h1>

@if (_loading)
{
  <p role="status">Loading administration details…</p>
}
else if (_actor is null || !_isAdmin)
{
  <section class="notice" role="alert"><h2>Access unavailable</h2><p>Sign in with an authorized Administrator or Partner identity to view firm administration.</p></section>
}
else
{
  <p class="scope-note">System and firm-level administrative configuration (§43.2). Versioned configuration and role grants; direct database manipulation consoles are prohibited.</p>

  <section class="card" aria-labelledby="safety-heading">
    <h2 id="safety-heading">Firm safety state</h2>
    <dl class="details">
      <dt>Firm ID</dt><dd><code>@_actor.FirmId</code></dd>
      <dt>Operating Mode</dt>
      <dd>
        @if (_safetyState?.OperatingMode == "RECOVERY_QUARANTINE")
        {
          <span class="error-text"><strong>RECOVERY_QUARANTINE</strong> (New operations halted; manual operator review required)</span>
        }
        else
        {
          <span class="success-text"><strong>@(_safetyState?.OperatingMode ?? "LOCAL_ONLY")</strong> (Normal operations active)</span>
        }
      </dd>
      <dt>Deployment Epoch</dt><dd>@(_safetyState?.DeploymentEpoch ?? 1)</dd>
      <dt>Operations Panel</dt><dd><a href="/app/operations">Manage durable operations & recovery</a></dd>
    </dl>
  </section>

  <section class="card" aria-labelledby="env-heading">
    <h2 id="env-heading">Runtime environment & security fences</h2>
    <dl class="details">
      <dt>Hosting Environment</dt><dd>@Configuration["ASPNETCORE_ENVIRONMENT"]</dd>
      <dt>External Effects Enabled</dt><dd><code>@Configuration["ExternalEffects:Enabled"]</code> (Strictly fenced)</dd>
      <dt>Simulation Adapters Allowed</dt><dd><code>@Configuration["ExternalEffects:AllowSimulationAdapters"]</code></dd>
      <dt>System Liveness</dt><dd><a href="/health/live" target="_blank">Check /health/live</a></dd>
      <dt>System Readiness</dt><dd><a href="/health/ready" target="_blank">Check /health/ready (migration verified)</a></dd>
    </dl>
  </section>

  <section class="card" aria-labelledby="m365-heading">
    <h2 id="m365-heading">Microsoft 365 onboarding</h2>
    <p class="field-help">Connection, selected-resource verification, role assignment, and client workspace provisioning are separate revisions. An unconfigured or unverified integration cannot create outward effects.</p>
    <a class="button" href="/app/administration/microsoft365" title="Open the protected, resumable Microsoft 365 setup draft">Open Microsoft 365 setup</a>
  </section>

  <section class="card" aria-labelledby="roles-heading">
    <h2 id="roles-heading">Firm role grants</h2>
    @if (_grants.Count == 0)
    {
      <p class="muted">No role grants found in current firm scope.</p>
    }
    else
    {
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Firm role grants</caption>
          <thead>
            <tr>
              <th scope="col">User ID</th>
              <th scope="col">Role</th>
              <th scope="col">Client Scope</th>
              <th scope="col">Engagement Scope</th>
              <th scope="col">Granted</th>
              <th scope="col">State / action</th>
            </tr>
          </thead>
          <tbody>
          @foreach (var grant in _grants)
          {
            <tr>
              <td><code>@grant.UserId</code></td>
              <td><strong>@grant.Role</strong></td>
              <td>@(grant.ClientId.HasValue ? grant.ClientId.Value.ToString() : "Firm-wide")</td>
              <td>@(grant.EngagementId.HasValue ? grant.EngagementId.Value.ToString() : "—")</td>
              <td>@grant.GrantedAt.ToString("yyyy-MM-dd HH:mm")</td>
              <td>
                @if (grant.RevokedAt is null)
                {
                  <button class="button" @onclick="() => RevokeRoleAsync(grant.Id)" disabled="@_roleBusy" title="Record an append-only revocation and invalidate the target session">Revoke</button>
                }
                else
                {
                  <span class="muted">Revoked @grant.RevokedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                }
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </section>

  <section class="card" aria-labelledby="role-change-heading">
    <h2 id="role-change-heading">Verified roster role administration</h2>
    <p class="field-help">Live Graph directory browsing is not enabled until DEC-01 is approved. Use an administrator-provided or exact verified-sign-in identity; email and display name never identify a user.</p>
    <div class="form-group"><label for="roster-tenant">Tenant ID <span class="required-marker">*</span><input id="roster-tenant" @bind="_rosterTenant" maxlength="200" required title="Exact verified Entra tenant ID (tid)." /></label></div>
    <div class="form-group"><label for="roster-subject">Object ID / subject <span class="required-marker">*</span><input id="roster-subject" @bind="_rosterSubject" maxlength="200" required title="Immutable verified Entra object/subject identifier (oid/sub)." /></label></div>
    <div class="form-group"><label for="roster-email">Email <span class="required-marker">*</span><input id="roster-email" type="email" @bind="_rosterEmail" maxlength="320" required title="Display/contact data only; it cannot merge identities." /></label></div>
    <div class="form-group"><label for="roster-name">Display name <span class="required-marker">*</span><input id="roster-name" @bind="_rosterName" maxlength="300" required /></label></div>
    <div class="form-group"><label for="roster-source">Identity evidence <span class="required-marker">*</span><select id="roster-source" @bind="_rosterSource" title="Record whether this exact identity came from an approved roster or a verified sign-in."><option value="APPROVED_ROSTER">Approved roster</option><option value="VERIFIED_SIGN_IN">Verified sign-in</option></select></label></div>
    <button class="button" @onclick="OnboardUserAsync" disabled="@_roleBusy" title="Bind the exact tenant and subject to a local staff user without granting a role">@(_roleBusy ? "Saving…" : "Bind user")</button>
    @if (_selectedUserId.HasValue)
    {
      <p class="field-help">Selected local user: <code>@_selectedUserId</code>. No role is granted until the explicit plan below is applied.</p>
      <div class="form-group"><label for="role-name">Application role <span class="required-marker">*</span><select id="role-name" @bind="_roleName"><option>Administrator</option><option>Partner</option><option>Manager</option><option>Staff</option><option>RelationshipManager</option><option>FinanceManager</option><option>FinanceReviewer</option></select></label></div>
      <div class="form-group"><label for="scope-kind">Scope <span class="required-marker">*</span><select id="scope-kind" @bind="_scopeKind" title="An empty scope is never inferred as firm-wide; choose it explicitly."><option value="FIRM_WIDE">Firm-wide</option><option value="CLIENT">Selected client</option><option value="ENGAGEMENT">Selected engagement</option></select></label></div>
      @if (_scopeKind is "CLIENT" or "ENGAGEMENT")
      { <div class="form-group"><label for="scope-client">Client ID <span class="required-marker">*</span><input id="scope-client" @bind="_scopeClientIdText" maxlength="36" title="Exact client ID in the current firm." /></label></div> }
      @if (_scopeKind == "ENGAGEMENT")
      { <div class="form-group"><label for="scope-engagement">Engagement ID <span class="required-marker">*</span><input id="scope-engagement" @bind="_scopeEngagementIdText" maxlength="36" title="Exact engagement ID; its client relationship is revalidated server-side." /></label></div> }
      <button class="button" @onclick="ApplyRoleAsync" disabled="@_roleBusy" title="Apply one reviewed, scope-bound local role grant and invalidate the target session epoch">Apply role grant</button>
    }
    @if (!string.IsNullOrWhiteSpace(_roleMessage)) { <p class="notice" role="status">@_roleMessage</p> }
    @if (!string.IsNullOrWhiteSpace(_roleError)) { <p class="notice error" role="alert">@_roleError</p> }
  </section>
}

@code {
  private ActorContext? _actor;
  private bool _isAdmin;
  private FirmSafetyState? _safetyState;
  private List<RoleGrant> _grants = [];
  private bool _loading = true;
  private bool _roleBusy;
  private Guid? _selectedUserId;
  private string _rosterTenant = string.Empty, _rosterSubject = string.Empty, _rosterEmail = string.Empty, _rosterName = string.Empty;
  private string _rosterSource = "APPROVED_ROSTER", _roleName = "Staff", _scopeKind = "FIRM_WIDE";
  private string _scopeClientIdText = string.Empty, _scopeEngagementIdText = string.Empty;
  private string _roleMessage = string.Empty, _roleError = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      _isAdmin = await db.RoleGrants.AsNoTracking().AnyAsync(x =>
        x.FirmId == _actor.FirmId && x.UserId == _actor.UserId && x.RevokedAt == null &&
        x.ClientId == null && x.EngagementId == null && x.Role == "Administrator");
      if (_isAdmin)
      {
        await LoadAdminDataAsync();
      }
    }
    _loading = false;
  }

  private async Task LoadAdminDataAsync()
  {
    if (_actor is null) return;
    await using var db = await DbFactory.CreateDbContextAsync();
    _safetyState = await db.FirmSafetyStates.AsNoTracking()
      .SingleOrDefaultAsync(x => x.Id == _actor.FirmId);

    _grants = await db.RoleGrants.AsNoTracking()
      .Where(x => x.FirmId == _actor.FirmId)
      .OrderBy(x => x.Role)
      .ThenBy(x => x.UserId)
      .ToListAsync();
  }

  private async Task OnboardUserAsync()
  {
    if (_actor is null) return;
    _roleMessage = _roleError = string.Empty; _roleBusy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await RoleAdministrationService.EnsureStaffUserAsync(db, _actor,
        new(_rosterTenant, _rosterSubject, _rosterEmail, _rosterName, _rosterSource));
      if (!result.Succeeded) { _roleError = result.Message ?? "The user could not be bound."; return; }
      _selectedUserId = result.Value;
      _roleMessage = "Exact identity bound. Review the explicit role and scope before applying it.";
      await LoadAdminDataAsync();
    }
    finally { _roleBusy = false; }
  }

  private async Task ApplyRoleAsync()
  {
    if (_actor is null || !_selectedUserId.HasValue) return;
    _roleMessage = _roleError = string.Empty; _roleBusy = true;
    try
    {
      Guid? clientId = null, engagementId = null;
      if (_scopeKind is "CLIENT" or "ENGAGEMENT")
      {
        if (!Guid.TryParse(_scopeClientIdText, out var parsedClient)) { _roleError = "A valid client ID is required for this scope."; return; }
        clientId = parsedClient;
      }
      if (_scopeKind == "ENGAGEMENT")
      {
        if (!Guid.TryParse(_scopeEngagementIdText, out var parsedEngagement)) { _roleError = "A valid engagement ID is required for this scope."; return; }
        engagementId = parsedEngagement;
      }
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await RoleAdministrationService.ApplyRoleGrantAsync(db, _actor,
        new(_selectedUserId.Value, _roleName, _scopeKind, clientId, engagementId));
      if (!result.Succeeded) { _roleError = result.Message ?? "The role grant was rejected."; return; }
      _roleMessage = "Role grant applied and target sessions invalidated.";
      await LoadAdminDataAsync();
    }
    finally { _roleBusy = false; }
  }

  private async Task RevokeRoleAsync(Guid grantId)
  {
    if (_actor is null) return;
    _roleMessage = _roleError = string.Empty; _roleBusy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var result = await RoleAdministrationService.RevokeRoleGrantAsync(db, _actor, new(grantId));
      if (!result.Succeeded) { _roleError = result.Message ?? "The role grant could not be revoked."; return; }
      _roleMessage = "Role grant revoked and the target session epoch was invalidated.";
      await LoadAdminDataAsync();
    }
    finally { _roleBusy = false; }
  }
}
