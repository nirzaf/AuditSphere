@page "/app/releases/{CandidateId:guid}"
@rendermode InteractiveServer
@using AuditSphereOps.Application.Completion
@using AuditSphereOps.Application.Security
@using AuditSphereOps.Domain.Records
@inject CurrentActorResolver ActorResolver
@inject IDbContextFactory<AuditSphereDbContext> DbFactory
@inject ReleaseSafetyOptions Safety


<PageTitle>Release candidate</PageTitle>
<MudLink Href="/app" Class="back-link mb-2 d-inline-block">← Back to portfolio</MudLink>
<PageHeader Title="Release candidate" Description="Release readiness, required gates, and the controlled issue decision for this candidate." />

@if (_loading)
{
  <LoadingState IsLoading="true" LoadingMessage="Loading current candidate…" />
}
else if (_actor is null || !IsStaff)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Access unavailable</h2><p>Sign in with an authorized staff identity to view this candidate.</p></MudAlert>
}
else if (_candidate is null)
{
  <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="notice my-4" role="alert"><h2>Candidate unavailable</h2><p>The candidate is not available in the current firm scope.</p></MudAlert>
}
else
{
  <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="candidate-heading" role="region">
    <p class="eyebrow">@_candidate.Status</p>
    <h2 id="candidate-heading"><code>@_candidate.Id</code></h2>
    <dl class="details">
      <dt>Target</dt><dd>@_candidate.TargetKind / revision @_candidate.TargetRevision</dd>
      <dt>Candidate revision</dt><dd>@_candidate.Revision</dd>
      <dt>Manifest digest</dt><dd><code>@_candidate.ManifestDigest</code></dd>
      <dt>Created</dt><dd>@_candidate.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
  </MudPaper>

  @if (_candidate.Status == ReleaseStates.Issued)
  {
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="notice success my-4"><h2>Issued</h2><p>This candidate already has an immutable release event. Repeating the same authorized request is idempotent.</p></MudAlert>
  }
  else
  {
    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="gates-heading" role="region">
      <h2 id="gates-heading">Release evidence gates (§24.4, §25.7)</h2>
      <p class="muted">Every gate requires stored, read-back evidence. Caller assertions are not accepted.</p>
      <dl class="details">
        <dt>External checkpoint</dt>
        <dd>
          @if (_checkpoint is null)
          {
            <span class="error-text">absent — No external checkpoint recorded</span>
          }
          else if (_checkpoint.VerifiedStatus == "VERIFIED")
          {
            <span class="success-text">verified — Stored reference: <code>@_checkpoint.StoredReference</code></span>
          }
          else
          {
            <span class="error-text">@_checkpoint.VerifiedStatus</span>
          }
        </dd>
        <dt>Protection attestation</dt>
        <dd>
          @if (_attestation is null)
          {
            <span class="muted">absent — No Microsoft Purview protection observed (optional in local mode)</span>
          }
          else if (_attestation.ObservedState == "PROTECTED")
          {
            @if (_attestation.ExpiryTime is { } expiry && expiry <= DateTimeOffset.UtcNow)
            {
              <span class="error-text">expired — Profile @_attestation.ProfileId (v@_attestation.ProfileVersion)</span>
            }
            else
            {
              <span class="success-text">verified — Profile @_attestation.ProfileId (v@_attestation.ProfileVersion)</span>
            }
          }
          else
          {
            <span class="error-text">@_attestation.ObservedState</span>
          }
        </dd>
        <dt>Signature lineage</dt>
        <dd>
          @if (_lineage is null)
          {
            <span class="muted">absent — Unsigned candidate (optional in local mode)</span>
          }
          else if (_lineage.VerificationOutcome == "VERIFIED")
          {
            <span class="success-text">verified — @_lineage.SigningMethod</span>
          }
          else
          {
            <span class="error-text">@_lineage.VerificationOutcome</span>
          }
        </dd>
      </dl>
      <p class="notice muted">Notice: No live Microsoft records action is observed. Local development enforces offline verified evidence.</p>
    </MudPaper>

    <MudPaper  Class="pa-4 my-4" Elevation="1" aria-labelledby="issue-heading" role="region">
      <h2 id="issue-heading">Issue exact package</h2>
      <p class="muted">This command rechecks current scope, approval applicability, revisions, generations, holds, manifest and recovery mode. It does not sign files or call a provider.</p>
      <div class="field">
        <label for="release-key">Authorized release key</label>
        <MudTextField T="string" @bind-Value="_releaseKey" MaxLength="200" id="release-key" autocomplete="off" required data-draft-skip="true" title="Enter the authorized key only for this release action; it is never stored in browser draft state." />
      </div>
      <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="button" OnClick="IssueAsync" Disabled="@(!CanIssue || string.IsNullOrWhiteSpace(_releaseKey))">@(_busy ? "Issuing…" : "Issue release")</MudButton>
      @if (_result is not null)
      {
        <p class="command-result @(_result.Succeeded ? "success-text" : "error-text")" role="status">@(_result.Succeeded ? $"Release event: {_result.Value}" : $"Blocked: {_result.ErrorCode}")</p>
      }
    </MudPaper>
  }
}

@code {
  [Parameter] public Guid CandidateId { get; set; }
  private ActorContext? _actor;
  private ReleaseCandidate? _candidate;
  private ReleaseCheckpoint? _checkpoint;
  private ProtectionAttestation? _attestation;
  private SignatureLineage? _lineage;
  private CommandResult<Guid>? _result;
  private string _releaseKey = string.Empty;
  private bool _loading = true;
  private bool _busy;
  private bool IsStaff => _actor is not null && _actor.Roles.Any(x => x is "Administrator" or "Partner" or "Manager" or "Reviewer" or "Staff");
  private bool CanIssue => !_busy && _checkpoint?.VerifiedStatus == "VERIFIED" &&
    (!Safety.RequireProtectionAttestation || _attestation is { ObservedState: "PROTECTED" } &&
      (_attestation.ExpiryTime is null || _attestation.ExpiryTime > DateTimeOffset.UtcNow)) &&
    (!Safety.RequireSignatureLineage || _lineage?.VerificationOutcome == "VERIFIED");

  protected override async Task OnInitializedAsync()
  {
    _actor = await ActorResolver.ResolveAsync();
    if (_actor is not null && IsStaff)
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      var candidate = await db.ReleaseCandidates.AsNoTracking()
        .SingleOrDefaultAsync(x => x.Id == CandidateId && x.FirmId == _actor.FirmId);
      if (candidate is not null)
      {
        var authorization = await AuthorizationDecision.AuthorizeAsync(db, _actor,
          new AuthorizationRequest(candidate.FirmId, candidate.ClientId, candidate.EngagementId,
            ["Administrator", "Partner", "Manager", "Reviewer", "Staff"], InternalOnly: true));
        if (authorization.Succeeded)
        {
          _candidate = candidate;
          _checkpoint = await db.ReleaseCheckpoints.AsNoTracking().SingleOrDefaultAsync(x =>
            x.FirmId == _actor.FirmId && x.ReleaseCandidateId == CandidateId &&
            x.CandidateRevision == candidate.Revision && x.ManifestDigest == candidate.ManifestDigest);
          _attestation = await db.ProtectionAttestations.AsNoTracking().SingleOrDefaultAsync(x =>
            x.FirmId == _actor.FirmId && x.ArtifactHash == candidate.ManifestDigest);
          _lineage = await db.SignatureLineages.AsNoTracking().SingleOrDefaultAsync(x =>
            x.FirmId == _actor.FirmId && x.CandidateId == CandidateId);
        }
      }
    }
    _loading = false;
  }

  private async Task IssueAsync()
  {
    if (_actor is null || _candidate is null || _busy) return;
    _busy = true;
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      _result = await ReleaseService.IssueAsync(db, _actor,
        new IssueReleaseRequest(_candidate.Id, _candidate.Revision, _candidate.ManifestDigest, _releaseKey), Safety);
      if (_result.Succeeded) _candidate.Status = ReleaseStates.Issued;
    }
    finally { _busy = false; }
  }
}
