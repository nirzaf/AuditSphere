@implements IDisposable
@inject AuthenticationStateProvider Authentication
@inject CurrentActorResolver ActorResolver
@inject ILogger<SessionAccessBoundary> Logger

@if (_denied)
{
  <main id="main-content" aria-live="assertive" data-access-revoked>
    <h1>Access unavailable</h1>
    <p>Your session is no longer valid. Sign in again to verify your current access.</p>
    <a href="/auth/sign-in">Sign in</a>
  </main>
}
else
{
  @ChildContent
}

@code {
  [Parameter] public RenderFragment? ChildContent { get; set; }
  private readonly CancellationTokenSource _stopping = new();
  private bool _initialized, _denied, _disposed, _authenticated;
  private Task? _monitor;

  protected override async Task OnInitializedAsync()
  {
    await CheckAsync();
    _initialized = true;
  }

  protected override Task OnAfterRenderAsync(bool firstRender)
  {
    if (_initialized && _monitor is null && !_disposed && _authenticated && !_denied)
      _monitor = MonitorAsync();
    return Task.CompletedTask;
  }

  private async Task CheckAsync()
  {
    try
    {
      var principal = (await Authentication.GetAuthenticationStateAsync()).User;
      _authenticated |= principal.Identity?.IsAuthenticated == true;
      // Anonymous pages retain their own sign-in presentation. Once authenticated,
      // loss of identity or a stale epoch removes the entire protected subtree.
      if (_authenticated)
        _denied = await ActorResolver.ResolveAsync(_stopping.Token) is null;
    }
    catch (OperationCanceledException) when (_stopping.IsCancellationRequested) { }
    catch (Exception ex)
    {
      _denied = true;
      Logger.LogWarning("Session verification failed closed ({FailureType}).", ex.GetType().Name);
    }
  }

  private async Task MonitorAsync()
  {
    using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
    try
    {
      while (await timer.WaitForNextTickAsync(_stopping.Token))
      {
        await InvokeAsync(async () =>
        {
          if (_disposed) return;
          await CheckAsync();
          if (!_disposed && _denied) StateHasChanged();
        });
        if (_denied) break;
      }
    }
    catch (OperationCanceledException) when (_stopping.IsCancellationRequested) { }
    finally { _stopping.Dispose(); }
  }

  public void Dispose()
  {
    if (_disposed) return;
    _disposed = true;
    // A denied monitor may already have completed and disposed its token source.
    if (_monitor?.IsCompleted != true) _stopping.Cancel();
    if (_monitor is null) _stopping.Dispose();
  }
}
