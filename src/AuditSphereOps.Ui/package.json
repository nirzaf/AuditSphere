{
  "name": "auditsphere-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "node ./scripts/run-angular-cli.cjs",
    "start": "node ./scripts/run-angular-cli.cjs serve",
    "build": "node ./scripts/run-angular-cli.cjs build",
    "watch": "node ./scripts/run-angular-cli.cjs build --watch --configuration development",
    "test": "node ./scripts/run-angular-cli.cjs test",
    "test:ci": "node ./scripts/run-angular-cli.cjs test --watch=false",
    "lint": "node ./scripts/run-angular-cli.cjs lint auditsphere-ui",
    "lint:files": "eslint --cache --cache-strategy content --cache-location .angular/cache/eslint --max-warnings 0",
    "lint:ci": "node ./scripts/run-angular-cli.cjs lint auditsphere-ui --cache=false --max-warnings=0"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.1",
    "angular-eslint": "22.1.0",
    "eslint": "10.6.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "overrides": {
    "vite": "8.3.3"
  }
}
