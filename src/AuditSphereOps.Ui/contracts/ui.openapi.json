{
  "openapi": "3.1.0",
  "info": {
    "title": "AuditSphere read-only UI pilot",
    "version": "1.0.0"
  },
  "paths": {
    "/api/ui/session": {
      "get": {
        "operationId": "readSession",
        "description": "Trusted cookie session; current local authority resolved server-side. Responses are Cache-Control: no-store. No browser actor or role authority is accepted.",
        "responses": {
          "200": {
            "description": "Current authorized projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Safe failure; no target or provider detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Safe failure; no target or provider detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Safe failure; no target or provider detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/ui/portfolio": {
      "get": {
        "operationId": "readPortfolioPage",
        "description": "Trusted cookie session; current local authority resolved server-side. Responses are Cache-Control: no-store. No browser actor or role authority is accepted.",
        "responses": {
          "200": {
            "description": "Current authorized projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioPage"
                }
              }
            }
          },
          "401": {
            "description": "Safe failure; no target or provider detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Safe failure; no target or provider detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Safe failure; no target or provider detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Safe failure; no target or provider detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ]
      }
    },
    "/api/ui/sign-out": {
      "post": {
        "operationId": "signOut",
        "description": "Current cookie session and valid X-XSRF-TOKEN antiforgery proof required. Removes authentication and XSRF cookies. No automatic retry.",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Session unavailable"
          },
          "403": {
            "description": "Missing or invalid antiforgery proof"
          },
          "503": {
            "description": "Outcome could not be confirmed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Session": {
        "type": "object",
        "required": [
          "userId",
          "firmId",
          "generation",
          "staff"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "firmId": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "staff": {
            "type": "boolean"
          }
        }
      },
      "PortfolioPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "engagements"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "engagements": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  }
}
