# Copy to .env on the VPS only, set restrictive permissions (for example chmod 600),
# and replace every required placeholder. Never commit a populated .env.

# Release image and worker deployment identity
RELEASE_TAG=replace-with-full-source-commit-sha
DEPLOYMENT_EPOCH=1

# PostgreSQL
POSTGRES_PASSWORD=replace-with-generated-long-random-password

# AuditSphere installation and first-run setup
FIRM_ID=replace-with-firm-guid
INSTALLATION_ID=replace-with-installation-id
BOOTSTRAP_PROOF_HASH=replace-with-sha256-of-approved-one-time-proof

# Entra sign-in and initial administrator
IDENTITY_TENANT_ID=replace-with-entra-tenant-guid
IDENTITY_CLIENT_ID=replace-with-oidc-application-client-guid
IDENTITY_CLIENT_SECRET=replace-with-oidc-application-client-secret
INITIAL_ADMIN_OBJECT_ID=replace-with-initial-administrator-object-guid

# Optional M365 capability switches: keep false until separately configured and approved.
TENANT_CONSENT_ENABLED=false
DIRECTORY_READER_ENABLED=false
PBC_TRANSFER_LIVE_PROVIDER=false
TENANT_ADMINISTRATION_PROVISIONING_ENABLED=false
TENANT_ADMINISTRATION_GUEST_INVITATION_ENABLED=false
TENANT_ADMINISTRATION_GROUP_MEMBERSHIP_ENABLED=false
OUTBOUND_MAIL_ENABLED=false

# Optional capability application IDs and targets. Leave blank while unused.
# DIRECTORY_READER_CLIENT_ID is also used by the tenant-consent flow.
DIRECTORY_READER_CLIENT_ID=
SELECTED_SITE_CLIENT_ID=
SELECTED_SITE_CREDENTIAL_REFERENCE=
SELECTED_SITE_NEGATIVE_CONTROL_URL=
TENANT_ADMINISTRATION_PROVISIONING_CLIENT_ID=
TENANT_ADMINISTRATION_GUEST_INVITATION_CLIENT_ID=
TENANT_ADMINISTRATION_GROUP_MEMBERSHIP_CLIENT_ID=
TENANT_ADMINISTRATION_GUEST_REDIRECT_URL=
OUTBOUND_MAIL_CLIENT_ID=
OUTBOUND_MAIL_SENDER_MAILBOX=
# API mailbox address above is distinct from the worker's immutable Entra mailbox object ID.
OUTBOUND_MAIL_SENDER_OBJECT_ID=
OUTBOUND_MAIL_SERVICE_PRINCIPAL_OBJECT_ID=
OUTBOUND_MAIL_CONTROL_OBJECT_ID=
# Explicit LEGACY or RBAC; leave blank while mail is unused/unverified.
MAIL_AUTHORIZATION_MODEL=
MAIL_AUTHORIZATION_PLAN_SHA256=
MAIL_AUTHORIZATION_SIGNER_SHA256=
MAIL_AUTHORIZATION_MAX_AGE_HOURS=24
MAIL_AUTHORIZATION_CONFIGURE_SHA256=
MAIL_AUTHORIZATION_MODULE_SHA256=
MAIL_AUTHORIZATION_MODULES_LOCK_SHA256=
MAIL_AUTHORIZATION_COMMON_SHA256=
MAIL_AUTHORIZATION_ENTRA_SHA256=
MAIL_AUTHORIZATION_PLAN_SCHEMA_SHA256=
# authorization.json and authorization.p7s belong in the existing read-only outbound-mail
# credential directory. Never place the attestation signer's private key there.
# Evidence source commit must equal RELEASE_TAG and the actual Worker/Application/Infrastructure build.

# Dedicated client-sites rollout. Keep the explicit UTC cutoff blank until approved.
# Compose defaults this capability to true; the blank cutoff keeps new-site rollout fenced.
CLIENT_SITES_ENABLED=true
CLIENT_SITES_CLIENTS_CREATED_AFTER=
CLIENT_SITES_CLIENT_ID=
CLIENT_SITES_SITE_HOST=
CLIENT_SITES_CUSTODIAN_OBJECT_ID=
CLIENT_SITES_ADMINISTRATOR_USER_ID=

# Certificate and private-key paths are fixed in compose.yaml; there are no .env path overrides.
# The base API mounts six individual capability directories read-only, never their parent
# or the privileged client-sites directory. Create protected empty directories for disabled
# capabilities before API recreation; create_host_path=false refuses absent host paths.
# Existing containers keep their old mounts until explicitly recreated and inspected.
# Store certificate.pem and private-key.pem on the VPS under
# /opt/auditsphere/storage/m365-credentials/<capability>/, never in this file or repository.
# Compose mounts these read-only at the following container paths:
#   /run/auditsphere/m365/directory-reader/{certificate.pem,private-key.pem}
#   /run/auditsphere/m365/selected-site/{certificate.pem,private-key.pem}
#   /run/auditsphere/m365/provisioning/{certificate.pem,private-key.pem}
#   /run/auditsphere/m365/guest-invitation/{certificate.pem,private-key.pem}
#   /run/auditsphere/m365/group-membership/{certificate.pem,private-key.pem}
#   /run/auditsphere/m365/outbound-mail/{certificate.pem,private-key.pem}
#   /run/auditsphere/m365/client-sites/{certificate.pem,private-key.pem}
# Leave capability IDs and switches unset/off until each identity, credential, and target is ready.
